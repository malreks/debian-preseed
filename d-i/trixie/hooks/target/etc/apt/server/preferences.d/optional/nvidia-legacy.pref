# Managed by the installer apt-setup preferences generator.
# Pascal requires the proprietary 580 branch. Specific negative records must
# precede the source-family allow: APT uses the FIRST specific matching record.
# Keep the OpenCL userspace packages (nvidia-opencl-*) eligible for Pika; only
# the open-kernel branch and its metapackage are incompatible with Pascal.
Package: nvidia-open-driver*:any nvidia-open-kernel*:any nvidia-kernel-open*:any nvidia-kernel-dkms-open*:any
Pin: version *
Pin-Priority: -1

# Source names alone do not constrain their package versions. Reject every
# non-580.* version, including epoch-qualified versions, before the Pika allow.
# Each alternative excludes ':' so an epoch cannot match as a driver version.
Package: src:nvidia-graphics-drivers-580:any
Pin: version /^([0-9]+:)?([^:5][^:]*|5[^:8][^:]*|58[^:0][^:]*|580[^:.][^:]*|5|58|580)$/
Pin-Priority: -1

# XanMod supplies the kernel, never competing NVIDIA packages.
Package: nvidia*:any libnvidia*:any libcuda*:any libcudadebugger*:any libegl-nvidia*:any libgles-nvidia*:any libglx-nvidia*:any libnvcuvid*:any libnvoptix*:any firmware-nvidia*:any
Pin: origin deb.xanmod.org
Pin-Priority: -1

# Keep DKMS, firmware, EGL/GLX/GLES/GL core, NVML and utilities in one signed
# source cohort, whose package dependencies bind their exact ABI versions.
Package: src:nvidia-graphics-drivers-580:any
Pin: release n=pika,c=cockatiel
Pin-Priority: 990

# Platform bridges and the Debian decoder/firmware have independent versions.
Package: libnvidia-egl-wayland1:any libnvidia-egl-gbm1:any
Pin: release n=pika,c=cockatiel
Pin-Priority: 990

Package: nvidia-vaapi-driver:any firmware-nvidia-graphics:any
Pin: release o=Debian
Pin-Priority: 990

# Fail closed on unsuffixed meta-packages and every other driver branch/origin.
# The independently versioned exceptions above must precede this family guard.
Package: nvidia*:any libnvidia*:any libcuda*:any libcudadebugger*:any libegl-nvidia*:any libgles-nvidia*:any libglx-nvidia*:any libnvcuvid*:any libnvoptix*:any firmware-nvidia*:any
Pin: version *
Pin-Priority: -1

# Pika's EGL implementation requires coherent GBM/Mesa runtime dependencies.
# This policy is staged only for the hardware-approved legacy NVIDIA class.
# Equal native/Pika priority selects newer versions without forced downgrades.
Package: libgbm1 libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libglapi-mesa mesa-libgallium libdrm-common libdrm2 src:glibc:any src:wayland:any libllvm21 libxml2-16
Pin: release o=Debian,n=trixie
Pin-Priority: 990

Package: libgbm1 libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libglapi-mesa mesa-libgallium libdrm-common libdrm2
Pin: release n=pika,c=cockatiel
Pin-Priority: 990

# Keep the required runtime families coherent, as in the desktop graphics
# policy; the rest of the Forky archive remains excluded on Trixie servers.
Package: src:glibc:any src:wayland:any src:libdrm:any libllvm21 libxml2-16
Pin: release o=Debian,n=forky
Pin-Priority: 990

# Keep the disabled Ubuntu-based fallback excluded.
Package: *
Pin: origin apt.pop-os.org
Pin-Priority: -1

# Cockatiel is installer-only. Specific Cockatiel package records above
# remain eligible; every other Cockatiel package is unavailable to pkgsel.
Package: *
Pin: release n=pika,c=cockatiel
Pin-Priority: -1
