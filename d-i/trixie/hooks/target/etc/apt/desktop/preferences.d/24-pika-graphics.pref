# Existing desktop DRM/Mesa runtime and utility packages only. This pin does
# not request packages or enable the excluded Vulkan ICDs/tools.
# Match native Default-Release (990) for the explicitly selected Debian
# graphics stack. PikaOS remains ineligible unless an optional driver pin
# names each package explicitly.
Package: libdrm-common libdrm2 libdrm-amdgpu1 libdrm-intel1 libdrm-nouveau2 libdrm-radeon1 libgbm1 libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libglapi-mesa mesa-libgallium mesa-utils mesa-utils-bin mesa-utils-extra src:glibc:any src:wayland:any libllvm21 libxml2-16
Pin: release o=Debian,n=trixie
Pin-Priority: 990

# Mesa 26 needs newer glibc, DRM and Wayland than native Trixie provides.
# Keep glibc's installed runtime, tools, locales and headers on one source;
# allow only these dependency families from the existing Forky archive.
# Matching the native priority lets a higher native version win in future.
Package: src:glibc:any src:wayland:any src:libdrm:any libllvm21 libxml2-16
Pin: release o=Debian,n=forky
Pin-Priority: 990
