Package: *
Pin: release o=Debian,n=trixie
Pin-Priority: 900

# Experimental's codename is rc-buggy. Its deny rule below also matches the
# experimental URL, including dependencies not named in pkgsel/include.
# Select the complete Debian snapshot source so libllvm24, libclang-cpp24 and
# the requested tools can share one installable build. Other sources stay out.
Package: src:llvm-toolchain-snapshot:any
Pin: release o=Debian,a=experimental
Pin-Priority: 1001

# Keep the runtime on Debian Experimental alongside the complete source
# pin above and the apt.llvm.org exclusion in 20-vendors.pref.
Package: libclang-rt-24-dev
Pin: release o=Debian,a=experimental
Pin-Priority: 1001

Package: libclang-rt-24-dev
Pin: origin apt.llvm.org
Pin-Priority: -1

# Keep the LLDB 24 runtime and Python binding on one Debian Experimental
# snapshot; the generic dependency names otherwise admit a mixed vendor build.
Package: lldb-24 liblldb-24 python3-lldb-24
Pin: release o=Debian,a=experimental
Pin-Priority: 1001

Package: lldb-24 liblldb-24 python3-lldb-24
Pin: origin apt.llvm.org
Pin-Priority: -1

Package: *
Pin: release o=Debian,n=trixie-security
Pin-Priority: 900

Package: *
Pin: release o=Debian,n=trixie-updates
Pin-Priority: 900

Package: *
Pin: release o=Debian,n=forky
Pin-Priority: -1

Package: *
Pin: release o=Debian,n=sid
Pin-Priority: 100

Package: *
Pin: release o=Debian,n=rc-buggy
Pin-Priority: -1

Package: *
Pin: release o=Debian,a=experimental
Pin-Priority: 1

Package: *
Pin: release o=Debian,n=trixie-backports
Pin-Priority: -1

Package: *
Pin: release o=Debian,n=forky-backports
Pin-Priority: -1
