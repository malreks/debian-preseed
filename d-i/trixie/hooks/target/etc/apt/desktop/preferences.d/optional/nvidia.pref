# Current NVIDIA driver from its signed upstream Debian 13 repository.
# Select the open kernel module and its matching Wayland/compute userspace.
# Full X.Org and Vulkan ICD policy remains in the immediate x11.pref.

Package: *
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin-Priority: 100

Package: nvidia-kernel-open-dkms nvidia-driver-cuda nvidia-kernel-support nvidia-modprobe nvidia-persistenced nvidia-powerd nvidia-opencl-icd nvidia-egl-icd firmware-nvidia-gsp libnvidia* libcuda1 libcudadebugger1 libnvcuvid1 libnvoptix1 libegl-nvidia0 libgles-nvidia1 libgles-nvidia2 libglx-nvidia0
Pin: release o=NVIDIA,l=NVIDIA CUDA
Pin-Priority: 900

# Prefer the render-node/PRIME-corrected EGLWayland 1 compatibility library.
# Desktop roles enable Pika Cockatiel; no Pika source is enabled for servers.
# Priority 990 permits a newer native version without forcing a downgrade.
Package: libnvidia-egl-wayland1
Pin: origin ppa.pika-os.com
Pin-Priority: 990

# Keep the disabled Pop!_OS fallback excluded.
Package: *
Pin: origin apt.pop-os.org
Pin-Priority: -1
