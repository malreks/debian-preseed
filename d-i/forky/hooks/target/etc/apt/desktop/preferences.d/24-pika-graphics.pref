# Existing desktop DRM/Mesa runtime and utility packages only. This pin does
# not request packages or enable the excluded Vulkan ICDs/tools.
# Match native Default-Release (990), so the higher available version wins
# in either direction without forcing a downgrade of an installed version.
# Keep that equality during pkgsel, before Default-Release is published.
Package: libdrm-common libdrm2 libdrm-amdgpu1 libdrm-intel1 libdrm-nouveau2 libdrm-radeon1 libgbm1 libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libglapi-mesa mesa-libgallium mesa-utils mesa-utils-bin mesa-utils-extra
Pin: release o=Debian,n=forky
Pin-Priority: 990

Package: libdrm-common libdrm2 libdrm-amdgpu1 libdrm-intel1 libdrm-nouveau2 libdrm-radeon1 libgbm1 libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libglapi-mesa mesa-libgallium mesa-utils mesa-utils-bin mesa-utils-extra
Pin: release n=pika,c=cockatiel
Pin-Priority: 990
