# Labwc requires the reviewed Qt Hyprpolkitagent 0.1.3 series. The native
# Forky 0.2.x build negotiates an unsupported layer-shell protocol and aborts
# during GBM initialization on the managed hybrid GPU. Select the signed
# Debian Trixie Backports build already staged by the Forky APT fragment.
Package: hyprpolkitagent:any
Pin: release o=Debian,n=forky
Pin-Priority: -1

Package: hyprpolkitagent:any
Pin: release a=experimental
Pin-Priority: -1

Package: hyprpolkitagent:any
Pin: release n=sid
Pin-Priority: -1

Package: hyprpolkitagent:any
Pin: release o=Debian,n=trixie-backports
Pin-Priority: 1001
