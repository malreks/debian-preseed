# These bridges are independently versioned Pika packages used by the
# selected EGL/GBM stack.
Package: libnvidia-egl-wayland1:any libnvidia-egl-gbm1:any
Pin: release n=pika,c=cockatiel
Pin-Priority: 990

# Pika Mesa/DRM runtime packages are required only by this exact
# legacy graphics class. They are not a repository-wide allow.
Package: libgbm1:any libgl1-mesa-dri:any libegl-mesa0:any libglx-mesa0:any libglapi-mesa:any mesa-libgallium:any libmesa-stable:any libdrm-common:any libdrm2:any
Pin: release n=pika,c=cockatiel
Pin-Priority: 990

# The VA-API bridge and firmware decoder remain Debian-owned.
Package: nvidia-vaapi-driver:any firmware-nvidia-graphics:any
Pin: release o=Debian
Pin-Priority: 990

# Fail closed on every other NVIDIA/CUDA package and origin. The
# exact records above are evaluated before this deny-only family guard.
Package: nvidia*:any libnvidia*:any libcuda*:any libcudadebugger*:any libegl-nvidia*:any libgles-nvidia*:any libglx-nvidia*:any libnvcuvid*:any libnvoptix*:any firmware-nvidia*:any
Pin: version *
Pin-Priority: -1

# Keep the disabled Ubuntu-based fallback excluded.
Package: *
Pin: origin apt.pop-os.org
Pin-Priority: -1

# Cockatiel is enabled only for this selected class. Every other Pika
# package remains ineligible for dependency resolution.
Package: *
Pin: release n=pika,c=cockatiel
Pin-Priority: -1
