# Managed by the installer apt-setup preferences generator.
# Pascal uses the signed Pika 580 binary packages below. Every Pika
# allow is an exact package name. The final wildcard is deny-only and
# keeps every unlisted Cockatiel package unavailable to APT.

# The open-kernel branch is incompatible with the proprietary Pascal
# driver even when its package is published by the same source.
Package: nvidia-open-driver-580:any nvidia-open-kernel-dkms-580:any nvidia-kernel-open-580:any nvidia-kernel-dkms-open-580:any
Pin: version *
Pin-Priority: -1

# Exact Pika binaries required by the selected 580 class and its
# package dependencies. This closure includes the class packages and
# their package-manager dependencies/recommends. Every Pika allow is
# an exact package name. The final wildcard is deny-only and keeps
# every unlisted Cockatiel package unavailable to APT.

Package: nvidia-alternative-580:any nvidia-driver-580:any nvidia-driver-bin-580:any nvidia-driver-libs-580:any nvidia-egl-icd-580:any nvidia-egl-common-580:any nvidia-kernel-dkms-580:any nvidia-kernel-common-580:any
