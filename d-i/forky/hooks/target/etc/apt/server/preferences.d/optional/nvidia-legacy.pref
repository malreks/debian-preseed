# Managed by the installer apt-setup preferences generator.
# Keep the proprietary 580 DKMS, firmware and userspace ABI in one Pika family.
# Source matching includes the branch's exact-version dependencies and virtual
# providers without selecting open modules, driver metapackages or X.Org.
Package: src:nvidia-graphics-drivers-580:any
Pin: origin ppa.pika-os.com
Pin-Priority: 990

# EGL/GBM platform libraries retain their fixes independently of driver updates.
Package: libnvidia-egl-wayland1 libnvidia-egl-gbm1
Pin: origin ppa.pika-os.com
Pin-Priority: 990

# XanMod supplies the kernel (15-kernel.pref), never competing NVIDIA packages.
Package: nvidia*:any libnvidia*:any libcuda*:any libcudadebugger*:any libegl-nvidia*:any libgles-nvidia*:any libglx-nvidia*:any libnvcuvid*:any libnvoptix*:any firmware-nvidia*:any
Pin: origin deb.xanmod.org
Pin-Priority: -1

# Pika's EGL implementation requires coherent GBM/Mesa runtime dependencies.
# This policy is staged only for the hardware-approved legacy NVIDIA class.
# Equal native/Pika priority selects newer versions without forced downgrades.
Package: libgbm1 libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libglapi-mesa mesa-libgallium libdrm-common libdrm2
Pin: release o=Debian,n=forky
Pin-Priority: 990

Package: libgbm1 libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libglapi-mesa mesa-libgallium libdrm-common libdrm2
Pin: origin ppa.pika-os.com
Pin-Priority: 990

# Other Pika packages remain opt-in, including on NVIDIA-enabled server roles.
Package: *
Pin: origin ppa.pika-os.com
Pin-Priority: 100

# Keep the disabled Ubuntu-based fallback excluded.
Package: *
Pin: origin apt.pop-os.org
Pin-Priority: -1
