# Repository configuration and shared directory roots; data, never shell code.
# Fixed source members are root-relative interfaces at their consumers.
# Build-generated source membership is catalog/compiled/source-members.tsv.
# Installed-system paths belong to hosts/installer/runtime.env; d-i state to
# hooks/installer/di.env. Do not put credentials in this public contract.

REPOSITORY_FAMILIES="desktop server"
REPOSITORY_NAME="debian-preseed-de"
DEBIAN_APT_PREFERENCES=""
DEBIAN_DEFAULT_CLASSES="site/prod;network/dhcp"
DIR_REPO_ROOT="."
DIR_REPO_BUILD_STATE=".build"
DIR_OFFLINE_WORK="${DIR_REPO_BUILD_STATE}/offline-work"
DIR_CATALOG="catalog"
DIR_CATALOG_COMPILED="${DIR_CATALOG}/compiled"
DIR_FRONTENDS="frontends"
DIR_FRONTEND="${DIR_FRONTENDS}/${INSTALLER_SUITE}"
DIR_CLASSES="${DIR_FRONTEND}/classes"
DIR_REPO_DI="d-i"
DIR_REPO_HOOKS="hooks"
DIR_REPO_HOSTS="hosts"
DIR_REPO_SCRIPTS="scripts"
DIR_CLASSES_AUTO="${DIR_CLASSES}/class-auto"
DIR_CLASSES_PROFILE="${DIR_CLASSES}/class-profile"
DIR_CLASSES_PROFILE_DESKTOP="${DIR_CLASSES_PROFILE}/desktop"
