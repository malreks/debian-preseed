#!/bin/sh
# DevOps installation entrypoint; implementation is in late/devops/.
set -eu

target_root=${1:-${TARGET_ROOT}}
[ -d "$target_root" ] || exit 0
devops_codex_host_log_dir=__INSTALLER_LOG_CODEX_RUNTIME_DIR__

runtime_dir=${INSTALLER_RUNTIME_DIR:-/tmp/install-runtime}
bootstrap_lib=${INSTALLER_BOOTSTRAP_LIB:-${runtime_dir}/bootstrap/bootstrap.sh}
[ -s "$bootstrap_lib" ] || {
  printf '%s\n' 'fatal: installer bootstrap is unavailable; start with preseed.cfg' >&2
  exit 1
}
# shellcheck disable=SC1090
. "$bootstrap_lib"
bootstrap_source_common_lib ""
installer_operation_context_repo scripts/late/devops.sh.tmpl 18 devops

# Module rendering needs the selected target paths in this child shell, before
# devops_main (which is itself defined by one of those modules) can run.
seed_base=$(installer_seed_base "")
installer_ensure_context_loaded "$seed_base"
installer_tools_class_selected || exit 0
host_env=${INSTALLER_LATE_HOST_ENV:-${DIR_INSTALLER_LATE_ENV}/host.env}
[ -r "$host_env" ] || installer_fetch_host_env "$seed_base" "$(installer_resolve_host_profile "")" "$host_env" 0600
installer_load_data_env "$host_env"

bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/validation-base.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/upstream-policy.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/policy-resolution.sh.tmpl)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/publication-layout.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/signing-key.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/publication-services.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/tool-configs.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/bazelisk-node.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/upstream-rust.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/codex-layout.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/codex-appserver.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/codex-release.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/account-execution.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/gitbuild.sh)" || exit "$?"
bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/main-orchestration.sh)" || exit "$?"

bootstrap_source_module "$(installer_repo_file_value scripts/late/devops/codex-provision.sh)" || exit "$?"

devops_main "$@"
