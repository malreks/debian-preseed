#!/bin/sh
# Installer-only Codex provisioning. No login hook performs installation.
set -eu
target_root=${1:-${TARGET_ROOT}}
runtime_dir=${INSTALLER_RUNTIME_DIR:-/tmp/install-runtime}
bootstrap_lib=${INSTALLER_BOOTSTRAP_LIB:-${runtime_dir}/bootstrap/bootstrap.sh}
# shellcheck disable=SC1090
. "$bootstrap_lib"
bootstrap_source_common_lib ""
seed_base=$(installer_seed_base "")
installer_ensure_context_loaded "$seed_base"
installer_assert_class_plan
[ "$(installer_plan_value codex_enable)" = true ] || installer_fatal 'Codex stage is absent from the frozen policy'
tmp_env_dir="${DIR_INSTALLER_LATE_ENV}/codex"
install -d -m 0700 "$tmp_env_dir"
host_env="$tmp_env_dir/host.env"
installer_fetch_host_env "$seed_base" "$INSTALLER_HOST_PROFILE" "$host_env" 0600
installer_load_data_env "$host_env"
bootstrap_source_common_support_libs "$seed_base" "$tmp_env_dir/support" fetch hook target ssh
for codex_module in scripts/late/devops/validation-base.sh scripts/late/devops/policy-resolution.sh.tmpl \
  scripts/late/devops/publication-layout.sh scripts/late/devops/tool-configs.sh \
  scripts/late/devops/codex-layout.sh scripts/late/devops/codex-release.sh \
  scripts/late/devops/codex-appserver.sh scripts/late/devops/codex-provision.sh; do
  bootstrap_source_module "$(installer_repo_file_value "$codex_module")" || exit "$?"
done
ACCOUNT_USERNAME=$(installer_cmdline_value primary_user) || installer_fatal 'Codex requires the explicit primary account'
devops_validate_account_name "$ACCOUNT_USERNAME"
ACCOUNT_HOME="${DIR_HOME}/$ACCOUNT_USERNAME"
account_ids=$(devops_target_passwd_ids "$ACCOUNT_USERNAME")
case "$account_ids" in ''|0:*|*[!0-9:]*) devops_fatal 'Codex requires a non-root target account' ;; esac
case "$INSTALLER_HOST_VARIANT" in
  desktop)
    DEVOPS_SKEL_DIR=$DIR_ETC_SKEL_DESKTOP
    codex_wrapper_selector=hooks/target/data/codex/lib/codex.tmpl
    ;;
  server)
    DEVOPS_SKEL_DIR=$DIR_ETC_SKEL_SERVER
    codex_wrapper_selector=hooks/target/usr/local/bin/server/codex.tmpl
    ;;
  *) devops_fatal 'Codex requires a registered role family' ;;
esac
# These are human-account storage permissions, never runner identities or sudo.
# Existing roots are checked without resetting an unrelated account/store.
# shellcheck disable=SC2016
run_in_target 'prepare the explicit Codex operator and private workspace' "${DIR_USR_BIN}/python3" -I -c '
import grp, os, pwd, stat, sys
account=pwd.getpwnam(sys.argv[1])
if (account.pw_uid<1000 or account.pw_uid in {2101,2102,2103,2104}
        or account.pw_dir!=sys.argv[2]):
    raise SystemExit("invalid Codex human account/home")
root=os.open(account.pw_dir,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
try:
    info=os.fstat(root)
    if info.st_uid!=account.pw_uid or info.st_mode&0o022:
        raise SystemExit("unsafe Codex home directory")
    try: os.mkdir("Workspace",0o700,dir_fd=root)
    except FileExistsError: pass
    workspace=os.open("Workspace",os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC,dir_fd=root)
    try:
        info=os.fstat(workspace)
        if info.st_uid not in (0,account.pw_uid) or info.st_mode&0o022:
            raise SystemExit("unsafe Codex workspace")
        os.fchown(workspace,account.pw_uid,account.pw_gid)
    finally: os.close(workspace)
finally: os.close(root)
' "$ACCOUNT_USERNAME" "$ACCOUNT_HOME"
# The server foundation does not source desktop account setup. Establish the
# shared group explicitly, and never grant its access to a CI service account.
# shellcheck disable=SC2016
run_in_target 'prepare the primary Codex operator storage group' "${DIR_BIN}/sh" -eu -c '
getent group devops >/dev/null || groupadd --system devops
for service_user in ci-github ci-gitlab; do
  if getent passwd "$service_user" >/dev/null; then
    case " $(id -nG "$service_user") " in *" devops "*) exit 1 ;; esac
  fi
done
usermod -a -G devops -- "$1"
' sh "$ACCOUNT_USERNAME"
devops_validate_codex_policy
devops_codex_paths
installer_stage_profile_file hooks/target/etc/ssh/git_known_hosts "${DIR_ETC}/ssh/git_known_hosts" 0644
devops_provision_codex
if [ "$INSTALLER_HOST_VARIANT" = server ]; then
  installer_stage_profile_file hooks/target/etc/skel-server/.profile.d/99-codex-srv.sh "${DEVOPS_SKEL_DIR}/.profile.d/99-codex-srv.sh" 0644
  installer_stage_profile_file hooks/target/etc/apparmor.d/common/abstractions/bwrap-common "${DIR_APPARMOR}/abstractions/bwrap-common" 0644
  installer_stage_profile_file hooks/target/etc/apparmor.d/server/codex-server.tmpl "${DIR_APPARMOR}/codex-server" 0644
  installer_run_target_setup scripts/server/setup.py.tmpl 'publish the primary account Codex login environment' \
    codex-account server "$ACCOUNT_USERNAME"
fi
devops_verify_codex
installer_info 'pinned Codex and codex-home configured; no API login or external enrollment performed'
