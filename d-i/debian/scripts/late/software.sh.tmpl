[ -u "$new_dir/chrome-sandbox" ] && [ -x "$new_dir/chrome-sandbox" ]
[ -x "$new_dir/AppRun" ] && [ -x "$new_dir/ledger-live-desktop" ]

if [ -e "$install_dir" ]; then
