software_prepare_tomat_app() {
# Bootstrap only the profile-pinned Tomat asset. The adapter validates the tag,
# canonical URL, digest and exact Debian package version.
# No latest-release API, source build or unverified fallback is used here.
run_in_target "download and validate pinned Tomat package" \
    __INSTALLER_PATH_DIR_USR_BIN__/perl \
    "-I${DIR_PERL5_SITE_PERL}/apt-repo-local" \
    -MAPTRepoLocal::Servicing::Tomat \
    -MAPTRepoLocal::Servicing::HTTP \
    -MAPTRepoLocal::Servicing::Deb \
    -MAPTRepoLocal::Servicing::Repository \
    -e 'use strict; use warnings;
      @ARGV == 4 or die "expected private workspace, Tomat tag, URL and SHA-256\n";
      my $repository = APTRepoLocal::Servicing::Repository->new();
      my $deb = APTRepoLocal::Servicing::Deb->new(repository => $repository);
      APTRepoLocal::Servicing::Tomat->new(
          http => APTRepoLocal::Servicing::HTTP->new(), deb => $deb,
      )->download_pinned(@ARGV);' -- "$work_dir" \
      "$SOFTWARE_TOMAT_TAG" "$SOFTWARE_TOMAT_URL" "$SOFTWARE_TOMAT_SHA256"
# Neither a packaged system daemon nor a default.target user daemon may compete
# with the session-scoped transient daemon. Persistent admin masks survive dpkg
# upgrades without editing vendor unit files or touching Xwayland.
chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/systemctl --root=/ mask tomat.service ||
  software_fatal "cannot mask the unscoped Tomat system service"
chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/systemctl --global mask tomat.service ||
  software_fatal "cannot mask the unscoped Tomat user service"
software_queue_deb "Tomat" "$tomat_deb" tomat amd64 __INSTALLER_PATH_DIR_USR_BIN__/tomat "" "" "$SOFTWARE_TOMAT_SHA256"
}

