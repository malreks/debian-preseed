software_render_theme_asset() {
  theme_asset=$1
  theme_repo_path=$2
  theme_token_prefix='__''THEME_'
  case "$theme_repo_path" in
    *.png|*.jpg|*.jpeg|*.webp|*.gif|*.ico|*.ttf|*.otf|*.woff|*.woff2|*.gz|*.xz|*.bz2|*.zip|*.deb)
      return 0 ;;
  esac
  if LC_ALL=C grep -Fq "$theme_token_prefix" "$theme_asset"; then
    if ! command -v installer_theme_render_file >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
      TMP_ENV_DIR=$tmp_env_dir
      theme_library="${tmp_env_dir}/themes.sh"
      bootstrap_fetch_seed_file "$seed_base" \
        "$(installer_repo_file_value scripts/late/themes.sh)" \
        "$theme_library" 0600 "software theme renderer" ||
        software_fatal "failed to fetch software theme renderer"
      # shellcheck disable=SC1090,SC1091
      . "$theme_library"
    fi
    installer_load_themes || software_fatal "failed to validate software theme catalog"
    installer_theme_render_file "$theme_asset" "$theme_repo_path" ||
      software_fatal "failed to render software theme asset: $theme_repo_path"
    if LC_ALL=C grep -Fq "$theme_token_prefix" "$theme_asset"; then
      software_fatal "unresolved software theme placeholder: $theme_repo_path"
    else
      theme_probe_status=$?
      [ "$theme_probe_status" -eq 1 ] ||
        software_fatal "failed to inspect rendered software theme asset: $theme_repo_path"
    fi
  else
    theme_probe_status=$?
    [ "$theme_probe_status" -eq 1 ] ||
      software_fatal "failed to inspect software theme asset: $theme_repo_path"
  fi
}

software_stage_seed_asset() {
  repo_path=$1
  target_path=$2
  mode=$3
  if bootstrap_prepared_asset_published "$repo_path" "$target_path" "$mode"; then
    return 0
  fi
  tmp_asset="${tmp_env_dir}/$(basename "$target_path").$$"
  target_host_path="${target_root}${target_path}"

  software_validate_abs_path "target asset path" "$target_path"
  bootstrap_fetch_seed_file "$seed_base" "$repo_path" "$tmp_asset" 0600 "software asset ${repo_path}"
  tmp_paths_rendered="${tmp_asset}.paths"
  installer_apply_scalar_placeholders "$tmp_asset" "$tmp_paths_rendered"
  mv -f "$tmp_paths_rendered" "$tmp_asset"
  installer_assert_no_unresolved_installer_placeholders "$tmp_asset" "software asset ${repo_path}"
  software_render_theme_asset "$tmp_asset" "$repo_path"
  install -d -m 0755 "${target_root}$(dirname "$target_path")"
  install -m "$mode" "$tmp_asset" "$target_host_path"
  chmod "$mode" "$target_host_path"
  rm -f "$tmp_asset"
}

software_render_seed_asset() {
  repo_path=$1
  target_path=$2
  mode=$3
  shift 3
  tmp_asset="${tmp_env_dir}/$(basename "$target_path").$$.src"
  tmp_rendered="${tmp_env_dir}/$(basename "$target_path").$$.rendered"
  target_host_path="${target_root}${target_path}"

  software_validate_abs_path "target rendered asset path" "$target_path"
  [ $(( $# % 2 )) -eq 0 ] ||
    software_fatal "rendered software asset placeholders must be name/value pairs: ${repo_path}"
  bootstrap_fetch_seed_file "$seed_base" "$repo_path" "$tmp_asset" 0600 "software template ${repo_path}"
  software_render_theme_asset "$tmp_asset" "$repo_path"
  installer_apply_scalar_placeholders "$tmp_asset" "$tmp_rendered" "$@" || {
    rm -f "$tmp_asset" "$tmp_rendered"
    software_fatal "failed to render software template: ${repo_path}"
  }
  if ! installer_assert_no_unresolved_installer_placeholders \
      "$tmp_rendered" "rendered software template ${repo_path}"; then
    rm -f "$tmp_asset" "$tmp_rendered"
    return 1
  fi
  install -d -m 0755 "${target_root}$(dirname "$target_path")"
  install -m "$mode" "$tmp_rendered" "$target_host_path"
  chmod "$mode" "$target_host_path"
  rm -f "$tmp_asset" "$tmp_rendered"
}

software_stage_menu_icon() {
  menu_icon_source=$1
  menu_icon_name=$2
  menu_icon_destination="${menu_icon_dir}/${menu_icon_name}.png"
  case "$menu_icon_name" in
    chatgpt|postman|discord|sleek) ;;
    *) software_fatal "unsupported managed menu icon: $menu_icon_name" ;;
  esac
  [ -f "${target_root}${menu_icon_source}" ] &&
    [ ! -L "${target_root}${menu_icon_source}" ] &&
    [ -r "${target_root}${menu_icon_source}" ] &&
    [ "$(chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/file --brief --mime-type "$menu_icon_source")" = image/png ] ||
    software_fatal "managed menu icon is missing or invalid: $menu_icon_source"
  if [ "$menu_icon_source" != "$menu_icon_destination" ]; then
    install -D -m 0644 "${target_root}${menu_icon_source}" "${target_root}${menu_icon_destination}"
  fi
  chown root:root "${target_root}${menu_icon_destination}"
  chmod 0644 "${target_root}${menu_icon_destination}"
}

software_managed_external_cpu_quota() {
  managed_external_online_cpus=$(
    chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/getconf _NPROCESSORS_ONLN
  ) || software_fatal "managed external software CPU count is unavailable"
  case "$managed_external_online_cpus" in
    ''|*[!0-9]*) software_fatal "managed external software CPU count is invalid" ;;
  esac
  [ "$managed_external_online_cpus" -ge 1 ] ||
    software_fatal "managed external software CPU count must be positive"

  managed_external_quota_cpus=$((managed_external_online_cpus / 2))
  [ "$managed_external_quota_cpus" -ge 1 ] || managed_external_quota_cpus=1
  printf '%s00%%\n' "$managed_external_quota_cpus"
}

