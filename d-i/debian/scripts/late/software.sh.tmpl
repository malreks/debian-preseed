esac
' sh "$ACCOUNT_USERNAME"

  run_in_target "preflight shared logging paths before ChatGPT tmpfiles" \
    __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/log-layout --preflight || return $?
