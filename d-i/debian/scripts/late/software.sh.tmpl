  ledger_icon_source=$(
    if [ -e "${target_root}${ledger_install_dir}/.DirIcon" ]; then
      readlink -f "${target_root}${ledger_install_dir}/.DirIcon"
    fi
  )
  if [ -z "$ledger_icon_source" ]; then
