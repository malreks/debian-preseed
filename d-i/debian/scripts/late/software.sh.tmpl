  ledger_version_tmp="${target_root}${ledger_version_file}.tmp.$$"
  printf '%s\n' "$ledger_version" >"$ledger_version_tmp"
  chmod 0644 "$ledger_version_tmp"
  mv -f -- "$ledger_version_tmp" "${target_root}${ledger_version_file}"
fi

# Adopt the verified, already-installed binary distributions without compiling
# or modifying their binaries. APT/dpkg now own their files and future upgrades.
software_binary_packages=$(
  chroot "$target_root" __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/apt-repo-local adopt-vendors
) || software_fatal "verified binary package adoption failed"
set --
for software_binary_package in $software_binary_packages; do
  case "$software_binary_package" in
    __INSTALLER_PATH_DIR_VAR_LIB_SOFTWARE_REPO_POOL__/*.deb) ;;
    *) software_fatal "invalid adopted binary package path" ;;
  esac
  case "$software_binary_package" in
    *[!A-Za-z0-9_./+:%~-]*) software_fatal 'unsafe adopted binary package filename' ;;
  esac
  set -- "$@" "$software_binary_package"
done
if [ "$#" -gt 0 ]; then
  software_refresh_managed_deb_repository
  # These are already-installed vendor distributions. Adopt all of their
  # verified packages in one transaction instead of repeating APT/dpkg setup,
  # dependency resolution and trigger processing for each binary distribution.
  chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/env -i \
