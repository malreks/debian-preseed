software_install_discord_app() {
# The Discord verifier publishes the runtime and then validates this desktop
# entry as part of its postinstall transaction. Stage it before bootstrap so a
# fresh install does not fail solely because the entry is created afterward.
software_stage_seed_asset \
  "$(installer_repo_file_value hooks/target/usr/local/share/desktop/applications/discord.desktop.tmpl)" \
  "$discord_desktop_file" \
  0644
# The shared HTTP transport owns bounded network retries. Repeating the entire
# transaction also repeats validation/publication failures and loses the cause.
run_in_target \
  "install complete managed Discord stable runtime" \
  "$software_update_helper" \
  --bootstrap-discord
for discord_runtime_path in \
  "${discord_install_dir}/Discord" \
  "${discord_install_dir}/chrome-sandbox" \
  "${discord_install_dir}/chrome_crashpad_handler" \
  "${discord_install_dir}/discord.png" \
  "${discord_install_dir}/libffmpeg.so" \
  "${discord_install_dir}/modules/installed.json" \
  "${discord_install_dir}/.release"
do
  chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/test -r "$discord_runtime_path" ||
    software_fatal "managed Discord runtime is incomplete after bootstrap: $discord_runtime_path"
done
unset discord_runtime_path
chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/test -x "${discord_install_dir}/Discord" &&
  chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/test -x "${discord_install_dir}/chrome_crashpad_handler" &&
  chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/test -u "${discord_install_dir}/chrome-sandbox" &&
  chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/test -x "${discord_install_dir}/chrome-sandbox" ||
  software_fatal "managed Discord runtime executables are invalid after bootstrap"
software_stage_menu_icon "${discord_install_dir}/discord.png" discord
chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/update-desktop-database __INSTALLER_PATH_DIR_USR_LOCAL_SHARE_APPLICATIONS__
}
software_run_selected_app "role/desktop/medium role/desktop/full" "Discord" software_install_discord_app software_discord_installed

