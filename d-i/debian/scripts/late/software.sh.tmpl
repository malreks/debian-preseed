software_install_tuta_app() {
software_stage_seed_asset \
  "$(installer_repo_file_value hooks/target/usr/local/share/desktop/software/tuta/tutao-pub.pem)" \
  "$tuta_public_key" \
  0644

tuta_public_key_sha256=$(
  # shellcheck disable=SC2016
  chroot "$target_root" __INSTALLER_PATH_DIR_BIN__/sh -eu -c '
openssl pkey -pubin -in "$1" -outform DER |
  sha256sum |
  awk "{print \$1}"
' sh "$tuta_public_key"
)
[ "$tuta_public_key_sha256" = "$SOFTWARE_TUTA_PUBLIC_KEY_SHA256" ] ||
  software_fatal "staged Tuta public key fingerprint does not match the pinned vendor key"

software_download \
  "Tuta Mail AppImage" \
  "$SOFTWARE_TUTA_APPIMAGE_URL" \
  "$tuta_appimage" \
  artifact \
  skip
software_download \
  "Tuta Mail signature" \
  "$SOFTWARE_TUTA_SIGNATURE_URL" \
  "$tuta_signature" \
  signature \
  skip

chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/openssl dgst \
  -sha512 \
  -verify "$tuta_public_key" \
  -signature "$tuta_signature" \
  "$tuta_appimage" >__INSTALLER_PATH_DIR_DEV__/null ||
  software_fatal "Tuta Mail AppImage signature verification failed"

tuta_file_type=$(chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/file -b "$tuta_appimage" 2>__INSTALLER_PATH_DIR_DEV__/null || true)
case "$tuta_file_type" in
  *"ELF 64-bit"*"x86-64"*) ;;
  *) software_fatal "Tuta Mail AppImage has an unexpected file type: ${tuta_file_type:-unset}" ;;
esac

tuta_sha256=$(chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/sha256sum "$tuta_appimage" | awk '{print $1}')
printf '%s\n' "$tuta_sha256" >"${target_root}${work_dir}/tuta.sha256"

# d-i's target executor mounts __INSTALLER_PATH_DIR_PROC__ for bwrap and the dedicated-uid check.
# shellcheck disable=SC2016
INSTALLER_TARGET_DIR="$target_root" target_exec __INSTALLER_PATH_DIR_BIN__/sh -eu -c '
work_dir=$1
appimage=$2
install_dir=$3
new_dir=__INSTALLER_PATH_DIR_OPT__/.tuta-mail.new
backup_dir=__INSTALLER_PATH_DIR_OPT__/.tuta-mail.previous

rollback() {
  rm -rf "$new_dir"
  if [ -d "$backup_dir" ]; then
    rm -rf "$install_dir"
    mv "$backup_dir" "$install_dir"
  fi
}
trap rollback EXIT HUP INT TERM

rm -rf "$work_dir/squashfs-root" "$new_dir" "$backup_dir"
: >"$work_dir/.extraction-active"
if __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/tuta-extract "$appimage" "$work_dir/squashfs-root"; then
  rm -f "$work_dir/.extraction-active"
else
  extraction_status=$?
  if [ "$extraction_status" -eq 1 ]; then
    rm -f "$work_dir/.extraction-active"
  else
    : >"$work_dir/.extraction-outcome-unknown"
  fi
  exit "$extraction_status"
fi
[ -f "$work_dir/squashfs-root/AppRun" ] && [ -x "$work_dir/squashfs-root/AppRun" ]

cp -a "$work_dir/squashfs-root" "$new_dir"
chown -R root:root "$new_dir"
__INSTALLER_PATH_DIR_USR_BIN__/find "$new_dir" -xdev -type d -exec __INSTALLER_PATH_DIR_BIN__/chmod 0755 {} +
__INSTALLER_PATH_DIR_USR_BIN__/find "$new_dir" -xdev -type f -exec __INSTALLER_PATH_DIR_BIN__/chmod a-s,go-w {} +
[ -f "$new_dir/AppRun" ] && [ -x "$new_dir/AppRun" ]
__INSTALLER_PATH_DIR_BIN__/chmod 0755 "$new_dir/AppRun"

if [ -e "$install_dir" ]; then
  mv "$install_dir" "$backup_dir"
fi
mv "$new_dir" "$install_dir"
[ -x "$install_dir/AppRun" ]
rm -rf "$backup_dir"
trap - EXIT HUP INT TERM
' sh "$work_dir" "$tuta_appimage" "$tuta_install_dir"

tuta_icon_source=$(
  # shellcheck disable=SC2016
  chroot "$target_root" __INSTALLER_PATH_DIR_BIN__/sh -eu -c '
install_dir=$1
if [ -e "$install_dir/.DirIcon" ]; then
  readlink -f "$install_dir/.DirIcon"
  exit 0
fi
find "$install_dir__INSTALLER_PATH_DIR_USR_SHARE_ICONS_HICOLOR__" -type f -name "*.png" -exec wc -c {} \; 2>__INSTALLER_PATH_DIR_DEV__/null |
  sort -n |
  tail -n 1 |
  cut -d " " -f 2-
' sh "$tuta_install_dir" 2>__INSTALLER_PATH_DIR_DEV__/null || true
)
case "$tuta_icon_source" in
  "$tuta_install_dir"/*) ;;
  *) software_fatal "unable to resolve the Tuta Mail icon from the verified AppImage" ;;
esac
[ -r "${target_root}${tuta_icon_source}" ] ||
  software_fatal "resolved Tuta Mail icon is unreadable: $tuta_icon_source"

install -d -m 0755 "${target_root}$(dirname "$tuta_icon_file")"
install -m 0644 "${target_root}${tuta_icon_source}" "${target_root}${tuta_icon_file}"

software_render_seed_asset \
  "$(installer_repo_file_value hooks/target/etc/skel-desktop/.local/share/applications/tutanota-desktop.desktop.tmpl)" \
  "$tuta_desktop_file" \
  0644 \
  LABWC_MANAGED_APP_DEFAULT_EXEC "$LABWC_MANAGED_APP_DEFAULT_EXEC"

chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/update-desktop-database __INSTALLER_PATH_DIR_USR_SHARE_APPLICATIONS__
if [ -x "${target_root}__INSTALLER_PATH_DIR_USR_BIN__/gtk-update-icon-cache" ]; then
  chroot "$target_root" __INSTALLER_PATH_DIR_USR_BIN__/gtk-update-icon-cache -f -q __INSTALLER_PATH_DIR_USR_SHARE_ICONS_HICOLOR__
fi

[ -n "$tuta_sha256" ] || software_fatal "failed to record Tuta Mail AppImage SHA-256"
software_store_managed_artifact \
  "Tuta Mail AppImage" \
  "$tuta_appimage" \
  "$software_tuta_artifact_dir" \
  "tuta-${tuta_sha256}.AppImage"
software_info "installed verified Tuta Mail AppImage sha256=${tuta_sha256}"
}
software_run_selected_app "role/desktop/base role/desktop/medium role/desktop/full" "Tuta Mail" software_install_tuta_app software_tuta_installed
if [ "$software_tuta_installed" = true ]; then
  IFS= read -r tuta_sha256 <"${target_root}${work_dir}/tuta.sha256"
fi

software_restore_managed_apparmor_profiles

install -d -m 0755 \
  "${target_root}${software_state_dir}" \
  "${target_root}${software_event_dir}" \
  "${target_root}${software_deb_archive_dir}" \
  "${target_root}${software_artifact_dir}" \
  "${target_root}${software_vendor_dir}" \
  "${target_root}${software_postman_artifact_dir}" \
  "${target_root}${software_discord_artifact_dir}" \
  "${target_root}${software_tuta_artifact_dir}" \
  "${target_root}${software_ledger_artifact_dir}" \
  "${target_root}${software_metadata_dir}"
chown root:root \
  "${target_root}${software_state_dir}" \
  "${target_root}${software_event_dir}" \
  "${target_root}${software_deb_archive_dir}" \
  "${target_root}${software_artifact_dir}" \
  "${target_root}${software_vendor_dir}" \
  "${target_root}${software_postman_artifact_dir}" \
  "${target_root}${software_discord_artifact_dir}" \
  "${target_root}${software_tuta_artifact_dir}" \
  "${target_root}${software_ledger_artifact_dir}" \
  "${target_root}${software_metadata_dir}"
chmod 0755 \
  "${target_root}${software_state_dir}" \
  "${target_root}${software_event_dir}" \
  "${target_root}${software_deb_archive_dir}" \
  "${target_root}${software_artifact_dir}" \
  "${target_root}${software_vendor_dir}" \
  "${target_root}${software_postman_artifact_dir}" \
  "${target_root}${software_discord_artifact_dir}" \
  "${target_root}${software_tuta_artifact_dir}" \
  "${target_root}${software_ledger_artifact_dir}" \
  "${target_root}${software_metadata_dir}"
if [ "$software_postman_installed" = true ]; then
  postman_state_tmp="${target_root}${postman_state_file}.tmp.$$"
  printf '%s|%s\n' "$postman_version" "$postman_sha256" >"$postman_state_tmp"
  chmod 0644 "$postman_state_tmp"
  mv -f -- "$postman_state_tmp" "${target_root}${postman_state_file}"
fi
if [ "$software_tuta_installed" = true ]; then
  tuta_hash_tmp="${target_root}${tuta_hash_file}.tmp.$$"
  printf '%s\n' "$tuta_sha256" >"$tuta_hash_tmp"
  chmod 0644 "$tuta_hash_tmp"
  mv -f -- "$tuta_hash_tmp" "${target_root}${tuta_hash_file}"
fi
if [ "$software_ledger_installed" = true ]; then
  ledger_hash_tmp="${target_root}${ledger_hash_file}.tmp.$$"
  printf '%s\n' "$ledger_actual_sha512" >"$ledger_hash_tmp"
