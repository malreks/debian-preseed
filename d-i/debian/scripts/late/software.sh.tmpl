    "$chatgpt_tmpfiles" || return $?
  chatgpt_enable_tmp="${target_root}${chatgpt_enable_file}.tmp.$$"
  [ ! -L "${target_root}${chatgpt_enable_file}" ] ||
    software_fatal "ChatGPT enable marker must not be a symlink"
  printf 'role/%s\n' "$INSTALLER_DESKTOP_ROLE" >"$chatgpt_enable_tmp"
  chown root:root "$chatgpt_enable_tmp"
  chmod 0644 "$chatgpt_enable_tmp"
  mv -f -- "$chatgpt_enable_tmp" "${target_root}${chatgpt_enable_file}"

  # HTTP owns transfer retries. Import, APT and policy recovery are mutations;
  # repeating the entire bootstrap cannot safely repair a failed transaction.
  # Keep its stage-specific diagnostic and original status in the installer log.
  run_in_target \
    "bootstrap the managed ChatGPT/Codex desktop package" \
    "$software_update_helper" \
    --bootstrap-chatgpt

  software_stage_menu_icon "$chatgpt_icon" chatgpt
  software_info "installed managed ChatGPT/Codex desktop through the signed local repository"
}

