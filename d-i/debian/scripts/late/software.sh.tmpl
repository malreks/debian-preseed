software_cleanup_work_dir() {
  if [ -e "${target_root}${work_dir}/.deb-batch-active" ] ||
     [ -L "${target_root}${work_dir}/.deb-batch-active" ]; then
    software_warn "package transaction incomplete; retain ${work_dir} for operator recovery; do not retry automatically"
    return 0
  fi
  if [ -e "${target_root}${work_dir}/.extraction-outcome-unknown" ] ||
     [ -e "${target_root}${work_dir}/.extraction-active" ]; then
    software_warn "extraction cleanup outcome unknown; retain ${work_dir} for operator recovery; do not retry automatically"
    return 0
  fi
  rm -rf -- "${target_root}${work_dir}"
}

software_run_selected_app() {
  selected_classes=$1
  selected_label=$2
  selected_worker=$3
  selected_result=$4
  installer_class_selected_any $selected_classes || return 0
  installer_operation_context_repo scripts/late/software.sh.tmpl 1932 "install_managed_application:${selected_worker}"
  software_info "starting ${selected_label}"
  # A required worker runs outside a conditional context so Dash keeps errexit.
  (
    trap - EXIT HUP INT TERM
    set -eu
    "$selected_worker"
  ) &
  selected_pid=$!
  if wait "$selected_pid"; then
    IFS= read -r "$selected_result" <<EOF_SELECTED
true
EOF_SELECTED
    software_info "completed ${selected_label}"
    return 0
  else
    selected_status=$?
  fi
  if [ "$selected_status" -eq 3 ] ||
     [ -e "${target_root}${work_dir}/.deb-batch-active" ] ||
     [ -e "${target_root}${work_dir}/.extraction-outcome-unknown" ] ||
     [ -e "${target_root}${work_dir}/.extraction-active" ]; then
    software_warn "$selected_label outcome unknown; retain ${work_dir}; do not retry automatically"
    exit 3
  fi
  software_fatal_status "$selected_status" "$selected_label required by $selected_classes failed (status=$selected_status); inspect the preceding stage diagnostic"
}

