#!/bin/sh
set -u

PATH=__INSTALLER_PATH_DIR_USR_LOCAL_SBIN__:__INSTALLER_PATH_DIR_USR_LOCAL_BIN__:__INSTALLER_PATH_DIR_USR_SBIN__:__INSTALLER_PATH_DIR_USR_BIN__:__INSTALLER_PATH_DIR_SBIN__:__INSTALLER_PATH_DIR_BIN__
export PATH
umask 077

FIRSTBOOT_LOG_DIR=${FIRSTBOOT_LOG_DIR:-__INSTALLER_PATH_DIR_FIRSTBOOT_LOG__}
FIRSTBOOT_DATA_DIR=${FIRSTBOOT_DATA_DIR:-${FIRSTBOOT_LOG_DIR}__INSTALLER_PATH_DIR_DATA__}
FIRSTBOOT_LOG_FILE=${FIRSTBOOT_LOG_FILE:-${FIRSTBOOT_LOG_DIR}/20-firstboot.log}
FIRSTBOOT_JOURNAL_LINES=${FIRSTBOOT_JOURNAL_LINES:-300}

mkdir -p "$FIRSTBOOT_LOG_DIR" "$FIRSTBOOT_DATA_DIR" 2>__INSTALLER_PATH_DIR_DEV__/null || exit 1
: >>"$FIRSTBOOT_LOG_FILE" 2>__INSTALLER_PATH_DIR_DEV__/null || exit 1

# The published shared library owns logging and bounded capture in every stage.
firstboot_logging="${FIRSTBOOT_SCRIPT_DIR:-__INSTALLER_PATH_DIR_FIRSTBOOT_LIB__}/logging.sh"
[ -f "$firstboot_logging" ] && [ ! -L "$firstboot_logging" ] || {
  printf '%s\n' 'fatal: shared firstboot logging library is unavailable' >&2
  exit 1
}
# shellcheck disable=SC1090
. "$firstboot_logging" || exit 1
unset firstboot_logging

case "$FIRSTBOOT_JOURNAL_LINES" in
  ''|*[!0-9]*) FIRSTBOOT_JOURNAL_LINES=300 ;;
esac
if [ "$FIRSTBOOT_JOURNAL_LINES" -gt 1000 ]; then
  FIRSTBOOT_JOURNAL_LINES=1000
fi

# Import only after switch-root and all real __INSTALLER_PATH_DIR_VAR_LOG__ mounts are active.
# The helper rejects indirect paths, non-root writers, hardlinks and oversize data.
if ! __INSTALLER_PATH_DIR_USR_BIN__/python3 -B __INSTALLER_PATH_DIR_FIRSTBOOT_LIB__/import-initramfs.py; then
  log_line log-collection error initramfs "import_failed=true"
  exit 1
fi
target_initramfs_log_dir=__INSTALLER_LOG_INITRAMFS_DIR__
if [ -d "$target_initramfs_log_dir" ]; then
  capture initramfs-log-files.txt find "$target_initramfs_log_dir" -maxdepth 1 -type f -name '*.log' -print
  log_line log-collection info initramfs "available=${target_initramfs_log_dir}"
else
  log_line log-collection warn initramfs "missing=${target_initramfs_log_dir}"
fi

if command -v systemctl >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture systemctl-failed.txt systemctl --failed --no-pager --plain
  capture systemctl-jobs.txt systemctl list-jobs --no-pager --plain
fi
if command -v journalctl >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture journal-warnings.txt journalctl -p warning..alert -b --no-pager --no-hostname -o short-iso -n "$FIRSTBOOT_JOURNAL_LINES"
fi
if command -v dmesg >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture dmesg-warnings.txt dmesg --level=err,warn
fi
if command -v findmnt >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture findmnt-verify.txt findmnt --verify --verbose
  capture mounts.txt findmnt -R / -o TARGET,SOURCE,FSTYPE,OPTIONS
fi
if command -v lsblk >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture block-devices.txt lsblk -o NAME,TYPE,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINTS
fi
if [ -r __INSTALLER_PATH_DIR_ETC__/fstab ]; then
  cp __INSTALLER_PATH_DIR_ETC__/fstab "${FIRSTBOOT_DATA_DIR}/fstab.txt" 2>__INSTALLER_PATH_DIR_DEV__/null || true
  chmod 0600 "${FIRSTBOOT_DATA_DIR}/fstab.txt" 2>__INSTALLER_PATH_DIR_DEV__/null || true
fi
if command -v systemd-analyze >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture systemd-analyze-time.txt systemd-analyze time
  systemd-analyze blame 2>&1 | sed -n '1,80p' >"${FIRSTBOOT_DATA_DIR}/systemd-analyze-blame.txt" || true
  chmod 0600 "${FIRSTBOOT_DATA_DIR}/systemd-analyze-blame.txt" 2>__INSTALLER_PATH_DIR_DEV__/null || true
fi

log_line log-collection info firstboot "collection_complete=true"
exit 0
