[ "${LABWC_GREETER_WLR_RENDERER:-}" = "gles2" ]
[ "${LABWC_GREETER_GSK_RENDERER:-}" = "opengl" ]
[ "${LABWC_GREETER_GDK_DISABLE:-}" = "vulkan" ]
[ "${LABWC_GREETER_WLR_NO_HARDWARE_CURSORS:-}" = "1" ]
[ ! -e __INSTALLER_PATH_DIR_ETC_ENVIRONMENT_D__/90-labwc-session.conf ]
grep -Eq "(^|[|;&][[:space:]]*)export WLR_RENDERER=" __INSTALLER_PATH_FILE_LABWC_SESSION__
grep -Eq "(^|[|;&][[:space:]]*)export GSK_RENDERER=" __INSTALLER_PATH_FILE_LABWC_SESSION__
