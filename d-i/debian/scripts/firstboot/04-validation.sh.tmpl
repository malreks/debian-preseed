check_desktop_command_required() {
  command_name=$1
  if desktop_role_excludes_path "__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/$command_name"; then
    if command -v "$command_name" >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
      record "FAIL desktop-command-${command_name}: excluded by selected desktop class"
      log_line validation error desktop "excluded_command_present=${command_name}"
      failures=$((failures + 1))
    else
      record "PASS desktop-command-${command_name}: excluded by selected desktop class"
    fi
    return 0
  fi
  if command -v "$command_name" >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
    record "PASS desktop-command-${command_name}"
  else
    record "FAIL desktop-command-${command_name}: missing"
    log_line validation error desktop "missing_command=${command_name}"
    failures=$((failures + 1))
  fi
}

check_desktop_command_optional() {
  command_name=$1
  if command -v "$command_name" >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
    record "PASS desktop-command-${command_name}"
  else
    record "WARN desktop-command-${command_name}: missing"
    log_line validation warn desktop "missing_optional_command=${command_name}"
  fi
}

check_desktop_command_optional_any() {
  primary_command=$1
  shift
  for command_name in "$primary_command" "$@"; do
    if command -v "$command_name" >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
      record "PASS desktop-command-${command_name}"
      return 0
    fi
  done
  record "WARN desktop-command-${primary_command}: missing"
  log_line validation warn desktop "missing_optional_command=${primary_command}"
}

validate_desktop_role() {
  if [ ! -r __INSTALLER_PATH_DIR_ETC_LABWC__/desktop.conf ]; then
    case '__INSTALLER_FIRSTBOOT_HOST_VARIANT__' in
      server)
        log_line validation info desktop 'desktop_role=not-selected'
        return 0 ;;
      *)
        record 'FAIL desktop-defaults: selected desktop policy is unavailable'
        log_line validation error desktop 'desktop_defaults_unavailable=true'
        failures=$((failures + 1))
        return 1 ;;
    esac
  fi

  record "desktop_role=selected"
  log_line validation info desktop "desktop_role=selected"
  desktop_selected_role='__INSTALLER_FIRSTBOOT_ROLE_IDS__'
  desktop_selected_suite='__INSTALLER_FIRSTBOOT_SUITE__'
  desktop_expected_family='__INSTALLER_FIRSTBOOT_HOST_VARIANT__'
  case "$desktop_expected_family:$desktop_selected_role:$desktop_selected_suite" in
    desktop:desktop/base:forky|desktop:desktop/medium:forky|desktop:desktop/full:forky|\
    desktop:desktop/base:trixie|desktop:desktop/medium:trixie|desktop:desktop/full:trixie)
      record "desktop_class=${desktop_selected_role}" ;;
    *)
      record 'FAIL desktop-rendered-policy: invalid installation-time expectations'
      log_line validation error desktop 'rendered_desktop_policy_invalid=true'
      failures=$((failures + 1))
      return 1 ;;
  esac
  desktop_metadata_failures=$failures
  check_command desktop-defaults-metadata \
    __INSTALLER_PATH_DIR_BIN__/sh -eu -c '
      [ -f __INSTALLER_PATH_DIR_ETC_LABWC__/desktop.conf ]
      [ ! -L __INSTALLER_PATH_DIR_ETC_LABWC__/desktop.conf ]
      [ "$(find -P __INSTALLER_PATH_DIR_ETC_LABWC__/desktop.conf -maxdepth 0 -size -1048577c -printf "%U:%G:%m:%n")" = "0:0:644:1" ]
    ' sh
  check_command desktop-skeleton-metadata \
    __INSTALLER_PATH_DIR_BIN__/sh -eu -c '
      skeleton=__INSTALLER_PATH_DIR_ETC_SKEL_DESKTOP__
      [ -d "$skeleton" ]
      [ ! -L "$skeleton" ]
      [ "$(find -P "$skeleton" -maxdepth 0 -printf "%U:%G:%m")" = "0:0:700" ]
    ' sh
  if [ "$failures" -ne "$desktop_metadata_failures" ]; then
    # Keep independent boot/security collection running, but never source or
    # inspect dependent desktop inputs after their trust boundary failed.
    record 'SKIP desktop-config-dependent-checks: unsafe defaults metadata'
    log_line validation error desktop 'desktop_config_checks_skipped=untrusted_metadata'
    return 1
  fi
  desktop_account_user=$(
    __INSTALLER_PATH_DIR_BIN__/sh -eu -c '
      . __INSTALLER_PATH_DIR_ETC_LABWC__/desktop.conf
      printf "%s\n" "${LABWC_QBITTORRENT_USER:-}"
    ' sh 2>__INSTALLER_PATH_DIR_DEV__/null || true
  )
  case "$desktop_account_user" in
    ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-]*)
      desktop_account_home=
      record "FAIL desktop-primary-account: invalid user ${desktop_account_user:-unset}"
      log_line validation error desktop "primary_account_invalid=${desktop_account_user:-unset}"
      failures=$((failures + 1))
      ;;
    *)
      desktop_account_home=$(getent passwd "$desktop_account_user" | cut -d: -f6)
      case "$desktop_account_home" in
        /*) ;;
        *)
          record "FAIL desktop-primary-account: missing home for ${desktop_account_user}"
          log_line validation error desktop "primary_account_home_missing=${desktop_account_user}"
          failures=$((failures + 1))
          desktop_account_home=
          ;;
      esac
      ;;
  esac
  check_command desktop-hyprpolkit-compatibility __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-hyprpolkit-agent --check

  check_command desktop-kanshi-policy __INSTALLER_PATH_DIR_BIN__/sh -eu -c '

