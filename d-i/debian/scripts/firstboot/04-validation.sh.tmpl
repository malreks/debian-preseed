grep -Eq "(^|[|;&][[:space:]]*)export WLR_NO_HARDWARE_CURSORS=" __INSTALLER_PATH_FILE_LABWC_SESSION__
grep -q "WLR_SCENE_DISABLE_DIRECT_SCANOUT=" __INSTALLER_PATH_FILE_LABWC_SESSION__
grep -q "^export QT_OPENGL=" __INSTALLER_PATH_FILE_LABWC_SESSION__
grep -q "^export QSG_RHI_BACKEND=" __INSTALLER_PATH_FILE_LABWC_SESSION__
