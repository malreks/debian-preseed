#!/bin/sh
set -u

PATH=__INSTALLER_PATH_DIR_USR_LOCAL_SBIN__:__INSTALLER_PATH_DIR_USR_LOCAL_BIN__:__INSTALLER_PATH_DIR_USR_SBIN__:__INSTALLER_PATH_DIR_USR_BIN__:__INSTALLER_PATH_DIR_SBIN__:__INSTALLER_PATH_DIR_BIN__
export PATH
umask 077

FIRSTBOOT_LOG_DIR=${FIRSTBOOT_LOG_DIR:-__INSTALLER_PATH_DIR_FIRSTBOOT_LOG__}
FIRSTBOOT_DATA_DIR=${FIRSTBOOT_DATA_DIR:-${FIRSTBOOT_LOG_DIR}__INSTALLER_PATH_DIR_DATA__}
FIRSTBOOT_LOG_FILE=${FIRSTBOOT_LOG_FILE:-${FIRSTBOOT_LOG_DIR}/20-firstboot.log}
VALIDATION_FILE=${FIRSTBOOT_DATA_DIR}/validation-results.txt

mkdir -p "$FIRSTBOOT_LOG_DIR" "$FIRSTBOOT_DATA_DIR" 2>__INSTALLER_PATH_DIR_DEV__/null || exit 1
: >>"$FIRSTBOOT_LOG_FILE" 2>__INSTALLER_PATH_DIR_DEV__/null || exit 1
: >"$VALIDATION_FILE" 2>__INSTALLER_PATH_DIR_DEV__/null || exit 1
chmod 0600 "$VALIDATION_FILE" 2>__INSTALLER_PATH_DIR_DEV__/null || true

# The published shared library owns logging and bounded capture in every stage.
firstboot_logging="${FIRSTBOOT_SCRIPT_DIR:-__INSTALLER_PATH_DIR_FIRSTBOOT_LIB__}/logging.sh"
[ -f "$firstboot_logging" ] && [ ! -L "$firstboot_logging" ] || {
  printf '%s\n' 'fatal: shared firstboot logging library is unavailable' >&2
  exit 1
}
# shellcheck disable=SC1090
. "$firstboot_logging" || exit 1
unset firstboot_logging

record() {
  printf '%s\n' "$*" >>"$VALIDATION_FILE"
}

failures=0

check_path() {
  label=$1
  path=$2
  if [ -e "$path" ]; then
    record "PASS ${label}: ${path}"
  else
    record "FAIL ${label}: missing ${path}"
    log_line validation error "$label" "missing=${path}"
    failures=$((failures + 1))
  fi
}

check_absent_path() {
  label=$1
  path=$2
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    record "PASS ${label}: ${path}"
  else
    record "FAIL ${label}: unexpected ${path}"
    log_line validation error "$label" "unexpected=${path}"
    failures=$((failures + 1))
  fi
}

desktop_read_selected_role() (
  # The installer receipt is restricted non-secret data, never shell input.
  receipt_field=${1:-role}
  case "$receipt_field" in role|suite) ;; *) return 1 ;; esac
  receipt=__INSTALLER_PATH_FILE_INSTALLER_CLASSES__
  [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
  receipt_metadata=$(find -P "$receipt" -maxdepth 0 -printf '%U:%G:%m:%n:%s') || return 1
  case "$receipt_metadata" in 0:0:644:1:*) ;; *) return 1 ;; esac
  receipt_size=${receipt_metadata##*:}
  case "$receipt_size" in ''|*[!0-9]*) return 1 ;; esac
  [ "$receipt_size" -gt 0 ] && [ "$receipt_size" -le 262144 ] || return 1
  awk -F '\t' -v field="$receipt_field" '
    NR>4096 || length($0)>4096 {bad=1; exit 1}
    $1=="format" {if(NF!=2 || $2!="2" || ++formats!=1) bad=1}
    $1=="family" {if(NF!=2 || $2!="desktop" || ++families!=1) bad=1}
    $1=="suite" {if(NF!=2 || $2 !~ /^(forky|trixie)$/ || ++suites!=1) bad=1; suite=$2}
    $1=="role" {if(NF!=2 || ++roles!=1) bad=1; role=$2}
    $1=="class" && $2 ~ /^role\// {if(NF!=2 || ++classes!=1) bad=1; selected=substr($2,6)}
    END {
      if(bad || formats!=1 || families!=1 || suites!=1 || roles!=1 || classes!=1 || selected!=role ||
         role !~ /^desktop\/(base|medium|full)$/) exit 1
      print (field=="suite" ? suite : role)
    }
  ' "$receipt"
)

desktop_role_excludes_path() {
  [ "${desktop_selected_role:-}" = desktop/base ] || return 1
  case "$1" in
    __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/resctl-bench|__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/rd-agent|\
    __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/rd-hashd|__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/scrcpy|\
    __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/scrcpy-server|__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/telbot)
      return 0 ;;
    __INSTALLER_PATH_DIR_USR_LOCAL_SHARE_DOC__/resctl-bench/*|__INSTALLER_PATH_DIR_USR_LOCAL_SHARE_DOC__/scrcpy/*|\
    */labwc-ai-copilots*|*/labwc-ai-llama-server|*/labwc-ai-model-*|\
    */labwc-digital-assets*|*/labwc-adb-*|*/labwc-podman-menu|*/labwc-qbittorrent|\
    */llama-server.service)
      return 0 ;;
  esac
  return 1
}

check_desktop_role_path() {
  if desktop_role_excludes_path "$2"; then
    check_absent_path "$1" "$2"
  else
    check_path "$1" "$2"
  fi
}

check_command() {
  label=$1
  shift
  if "$@" >>"$VALIDATION_FILE" 2>&1; then
    record "PASS ${label}"
  else
    status=$?
    record "FAIL ${label}: status=${status}"
    log_line validation error "$label" "status=${status}"
    failures=$((failures + 1))
  fi
}

validate_stubby_boot_order() {
  stubby_properties=$(timeout --signal=TERM --kill-after=2s 20s \
    systemctl show stubby.service --property=FragmentPath --property=After --property=Before) || return "$?"
  stubby_fragment=$(printf '%s\n' "$stubby_properties" | sed -n 's/^FragmentPath=//p')
  stubby_after=$(printf '%s\n' "$stubby_properties" | sed -n 's/^After=//p')
  stubby_before=$(printf '%s\n' "$stubby_properties" | sed -n 's/^Before=//p')
  if [ "$stubby_fragment" != __INSTALLER_PATH_DIR_SYSTEMD_SYSTEM__/stubby.service ]; then
    printf '%s\n' 'managed Stubby base unit is not loaded' >&2
    return 1
  fi
  for stubby_dependency in network-online.target network.target basic.target sysinit.target; do
    case " $stubby_after " in
      *" $stubby_dependency "*)
        printf 'unexpected Stubby ordering: After=%s\n' "$stubby_dependency" >&2
        return 1
        ;;
    esac
  done
  for stubby_dependency in local-fs.target systemd-sysusers.service apparmor.service; do
    case " $stubby_after " in
      *" $stubby_dependency "*) ;;
      *) printf 'missing Stubby ordering: After=%s\n' "$stubby_dependency" >&2; return 1 ;;
    esac
  done
  for stubby_dependency in sysinit.target systemd-resolved.service shutdown.target; do
    case " $stubby_before " in
      *" $stubby_dependency "*) ;;
      *) printf 'missing Stubby ordering: Before=%s\n' "$stubby_dependency" >&2; return 1 ;;
    esac
  done
}

