#!/bin/sh
set -u

PATH=__INSTALLER_PATH_DIR_USR_LOCAL_SBIN__:__INSTALLER_PATH_DIR_USR_LOCAL_BIN__:__INSTALLER_PATH_DIR_USR_SBIN__:__INSTALLER_PATH_DIR_USR_BIN__:__INSTALLER_PATH_DIR_SBIN__:__INSTALLER_PATH_DIR_BIN__
export PATH
umask 077

FIRSTBOOT_LOG_DIR=${FIRSTBOOT_LOG_DIR:-__INSTALLER_PATH_DIR_FIRSTBOOT_LOG__}
FIRSTBOOT_DATA_DIR=${FIRSTBOOT_DATA_DIR:-${FIRSTBOOT_LOG_DIR}__INSTALLER_PATH_DIR_DATA__}
FIRSTBOOT_LOG_FILE=${FIRSTBOOT_LOG_FILE:-${FIRSTBOOT_LOG_DIR}/20-firstboot.log}
VALIDATION_FILE=${FIRSTBOOT_DATA_DIR}/validation-results.txt

mkdir -p "$FIRSTBOOT_LOG_DIR" "$FIRSTBOOT_DATA_DIR" 2>__INSTALLER_PATH_DIR_DEV__/null || exit 1
: >>"$FIRSTBOOT_LOG_FILE" 2>__INSTALLER_PATH_DIR_DEV__/null || exit 1
: >"$VALIDATION_FILE" 2>__INSTALLER_PATH_DIR_DEV__/null || exit 1
chmod 0600 "$VALIDATION_FILE" 2>__INSTALLER_PATH_DIR_DEV__/null || true

# The published shared library owns logging and bounded capture in every stage.
firstboot_logging="${FIRSTBOOT_SCRIPT_DIR:-__INSTALLER_PATH_DIR_FIRSTBOOT_LIB__}/logging.sh"
[ -f "$firstboot_logging" ] && [ ! -L "$firstboot_logging" ] || {
  printf '%s\n' 'fatal: shared firstboot logging library is unavailable' >&2
  exit 1
}
# shellcheck disable=SC1090
. "$firstboot_logging" || exit 1
unset firstboot_logging

record() {
  printf '%s\n' "$*" >>"$VALIDATION_FILE"
}

failures=0
settled_state=starting
settled_boot_id=$(cat __INSTALLER_PATH_DIR_PROC__/sys/kernel/random/boot_id) || exit 1
case "$settled_boot_id" in ''|*[!0-9a-f-]*) exit 1 ;; esac
[ "${#settled_boot_id}" -eq 36 ] || exit 1
# Installation renders the frozen release identity; boot never loads class data.
settled_release='__INSTALLER_FIRSTBOOT_RELEASE_ID__'
case "$settled_release" in ''|*[!0-9a-f]*) exit 64 ;; esac
[ "${#settled_release}" -eq 64 ] || exit 64

write_settled_receipt() {
  settled_candidate=$(mktemp "${FIRSTBOOT_DATA_DIR}/.settled-boot.XXXXXX") || return 1
  {
    printf 'format=1\nboot_id=%s\nrelease=%s\n' "$settled_boot_id" "$settled_release"
    printf 'state=%s\nfailures=%s\n' "$settled_state" "$failures"
    printf 'timestamp=%s\n' "$(timestamp)"
  } >"$settled_candidate" && chmod 0600 "$settled_candidate" &&
    mv -fT -- "$settled_candidate" "${FIRSTBOOT_DATA_DIR}/settled-boot.env" || {
      rm -f -- "$settled_candidate"
      return 1
    }
}
# Invalidate earlier boot/release evidence before any fallible check. Stages
# 01/02 already captured early boot; Type=exec lets multi-user.target settle
# while this bounded diagnostic process continues.
write_settled_receipt || exit 1
settled_wait_status=0
timeout --signal=TERM --kill-after=2s 120s systemctl is-system-running --wait \
  >"${FIRSTBOOT_DATA_DIR}/settled-system-state.txt" 2>&1 || settled_wait_status=$?
case "$settled_wait_status" in
  0) settled_state=verified ;;
  124|137) settled_state=timeout; failures=$((failures + 1)) ;;
  *) settled_state=failed; failures=$((failures + 1)) ;;
esac
record "settled_system_state=${settled_state} status=${settled_wait_status}"

check_path() {
  label=$1
  path=$2
  if [ -e "$path" ]; then
    record "PASS ${label}: ${path}"
  else
    record "FAIL ${label}: missing ${path}"
    log_line validation error "$label" "missing=${path}"
    failures=$((failures + 1))
  fi
}

check_absent_path() {
  label=$1
  path=$2
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    record "PASS ${label}: ${path}"
  else
    record "FAIL ${label}: unexpected ${path}"
    log_line validation error "$label" "unexpected=${path}"
    failures=$((failures + 1))
  fi
}


desktop_role_excludes_path() {
  [ "${desktop_selected_role:-}" = desktop/base ] || return 1
  case "$1" in
    __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/resctl-bench|__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/rd-agent|\
    __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/rd-hashd|__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/scrcpy|\
    __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/scrcpy-server|__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/telbot)
      return 0 ;;
    __INSTALLER_PATH_DIR_USR_LOCAL_SHARE_DOC__/resctl-bench/*|__INSTALLER_PATH_DIR_USR_LOCAL_SHARE_DOC__/scrcpy/*|\
    */labwc-ai-copilots*|*/labwc-ai-llama-server|*/labwc-ai-model-*|\
    */labwc-digital-assets*|*/labwc-adb-*|*/labwc-podman-menu|*/labwc-qbittorrent|\
    */llama-server.service)
      return 0 ;;
  esac
  return 1
}

check_desktop_role_path() {
  if desktop_role_excludes_path "$2"; then
    check_absent_path "$1" "$2"
  else
    check_path "$1" "$2"
  fi
}

check_command() {
  label=$1
  shift
  if "$@" >>"$VALIDATION_FILE" 2>&1; then
    record "PASS ${label}"
  else
    status=$?
    record "FAIL ${label}: status=${status}"
    log_line validation error "$label" "status=${status}"
    failures=$((failures + 1))
  fi
}

validate_selected_unit_states() {
  # The installer already encoded selection in systemd's enabled unit links.
  # Batch-read that supported interface; do not load class or renderer inputs.
  __INSTALLER_PATH_DIR_USR_BIN__/python3 -I -B - <<'PY'
import os
from pathlib import Path
import re
import selectors
import stat
import subprocess
import sys
import time

MANAGER = '__INSTALLER_PATH_DIR_USR_BIN__/systemctl'
DEADLINE = time.monotonic() + 45
LIMIT = 2 * 1024 * 1024
CAPTURE_BYTES = 0
UNIT = re.compile(r'[A-Za-z0-9_@.\\:-]{1,255}')
STRICT = {'apparmor.service', 'auditd.service', 'journal-sealing.service',
          'nftables.service', 'rsyslog.service',
          'rsyslog-journal-forwarding.service', 'syslog.socket'}
PROPERTIES = ('Id', 'Names', 'Requires', 'LoadState', 'ActiveState', 'SubState', 'Result', 'Type',
              'ExecMainStartTimestampMonotonic', 'ConditionResult', 'AssertResult',
              'ConditionTimestampMonotonic', 'AssertTimestampMonotonic',
              'TriggeredBy', 'WantedBy', 'RequiredBy')


class CleanupUnknown(Exception):
    pass


def capture(arguments):
    global CAPTURE_BYTES
    remaining = DEADLINE - time.monotonic()
    if remaining <= 0:
        raise TimeoutError
    process = subprocess.Popen([MANAGER, '--no-pager', '--no-ask-password', *arguments],
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT,
                               env={'PATH': '__INSTALLER_PATH_DIR_USR_BIN__:__INSTALLER_PATH_DIR_BIN__',
                                    'LC_ALL': 'C', 'SYSTEMD_COLORS': '0'})
    try:
        output = bytearray()
        os.set_blocking(process.stdout.fileno(), False)
        with selectors.DefaultSelector() as reader:
            reader.register(process.stdout, selectors.EVENT_READ)
            while reader.get_map():
                remaining = DEADLINE - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError
                for key, unused in reader.select(min(remaining, 0.2)):
                    block = os.read(key.fd, 65536)
                    if not block:
                        reader.unregister(key.fileobj)
                    else:
                        CAPTURE_BYTES += len(block)
                        if len(output) + len(block) > LIMIT or CAPTURE_BYTES > 8 * LIMIT:
                            raise ValueError('bounded-output-exceeded')
                        output.extend(block)
            remaining = DEADLINE - time.monotonic()
            if remaining <= 0:
                raise TimeoutError
            if process.wait(timeout=remaining):
                raise ValueError('manager-query-failed')
        return output.decode('ascii')
    finally:
        try:
            if process.poll() is None:
                process.kill()
                try:
                    process.wait(timeout=2)
                except subprocess.TimeoutExpired as error:
                    raise CleanupUnknown from error
        finally:
            process.stdout.close()


def template_instances(templates):
    found = set()
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    count = 0
    roots = ('__INSTALLER_PATH_DIR_SYSTEMD_SYSTEM__',
             '__INSTALLER_PATH_DIR_SYSTEMD_SYSTEM_LIB__',
             '__INSTALLER_PATH_DIR_RUN_SYSTEMD__/system')
    for root in roots:
        try:
            for parent in reversed((Path(root), *Path(root).parents)):
                info = parent.lstat()
                if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or
                        info.st_gid != 0 or info.st_mode & 0o022):
                    raise ValueError('unsafe-unit-link-ancestry')
            descriptor = os.open(root, flags)
        except FileNotFoundError:
            continue
        try:
            with os.scandir(descriptor) as entries:
                for entry in entries:
                    count += 1
                    if count > 16384:
                        raise ValueError('unit-link-inventory-limit')
                    if time.monotonic() >= DEADLINE:
                        raise TimeoutError
                    if not entry.name.endswith(('.wants', '.requires')):
                        continue
                    child = os.open(entry.name, flags, dir_fd=descriptor)
                    try:
                        info = os.fstat(child)
                        if info.st_uid != 0 or info.st_gid != 0 or info.st_mode & 0o022:
                            raise ValueError('unsafe-unit-link-directory')
                        with os.scandir(child) as links:
                            for link in links:
                                count += 1
                                if count > 16384:
                                    raise ValueError('unit-link-inventory-limit')
                                if time.monotonic() >= DEADLINE:
                                    raise TimeoutError
                                stem, at, instance = link.name.partition('@')
                                if not at or '.' not in instance:
                                    continue
                                suffix = instance.rsplit('.', 1)[1]
                                if stem + '@.' + suffix not in templates:
                                    continue
                                info = link.stat(follow_symlinks=False)
                                if (not UNIT.fullmatch(link.name) or instance.startswith('.') or
                                        not stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or
                                        info.st_gid != 0 or info.st_nlink != 1):
                                    raise ValueError('unsafe-template-instance-link')
                                found.add(link.name)
                    finally:
                        os.close(child)
        finally:
            os.close(descriptor)
    resolved = {name.split('@', 1)[0] + '@.' + name.rsplit('.', 1)[1] for name in found}
    if resolved != templates:
        raise ValueError('enabled-template-without-instance')
    return found


def enabled_units():
    selected = set()
    for line in capture(['list-unit-files', '--state=enabled,enabled-runtime',
                         '--no-legend', '--plain']).splitlines():
        fields = line.split()
        if (len(fields) not in (2, 3) or not UNIT.fullmatch(fields[0]) or
                fields[1] not in ('enabled', 'enabled-runtime')):
            raise ValueError('malformed-enabled-inventory')
        selected.add(fields[0])
        if len(selected) > 2048:
            raise ValueError('too-many-selected-units')
    if not selected:
        raise ValueError('empty-enabled-inventory')
    templates = {name for name in selected if '@.' in name}
    return (selected - templates) | (template_instances(templates) if templates else set()), templates


def show(units):
    records = {}
    properties = [argument for name in PROPERTIES for argument in ('--property', name)]
    text = capture(['show', *properties, '--', *sorted(units)])
    for block in text.strip().split('\n\n'):
        record = {}
        for line in block.splitlines():
            key, separator, value = line.partition('=')
            if not separator or key not in PROPERTIES or key in record:
                raise ValueError('malformed-unit-properties')
            record[key] = value
        name = record.get('Id', '')
        aliases = record.get('Names', '').split()
        if (not UNIT.fullmatch(name) or name not in aliases or
                any(not UNIT.fullmatch(alias) for alias in aliases) or
                'LoadState' not in record or 'ActiveState' not in record):
            raise ValueError('invalid-unit-identity')
        if name in records and records[name] != record:
            raise ValueError('unit-changed-during-query')
        records[name] = record
    mapped = {}
    used = set()
    for requested in units:
        matches = [record for record in records.values()
                   if requested in record['Names'].split()]
        if len(matches) != 1:
            raise ValueError('incomplete-unit-properties')
        mapped[requested] = matches[0]
        used.add(matches[0]['Id'])
    if used != set(records):
        raise ValueError('unexpected-unit-properties')
    return mapped


def dependencies(record):
    names = set()
    for key in ('Requires', 'TriggeredBy', 'WantedBy', 'RequiredBy'):
        for name in record.get(key, '').split():
            if not UNIT.fullmatch(name):
                raise ValueError('invalid-related-unit')
            names.add(name)
    return names


def classify(name, record, related):
    active = record['ActiveState']
    if record['LoadState'] != 'loaded' or active == 'failed':
        return 'failed', 'load-or-execution-failed'
    if active in ('activating', 'deactivating', 'refreshing', 'maintenance'):
        return 'pending', active
    if (record.get('AssertResult') == 'no' and
            record.get('AssertTimestampMonotonic', '0').isdecimal() and
            int(record.get('AssertTimestampMonotonic', '0')) > 0):
        return 'failed', 'assertion-failed'
    if record.get('Result', 'success') != 'success':
        return 'failed', 'unsuccessful-result'
    if active in ('active', 'reloading'):
        return 'verified', active
    # Cleanup is intentionally gated on this validator's final completion.
    # Its earlier inactivity cannot be a reason to block that completion.
    if name == 'secondboot.service':
        return 'expected', 'completion-gated-cleanup'
    if active != 'inactive':
        return 'failed', 'unknown-active-state'
    if (record.get('ConditionResult') == 'no' and
            record.get('ConditionTimestampMonotonic', '0').isdecimal() and
            int(record.get('ConditionTimestampMonotonic', '0')) > 0):
        return ('failed', 'required-condition-failed') if name in STRICT else (
            'expected', 'condition-not-applicable')
    stamp = record.get('ExecMainStartTimestampMonotonic', '0')
    if (record.get('Type') == 'oneshot' and stamp.isdecimal() and int(stamp) > 0
            and record.get('Result') == 'success'):
        return 'verified', 'oneshot-completed'
    triggers = record.get('TriggeredBy', '').split()
    if triggers and any(related[item]['ActiveState'] == 'active' for item in triggers):
        return 'expected', 'armed-by-active-trigger'
    parents = (record.get('WantedBy', '') + ' ' + record.get('RequiredBy', '')).split()
    if name not in STRICT and parents and all(
            related[item]['LoadState'] == 'loaded' and
            related[item]['ActiveState'] == 'inactive' for item in parents):
        return 'expected', 'armed-for-inactive-target'
    return 'failed', 'selected-unit-did-not-run'


def main():
    selected, templates = enabled_units()
    required = selected | STRICT
    records = show(required)
    # Required static dependencies can lose a boot job without appearing in
    # --failed. Include their complete bounded closure, resolving package aliases
    # through systemd's Names property rather than guessing canonical names.
    for unused in range(32):
        extra = set()
        for record in records.values():
            dependencies(record)
            extra.update(record.get('Requires', '').split())
        extra -= required
        if not extra:
            break
        if len(required) + len(extra) > 4096:
            raise ValueError('too-many-required-units')
        records.update(show(extra))
        required.update(extra)
    else:
        raise ValueError('required-dependency-depth-exceeded')
    extra = set().union(*(dependencies(record) for record in records.values())) - required
    if len(extra) > 8192:
        raise ValueError('too-many-related-units')
    related = {**records, **(show(extra) if extra else {})}
    if enabled_units() != (selected, templates):
        print('selected_units_state=pending reason=inventory-changed')
        return 75
    bad = False
    pending = False
    for name in sorted(templates):
        print('unit=' + name + ' state=expected reason=template-with-installed-instances')
    for name, record in sorted(records.items()):
        state, reason = classify(name, record, related)
        print('unit=' + name + ' state=' + state + ' reason=' + reason)
        bad |= state == 'failed'
        pending |= state == 'pending'
    print('selected_units_count=' + str(len(required)))
    return 1 if bad else 75 if pending else 0


try:
    sys.exit(main())
except CleanupUnknown:
    print('selected_units_state=outcome-unknown reason=manager-child-reap-unproven')
    sys.exit(75)
except (TimeoutError, subprocess.TimeoutExpired):
    print('selected_units_state=timeout reason=operation-deadline')
    sys.exit(124)
except (OSError, UnicodeError, ValueError) as error:
    reason = str(error) if isinstance(error, ValueError) else type(error).__name__
    if re.fullmatch(r'[A-Za-z0-9-]{1,80}', reason) is None:
        reason = 'invalid-manager-output'
    print('selected_units_state=failed reason=' + reason)
    sys.exit(1)
PY
}

validate_stubby_boot_order() {
  stubby_properties=$(timeout --signal=TERM --kill-after=2s 20s \
    systemctl show stubby.service --property=FragmentPath --property=After --property=Before) || return "$?"
  stubby_fragment=$(printf '%s\n' "$stubby_properties" | sed -n 's/^FragmentPath=//p')
  stubby_after=$(printf '%s\n' "$stubby_properties" | sed -n 's/^After=//p')
  stubby_before=$(printf '%s\n' "$stubby_properties" | sed -n 's/^Before=//p')
  if [ "$stubby_fragment" != __INSTALLER_PATH_DIR_SYSTEMD_SYSTEM__/stubby.service ]; then
    printf '%s\n' 'managed Stubby base unit is not loaded' >&2
    return 1
  fi
  for stubby_dependency in network-online.target network.target basic.target sysinit.target; do
    case " $stubby_after " in
      *" $stubby_dependency "*)
        printf 'unexpected Stubby ordering: After=%s\n' "$stubby_dependency" >&2
        return 1
        ;;
    esac
  done
  for stubby_dependency in local-fs.target systemd-sysusers.service apparmor.service; do
    case " $stubby_after " in
      *" $stubby_dependency "*) ;;
      *) printf 'missing Stubby ordering: After=%s\n' "$stubby_dependency" >&2; return 1 ;;
    esac
  done
  for stubby_dependency in sysinit.target systemd-resolved.service shutdown.target; do
    case " $stubby_before " in
      *" $stubby_dependency "*) ;;
      *) printf 'missing Stubby ordering: Before=%s\n' "$stubby_dependency" >&2; return 1 ;;
    esac
  done
}

# The required one-shot has already provisioned the on-disk FSS generation.
# This also checks its state without exposing the off-host verification key.
check_command journal-sealing-status __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/journal-sealing --status

# auditd retains the native security audit trail. Confirm that rsyslog also
# delivered AppArmor records to the dedicated log before firstboot succeeds.
apparmor_log_delivery() {
  audit_file=__INSTALLER_LOG_AUDIT_FILE__
  apparmor_file=__INSTALLER_LOG_APPARMOR_FILE__
  apparmor_sample=
  apparmor_poll_attempts=0
  while :; do
    # Snapshot one real record, newest available first. Native auditd rotation
    # may already have moved boot records into its bounded archive set.
    if [ -z "$apparmor_sample" ]; then
      audit_index=0
      # shellcheck disable=SC2170 # Installer renders this placeholder as a decimal count.
      while [ "$audit_index" -lt __INSTALLER_LOG_AUDIT_FILE_COUNT__ ]; do
        audit_candidate=$audit_file
        [ "$audit_index" -eq 0 ] || audit_candidate=${audit_file}.${audit_index}
        [ ! -L "$audit_candidate" ] || return 1
        if [ -e "$audit_candidate" ]; then
          [ -f "$audit_candidate" ] && [ -r "$audit_candidate" ] || return 1
          # Match the same authoritative header as the rsyslog input. EXECVE
          # arguments can contain denial-looking text and must not become the
          # delivery sample merely because they occur later in the audit file.
          apparmor_sample=$(sed -nE '
            /^(node=[^ ]+ )?type=(AVC|1400|APPARMOR[A-Z_]*) msg=audit\([0-9]+\.[0-9]+:[0-9]+\): / {
              /apparmor=|type=(1400|APPARMOR)/h
            }
            ${g;p;}
          ' "$audit_candidate") || return 1
          [ -z "$apparmor_sample" ] || break
        fi
        audit_index=$((audit_index + 1))
      done
    fi
    if [ -n "$apparmor_sample" ]; then
      apparmor_index=0
      # shellcheck disable=SC2170 # Installer renders this placeholder as a decimal count.
      while [ "$apparmor_index" -le __INSTALLER_LOG_ROTATE_COUNT__ ]; do
        apparmor_candidate=$apparmor_file
        [ "$apparmor_index" -eq 0 ] || apparmor_candidate=${apparmor_file}.${apparmor_index}
        [ ! -L "$apparmor_candidate" ] || return 1
        if [ -e "$apparmor_candidate" ]; then
          [ -f "$apparmor_candidate" ] && [ -r "$apparmor_candidate" ] || return 1
          if grep -Fqx -- "$apparmor_sample" "$apparmor_candidate"; then
            printf '%s\n' 'apparmor_log_delivery=verified matching_native_record=true'
            return 0
          else
            apparmor_grep_status=$?
            [ "$apparmor_grep_status" -eq 1 ] || return "$apparmor_grep_status"
          fi
        fi
        apparmor_index=$((apparmor_index + 1))
      done
    fi
    [ "$apparmor_poll_attempts" -lt 10 ] || break
    sleep 2
    apparmor_poll_attempts=$((apparmor_poll_attempts + 1))
  done
  if [ -z "$apparmor_sample" ]; then
    printf '%s\n' 'apparmor_log_delivery=failed reason=no-native-apparmor-record'
  else
    printf '%s\n' 'apparmor_log_delivery=failed reason=native-record-not-delivered'
  fi
  return 1
}
check_command apparmor-log-delivery apparmor_log_delivery

bool_is_true() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
  esac
  return 1
}

