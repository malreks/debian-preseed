    log_line validation info desktop "graphics_capture_skipped=no_active_wayland_session"
  fi
}

record "timestamp=$(timestamp)"
record "hostname=$(hostname 2>__INSTALLER_PATH_DIR_DEV__/null || printf unknown)"
record "kernel=$(uname -r 2>__INSTALLER_PATH_DIR_DEV__/null || printf unknown)"

check_path installer-log __INSTALLER_PATH_DIR_VAR_LIB_INSTALLER_STATE__/installer.log

check_path initramfs-health-log-dir __INSTALLER_LOG_INITRAMFS_DIR__
for initramfs_health_log in \
  01-init-top.log \
  02-init-premount.log \
  03-local-top.log \
  04-local-block.log \
  05-local-premount.log \
  06-local-bottom.log \
  07-init-bottom.log
do
  check_path "initramfs-health-${initramfs_health_log%.log}" \
    "__INSTALLER_LOG_INITRAMFS_DIR__/${initramfs_health_log}"
done

if command -v findmnt >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  check_command findmnt-verify findmnt --verify
  check_command root-mounted findmnt /
  if [ -d __INSTALLER_PATH_DIR_SYS__/firmware/efi ]; then
    check_command efi-vfat-mounted findmnt -n -t vfat __INSTALLER_PATH_DIR_BOOT_EFI__
  fi
fi

if command -v coredumpctl >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture coredump-summary.txt coredumpctl list --no-pager
fi

if command -v systemctl >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  system_state=$(systemctl is-system-running 2>__INSTALLER_PATH_DIR_DEV__/null || true)
  record "system_state=${system_state:-unknown}"
  case "$system_state" in
    degraded|failed|maintenance|emergency)
      log_line validation error systemd "system_state=${system_state}"
      failures=$((failures + 1))
      ;;
  esac
  failed_units=$(systemctl --failed --no-legend --plain 2>__INSTALLER_PATH_DIR_DEV__/null | sed -n '1,20p' || true)
  if [ -n "$failed_units" ]; then
    record "FAIL failed-units-present"
    printf '%s\n' "$failed_units" >>"$VALIDATION_FILE"
    log_line validation error systemd "failed_units_present=true"
    failures=$((failures + 1))
  else
    record "PASS failed-units-absent"
  fi
  if [ -f __INSTALLER_PATH_DIR_SYSTEMD_SYSTEM_STUBBY_DROPIN__/60-app-veth.conf ]; then
    # A job deleted to break an ordering cycle need not appear in --failed.
    check_command managed-stubby-boot-order validate_stubby_boot_order
    check_command managed-stubby-active timeout --signal=TERM --kill-after=2s 20s \
      systemctl is-active --quiet stubby.service
  fi
fi

if [ -x __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/dbus-broker-check ]; then
  check_command dbus-broker-system timeout --kill-after=2s 60s __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/dbus-broker-check --system --wait
fi
validate_desktop_role

if command -v mokutil >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture secureboot-state.txt mokutil --sb-state
  capture mok-enrollment.txt mokutil --list-enrolled
  log_line enrollment info secureboot "mokutil_collected=true"
else
  log_line enrollment warn secureboot "mokutil=missing"
fi

if command -v systemctl >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture security-baseline-units.txt systemctl status apparmor.service apparmor-modes.service auditd.service nftables.service ssh.service ssh.socket sshd.service --no-pager --lines=40
  log_line security-baseline info systemd "security_unit_status_collected=true"
fi

if [ -x __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/apparmor-modes-run ]; then
  # firstboot.service is ordered after the reconciliation unit, so source and
  # loaded modes must already agree rather than being deferred as a boot race.
  check_command apparmor-modes-loaded __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/apparmor-modes-run --check-loaded
fi
if command -v aa-status >__INSTALLER_PATH_DIR_DEV__/null 2>&1; then
  capture apparmor-status.json aa-status --pretty-json
fi

if [ -r __INSTALLER_PATH_DIR_BOOT__/grub/grub.cfg ]; then
  record "PASS grub-cfg-readable"
else
  record "FAIL grub-cfg-readable: __INSTALLER_PATH_DIR_BOOT__/grub/grub.cfg"
  log_line validation error bootloader "missing=__INSTALLER_PATH_DIR_BOOT__/grub/grub.cfg"
  failures=$((failures + 1))
fi

# These checks are explicit: firstboot must collect diagnostics after a logging
# startup failure, but must never publish successful completion without it.
# Check at the end so an earlier native record cannot hide a stopped collector.
check_command rsyslog-service __INSTALLER_PATH_DIR_USR_BIN__/timeout --kill-after=2s 10s __INSTALLER_PATH_DIR_USR_BIN__/systemctl is-active --quiet rsyslog.service
check_command rsyslog-journal-forwarding-service __INSTALLER_PATH_DIR_USR_BIN__/timeout --kill-after=2s 10s __INSTALLER_PATH_DIR_USR_BIN__/systemctl is-active --quiet rsyslog-journal-forwarding.service
check_command journal-forwarding-policy __INSTALLER_PATH_DIR_USR_BIN__/timeout --kill-after=2s 20s __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/journal-check --require-forwarding
check_command syslog-socket __INSTALLER_PATH_DIR_USR_BIN__/timeout --kill-after=2s 10s __INSTALLER_PATH_DIR_USR_BIN__/systemctl is-active --quiet syslog.socket
capture logging-units.txt __INSTALLER_PATH_DIR_USR_BIN__/systemctl status rsyslog.service rsyslog-journal-forwarding.service syslog.socket --no-pager --lines=40

if [ "$failures" -eq 0 ]; then
  record "validation_status=pass"
  log_line validation info validation "validation_status=pass"
  exit 0
fi

record "validation_status=fail failures=${failures}"
log_line validation error validation "validation_status=fail failures=${failures}"
exit 1
