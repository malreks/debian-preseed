    log_line validation info desktop "desktop_role=not-selected"
    return 0
  fi

  record "desktop_role=selected"
  log_line validation info desktop "desktop_role=selected"
  if desktop_selected_role=$(desktop_read_selected_role) &&
     desktop_selected_suite=$(desktop_read_selected_role suite); then
    record "desktop_class=${desktop_selected_role}"
  else
    record 'FAIL desktop-class-receipt: missing, unsafe or inconsistent selected class'
    log_line validation error desktop 'selected_class_receipt_invalid=true'
    failures=$((failures + 1))
    return 1
