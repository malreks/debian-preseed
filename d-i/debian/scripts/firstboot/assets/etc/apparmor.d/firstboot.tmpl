profile firstboot __INSTALLER_PATH_FILE_FIRSTBOOT_HELPER__ flags=(attach_disconnected) {
  #include <abstractions/wrapper-base>

  unix,
  dbus,
  network create inet dgram,
  network (create, bind, getattr, getopt, setopt, send, receive) netlink raw,
  capability audit_write,
  capability chown,
  capability dac_read_search,
  capability fowner,
  capability net_admin,
  capability setgid,
  capability setuid,
  capability sys_admin,
  capability syslog,
  capability sys_ptrace,
  # systemctl and networkctl inspect PID 1 and unconfined service metadata.
  ptrace (read) peer=unconfined,
  ptrace (read) peer=firstboot,
  ptrace (read) peer=labwc-compositor,
  ptrace (read) peer=labwc-greeter-session,
  ptrace (read) peer=zram-writeback,
  ptrace (read) peer=usr.sbin.tailscaled,

  # Read service-account process metadata during firstboot validation. The
  # reciprocal rule is on crowdsec-firstboot; no trace/attach is granted.
  ptrace (read) peer=crowdsec-firstboot,

  __INSTALLER_PATH_FILE_FIRSTBOOT_HELPER__ rix,
  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/dbus-broker-check rix,
  # Read-only package check; never execute an authentication dialog as root.
  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-hyprpolkit-agent rix,
  __INSTALLER_PATH_DIR_USR_LIBEXEC__/ r,
  __INSTALLER_PATH_DIR_USR_LIBEXEC__/hyprpolkitagent r,
  # --status is read-only: journal-sealing.service owns generation.
  # Keep the verification seed readable only at its exact path; no key writes.
  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/journal-sealing rix,
  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/journal-check rix,
  # firstboot invokes the read-only --check path; do not grant __INSTALLER_PATH_DIR_DEV__ writes.
  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/nvidia-char-links rix,
  __INSTALLER_PATH_DIR_USR_BIN__/python3{,.[0-9]*} rix,
  __INSTALLER_PATH_DIR_USR_BIN__/printf rix,
  # awk resolves through Debian alternatives to mawk/gawk/nawk. Receipt and
  # package metadata readers must retain this confined firstboot domain.
  __INSTALLER_PATH_DIR_USR_BIN__/{awk,mawk,gawk,nawk} rix,
  # O_DIRECTORY/O_NOFOLLOW probes need both directory-read and search on this
  # exact read-only leaf. Keep the permissions separate so kernels that report
  # the directory open as a plain read request match the rule explicitly.
  __INSTALLER_PATH_DIR_DEV__/char/ rx,
  __INSTALLER_PATH_DIR_DEV__/char/[0-9]*:[0-9]* r,
  __INSTALLER_PATH_DIR_DEV__/nvidia{[0-9]*,ctl,-modeset,-uvm,-uvm-tools} r,
  __INSTALLER_PATH_DIR_DEV__/nvidia-caps/ r,
  __INSTALLER_PATH_DIR_DEV__/nvidia-caps/ x,
  __INSTALLER_PATH_DIR_DEV__/nvidia-caps/** r,
  __INSTALLER_PATH_DIR_USR_BIN__/{busctl,id,find} rix,
  # dpkg --compare-versions validates the installed swaylock/PAM chain.
  # The package database remains read-only in this profile.
  __INSTALLER_PATH_DIR_USR_BIN__/dpkg rix,
  __INSTALLER_PATH_DIR_USR_BIN__/{dpkg-query,passwd,perl,readlink} rix,
  __INSTALLER_PATH_DIR_USR_SBIN__/runuser rix,
  __INSTALLER_PATH_DIR_USR_BIN__/{flock,grep,mkdir,mktemp,sleep,timeout,desktop-file-validate} rix,
  signal (send, receive) set=(hup, int, term, kill, cont) peer=firstboot,
  __INSTALLER_PATH_DIR_FIRSTBOOT_LIB__/ r,
  __INSTALLER_PATH_DIR_FIRSTBOOT_LIB__/logging.sh r,
  __INSTALLER_PATH_DIR_FIRSTBOOT_LIB__/import-initramfs.py r,
  __INSTALLER_PATH_DIR_FIRSTBOOT_LIB__/service-account-processes.py r,
  __INSTALLER_PATH_DIR_FIRSTBOOT_LIB__/{01-early,02-collect,03-network,04-validation,05-cleanup}.sh rix,
  __INSTALLER_PATH_DIR_USR_BIN__/{cat,chmod,chown,cp,cut,date,dmesg,find,findmnt,getent,hostname,hostnamectl,journalctl,lsblk,mokutil,mv,networkctl,resolvectl,rm,sed,ss,systemctl,systemd-analyze,uname} rix,
  __INSTALLER_PATH_DIR_USR__/{bin,sbin}/ip rix,
  __INSTALLER_PATH_DIR_USR_BIN__/{eglinfo,es2_info,wlr-randr} rix,
  __INSTALLER_PATH_DIR_USR_BIN__/coredumpctl rix,
  __INSTALLER_PATH_DIR_USR_SBIN__/aa-status rPx -> aa-status-reader,
  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/apparmor-modes-run rPx -> apparmor-modes,

  / r,
  __INSTALLER_PATH_DIR_BOOT__/ r,
  __INSTALLER_PATH_DIR_BOOT__/** r,
  __INSTALLER_PATH_DIR_DEV__/ r,
  __INSTALLER_PATH_DIR_DEV__/{kmsg,tty,urandom} r,
  __INSTALLER_PATH_DIR_DEV__/null rw,
  __INSTALLER_PATH_DIR_ETC__/ r,
  __INSTALLER_PATH_DIR_ETC__/** r,
  __INSTALLER_PATH_DIR_ETC_LABWC__/desktop.conf r,
  __INSTALLER_PATH_DIR_HOME__/*/.config/qt6ct/qt6ct.conf r,
  # Root firstboot enumerates the user-owned unit directory; owner would not match.
  @{HOME}/.config/systemd/user/ r,
  __INSTALLER_PATH_DIR_RUN__/ r,
  __INSTALLER_PATH_DIR_RUN__/** r,
  __INSTALLER_PATH_DIR_USR_LOCAL__/ r,
  __INSTALLER_PATH_DIR_USR_LOCAL__/** r,
  __INSTALLER_PATH_DIR_USR_BIN__/pwd r,
  __INSTALLER_PATH_DIR_USR_LIB__/ r,
  __INSTALLER_PATH_DIR_USR_LIB__/** mr,
  __INSTALLER_PATH_DIR_USR_SHARE__/ r,
  __INSTALLER_PATH_DIR_USR_SHARE__/** r,
  # The initramfs importer opens every ancestor with O_DIRECTORY/O_NOFOLLOW.
  __INSTALLER_PATH_DIR_VAR__/ rx,
  __INSTALLER_PATH_DIR_VAR_LIB__/ rx,
  __INSTALLER_PATH_DIR_VAR_LIB__/dpkg/ rx,
  __INSTALLER_PATH_DIR_VAR_LIB__/dpkg/** r,
  __INSTALLER_PATH_DIR_VAR_LIB__/journal-sealing/ r,
  __INSTALLER_PATH_DIR_VAR_LIB__/journal-sealing/lock rk,
  __INSTALLER_PATH_DIR_VAR_LIB__/journal-sealing/status.json r,
  __INSTALLER_PATH_DIR_VAR_LIB__/journal-sealing/verification-key r,
  __INSTALLER_PATH_DIR_FIRSTBOOT__/ rx,
  # Firstboot owns this diagnostic subtree and retains rejected query output
  # there for the next repair attempt.
  __INSTALLER_PATH_DIR_FIRSTBOOT_DATA__/ rwx,
  __INSTALLER_PATH_DIR_FIRSTBOOT_DATA__/**/ rwx,
  __INSTALLER_PATH_DIR_FIRSTBOOT_DATA__/** rwkl,
  # The validator opens the receipt through this fixed directory. Grant
  # directory-read and search separately while the receipt remains exact.
  __INSTALLER_PATH_DIR_TAILSCALE_STATE__/ r,
  __INSTALLER_PATH_DIR_TAILSCALE_STATE__/ x,
  __INSTALLER_PATH_FILE_TAILSCALE_STATUS__ r,
  __INSTALLER_PATH_DIR_FIRSTBOOT_STATE__/ rw,
  __INSTALLER_PATH_DIR_FIRSTBOOT_STATE__/** rwkl,
  # Installer selection/state is not boot policy. Only this logger's subtree
  # is writable; sibling installer receipts and policy inputs stay unwritable.
  __INSTALLER_PATH_DIR_VAR_LIB_INSTALLER_STATE__/ r,
  __INSTALLER_PATH_DIR_VAR_LIB_INSTALLER_STATE__/installer.log r,
  __INSTALLER_PATH_DIR_VAR_LIB_INSTALLER_STATE__/*.tsv r,
  __INSTALLER_PATH_DIR_STATE_LOG__/ r,
  __INSTALLER_PATH_DIR_FIRSTBOOT_LOG__/ rw,
  __INSTALLER_PATH_DIR_FIRSTBOOT_LOG__/** rwkl,
  __INSTALLER_PATH_DIR_VAR_LOG__/ r,
  __INSTALLER_PATH_DIR_VAR_LOG__/** r,
  __INSTALLER_LOG_INITRAMFS_DIR__/ rw,
  __INSTALLER_LOG_INITRAMFS_DIR__/** rwk,
  @{PROC}/ r,
  @{PROC}/** r,
  @{sys}/ r,
  @{sys}/** r,

  include if exists <local/usr.local.libexec.firstboot.sh>
}

