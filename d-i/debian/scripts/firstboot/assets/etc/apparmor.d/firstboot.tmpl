  __INSTALLER_PATH_DIR_USR_BIN__/{chmod,date,dirname,getent,grep,hostname,install,mkdir,mktemp,mv,rm,sha256sum,sleep,ss,find,systemctl,timeout} rix,
  __INSTALLER_PATH_DIR_USR__/{bin,sbin,local/bin,local/sbin}/cscli rix,
  __INSTALLER_PATH_DIR_USR_BIN__/crowdsec rix,
  __INSTALLER_PATH_DIR_USR_BIN__/cmp rix,

  __INSTALLER_PATH_DIR_ETC_CROWDSEC__/ rw,
  __INSTALLER_PATH_DIR_ETC_CROWDSEC__/** rwkl,
  __INSTALLER_PATH_DIR_ETC__/machine-id r,
  # Root-owned state ancestry checked before the bootstrap writes state.
  __INSTALLER_PATH_DIR_VAR__/ r,
  __INSTALLER_PATH_DIR_VAR_LIB__/ r,
  __INSTALLER_PATH_DIR_ETC__/resolv.conf r,
  __INSTALLER_PATH_DIR_ETC__/ssl/ r,
  __INSTALLER_PATH_DIR_ETC__/ssl/** r,
  __INSTALLER_PATH_DIR_SYSTEMD_SYSTEM__/ rw,
  __INSTALLER_PATH_DIR_SYSTEMD_SYSTEM__/** rwkl,
  __INSTALLER_PATH_DIR_RUN__/crowdsec/ rw,
  __INSTALLER_PATH_DIR_RUN__/crowdsec/** rwkl,
  __INSTALLER_PATH_DIR_RUN_DBUS__/system_bus_socket rw,
  __INSTALLER_PATH_DIR_RUN_SYSTEMD__/private rw,
  @{PROC}/[0-9]*/mountinfo r,
  @{PROC}/[0-9]*/stat r,
  __INSTALLER_PATH_DIR_SYS__/kernel/mm/hugepages/ r,
  __INSTALLER_PATH_DIR_CROWDSEC_STATE__/ rw,
  __INSTALLER_PATH_DIR_CROWDSEC_STATE__/** rwkl,
  __INSTALLER_PATH_DIR_VAR_LIB_CROWDSEC__/ rw,
  __INSTALLER_PATH_DIR_VAR_LIB_CROWDSEC__/** rwkl,
  __INSTALLER_PATH_DIR_SYSTEMD__/ r,
  __INSTALLER_PATH_DIR_SYSTEMD__/** rwkl,
  __INSTALLER_LOG_CROWDSEC_DIR__/ rw,
  __INSTALLER_LOG_CROWDSEC_DIR__/** rwkl,
  owner __INSTALLER_PATH_DIR_TMP__/crowdsec-*.log rw,
  owner __INSTALLER_PATH_DIR_TMP__/crowdsec-enroll.*.log rw,
  # Coraza checks its temporary directory with CreateTemp("checkfsfile")
