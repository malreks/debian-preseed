    ${TARGET_ROOT}${DIR_ETC}/rsyslog.d \
    ${TARGET_ROOT}${DIR_ETC}/logrotate.d \
    ${TARGET_ROOT}${DIR_SYSTEMD_SYSTEM_LOGROTATE_TIMER_DROPIN} \
    ${TARGET_ROOT}${DIR_SYSTEMD_SYSTEM_RSYSLOG_DROPIN} \
    ${TARGET_ROOT}${DIR_USR_LOCAL_LIBEXEC}

