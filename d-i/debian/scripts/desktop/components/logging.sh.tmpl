    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_LOGROTATE_D_SECURITY_NOTIFY)" \
    __INSTALLER_PATH_DIR_ETC__/logrotate.d/security-notify \
    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_LOGROTATE_D_SECURITY_SCANNERS_TMPL)" \
    __INSTALLER_PATH_DIR_ETC__/logrotate.d/security-scanners \
    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_LOGROTATE_D_FUZZEL_TMPL)" \
