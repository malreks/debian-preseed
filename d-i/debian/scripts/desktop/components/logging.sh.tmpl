#!/bin/sh
# Sourced installer module; edit this file directly.

desktop_stage_logging_policy() {
  : "${ACCOUNT_USERNAME:?ACCOUNT_USERNAME must be set}"

  # shellcheck disable=SC2016
  run_in_target "configure Labwc security notification access" __INSTALLER_PATH_DIR_BIN__/sh -c '
set -eu
account_user=$1
signal_reader_group=logreader
scanner_writer_group=securitylogger

for command_name in getent groupadd usermod; do
  command -v "$command_name" >__INSTALLER_PATH_DIR_DEV__/null 2>&1 || {
    printf "fatal: required notification access command is missing: %s\n" "$command_name" >&2
    exit 1
  }
done

getent passwd "$account_user" >__INSTALLER_PATH_DIR_DEV__/null
getent group "$signal_reader_group" >__INSTALLER_PATH_DIR_DEV__/null 2>&1 ||
  groupadd --system "$signal_reader_group"
getent group "$scanner_writer_group" >__INSTALLER_PATH_DIR_DEV__/null 2>&1 || {
  printf "fatal: managed scanner logging group is unavailable: %s\n" "$scanner_writer_group" >&2
  exit 1
}
usermod -a -G "$signal_reader_group,$scanner_writer_group" "$account_user"
' sh "$ACCOUNT_USERNAME"

