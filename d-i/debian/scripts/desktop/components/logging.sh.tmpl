    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_LOGROTATE_D_DESKTOP_APPS)" \
    __INSTALLER_PATH_DIR_ETC__/logrotate.d/desktop-apps \
    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_TMPFILES_D_60_SECURITY_LOGS_TMPL)" \
    __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/60-security-logs.conf \
    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_TMPFILES_D_65_AUDIT_SYSLOG)" \
    __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/65-audit-syslog.conf \
    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_LIBEXEC_RSYSLOG_SECURITY_SOCKET_TMPL)" \
    __INSTALLER_PATH_DIR_USR_LOCAL__/libexec/rsyslog-security-socket \
    0755
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_UNIT_RSYSLOG_SERVICE_D_30_SECURITY_SCANNER_SOCKET)" \
    __INSTALLER_PATH_DIR_SYSTEMD_SYSTEM_RSYSLOG_DROPIN__/30-security-scanner-socket.conf \
    0644
  desktop_stage_role_asset \
    FILE_TARGET_BIN_LABWC_FUZZEL_LOG_TMPL \
    __INSTALLER_PATH_DIR_USR_LOCAL__/bin/labwc-fuzzel-log \
    0755

  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_RSYSLOG_D_44_COMPONENTS_TMPL)" \
    __INSTALLER_PATH_DIR_ETC__/rsyslog.d/44-components.conf \
    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_TMPFILES_D_59_LOG_LAYOUT_TMPL)" \
    __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/59-log-layout.conf \
    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_UNIT_RSYSLOG_SERVICE_D_20_LOG_LAYOUT_TMPL)" \
    __INSTALLER_PATH_DIR_SYSTEMD_SYSTEM_RSYSLOG_DROPIN__/20-log-layout.conf \
    0644
  stage_target_asset \
    "$(installer_repo_file_value FILE_TARGET_LIBEXEC_LOG_LAYOUT_TMPL)" \
    __INSTALLER_PATH_DIR_USR_LOCAL__/libexec/log-layout \
    0755

  if installer_plan_package_selected clamav-freshclam || installer_plan_package_selected clamav-daemon; then
    stage_target_asset "$(installer_repo_file_value FILE_TARGET_TMPFILES_D_58_CLAMAV_LOGS_TMPL)" \
      __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/58-clamav-logs.conf 0644
    run_in_target 'create selected ClamAV writer log paths' \
      __INSTALLER_PATH_DIR_USR_BIN__/systemd-tmpfiles --create \
      __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/58-clamav-logs.conf
  fi
  if installer_plan_package_selected clamav-daemon; then
    stage_target_asset \
      "$(installer_repo_file_value FILE_TARGET_AA_LOCAL_USR_SBIN_CLAMD_TMPL)" \
      __INSTALLER_PATH_DIR_ETC__/apparmor.d/local/usr.sbin.clamd 0644
  fi
  run_in_target "preflight protected logging destinations before tmpfiles" \
    __INSTALLER_PATH_DIR_USR_LOCAL__/libexec/log-layout --preflight

  run_in_target "validate effective managed journald policy" \
    __INSTALLER_PATH_DIR_USR_LOCAL__/libexec/journal-check
  run_in_target "create protected managed logging destinations" \
    __INSTALLER_PATH_DIR_USR_BIN__/systemd-tmpfiles --create \
    __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/58-native-logs.conf \
    __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/59-log-layout.conf \
    __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/60-security-logs.conf \
    __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/65-audit-syslog.conf
  run_in_target "validate managed log layout" \
    __INSTALLER_PATH_DIR_USR_LOCAL__/libexec/log-layout

  run_in_target \
    "validate managed rsyslog configuration" \
    __INSTALLER_PATH_DIR_USR_SBIN__/rsyslogd \
    -N1 \
    -f \
    __INSTALLER_PATH_DIR_ETC__/rsyslog.conf

  desktop_log "staged_logging_policy journal_input=imuxsock apps=__INSTALLER_LOG_APPLICATIONS_FILE__ system=__INSTALLER_LOG_SYSTEM_SERVICES_FILE__ kernel=__INSTALLER_LOG_KERNEL_FILE__ auth=__INSTALLER_LOG_AUTH_FILE__ apparmor=__INSTALLER_LOG_APPARMOR_FILE__ rotation=writer-size threshold_bytes=__INSTALLER_LOG_RSYSLOG_ROTATE_BYTES__ archives=__INSTALLER_LOG_ROTATE_COUNT__ scanner_socket=__INSTALLER_LOG_SCANNER_SOCKET__ log_group=__INSTALLER_LOG_GROUP__"
