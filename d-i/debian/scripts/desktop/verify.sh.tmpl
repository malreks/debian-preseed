    config.read_string(captured["config"])
    if (captured["HEAD"] != "ref: refs/heads/" + branch + "\n"
            or config.get("remote \"origin\"", "url") != expected_url
            or config.get("branch \"" + branch + "\"", "remote") != "origin"
            or config.get("branch \"" + branch + "\"", "merge") != "refs/heads/" + branch):
