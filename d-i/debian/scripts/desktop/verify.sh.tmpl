    Path("__INSTALLER_PATH_DIR_OPT__/calix/calix"),
    Path("__INSTALLER_PATH_DIR_OPT__/waycal/waycal"),
    Path("__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/com.github.dahenson.agenda"),
    Path("__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/calix-fruux-bootstrap"),
    Path("__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-waycal-control"),
    Path("__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-calendar-worker"),
    Path("__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/labwc-build"),
    Path("__INSTALLER_PATH_DIR_SYSTEMD_USER__/build.slice"),
    Path("__INSTALLER_PATH_DIR_USR_LIBEXEC__/hyprpolkitagent"),
    Path("__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-hyprpolkit-agent"),
