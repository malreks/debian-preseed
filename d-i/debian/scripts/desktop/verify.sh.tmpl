    Path("__INSTALLER_PATH_DIR_SYSTEMD_USER_HYPRPOLKITAGENT_DROPIN__/60-resource-class.conf"),
    Path("__INSTALLER_PATH_DIR_SYSTEMD_USER_HYPRPOLKITAGENT_DROPIN__/70-no-core.conf"),
