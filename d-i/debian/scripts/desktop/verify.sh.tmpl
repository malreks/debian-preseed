            or info.st_gid != gid or stat.S_IMODE(info.st_mode) != mode):
        raise SystemExit("desktop build storage has unsafe metadata: " + str(path))

# AppDir AppRun and native package entrypoints may be contained symlinks.
# Validate each link and its ancestry before following it; bound the chain,
# reject cycles and escapes, then require a root-owned executable regular file.
for path, boundary in (
    (Path("__INSTALLER_PATH_DIR_OPT_TUTA_MAIL__/AppRun"), Path("__INSTALLER_PATH_DIR_OPT_TUTA_MAIL__")),
    (Path("__INSTALLER_PATH_DIR_OPT_OBSIDIAN__/obsidian"), Path("__INSTALLER_PATH_DIR_OPT_OBSIDIAN__")),
    (Path("__INSTALLER_PATH_DIR_OPT_SLEEK__/sleek"), Path("__INSTALLER_PATH_DIR_OPT_SLEEK__")),
    (Path("__INSTALLER_PATH_DIR_OPT_LEDGER_LIVE__/AppRun"), Path("__INSTALLER_PATH_DIR_OPT_LEDGER_LIVE__")),
    (Path("__INSTALLER_PATH_DIR_USR_BIN__/tomat"), Path("__INSTALLER_PATH_DIR_USR__")),
    (Path("__INSTALLER_PATH_DIR_USR_BIN__/spotify"), Path("__INSTALLER_PATH_DIR_USR__")),
    (Path("__INSTALLER_PATH_DIR_USR_BIN__/l3afpad"), Path("__INSTALLER_PATH_DIR_USR__")),
):
    seen = set()
    for _ in range(17):
        if path in seen or not path.is_relative_to(boundary):
            raise SystemExit("desktop entrypoint has a cyclic or escaping link")
        seen.add(path)
        trusted_parents(path)
        info = path.lstat()
        if info.st_uid != 0 or info.st_nlink != 1:
            raise SystemExit("desktop entrypoint has untrusted ownership or identity")
        if stat.S_ISLNK(info.st_mode):
            link = os.readlink(path)
            if not link or len(link) > 4096 or os.path.isabs(link):
                raise SystemExit("desktop entrypoint link must be bounded and relative")
            path = Path(os.path.normpath(str(path.parent / link)))
            continue
        if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o022 or not info.st_mode & 0o111:
            raise SystemExit("desktop entrypoint is not a trusted executable")
