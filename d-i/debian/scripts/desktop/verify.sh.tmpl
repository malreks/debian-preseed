    (Path("__INSTALLER_PATH_DIR_POOL_BUILD__"), 0, pool_group, 0o2770),
    (build_root, account.pw_uid, pool_group, 0o2770),
    (build_root / "tmp", account.pw_uid, account.pw_gid, 0o700),
