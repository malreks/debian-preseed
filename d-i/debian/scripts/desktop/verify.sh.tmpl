    trusted_parents(path)
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or info.st_nlink != 1:
        raise SystemExit("required desktop class asset has unsafe metadata: " + str(path))

account = pwd.getpwnam(sys.argv[2])
if account.pw_uid == 0:
    raise SystemExit("desktop build storage cannot belong to root")
for offset in (3, 6):
    relative, expected_url, branch = sys.argv[offset:offset+3]
    checkout = Path(account.pw_dir) / relative
    if (Path(relative).is_absolute() or len(Path(relative).parts) != 2
            or any(part in (".", "..") for part in Path(relative).parts)
            or os.path.realpath(checkout) != str(checkout)):
        raise SystemExit("desktop repository path is indirect or outside its account")
    for directory in (checkout, checkout / ".git"):
        info = directory.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != account.pw_uid
                or stat.S_IMODE(info.st_mode) != 0o700):
            raise SystemExit("desktop repository metadata is not private to its account")
    captured = {}
    for leaf in ("HEAD", "config"):
        descriptor = os.open(checkout / ".git" / leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            info = os.fstat(descriptor)
            if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != account.pw_uid
                    or info.st_mode & 0o077 or info.st_size > 65536):
                raise SystemExit("desktop repository record is unsafe or oversized")
            value = os.read(descriptor, 65537)
            if len(value) > 65536:
                raise SystemExit("desktop repository record exceeds its limit")
            captured[leaf] = value.decode("utf-8")
        finally:
            os.close(descriptor)
