# shellcheck shell=sh
# shellcheck disable=SC2016,SC2034
# Private initrd /preseed.env supplies the primary account and root password.
# Credential-valued boot arguments are forbidden. Root and account credentials
# are read only from the protected initrd /preseed.env channel.
# Missing credentials fail before disk discovery; no distributed password fallback.
# Public LAN key: initrd first, authenticated payload second; absence is nonfatal.
# PRESEED_GIT_SSH_PASSPHRASE stays private and is never saved in account metadata.

# Root account policy.
ROOT_LOGIN=true

# Account policy.
ACCOUNT_DEFAULT_GROUPS="audio cdrom video sudo"

# Private calendar credentials.
FRUUX_CALENDAR_USERNAME="${FRUUX_CALENDAR_USERNAME:-}"
FRUUX_CALENDAR_PASSWORD="${FRUUX_CALENDAR_PASSWORD:-}"

# SSH server configuration.
SSHD_CONFIG_SOURCE="ssh/sshd_config"

# SSH server policy.
SSH_USER_CONFIG_SOURCE="ssh/config"
SSH_PUBLIC_KEY_MAX_BYTES="4096"
SSH_CONFIG_MAX_BYTES="65536"

# Git SSH bootstrap inputs.
GIT_SSH_PRIVATE_KEY_INITRD="/git_ed25519"
GIT_SSH_PUBLIC_KEY_INITRD="/git_ed25519.pub"
