# Proxy policy.
# Browser veth sessions may reach HTTPS portals plus the managed Technitium
# HTTP console on the trusted LAN gateway. The veth firewall and CONNECT proxy
# consume this same allowlist; all other destination ports remain denied.
PROXY3_PORTS_ALLOW_WEB_BROWSER="443,5380,8443,53443"
PROXY3_PORTS_ALLOW_QBITTORRENT="443"
PROXY3_PORT_LISTEN_WEB_BROWSER="3128"
PROXY3_PORT_LISTEN_QBITTORRENT="3128"
PROXY3_MAXCONN_WEB_BROWSER="512"
PROXY3_MAXCONN_QBITTORRENT="64"
PROXY3_TIMEOUTS_WEB_BROWSER="1 5 30 60 180 1800 15 60 15 5"
PROXY3_TIMEOUTS_QBITTORRENT="1 5 15 30 15 1800 5 30 10 5"

# Managed networking.
MANAGED_NETWORK_ETHERNET_IFACE="eth0"
MANAGED_NETWORK_WIFI_IFACE="wifi0"

# Tailscale policy.
TAILSCALE_INTERFACE="tailscale0"
TAILSCALE_UDP_PORT="41641"
TAILSCALE_ACCEPT_DNS="false"
TAILSCALE_ACCEPT_ROUTES="false"
# Tailscale remains enrollment-gated. Keep SSH off, leave packet filtering to
# the rendered nftables policy, and enable the daemon's defensive modes.
TAILSCALE_RUN_SSH_SERVER="false"
TAILSCALE_NETFILTER_MODE="nodivert"
TAILSCALE_OPERATOR_USER=""
TAILSCALE_ACCEPT_RISK=""
TAILSCALE_ADVERTISE_TAGS=""
TAILSCALE_ADVERTISE_ROUTES=""
TAILSCALE_ADVERTISE_EXIT_NODE="false"
TAILSCALE_EXIT_NODE=""
TAILSCALE_EXIT_NODE_ALLOW_LAN_ACCESS="false"
TAILSCALE_SHIELDS_UP="true"
TAILSCALE_REPORT_POSTURE="false"
TAILSCALE_SNAT_SUBNET_ROUTES="true"
TAILSCALE_STATEFUL_FILTERING="true"
TAILSCALE_AUTH_KEY_REQUIRED="true"
TAILSCALE_FORCE_REAUTH="false"
TAILSCALE_TIMEOUT="2m"

# Syncthing policy.
SYNCTHING_TCP_PORT="35000"

