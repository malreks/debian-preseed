# Desktop greeter defaults.
LABWC_GREETER_VT="1"
LABWC_GREETER_USER_CANDIDATES="_greetd greeter greetd"
LABWC_GREETER_COMMAND="/usr/local/bin/labwc-greeter-session"

# Labwc session and toolkit defaults.
LABWC_WLR_RENDERER="gles2"
# Compositor selectors belong here; NVIDIA application selectors stay private.
LABWC_COMPOSITOR_GPU="auto"
# Disable explicit dma-buf modifiers for the compositor.  The Intel display
# device is intentionally kept as the compositor owner on hybrid systems, but
# legacy NVIDIA render clients can advertise modifiers that the Intel EGL
# importer cannot match.  The modifier-free path is the stable interop mode
# for Pascal/SM 6.1 and remains safe when no NVIDIA device is installed.
LABWC_WLR_EGL_NO_MODIFIERS="1"
LABWC_WLR_DRM_NO_MODIFIERS="1"
LABWC_GSK_RENDERER="opengl"
LABWC_GDK_DISABLE="vulkan"
LABWC_WLR_NO_HARDWARE_CURSORS="1"
LABWC_WLR_SCENE_DISABLE_DIRECT_SCANOUT="1"
LABWC_WLR_DRM_NO_ATOMIC="0"

# Desktop greeter defaults.
LABWC_GREETER_WLR_RENDERER="gles2"
