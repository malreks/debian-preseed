# shellcheck shell=sh

# Desktop defaults and verified release policy; selected host values override these.
# Empty custom TLS SAN uses resolver-specific names; no remote trust is weakened.

# System identity and resolver policy.
SYSTEM_DOMAIN="lan.icramer.com"
SYSTEM_PREFIX="LPL"
SYSTEM_NAMESERVERS_TLS_SAN_CUSTOM=""

# Journal storage and retention defaults; concrete profiles may override these keys.
SYSTEMD_JOURNAL_VOLATILE_ENABLE="false"
SYSTEMD_JOURNAL_SYSTEM_MAX_USE="1G"
SYSTEMD_JOURNAL_SYSTEM_KEEP_FREE="256M"
SYSTEMD_JOURNAL_SYSTEM_MAX_FILE_SIZE="128M"
