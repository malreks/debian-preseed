# shellcheck shell=sh
# Server defaults and verified release policy; selected host values override these.
# Enrollment remains private; installed pending services are not registered online.
# Empty custom TLS SAN uses resolver-specific names; no remote trust is weakened.

# System identity and resolver policy.
SYSTEM_DOMAIN="lan.icramer.com"
SYSTEM_PREFIX="LPL"
SYSTEM_NAMESERVERS_TLS_SAN_CUSTOM=""

# SSH server policy.
SSH_SERVER_PORT="32020"
SSH_SERVER_CIDR_ALLOW="192.168.50.0/24"
SSH_SERVER_CIDR_ALLOW6="::1/128"

# NFS sharing.
NFS_SERVER_EXPORT_CIDR="192.168.50.0/24"

# Filen sharing.
FILEN_CLI_MINIMUM_BYTES="1048576"
FILEN_CLI_PRIV_REMOTE_PATH="/Desktop"
FILEN_CLI_OFFSEC_REMOTE_PATH="/Desktop"
FILEN_CLI_VERSION="0.0.36"
FILEN_CLI_ARCHITECTURE="amd64"
FILEN_CLI_URL="https://github.com/FilenCloudDienste/filen-cli/releases/download/v${FILEN_CLI_VERSION}/filen-cli-v${FILEN_CLI_VERSION}-linux-x64"
FILEN_CLI_SHA256="be690d94d3310187dc7b4fe46b3e49becfb327c29ac64d49cfe73252c7c3c04a"
FILEN_CLI_MAXIMUM_BYTES="411041792"

# CI runner policy.
CI_RUNNER_GITHUB_SUBUID="200000:65536"
CI_RUNNER_GITLAB_SUBUID="266536:65536"

# Rootless Podman identities, storage and workload budgets.
# Persistent container data and image-transfer scratch stay below /pool/podman;
# runner build/cache trees remain separate under their provider work roots.
PODMAN_ROOTLESS_STATE_BASE="${DIR_POOL_PODMAN}"
PODMAN_GITHUB_STORAGE_DRIVER="overlay"
PODMAN_GITHUB_GRAPHROOT="${DIR_POOL_PODMAN}/github-actions/containers"
PODMAN_GITHUB_RUNROOT="${DIR_RUN}/user/2101/containers"
PODMAN_GITHUB_IMAGE_COPY_TMP_DIR="${DIR_POOL_PODMAN}/github-actions/tmp"
PODMAN_GITLAB_STORAGE_DRIVER="overlay"
PODMAN_GITLAB_GRAPHROOT="${DIR_POOL_PODMAN}/gitlab-cicd/containers"
PODMAN_GITLAB_RUNROOT="${DIR_RUN}/user/2102/containers"
PODMAN_GITLAB_IMAGE_COPY_TMP_DIR="${DIR_POOL_PODMAN}/gitlab-cicd/tmp"
PODMAN_DEVOPS_STORAGE_DRIVER="overlay"
PODMAN_DEVOPS_GRAPHROOT_ROOT="${DIR_POOL_PODMAN}/devops"
PODMAN_DEVOPS_GRAPHROOT_SUBDIR="containers"
PODMAN_DEVOPS_RUNROOT_BASE="${DIR_RUN}/user"
PODMAN_DEVOPS_IMAGE_COPY_TMP_ROOT="${DIR_POOL_PODMAN}/devops"
PODMAN_DEVOPS_IMAGE_COPY_TMP_SUBDIR="tmp"
PODMAN_SERVICE_CPU_WEIGHT="1000"
PODMAN_SERVICE_IO_WEIGHT="1000"
PODMAN_SERVICE_TASKS_MAX="65536"
PODMAN_SERVICE_MEMORY_HIGH="90%"
PODMAN_SERVICE_MEMORY_MAX="98%"
PODMAN_GITHUB_USER="ci-github"
PODMAN_GITHUB_GROUP="ci-github"
PODMAN_GITHUB_RUNTIME_DIR="${DIR_RUN}/user/2101"
PODMAN_GITHUB_SOCKET="${PODMAN_GITHUB_RUNTIME_DIR}/podman/podman.sock"
PODMAN_GITLAB_USER="ci-gitlab"
PODMAN_GITLAB_GROUP="ci-gitlab"
PODMAN_GITLAB_RUNTIME_DIR="${DIR_RUN}/user/2102"
PODMAN_GITLAB_SOCKET="${PODMAN_GITLAB_RUNTIME_DIR}/podman/podman.sock"
PODMAN_DEVOPS_USER="srv-devops"
PODMAN_DEVOPS_GROUP="srv-devops"
CI_RUNNER_CPU_WEIGHT="1000"
CI_RUNNER_IO_WEIGHT="1000"
CI_RUNNER_TASKS_MAX="65536"
CI_RUNNER_MEMORY_HIGH="90%"
CI_RUNNER_MEMORY_MAX="98%"

