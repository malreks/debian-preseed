# shellcheck shell=sh
# Shared non-secret policy. Family and concrete host values take precedence.
# Loaded as restricted data after the host, so derived defaults use host overrides.

# CUDA repository policy for the explicitly selected cuda-legacy path.
CUDA_LEGACY_REPOSITORY_URL="https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/"
CUDA_LEGACY_REPOSITORY_KEY="https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/3bf863cc.pub"
CUDA_LEGACY_TOOLKIT_VERSIONS="12.8 12.9"
CUDA_LEGACY_TOOLKIT_DEFAULT_VERSION="12.9"

# Shared artifact servicing ceilings. The foundation publishes these Perl
# modules for both families; desktop-only defaults leave server assets unset.
SOFTWARE_APT_REPO_LOCAL_DEB_MAXIMUM_BYTES="34359738368"
SOFTWARE_APT_REPO_LOCAL_ARCHIVE_MAXIMUM_BYTES="68719476736"
SOFTWARE_APT_REPO_LOCAL_EXTRACTED_MAXIMUM_BYTES="137438953472"
SOFTWARE_APT_REPO_LOCAL_CONTROL_MAXIMUM_BYTES="134217728"
SOFTWARE_APT_REPO_LOCAL_HEADERS_MAXIMUM_BYTES="1048576"
SOFTWARE_APT_REPO_LOCAL_METADATA_MAXIMUM_BYTES="33554432"

# Shared headless AI runtime locations. Per-host profiles own release, model,
# resource, and enablement policy; these paths are common to desktop/server.
WHISPER_ROOT="/data/whisper"
WHISPER_BINARY_DIR="/data/whisper/bin"
WHISPER_METADATA_DIR="/data/whisper/metadata"
WHISPER_MODEL_DIR="${DIR_POOL_CACHE}/whisper/models"
LLAMA_ROOT="/data/llama"
LLAMA_BINARY_DIR="/data/llama/bin"
LLAMA_METADATA_DIR="/data/llama/metadata"
LLAMA_SHARE_DIR="/data/llama/share"
LLAMA_WRAPPER_PATH="/data/llama/lib"
LLAMA_MODEL_DIR="${DIR_POOL_CACHE}/llama/models"

# Network sharing defaults used by both families when explicitly enabled.
NETWORK_SHARING_ROOT_PATH="${DIR_DATA}/sharing"
NETWORK_SHARING_HOME_BIND_PATH="Sharing"

# Antivirus refresh policy.
FANGFRISCH_URLHAUS_ENABLE="false"
FANGFRISCH_URLHAUS_FEED_BASE="https://urlhaus-api.abuse.ch/v2/files/exports"
FANGFRISCH_SANESECURITY_PREFIX="https://mirror.seichter.de/sanesecurity/"

# Profile-independent sched_ext artifact policy.
HARDWARE_CPU_SCHEDULER_SCX_ARTIFACT_HOSTS="github.com release-assets.githubusercontent.com objects.githubusercontent.com"
HARDWARE_CPU_SCHEDULER_SCX_PACKAGE_URL="https://github.com/mjcramerz/scx/releases/download/scx-v1.1.4/scx_1.1.4-1_amd64.deb"
HARDWARE_CPU_SCHEDULER_SCX_LOADER_PACKAGE_URL="https://github.com/mjcramerz/scx-loader/releases/download/scx-loader-v1.1.3/scx-loader_1.1.3-1_amd64.deb"
HARDWARE_CPU_SCHEDULER_SCX_PACKAGE_SHA256="b853753f9accd22bb5b7ec4a42b5a422cf3f74290903f65d3c0338a0268d4ade"
HARDWARE_CPU_SCHEDULER_SCX_LOADER_PACKAGE_SHA256="c6717ddb8963b33f85f647fe86fcb36351e719ad2f35a1d71ead01d5b3adfacc"


# NFS transport and shared storage.
NFS_SERVER_PORT="2049"
NFS_SERVER_PATH="${NETWORK_SHARING_ROOT_PATH}/nfs-server"
NFS_CLIENT_PATH="${NETWORK_SHARING_ROOT_PATH}/nfs-client"
NFS_CLIENT_EXPORT_PATH="/"
NFS_CLIENT_MOUNT_TIMEOUT="30"
NFS_INTERFACES="${MANAGED_NETWORK_ETHERNET_IFACE} ${MANAGED_NETWORK_WIFI_IFACE}"
NFS_TCP_RMEM="4096 131072 16777216"
NFS_TCP_WMEM="4096 16384 16777216"
NFS_SOCKET_RMEM_MAX="16777216"
NFS_SOCKET_WMEM_MAX="16777216"


# Firmware tools.
SNANDER_VERSION="1.7.9.3"
SNANDER_COMMIT="89e1fc29d01acee83f67fae95eb14a2b860fcee0"
