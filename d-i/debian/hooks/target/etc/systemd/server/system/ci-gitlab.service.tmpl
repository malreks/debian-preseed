[Unit]
Description=GitLab Runner (unprivileged Docker executor over its own rootless Podman)
Wants=network-online.target user@2102.service
After=network-online.target user@2102.service
RequiresMountsFor=__INSTALLER_PATH_DIR_SERVER_GITLAB_WORK__ __INSTALLER_PODMAN_GITLAB_GRAPHROOT__ __INSTALLER_PODMAN_GITLAB_IMAGE_COPY_TMP_DIR__
ConditionPathExists=__INSTALLER_PATH_DIR_SERVER_GITLAB__/enrolled

[Service]
Slice=ci-workloads.slice
User=__INSTALLER_PODMAN_GITLAB_USER__
Group=__INSTALLER_PODMAN_GITLAB_GROUP__
WorkingDirectory=__INSTALLER_PATH_DIR_SERVER_GITLAB__
ExecStart=__INSTALLER_PATH_DIR_SERVER_GITLAB__/release/gitlab-runner run --config __INSTALLER_PATH_FILE_SERVER_GITLAB_CONFIG__ --working-directory __INSTALLER_PATH_DIR_SERVER_GITLAB_WORK__/build
Environment=HOME=__INSTALLER_PATH_DIR_SERVER_GITLAB__
Environment=XDG_RUNTIME_DIR=__INSTALLER_PODMAN_GITLAB_RUNTIME_DIR__
Environment=TMPDIR=__INSTALLER_PATH_DIR_SERVER_GITLAB_WORK__/tmp
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=90
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__INSTALLER_PATH_DIR_SERVER_GITLAB__ __INSTALLER_PATH_DIR_SERVER_GITLAB_WORK__ __INSTALLER_PODMAN_GITLAB_GRAPHROOT__ __INSTALLER_PODMAN_GITLAB_IMAGE_COPY_TMP_DIR__ __INSTALLER_PODMAN_GITLAB_RUNTIME_DIR__
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CPUWeight=__INSTALLER_CI_RUNNER_CPU_WEIGHT__
IOWeight=__INSTALLER_CI_RUNNER_IO_WEIGHT__
TasksMax=__INSTALLER_CI_RUNNER_TASKS_MAX__
MemoryHigh=__INSTALLER_CI_RUNNER_MEMORY_HIGH__
MemoryMax=__INSTALLER_CI_RUNNER_MEMORY_MAX__

[Install]
WantedBy=multi-user.target
