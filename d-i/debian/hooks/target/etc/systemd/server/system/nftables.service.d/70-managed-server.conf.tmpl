# Server-family owner: one atomic transaction replaces only managed_server.
# Stop retains its filtering; it never flushes administrator or CrowdSec tables.
[Service]
ExecStart=
ExecStart=__INSTALLER_PATH_DIR_USR_SBIN__/nft -f __INSTALLER_PATH_DIR_ETC__/nftables.d/70-managed-server.nft
ExecReload=
ExecReload=__INSTALLER_PATH_DIR_USR_SBIN__/nft -f __INSTALLER_PATH_DIR_ETC__/nftables.d/70-managed-server.nft
ExecStop=
ExecStop=__INSTALLER_PATH_DIR_USR_BIN__/true
TimeoutStartSec=45s
TimeoutStopSec=10s
KillMode=control-group
