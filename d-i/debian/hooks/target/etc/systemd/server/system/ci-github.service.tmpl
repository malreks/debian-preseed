[Unit]
Description=GitHub Actions runner (trusted project jobs, private rootless engine)
Wants=network-online.target user@2101.service
After=network-online.target user@2101.service
RequiresMountsFor=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__ __INSTALLER_PODMAN_GITHUB_GRAPHROOT__ __INSTALLER_PODMAN_GITHUB_IMAGE_COPY_TMP_DIR__
ConditionPathExists=__INSTALLER_PATH_DIR_SERVER_GITHUB__/enrolled

[Service]
Slice=ci-workloads.slice
User=__INSTALLER_PODMAN_GITHUB_USER__
Group=__INSTALLER_PODMAN_GITHUB_GROUP__
WorkingDirectory=__INSTALLER_PATH_DIR_SERVER_GITHUB__/runner
ExecStart=__INSTALLER_PATH_DIR_SERVER_GITHUB__/runner/bin/Runner.Listener run --startuptype service
Environment=HOME=__INSTALLER_PATH_DIR_SERVER_GITHUB__
Environment=XDG_RUNTIME_DIR=__INSTALLER_PODMAN_GITHUB_RUNTIME_DIR__
Environment=DOCKER_HOST=unix://__INSTALLER_PODMAN_GITHUB_SOCKET__
Environment=CONTAINER_HOST=unix://__INSTALLER_PODMAN_GITHUB_SOCKET__
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED=__INSTALLER_PATH_FILE_SERVER_GITHUB_JOB_START__
Environment=TMPDIR=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/tmp
Environment=CARGO_HOME=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/cache/cargo
Environment=CARGO_TARGET_DIR=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/build/cargo
Environment=RUSTUP_HOME=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/cache/rustup
Environment=GOPATH=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/build/go
Environment=GOCACHE=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/cache/go-build
Environment=GOMODCACHE=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/cache/go-mod
Environment=GOTMPDIR=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/tmp
Environment=PIP_CACHE_DIR=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/cache/pip
Environment=UV_CACHE_DIR=__INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__/cache/uv
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=90
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__INSTALLER_PATH_DIR_SERVER_GITHUB__ __INSTALLER_PATH_DIR_SERVER_GITHUB_WORK__ __INSTALLER_PODMAN_GITHUB_GRAPHROOT__ __INSTALLER_PODMAN_GITHUB_IMAGE_COPY_TMP_DIR__ __INSTALLER_PODMAN_GITHUB_RUNTIME_DIR__
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CPUWeight=__INSTALLER_CI_RUNNER_CPU_WEIGHT__
IOWeight=__INSTALLER_CI_RUNNER_IO_WEIGHT__
TasksMax=__INSTALLER_CI_RUNNER_TASKS_MAX__
MemoryHigh=__INSTALLER_CI_RUNNER_MEMORY_HIGH__
MemoryMax=__INSTALLER_CI_RUNNER_MEMORY_MAX__

[Install]
WantedBy=multi-user.target
