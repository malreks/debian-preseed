[Unit]
Requisite=labwc-session.target
Description=Unprivileged intel high hardware tuning lease
PartOf=intel-high.target labwc-session.target
After=labwc-session.target
StartLimitIntervalSec=120s
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=370s
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/labwc-hardware-tuning lease intel high
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5s
TimeoutStopSec=3s
KillMode=control-group
Slice=background.slice
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
