[Unit]
Description=Reconcile system Labwc desktop overrides
After=local-fs.target
ConditionPathExists=__INSTALLER_PATH_DIR_ETC__/labwc/desktop.conf
# Real input events can arrive rapidly during unpack. There is no output watch.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-wrap-desktop-files
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
StateDirectory=labwc-desktop-files
StateDirectoryMode=0700
# The initial installer invocation creates the output directory. AppArmor
# restricts the writable lock directory to our one never-unlinked lock file.
ReadWritePaths=__INSTALLER_PATH_DIR_USR_LOCAL_SHARE__/applications __INSTALLER_PATH_DIR_VAR_LIB__/labwc-desktop-files __INSTALLER_PATH_DIR_RUN__/lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
Environment=PATH=__INSTALLER_PATH_DIR_USR__/sbin:__INSTALLER_PATH_DIR_USR__/bin:/sbin:/bin HOME=/nonexistent LC_ALL=C

[Install]
# Existing state also gets one content-gated check on boot, not just changes.
WantedBy=multi-user.target
