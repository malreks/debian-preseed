[Unit]
Description=Renew key-manager ACME certificates
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=__INSTALLER_DIR_DATA_PKI__/tls/acme/config/renewal

[Service]
Type=oneshot
ExecCondition=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-online-check
ExecStart=__INSTALLER_PATH_DIR_USR__/bin/certbot --config __INSTALLER_PATH_DIR_ETC__/key-manager/certbot.ini renew --non-interactive --config-dir __INSTALLER_DIR_DATA_PKI__/tls/acme/config --work-dir __INSTALLER_DIR_DATA_PKI__/tls/acme/work --logs-dir __INSTALLER_DIR_DATA_PKI__/tls/acme/logs
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# HTTP-01 also needs the root-owned __INSTALLER_PATH_DIR_VAR__/www or /srv webroot recorded by Certbot.
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=__INSTALLER_DIR_DATA_PKI__/tls/acme
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
LimitCORE=0
KillMode=control-group
TimeoutStartSec=30min
TimeoutStopSec=15s
