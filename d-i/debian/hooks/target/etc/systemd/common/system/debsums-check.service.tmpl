[Unit]
Description=Narrow managed package integrity check
Documentation=man:debsums(1)
After=rsyslog.service apt-daily.service apt-daily-upgrade.service apt-repo-local-refresh.service
ConditionPathExists=__INSTALLER_LOG_SCANNER_SOCKET__
ConditionFileIsExecutable=__INSTALLER_PATH_DIR_USR__/bin/debsums

[Service]
Type=oneshot
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/debsums-check
RuntimeDirectory=debsums-check
RuntimeDirectoryMode=0700
PrivateNetwork=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=__INSTALLER_PATH_DIR_RUN__/debsums-check
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
Nice=19
IOSchedulingClass=idle
UMask=0077
TimeoutStartSec=15min
TimeoutStopSec=30s
KillMode=control-group
