[Unit]
Description=Apply profile-owned physical uplink priority and saved Wi-Fi addressing
Requires=NetworkManager.service
After=NetworkManager.service
Before=greetd.service
ConditionPathExists=__INSTALLER_PATH_FILE_NETWORK_UPLINK_POLICY__
StartLimitIntervalSec=10min
StartLimitBurst=2

[Service]
Type=oneshot
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-wifi-configure --firstboot
# The service cgroup bounds both adapter reconciliations and the ownership lock.
TimeoutStartSec=240s
TimeoutStopSec=10s
KillMode=control-group
Restart=on-failure
RestartSec=30s
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
# Preserve the explicit transitions into native nmcli/rfkill profiles.
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
