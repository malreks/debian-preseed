[Unit]
Description=Validate managed static networking for installed adapters
Documentation=man:interfaces(5) man:systemd.service(5)
DefaultDependencies=no

Requires=local-fs.target
After=local-fs.target systemd-udev-trigger.service
Wants=network-pre.target
Before=network-pre.target networking.service NetworkManager.service systemd-networkd.service

ConditionPathExists=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-run
ConditionPathExists=__INSTALLER_PATH_DIR_ETC__/network/host.conf
ConditionPathExists=__INSTALLER_PATH_DIR_ETC__/system-runtime.conf
ConditionPathExists=__INSTALLER_PATH_DIR_ETC__/network/interfaces.d/50-network

[Service]
Type=oneshot
EnvironmentFile=__INSTALLER_PATH_DIR_ETC__/system-runtime.conf
# Removable Ethernet must not make boot policy validation fail when detached.
# Manual network validate remains strict; this is not an online-network gate.
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-run validate --wait-seconds 15 --allow-absent
RemainAfterExit=yes
TimeoutStartSec=20s
TimeoutStopSec=10s

StandardOutput=journal
StandardError=journal

User=root
Group=root
UMask=0022

PrivateTmp=true
ProtectHome=true
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=sysinit.target
