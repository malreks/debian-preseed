[Unit]
Description=Verify the managed NFS identity namespace before use
Requires=apparmor.service apparmor-modes.service
After=apparmor.service apparmor-modes.service systemd-modules-load.service
AssertPathExists=__INSTALLER_PATH_DIR_ETC__/network-sharing/config.json
AssertPathExists=__INSTALLER_PATH_DIR_ETC__/idmapd.conf

[Service]
Type=oneshot
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-sharing-identity
# Recheck on subsequent starts; no resident process or cached success state.
RemainAfterExit=no
AppArmorProfile=network-sharing-identity
TimeoutStartSec=30s
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
TasksMax=16
MemoryMax=96M
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
# This prerequisite reads policy and identities, never share contents. Hide
# every allowed sharing parent before recursive read-only sandbox setup, so
# its namespace cannot traverse the automount that is waiting for this check.
InaccessiblePaths=-__INSTALLER_PATH_DIR_DATA__ -__INSTALLER_PATH_DIR_POOL__ -__INSTALLER_PATH_DIR_SRV__
PrivateTmp=yes
PrivateDevices=yes
IPAddressDeny=any
SocketBindDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
