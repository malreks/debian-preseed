[Unit]
Description=Reconcile managed Wi-Fi after Ethernet carrier change on %I
After=NetworkManager.service
ConditionPathExists=__INSTALLER_PATH_DIR_ETC__/network/host.conf
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-wifi-configure --carrier %I
TimeoutStartSec=90s
RuntimeDirectory=network-wifi
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=network-wifi
StateDirectoryMode=0700
KillMode=control-group
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=__INSTALLER_PATH_DIR_RUN__/lock __INSTALLER_PATH_DIR_RUN__/network-wifi __INSTALLER_PATH_DIR_VAR_LIB__/network-wifi
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
