[Unit]
After=systemd-tmpfiles-setup.service
RequiresMountsFor=__INSTALLER_LOG_DEBUGSYS_DIR__
Description=Consolidate explicitly enabled debugsys early-boot evidence
After=local-fs.target systemd-journald.service apparmor.service
ConditionPathExists=__INSTALLER_PATH_DIR_VAR_LIB__/debugsys/armed
ConditionPathIsDirectory=__INSTALLER_PATH_DIR_RUN__/initramfs/debugsys

[Service]
# Collect host processes, mounts and namespace metadata, not a sandbox snapshot.
PrivatePIDs=no
PrivateUsers=no
Type=oneshot
ExecStart=__INSTALLER_PATH_DIR_USR__/bin/python3 -I -B __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/debugsys.py boot-finalize
AppArmorProfile=debugsys-boot-report
TimeoutStartSec=300
KillMode=control-group
UMask=0077
LimitCORE=0
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
StateDirectory=debugsys
StateDirectoryMode=0700
ReadWritePaths=__INSTALLER_LOG_DEBUGSYS_DIR__ __INSTALLER_PATH_DIR_VAR_LIB__/debugsys

[Install]
WantedBy=multi-user.target
