# Never write to an underlying root filesystem before managed log/spool mounts.
[Unit]
RequiresMountsFor=__INSTALLER_LOG_POWER_DIR__ __INSTALLER_LOG_ROOT__ __INSTALLER_LOG_RSYSLOG_SPOOL_DIR__
After=systemd-journald.service systemd-tmpfiles-setup.service

[Service]
# Debian sends stdout to null; inherited stderr would discard startup failures
# from the pre/post commands as well. Keep their error causes in the journal.
StandardError=journal
LimitNOFILE=__INSTALLER_LOG_RSYSLOG_MAX_OPEN_FILES__
ExecStartPre=__INSTALLER_PATH_DIR_USR__/bin/test -x __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/rsyslog-size-rotate
ExecStartPre=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/journal-check
ExecStartPre=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/log-layout --preflight
ExecStartPre=__INSTALLER_PATH_DIR_USR__/bin/systemd-tmpfiles --create __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/59-log-layout.conf __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/60-security-logs.conf __INSTALLER_PATH_DIR_ETC__/tmpfiles.d/65-audit-syslog.conf
ExecStartPre=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/log-layout
ExecStartPre=__INSTALLER_PATH_DIR_USR__/sbin/rsyslogd -N1 -f __INSTALLER_PATH_DIR_ETC__/rsyslog.conf
