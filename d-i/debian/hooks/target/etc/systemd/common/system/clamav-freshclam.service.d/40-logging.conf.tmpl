[Unit]
After=systemd-tmpfiles-setup.service
RequiresMountsFor=__INSTALLER_LOG_CLAMAV_DIR__

[Service]
ExecCondition=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-online-check
LogsDirectory=
ReadWritePaths=__INSTALLER_LOG_CLAMAV_DIR__
UMask=0027
StandardOutput=journal
StandardError=journal
ExecStartPre=+__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/native-logging --check freshclam
