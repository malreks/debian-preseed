[Unit]
Description=Discover updates and atomically publish the local APT repository
Wants=network-online.target
After=network-online.target
ConditionPathExists=__INSTALLER_PATH_DIR_VAR_LIB_SOFTWARE__/repo/current

[Service]
Type=oneshot
ExecCondition=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-online-check
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/apt-repo-init --refresh
User=root
Group=root
UMask=0077
TimeoutStartSec=2h
TimeoutStopSec=30s
KillMode=control-group
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-__INSTALLER_PATH_DIR_RUN_USER__/0/gnupg
ReadWritePaths=__INSTALLER_PATH_DIR_VAR_LIB__/software __INSTALLER_PATH_DIR_ETC__/apt/keyrings __INSTALLER_PATH_DIR_ETC__/apt/sources.list.d __INSTALLER_PATH_DIR_RUN__/lock
# The root publisher must enter the dedicated tuta-extract and bwrap AppArmor
# profiles. NNP rejects those explicit transitions. The parser itself drops
# uid/gid/capabilities and sets NNP inside its isolated namespace.
NoNewPrivileges=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apt-repo-local-refresh
