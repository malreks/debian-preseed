## Kernel, clock, hostname, and mount-state changes.
-a always,exit -F arch=b64 -S init_module -S finit_module -S delete_module -F key=kernel-module
-a always,exit -F arch=b64 -S adjtimex -S settimeofday -S clock_settime -F key=time-change
-a always,exit -F arch=b64 -S sethostname -S setdomainname -F key=host-identity
-a always,exit -F arch=b64 -S mount -S umount2 -F key=mount-change

## Permission-denied access attempts against high-value configuration trees.
-a always,exit -F arch=b64 -S openat -S openat2 -S truncate -S ftruncate -F dir=__INSTALLER_PATH_DIR_ETC__ -F success=0 -F key=etc-access-denied
-a always,exit -F arch=b64 -S openat -S openat2 -S truncate -S ftruncate -F dir=__INSTALLER_PATH_DIR_BOOT__ -F success=0 -F key=boot-access-denied

-e 1
