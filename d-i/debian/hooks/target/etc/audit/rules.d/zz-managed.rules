## Managed by installer late_command.
## Common baseline: native-ABI integrity coverage without old-style
## -w watches, catch-all execve, networking, or global file-open syscall rules.
## auditctl requires syscall selectors on arch-qualified perm/path/dir rules.

-D
--backlog_wait_time 120000
## auditctl/augenrules status prints this as "failure 1"; it is the kernel
## audit failure mode (printk), not a rule load failure.
-f 1

## Ignore kernel pseudo-filesystems before any filesystem-scoped checks.
-a never,filesystem -F fstype=debugfs
-a never,filesystem -F fstype=tracefs

## AppArmor policy changes; AppArmor denials are emitted by the kernel LSM into audit.
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F dir=__INSTALLER_PATH_DIR_ETC__/apparmor.d -F perm=wa -F key=apparmor-policy
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F dir=__INSTALLER_PATH_DIR_ETC__/apparmor -F perm=wa -F key=apparmor-policy
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F path=__INSTALLER_PATH_DIR_ETC__/apparmor/parser.conf -F perm=wa -F key=apparmor-policy

## Identity databases.
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F path=__INSTALLER_PATH_DIR_ETC__/passwd -F perm=wa -F key=identity
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F path=__INSTALLER_PATH_DIR_ETC__/group -F perm=wa -F key=identity
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F path=__INSTALLER_PATH_DIR_ETC__/shadow -F perm=wa -F key=identity
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F path=__INSTALLER_PATH_DIR_ETC__/gshadow -F perm=wa -F key=identity
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F path=__INSTALLER_PATH_DIR_ETC__/security/opasswd -F perm=wa -F key=identity

## sudo, su, and administrative activity.
-a always,exit -F arch=b64 -S execve -S execveat -F path=__INSTALLER_PATH_DIR_USR__/bin/sudo -F perm=x -F key=privilege-escalation
-a always,exit -F arch=b64 -S execve -S execveat -F path=__INSTALLER_PATH_DIR_USR__/bin/su -F perm=x -F key=privilege-escalation
-a always,exit -F arch=b64 -S execve -S execveat -F path=__INSTALLER_PATH_DIR_USR__/bin/passwd -F perm=x -F key=account-tools
-a always,exit -F arch=b64 -S execve -S execveat -F path=__INSTALLER_PATH_DIR_USR__/bin/chsh -F perm=x -F key=account-tools
-a always,exit -F arch=b64 -S execve -S execveat -F path=__INSTALLER_PATH_DIR_USR__/bin/chfn -F perm=x -F key=account-tools
-a always,exit -F arch=b64 -S execve -S execveat -F path=__INSTALLER_PATH_DIR_USR__/bin/newgrp -F perm=x -F key=account-tools
-a always,exit -F arch=b64 -S execve -S execveat -F path=__INSTALLER_PATH_DIR_USR__/bin/gpasswd -F perm=x -F key=account-tools
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F path=__INSTALLER_PATH_DIR_ETC__/sudoers -F perm=wa -F key=sudo-config
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F dir=__INSTALLER_PATH_DIR_ETC__/sudoers.d -F perm=wa -F key=sudo-config

## PAM, login, SSH, and security policy configuration.
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F dir=__INSTALLER_PATH_DIR_ETC__/pam.d -F perm=wa -F key=auth-config
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F dir=__INSTALLER_PATH_DIR_ETC__/security -F perm=wa -F key=auth-config
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F path=__INSTALLER_PATH_DIR_ETC__/login.defs -F perm=wa -F key=auth-config
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F dir=__INSTALLER_PATH_DIR_ETC__/ssh -F perm=wa -F key=auth-config

