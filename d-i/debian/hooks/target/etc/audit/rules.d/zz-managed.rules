-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F dir=__INSTALLER_PATH_DIR_SYSTEMD_ETC__/system -F perm=wa -F key=systemd-config
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F dir=__INSTALLER_PATH_DIR_BOOT__ -F perm=wa -F key=boot-config
-a always,exit -F arch=b64 -S openat -S truncate -S ftruncate -S chmod -S fchmod -S fchmodat -S chown -S fchown -S fchownat -S lchown -S rename -S renameat -S renameat2 -S unlink -S unlinkat -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F dir=__INSTALLER_PATH_DIR_USR_LOCAL__/sbin -F perm=wa -F key=local-admin-tools
