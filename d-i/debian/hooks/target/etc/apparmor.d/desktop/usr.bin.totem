# Managed by unattended-installer.

abi "__INSTALLER_PATH_DIR_USR_SHARE__/apparmor-features/features",

#include <tunables/global>

profile __INSTALLER_PATH_DIR_USR__/bin/totem __INSTALLER_PATH_DIR_USR__/bin/totem flags=(attach_disconnected) {
  #include <abstractions/desktop-application>
  #include <abstractions/user-documents>
  #include <abstractions/pipewire-audio>
  include if exists <abstractions/user-tmp>

  capability sys_nice,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  __INSTALLER_PATH_DIR_USR__/bin/totem mr,
  __INSTALLER_PATH_DIR_USR_LIBEXEC__/totem* rix,
  __INSTALLER_PATH_DIR_USR_LIBEXEC__/gstreamer-1.0/gst-plugin-scanner ix,
  __INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner rix,
  __INSTALLER_PATH_DIR_USR_SHARE__/{glib-2.0,gstreamer-1.0,totem}/ r,
  __INSTALLER_PATH_DIR_USR_SHARE__/{glib-2.0,gstreamer-1.0,totem}/** r,

  __INSTALLER_PATH_DIR_DEV__/video* rw,

  owner @{HOME}/.cache/totem/ rw,
  owner @{HOME}/.cache/totem/** rwk,
  owner @{HOME}/.config/totem/ rw,
  owner @{HOME}/.config/totem/** rwk,
  owner @{HOME}/.local/share/totem/ rw,
  owner @{HOME}/.local/share/totem/** rwk,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ r,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** r,
  owner @{HOME}/@{XDG_MUSIC_DIR}/ r,
  owner @{HOME}/@{XDG_MUSIC_DIR}/** r,
  owner @{HOME}/@{XDG_VIDEOS_DIR}/ r,
  owner @{HOME}/@{XDG_VIDEOS_DIR}/** r,
  owner /media/*/ r,
  owner /media/*/** r,
  owner /mnt/ r,
  owner /mnt/** r,
  owner __INSTALLER_PATH_DIR_RUN__/media/*/ r,
  owner __INSTALLER_PATH_DIR_RUN__/media/*/** r,

  profile sanitized_helper flags=(attach_disconnected) {
    #include <abstractions/desktop-application>
    include if exists <abstractions/user-tmp>

    __INSTALLER_PATH_DIR_USR__/bin/totem mr,
    __INSTALLER_PATH_DIR_USR_LIBEXEC__/totem* rix,
    __INSTALLER_PATH_DIR_USR_LIBEXEC__/gstreamer-1.0/gst-plugin-scanner ix,
    __INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner rix,
    __INSTALLER_PATH_DIR_USR_SHARE__/{glib-2.0,gstreamer-1.0,totem}/ r,
    __INSTALLER_PATH_DIR_USR_SHARE__/{glib-2.0,gstreamer-1.0,totem}/** r,

    owner @{HOME}/.cache/totem/ rw,
    owner @{HOME}/.cache/totem/** rwk,

    include if exists <local/usr.bin.totem>
  }

  include if exists <local/usr.bin.totem>
}
