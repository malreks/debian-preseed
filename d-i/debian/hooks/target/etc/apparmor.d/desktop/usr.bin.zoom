# Managed by unattended-installer.

abi "__INSTALLER_PATH_DIR_USR_SHARE__/apparmor-features/features",

#include <tunables/global>

profile usr.bin.zoom /{usr/bin/zoom,opt/zoom/{zoom,ZoomLauncher}} flags=(attach_disconnected, mediate_deleted) {
  # Zoom embeds Chromium/CEF and needs the same user-namespace and process
  # bookkeeping contract as the repository-managed Electron applications.
  #include <abstractions/electron-application>
  #include <abstractions/pipewire-audio>
  include if exists <abstractions/user-tmp>

  capability sys_nice,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  __INSTALLER_PATH_DIR_DEV__/video* rw,

  __INSTALLER_PATH_DIR_USR__/bin/zoom rix,
  __INSTALLER_PATH_DIR_OPT__/zoom/ r,
  __INSTALLER_PATH_DIR_OPT__/zoom/{ZoomLauncher,zoom} rix,
  __INSTALLER_PATH_DIR_OPT__/zoom/** mrix,

  # Zoom is a desktop client, not a root service. Block root-owned state even
  # when the package executable is invoked directly instead of through the
  # managed non-root command wrapper.
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.cache/zoom/ rw,
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.cache/zoom/** rwkl,
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.config/\#* rwkl,
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.config/zoom/ rw,
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.config/zoom/** rwkl,
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.config/zoomus.conf* rwkl,
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.local/share/zoom/ rw,
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.local/share/zoom/** rwkl,
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.zoom/ rw,
  deny __INSTALLER_PATH_DIR_ROOT_HOME__/.zoom/** rwkl,

  owner @{HOME}/.cache/zoom/ rw,
  owner @{HOME}/.cache/zoom/** rwk,
  owner @{HOME}/.config/zoom/ rw,
  owner @{HOME}/.config/zoom/** rwkl,
  owner @{HOME}/.config/\#* rwkl,
  owner @{HOME}/.config/zoomus.conf* rwkl,
  owner @{HOME}/.local/share/zoom/ rw,
  owner @{HOME}/.local/share/zoom/** rwkl,
  owner @{HOME}/.zoom/ rw,
  owner @{HOME}/.zoom/** rwkl,
  owner @{HOME}/.zoom/logs/zoom_stdout_stderr.log rak,
  owner @{HOME}/@{XDG_DOCUMENTS_DIR}/ rw,
  owner @{HOME}/@{XDG_DOCUMENTS_DIR}/** rwkl,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ rw,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** rwkl,

  include if exists <local/usr.bin.zoom>
}
