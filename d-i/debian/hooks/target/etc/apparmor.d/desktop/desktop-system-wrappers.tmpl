  __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/{podman,docker,docker-compose} rix,
  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/podman-devops-client rix,
  __INSTALLER_PATH_DIR_USR__/bin/python3* rix,
  __INSTALLER_PATH_DIR_USR__/bin/{podman,docker,docker-compose} rPUx,
  __INSTALLER_PATH_DIR_RUN__/podman-devops/ r,
  __INSTALLER_PATH_DIR_RUN__/podman-devops/podman.sock r,
  __INSTALLER_PATH_DIR_ETC__/podman-devops/ r,
  __INSTALLER_PATH_DIR_ETC__/podman-devops/client.conf r,
  signal (send, receive),

  include if exists <local/usr.local.libexec.podman-devops-client>
