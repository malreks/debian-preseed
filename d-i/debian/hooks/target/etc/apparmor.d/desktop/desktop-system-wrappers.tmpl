# Managed exact executable attachments; native package candidates are suite-owned.
#include <tunables/global>

profile syncthing-configure __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/syncthing-configure flags=(attach_disconnected) {
  #include <abstractions/wrapper-python>
  #include <abstractions/nameservice>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  signal (send, receive) peer=syncthing-configure,

  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/syncthing-configure rix,
  __INSTALLER_PATH_DIR_USR__/bin/{dirname,flock,id,install,python3,syncthing,timeout} rix,
  / r,
  __INSTALLER_PATH_DIR_ETC__/syncthing/service.conf r,
  __INSTALLER_PATH_DIR_DATA__/ r,
  __INSTALLER_PATH_DIR_DATA__/** rwkl,
  __INSTALLER_PATH_DIR_HOME__/ r,
  __INSTALLER_PATH_DIR_HOME__/*/ r,
  __INSTALLER_PATH_DIR_HOME__/*/Syncthing/ rw,
  __INSTALLER_PATH_DIR_HOME__/*/Syncthing/** rwkl,
  __INSTALLER_PATH_DIR_HOME__/*/.local/ r,
  __INSTALLER_PATH_DIR_HOME__/*/.local/state/ rw,
  __INSTALLER_PATH_DIR_HOME__/*/.local/state/syncthing/ rw,
  __INSTALLER_PATH_DIR_HOME__/*/.local/state/syncthing/** rwkl,

  include if exists <local/usr.local.libexec.syncthing-configure>
}

