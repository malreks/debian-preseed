# Direct browser invocation remains confined. Managed launches enter the
# narrower nested browser domain under labwc-app//tor-bwrap before exec.
abi "__INSTALLER_PATH_DIR_USR_SHARE__/apparmor-features/features",
#include <tunables/global>

profile tor-browser __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/Browser/{firefox,firefox.real} flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/tor-browser-runtime>
  #include <abstractions/wrapper-base>
  __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/Browser/{firefox,firefox.real,abicheck,glxtest,vaapitest} rix,
  __INSTALLER_PATH_DIR_USR__/bin/dirname rix,
  deny network inet,
  deny network inet6,
  include if exists <local/tor-browser>
}
