  network unix dgram,
  __INSTALLER_PATH_DIR_RUN__/systemd/notify w,
  #include <abstractions/dbus-strict>
  network unix stream,
  __INSTALLER_PATH_DIR_ETC__/machine-id r,
  __INSTALLER_PATH_DIR_RUN__/systemd/system/ r,
  __INSTALLER_PATH_DIR_RUN__/systemd/private rw,
