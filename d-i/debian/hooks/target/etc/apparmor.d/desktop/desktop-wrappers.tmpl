  # NoNewPrivileges=yes is intentional: these fixed utilities inherit this
  # profile instead of requiring a privilege-widening PUx transition. The
  # Child transports drop to the authorized UID without a PAM/stdio bridge.
  capability setuid,
  capability setgid,
  capability kill,
