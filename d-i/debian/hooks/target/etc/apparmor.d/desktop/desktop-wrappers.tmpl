profile android-platform-tools /{bin/{adb,fastboot},usr/bin/{adb,fastboot},usr/local/bin/{adb,fastboot},usr/local/lib/android-sdk/platform-tools/{adb,etc1tool,fastboot,hprof-conv,make_f2fs,make_f2fs_casefold,mke2fs,sqlite3}} flags=(attach_disconnected) {
  #include <abstractions/wrapper-terminal>
  #include <abstractions/wrapper-desktop>
  include if exists <abstractions/nameservice-strict>
  include if exists <abstractions/ssl_certs>
  include if exists <abstractions/user-tmp>

  unix,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink dgram,
  network netlink raw,

  # adb enumerates process descriptor directories to find an existing server,
  # then reads only its own network namespace transport tables. Procfs owns
  # these table inodes as root even when the namespace belongs to this process,
  # so an AppArmor owner qualifier would reject the legitimate read.
  @{PROC}/ r,
  @{PROC}/[0-9]*/fd/ r,
  @{PROC}/@{pid}/net/{tcp,tcp6,udp,udp6} r,

  /{bin,usr/bin}/{adb,fastboot} rix,
  __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/{adb,fastboot} rix,
  __INSTALLER_PATH_DIR_USR_LOCAL_LIB__/android-sdk/platform-tools/ r,
  __INSTALLER_PATH_DIR_USR_LOCAL_LIB__/android-sdk/platform-tools/** mr,
  __INSTALLER_PATH_DIR_USR_LOCAL_LIB__/android-sdk/platform-tools/{adb,etc1tool,fastboot,hprof-conv,make_f2fs,make_f2fs_casefold,mke2fs,sqlite3} rix,
  __INSTALLER_PATH_DIR_DEV__/bus/usb/ r,
  __INSTALLER_PATH_DIR_DEV__/bus/usb/** rw,
  __INSTALLER_PATH_DIR_DEV__/usb/ r,
  __INSTALLER_PATH_DIR_DEV__/usb/** rw,
  __INSTALLER_PATH_DIR_RUN__/udev/data/ r,
  __INSTALLER_PATH_DIR_RUN__/udev/data/** r,
  __INSTALLER_PATH_DIR_SYS__/bus/usb/devices/ r,
  __INSTALLER_PATH_DIR_SYS__/bus/usb/devices/** r,
  __INSTALLER_PATH_DIR_SYS__/devices/**/{busnum,descriptors,devnum,idProduct,idVendor,manufacturer,product,serial,uevent} r,
  owner @{HOME}/ r,
  owner @{HOME}/** rwkl,
  __INSTALLER_PATH_DIR_POOL__/ r,
  __INSTALLER_PATH_DIR_POOL__/** rwkl,

  include if exists <local/usr.local.lib.android-platform-tools>
}

