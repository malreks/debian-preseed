  # Bundled Tor uses the dedicated veth; Tor Browser's UI/content processes
  # execute in a second namespace with no IP connectivity. No host DNS/proxy.
  profile tor-bwrap flags=(attach_disconnected, mediate_deleted) {
    #include <abstractions/bwrap-common>
    #include <abstractions/wrapper-python>
    #include <abstractions/tor-browser-runtime>
    __INSTALLER_PATH_DIR_USR__/bin/bwrap rix,
    __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/tor-browser-run rix,
    /{bin,lib,lib32,lib64,opt,sbin,usr}/ r,
    __INSTALLER_PATH_DIR_USR__/{lib32,lib64,sbin}/ r,
    # Tor reads the root-owned kernel UUID source; both stacked profiles apply.
    @{PROC}__INSTALLER_PATH_DIR_SYS__/kernel/random/uuid r,
    # Bubblewrap has set no_new_privs. Retain this profile in each exec stack
    # and add the narrower child, so confinement can only become stricter.
    # Lowercase px retains the fixed bundled Tor library environment.
    __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/Browser/TorBrowser/Tor/tor rpx -> "labwc-app//tor-bwrap//&labwc-app//tor-bwrap//transport",
    __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/Browser/{firefox.real,abicheck,glxtest,vaapitest} rix,
    network inet stream,
    network inet6 stream,
    # Bubblewrap uses a datagram socket for private loopback setup. The Tor
    # transport child denies datagrams; the veth guard blocks all DNS/UDP.
    network inet dgram,
    network inet6 dgram,
    __INSTALLER_PATH_DIR_SYS__/{,**} r,
    __INSTALLER_PATH_DIR_ETC__/{alternatives,ca-certificates,chromium,chromium.d,fonts,ld.so.conf.d,pki,ssl,xdg}/{,**} r,
    __INSTALLER_PATH_DIR_ETC__/{group,hostname,hosts,localtime,machine-id,nsswitch.conf,passwd,resolv.conf} r,
    __INSTALLER_PATH_DIR_VAR_LIB__/dbus/{,machine-id} r,
    owner __INSTALLER_PATH_DIR_RUN_USER__/[0-9]*/labwc-tor-browser-{sandbox,privacy}-*/{,**} rwkl,
    owner __INSTALLER_PATH_DIR_RUN_USER__/[0-9]*/labwc-tor-browser-tmp/{,**} rwkl,
    owner __INSTALLER_PATH_DIR_TMP__/labwc-tor-browser-{sandbox,privacy}-*/{,**} rwkl,
    signal (receive) set=(hup int term kill) peer=labwc-app,
    ptrace (readby) peer=labwc-app,
    signal (send, receive) peer=labwc-app//tor-bwrap//browser,
    ptrace (read) peer=labwc-app//tor-bwrap//browser,
    signal (send, receive) peer=labwc-app//tor-bwrap//transport,
    ptrace (read) peer=labwc-app//tor-bwrap//transport,
    signal (send, receive) peer="labwc-app//tor-bwrap//&labwc-app//tor-bwrap//{browser,transport}",
    ptrace (read, trace, readby, tracedby) peer="labwc-app//tor-bwrap//&labwc-app//tor-bwrap//browser",
    ptrace (read, readby) peer="labwc-app//tor-bwrap//&labwc-app//tor-bwrap//transport",
    __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/Browser/firefox rPx -> "labwc-app//tor-bwrap//&labwc-app//tor-bwrap//browser",
    profile transport flags=(attach_disconnected, mediate_deleted) {
      #include <abstractions/base>
      #include <abstractions/nameservice-strict>
      include if exists <abstractions/openssl>
      __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/{,**} mr,
      __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/Browser/TorBrowser/Tor/tor rix,
      # Pluggable transports can perform external bootstrap/DNS exchanges.
      # This runtime accepts native Tor/IP bridges only, including in complain.
      deny __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/Browser/TorBrowser/Tor/PluggableTransports/** x,
      network inet stream,
      network inet6 stream,
      # Route/interface enumeration uses NETLINK_ROUTE, not an IP raw socket.
      network netlink raw,
      deny network inet dgram,
      deny network inet6 dgram,
      unix,
      __INSTALLER_PATH_DIR_ETC__/{hosts,nsswitch.conf,resolv.conf} r,
      owner @{HOME}/.local/share/tor-browser/tor/{,**} rwkl,
      owner __INSTALLER_PATH_DIR_RUN_USER__/[0-9]*/tor-*/transport/{,**} rwkl,
      @{PROC}/[0-9]*/{stat,status} r,
      @{PROC}__INSTALLER_PATH_DIR_SYS__/kernel/random/uuid r,
      signal (send, receive) peer=@{profile_name},
      signal (send, receive) peer=labwc-app//tor-bwrap,
      signal (send, receive) peer="labwc-app//tor-bwrap//&labwc-app//tor-bwrap//transport",
      ptrace (readby) peer=labwc-app//tor-bwrap,
      ptrace (read, readby) peer="labwc-app//tor-bwrap//&labwc-app//tor-bwrap//transport",
      deny __INSTALLER_PATH_DIR_DEV__/dri/{,**} rw,
      deny __INSTALLER_PATH_DIR_DEV__/nvidia* rw,
      deny __INSTALLER_PATH_DIR_DEV__/snd/{,**} rw,
    }
    # Cookie/SOCKS IPC remains usable; even a proxy preference override cannot
    # give this child IPv4/IPv6 socket access or invoke the transport executable.
    profile browser flags=(attach_disconnected, mediate_deleted) {
      #include <abstractions/tor-browser-runtime>
      #include <abstractions/wrapper-base>
      #include <abstractions/bwrap-common>
      __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/Browser/{firefox,firefox.real,abicheck,glxtest,vaapitest} rix,
      __INSTALLER_PATH_DIR_USR__/bin/dirname rix,
      deny network inet,
      deny network inet6,
      signal (send, receive) peer=labwc-app//tor-bwrap,
      ptrace (readby) peer=labwc-app//tor-bwrap,
      signal (send, receive) peer="labwc-app//tor-bwrap//&labwc-app//tor-bwrap//browser",
      ptrace (read, trace, readby, tracedby) peer="labwc-app//tor-bwrap//&labwc-app//tor-bwrap//browser",
    }
