profile gtkgreet __INSTALLER_PATH_DIR_USR__/bin/gtkgreet flags=(attach_disconnected, mediate_deleted) {
  # GTK resources, Wayland and client-side Intel/NVIDIA graphics. Authentication
  # belongs to greetd/PAM; this process needs only greetd's protocol socket.
  #include <abstractions/wrapper-gui>
  __INSTALLER_PATH_DIR_USR__/bin/gtkgreet mr,
  # Glycin inventories root entries to construct its private loader namespace.
  / r,
  __INSTALLER_PATH_DIR_RUN__/greetd{,-[0-9]*}.sock rw,
  owner __INSTALLER_PATH_DIR_RUN_USER__/[0-9]*/wayland-[0-9]* rw,
  __INSTALLER_PATH_DIR_ETC__/localtime r,
  __INSTALLER_PATH_DIR_ETC__/greetd/{,gtkgreet.css,waypaper-wallpaper-[0-9a-f]*.png,waypaper-wallpaper-[0-9a-f]*.jpg} r,
  # Any installed background may be selected, including nested collections.
  # Appearance publishes account-selected images into the root-owned greetd
  # directory; the login process never needs access to account home files.
  __INSTALLER_PATH_DIR_USR_SHARE_BACKGROUNDS__/{,**} r,
  __INSTALLER_PATH_DIR_USR_LOCAL_SHARE__/backgrounds/{,**} r,
  owner __INSTALLER_PATH_DIR_RUN_USER__/[0-9]*/labwc-greeter.*/{cache,config,data,home,tmp}/{,**} rwkl,
  owner __INSTALLER_PATH_DIR_TMP__/labwc-greeter.*/{cache,config,data,home,tmp}/{,**} rwkl,
  owner __INSTALLER_PATH_DIR_TMP__/gdk-pixbuf-glycin-tmp.* rwk,
  __INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/{,**} r,
  __INSTALLER_PATH_DIR_USR__/bin/bwrap rPx -> gtkgreet-glycin-bwrap,
  signal (send) set=(kill term) peer=gtkgreet-glycin-bwrap,
  signal (receive) set=(chld) peer=gtkgreet-glycin-bwrap,
  signal (send) set=(chld) peer=labwc-greeter-client,
  signal (receive) set=(hup int term kill) peer={labwc-compositor,labwc-greeter-client,unconfined},
  # A login UI has no shell, external network or session-bus service role.
