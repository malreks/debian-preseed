    #include <abstractions/bwrap-common>

    signal (receive) peer=tuta-extract,
    / r,
    __INSTALLER_PATH_DIR_USR__/bin/{bwrap,setpriv,unsquashfs,python3,python3.[0-9]*} rix,
    __INSTALLER_PATH_DIR_USR__/lib/python3*/{,**} r,
    __INSTALLER_PATH_DIR_USR__/lib/python3*/lib-dynload/** mr,
    /{bin,sbin,lib,lib64,usr}/ r,
    __INSTALLER_PATH_DIR_ETC__/ r,
    __INSTALLER_PATH_DIR_TMP__/{installer-software,apt-repo-local-software-update.*}/{,**} rwkl,
    __INSTALLER_PATH_DIR_VAR_LIB_SOFTWARE__/inbox/{,**} rwkl,
    /artifact r,
    /output/{,**} rwkl,
    @{PROC}__INSTALLER_PATH_DIR_SYS__/kernel/cap_last_cap r,
    @{PROC}/[0-9]*/status r,
  }
  include if exists <local/usr.local.libexec.tuta-extract>
}
