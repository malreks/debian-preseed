    / r,
    __INSTALLER_PATH_DIR_DEV__/tty r,
    __INSTALLER_PATH_DIR_DEV__/pts/[0-9]* r,
    __INSTALLER_PATH_DIR_DEV__/tty[0-9]* r,
    __INSTALLER_PATH_DIR_ETC__/{ld.so.cache,nsswitch.conf,passwd} r,
    @{PROC}/ r,
    @{PROC}/{cpuinfo,meminfo,stat} r,
