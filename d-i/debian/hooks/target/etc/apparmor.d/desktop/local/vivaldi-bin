# Managed by unattended-installer.
#
# Direct Vivaldi binary attachment. Keep this aligned with vivaldi-stable so a
# direct vivaldi-bin invocation has the same bounded browser contract.

#include <abstractions/electron-application>
#include <abstractions/pipewire-audio>
#include <abstractions/user-documents>
include if exists <abstractions/user-tmp>
include if exists <abstractions/xdg-open>

network inet stream,
network inet6 stream,
network inet dgram,
network inet6 dgram,
network netlink raw,
signal (send) set=(kill) peer=vivaldi-bin//vivaldi-bwrap,

# Vivaldi probes both session and system D-Bus sockets through Chromium helper
# threads before the final pathname is fully connected to the current mount
# namespace. Keep those bounded desktop IPC reads explicit for enforce mode.
__INSTALLER_PATH_DIR_RUN__/dbus/system_bus_socket rw,
owner __INSTALLER_PATH_DIR_RUN_USER__/[0-9]*/bus rw,

__INSTALLER_PATH_DIR_DEV__/video* rw,
__INSTALLER_PATH_DIR_DEV__/ r,
# Preserve the same user-owned terminal across the wrapper -> browser transition.
owner __INSTALLER_PATH_DIR_DEV__/pts/[0-9]* rw,

# Chromium's MemoryInfra thread samples root-owned sandbox helper processes.
@{PROC}/[0-9]*/statm r,

# Crashpad reads the owning user's browser memory. The electron-runtime
# ptrace rule restricts attach access to processes with this same profile.
owner @{PROC}/[0-9]*/mem r,

# Chromium gamepad polling resolves dynamically numbered input and USB records.
__INSTALLER_PATH_DIR_RUN__/udev/data/ r,
__INSTALLER_PATH_DIR_RUN__/udev/data/** r,

__INSTALLER_PATH_DIR_OPT__/vivaldi/ r,
__INSTALLER_PATH_DIR_OPT__/vivaldi/** mrix,
__INSTALLER_PATH_DIR_VAR__/opt/vivaldi/ r,
__INSTALLER_PATH_DIR_VAR__/opt/vivaldi/** mr,
__INSTALLER_PATH_DIR_USR__/bin/bwrap rCx -> vivaldi-bwrap,
__INSTALLER_PATH_DIR_USR_LIBEXEC__/glycin-loaders/2+/glycin-svg mrix,
__INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/ r,
__INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/** r,

__INSTALLER_PATH_DIR_ETC__/vivaldi/policies/ r,
__INSTALLER_PATH_DIR_ETC__/vivaldi/policies/managed/ r,
__INSTALLER_PATH_DIR_ETC__/vivaldi/policies/managed/** r,
__INSTALLER_PATH_DIR_ETC__/vivaldi/policies/recommended/ r,
__INSTALLER_PATH_DIR_ETC__/vivaldi/policies/recommended/** r,
# Managed policy is root-owned input. The browser may read it but must never
# rewrite policy, lock files, or directory entries through a broader include.
deny __INSTALLER_PATH_DIR_ETC__/vivaldi/policies/ w,
deny __INSTALLER_PATH_DIR_ETC__/vivaldi/policies/** wkl,
deny __INSTALLER_PATH_DIR_ETC_OPT__/chrome/ w,
# Chromium probes this directory with mkdir. No file writes are granted;
# root-owned DAC permissions still prohibit users modifying system manifests.
__INSTALLER_PATH_DIR_ETC_OPT__/chrome/native-messaging-hosts/ rw,
deny __INSTALLER_PATH_DIR_OPT__/vivaldi/extensions/ w,

@{sys}/devices/**/interface r,
@{sys}/devices/**/report_descriptor r,
owner __INSTALLER_PATH_DIR_RUN__/media/*/ r,
owner __INSTALLER_PATH_DIR_RUN__/media/*/** r,
owner @{HOME}/.cache/vivaldi/ rw,
owner @{HOME}/.cache/vivaldi/** rwk,
owner @{HOME}/.config/vivaldi/ rw,
owner @{HOME}/.config/vivaldi/** rwkl,
owner @{HOME}/.config/vivaldi/NativeMessagingHosts/.bitwarden_desktop_proxy rix,
owner @{HOME}/.config/{chromium,microsoft-edge}/NativeMessagingHosts/ r,
owner @{HOME}/.config/{chromium,microsoft-edge}/NativeMessagingHosts/.app.bw.socket rw,
owner @{HOME}/.config/{chromium,microsoft-edge}/NativeMessagingHosts/.app.bw.bitwarden.log rwkl,
owner @{HOME}/.config/vivaldi/WidevineCdm/*/_platform_specific/*/libwidevinecdm.so mr,
owner @{HOME}/.local/share/.vivaldi_reporting_data rwkl,
owner @{HOME}/.local/share/gvfs-metadata/root r,
owner @{HOME}/.local/share/gvfs-metadata/root-*.log r,
owner @{HOME}/.local/share/pki/ rw,
owner @{HOME}/.local/share/pki/** rwkl,
owner @{HOME}/.pki/nssdb/ rw,
owner @{HOME}/.pki/nssdb/** rwk,
owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ rw,
owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** rwkl,
owner @{HOME}/Documents/ rw,
owner @{HOME}/Documents/** rwkl,
owner @{HOME}/Workspace/llama-labwc/output/llama-{cuda,ram}.tar.gz r,
owner @{HOME}/Workspace/codex-home.zip r,
__INSTALLER_PATH_DIR_POOL__/build/whisper-labwc/artifacts/whisper-{cuda,ram}.tar.gz r,

# Vivaldi invokes Bubblewrap from a worker thread. Keep namespace construction,
# inherited browser descriptors, and the fixed browser/runtime trees out of the
# main browser profile and inside a no-new-privileges-safe child domain.

# Opt-in developer profile used by __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/browser-devtools.
owner @{HOME}/.local/ r,
owner @{HOME}/.local/state/ r,
owner @{HOME}/.local/state/browser-devtools/ r,
owner @{HOME}/.local/state/browser-devtools/vivaldi/ rw,
owner @{HOME}/.local/state/browser-devtools/vivaldi/** rwkl,

profile vivaldi-bwrap flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/bwrap-common>
  #include <abstractions/electron-runtime>
  #include <abstractions/user-documents>

  # A parent browser mDNS socket can reach exec as an inherited descriptor.
  # Bubblewrap must not use host UDP sockets while constructing its namespace.
  deny network inet dgram,
  signal (receive) set=(kill) peer=vivaldi-bin,

  __INSTALLER_PATH_DIR_OPT__/vivaldi/ r,
  __INSTALLER_PATH_DIR_OPT__/vivaldi/** mr,
  __INSTALLER_PATH_DIR_VAR__/opt/vivaldi/ r,
  __INSTALLER_PATH_DIR_VAR__/opt/vivaldi/** mr,
  __INSTALLER_PATH_DIR_USR__/bin/true rix,
  __INSTALLER_PATH_DIR_USR_LIBEXEC__/glycin-loaders/2+/{glycin-image-rs,glycin-svg} rix,
  __INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/ r,
  __INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/** r,
  
  # Opt-in developer profile used by __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/browser-devtools.
  owner @{HOME}/.local/ r,
  owner @{HOME}/.local/state/ r,
  owner @{HOME}/.local/state/browser-devtools/ r,
  owner @{HOME}/.local/state/browser-devtools/vivaldi/ rw,
  owner @{HOME}/.local/state/browser-devtools/vivaldi/** rwkl,
  owner @{HOME}/.config/vivaldi/ rw,
  owner @{HOME}/.config/vivaldi/** rwkl,
}

# Read-only btop monitoring from the managed terminal.
ptrace (readby) peer=desktop-launcher,
ptrace (readby) peer=waypaper//waypaper-ps,
