# Managed by unattended-installer.

abi "__INSTALLER_PATH_DIR_USR_SHARE__/apparmor-features/features",

#include <tunables/global>

profile tuta-mail __INSTALLER_PATH_DIR_OPT__/tuta-mail/AppRun flags=(attach_disconnected) {
  #include <abstractions/electron-runtime>
  # Save/export mail and select attachments in the managed document roots.
  #include <abstractions/user-documents>
  # Electron constructs nested PID/network namespaces and a safe proc chroot.
  # These AppArmor permissions do not grant host capabilities to the daily uid.
  # Do not weaken the shared capability-free runtime for other applications.
  userns,
  capability sys_admin,
  capability sys_chroot,
  owner @{PROC}/@{pid}/{uid_map,gid_map,setgroups} rw,
  owner @{PROC}/@{pid}/fdinfo/ r,
  owner @{PROC}/@{pid}/fdinfo/[0-9]* r,
  #include <abstractions/pipewire-audio>
  include if exists <abstractions/user-tmp>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  __INSTALLER_PATH_DIR_DEV__/tty rw,
  # Chromium's generic sensor backend probes host accelerometers even though
  # the mail client has no sensor feature. Keep those privacy-sensitive reads
  # explicitly unavailable instead of widening Tuta's hardware boundary.
  deny @{sys}/devices/**/iio:device[0-9]*/in_accel_{offset,sampling_frequency,scale,x_raw,y_raw,z_raw} r,
  __INSTALLER_PATH_DIR_USR__/bin/bwrap rCx -> tuta-bwrap,
  __INSTALLER_PATH_DIR_USR__/bin/{env,expr,ldd,touch,true} rix,
  __INSTALLER_PATH_DIR_USR__/bin/chromium rPx,
  __INSTALLER_PATH_DIR_USR_LIBEXEC__/glycin-loaders/2+/glycin-image-rs rPx -> tuta-glycin-loader,
  __INSTALLER_PATH_DIR_USR_LIBEXEC__/glycin-loaders/2+/glycin-svg rPx -> tuta-glycin-loader,
  __INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/ r,
  __INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/** r,
  __INSTALLER_PATH_DIR_OPT__/tuta-mail/ r,
  __INSTALLER_PATH_DIR_OPT__/tuta-mail/** mrix,

  owner __INSTALLER_PATH_DIR_RUN_USER__/[0-9]*/labwc-tutanota-tmp/{,**} rwkl,
  owner @{HOME}/.config/mimeapps.list{,.*} rwkl,
  owner @{HOME}/.cache/glycin/ rw,
  owner @{HOME}/.cache/glycin/** rwkl,
  owner @{HOME}/.cache/tutanota-desktop/ rw,
  owner @{HOME}/.cache/tutanota-desktop/** rwk,
  owner @{HOME}/.config/tuta_integration/ rw,
  owner @{HOME}/.config/tuta_integration/** rwkl,
  owner @{HOME}/.config/user-dirs.dirs r,
  owner @{HOME}/.config/tutanota-desktop/ rw,
  owner @{HOME}/.config/tutanota-desktop/** rwkl,
  owner @{HOME}/.local/share/tutanota-desktop/ rw,
  owner @{HOME}/.local/share/tutanota-desktop/** rwkl,
  owner @{HOME}/.local/share/applications/ rw,
  owner @{HOME}/.local/share/applications/tutanota-desktop.desktop rwkl,
  owner @{HOME}/.local/share/icons/ rw,
  owner @{HOME}/.local/share/icons/hicolor/ rw,
  owner @{HOME}/.local/share/icons/hicolor/{64x64,512x512}/ rw,
  owner @{HOME}/.local/share/icons/hicolor/{64x64,512x512}/apps/ rw,
  owner @{HOME}/.local/share/icons/hicolor/{64x64,512x512}/apps/tutanota-desktop.png rwkl,
  owner @{HOME}/.local/state/ rw,
  owner @{HOME}/.local/state/tutanota-desktop/ rw,
  owner @{HOME}/.local/state/tutanota-desktop/** rwkl,
  owner @{HOME}/@{XDG_DESKTOP_DIR}/ r,
  owner @{HOME}/@{XDG_DESKTOP_DIR}/** r,
  owner @{HOME}/@{XDG_DOCUMENTS_DIR}/ r,
  owner @{HOME}/@{XDG_DOCUMENTS_DIR}/** r,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ rw,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** rwkl,
  owner @{HOME}/@{XDG_MUSIC_DIR}/ r,
  owner @{HOME}/@{XDG_MUSIC_DIR}/** r,
  owner @{HOME}/@{XDG_PICTURES_DIR}/ r,
  owner @{HOME}/@{XDG_PICTURES_DIR}/** r,
  owner @{HOME}/@{XDG_PUBLICSHARE_DIR}/ r,
  owner @{HOME}/@{XDG_PUBLICSHARE_DIR}/** r,
  owner @{HOME}/@{XDG_TEMPLATES_DIR}/ r,
  owner @{HOME}/@{XDG_TEMPLATES_DIR}/** r,
  owner @{HOME}/@{XDG_VIDEOS_DIR}/ r,
  owner @{HOME}/@{XDG_VIDEOS_DIR}/** r,

  profile tuta-bwrap flags=(attach_disconnected, mediate_deleted) {
    #include <abstractions/bwrap-common>
    #include <abstractions/desktop-application>
    #include <abstractions/user-documents>
    include if exists <abstractions/user-tmp>

    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,

    __INSTALLER_PATH_DIR_USR__/bin/{env,expr,ldd,touch,true} rix,
    __INSTALLER_PATH_DIR_USR__/bin/chromium rPx -> chromium,
    __INSTALLER_PATH_DIR_USR_LIBEXEC__/glycin-loaders/2+/glycin-image-rs rPx -> tuta-glycin-loader,
    __INSTALLER_PATH_DIR_USR_LIBEXEC__/glycin-loaders/2+/glycin-svg rPx -> tuta-glycin-loader,
    __INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/ r,
    __INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/** r,
    __INSTALLER_PATH_DIR_OPT__/tuta-mail/ r,
    __INSTALLER_PATH_DIR_OPT__/tuta-mail/** mr,
    __INSTALLER_PATH_DIR_OPT__/tuta-mail/** rPx -> tuta-mail,

    owner __INSTALLER_PATH_DIR_RUN_USER__/[0-9]*/labwc-tutanota-tmp/{,**} rwkl,
    owner @{HOME}/.config/mimeapps.list{,.*} rwkl,
    owner @{HOME}/.cache/glycin/ rw,
    owner @{HOME}/.cache/glycin/** rwkl,
    owner @{HOME}/.cache/tutanota-desktop/ rw,
    owner @{HOME}/.cache/tutanota-desktop/** rwk,
    owner @{HOME}/.config/tuta_integration/ rw,
    owner @{HOME}/.config/tuta_integration/** rwkl,
    owner @{HOME}/.config/user-dirs.dirs r,
    owner @{HOME}/.config/tutanota-desktop/ rw,
    owner @{HOME}/.config/tutanota-desktop/** rwkl,
    owner @{HOME}/.local/share/tutanota-desktop/ rw,
    owner @{HOME}/.local/share/tutanota-desktop/** rwkl,
    owner @{HOME}/.local/state/tutanota-desktop/ rw,
    owner @{HOME}/.local/state/tutanota-desktop/** rwkl,
    owner @{HOME}/@{XDG_DESKTOP_DIR}/ r,
    owner @{HOME}/@{XDG_DESKTOP_DIR}/** r,
    owner @{HOME}/@{XDG_DOCUMENTS_DIR}/ r,
    owner @{HOME}/@{XDG_DOCUMENTS_DIR}/** r,
    owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ rw,
    owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** rwkl,
    owner @{HOME}/@{XDG_MUSIC_DIR}/ r,
    owner @{HOME}/@{XDG_MUSIC_DIR}/** r,
    owner @{HOME}/@{XDG_PICTURES_DIR}/ r,
    owner @{HOME}/@{XDG_PICTURES_DIR}/** r,
    owner @{HOME}/@{XDG_PUBLICSHARE_DIR}/ r,
    owner @{HOME}/@{XDG_PUBLICSHARE_DIR}/** r,
    owner @{HOME}/@{XDG_TEMPLATES_DIR}/ r,
    owner @{HOME}/@{XDG_TEMPLATES_DIR}/** r,
    owner @{HOME}/@{XDG_VIDEOS_DIR}/ r,
    owner @{HOME}/@{XDG_VIDEOS_DIR}/** r,
  }

  include if exists <local/opt.tuta-mail.AppRun>
}

profile tuta-glycin-loader flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/desktop-application>
  include if exists <abstractions/user-tmp>

  # Attachment previews can read group-owned NFS files, never modify them.
  __INSTALLER_PATH_DIR_DATA__/ r,
  __INSTALLER_PATH_DIR_DATA__/{downloads,sharing}/ r,
  __INSTALLER_PATH_DIR_DATA__/downloads/** r,
  __INSTALLER_PATH_DIR_DATA__/sharing/{nfs-client,nfs-server}/{,**} r,
  owner @{HOME}/Sharing/ r,
  @{HOME}/Sharing/{nfs-client,nfs-server}/{,**} r,

  __INSTALLER_PATH_DIR_USR_LIBEXEC__/glycin-loaders/2+/glycin-image-rs mrix,
  __INSTALLER_PATH_DIR_USR_LIBEXEC__/glycin-loaders/2+/glycin-svg mrix,
  __INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/ r,
  __INSTALLER_PATH_DIR_USR_SHARE__/glycin-loaders/2+/conf.d/** r,

  owner @{HOME}/.cache/glycin/ rw,
  owner @{HOME}/.cache/glycin/** rwkl,
  owner @{HOME}/.config/user-dirs.dirs r,
  owner @{HOME}/@{XDG_DESKTOP_DIR}/ r,
  owner @{HOME}/@{XDG_DESKTOP_DIR}/** r,
  owner @{HOME}/@{XDG_DOCUMENTS_DIR}/ r,
  owner @{HOME}/@{XDG_DOCUMENTS_DIR}/** r,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ r,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** r,
  owner @{HOME}/@{XDG_MUSIC_DIR}/ r,
  owner @{HOME}/@{XDG_MUSIC_DIR}/** r,
  owner @{HOME}/@{XDG_PICTURES_DIR}/ r,
  owner @{HOME}/@{XDG_PICTURES_DIR}/** r,
  owner @{HOME}/@{XDG_PUBLICSHARE_DIR}/ r,
  owner @{HOME}/@{XDG_PUBLICSHARE_DIR}/** r,
  owner @{HOME}/@{XDG_TEMPLATES_DIR}/ r,
  owner @{HOME}/@{XDG_TEMPLATES_DIR}/** r,
  owner @{HOME}/@{XDG_VIDEOS_DIR}/ r,
  owner @{HOME}/@{XDG_VIDEOS_DIR}/** r,
}
