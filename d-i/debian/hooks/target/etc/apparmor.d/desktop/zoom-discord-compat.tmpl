    @{sys}/devices/**/power_supply/*/{capacity,online,type} r,
    @{sys}/devices/system/cpu/cpu[0-9]*/cache/index[0-9]*/{coherency_line_size,number_of_sets,physical_line_partition,shared_cpu_map,type,ways_of_associativity} r,
    @{sys}/devices/system/cpu/cpu[0-9]*/hotplug/state r,
    @{sys}/devices/system/cpu/cpu[0-9]*/topology/{core_id,core_siblings,thread_siblings} r,
    @{sys}/devices/system/cpu/cpufreq/policy[0-9]*/cpuinfo_min_freq r,
    @{sys}/devices/system/cpu/hotplug/states r,
    @{sys}/devices/system/cpu/vulnerabilities/ r,
    @{sys}/devices/system/cpu/vulnerabilities/* r,
    @{sys}/kernel/cpu_byteorder r,
    __INSTALLER_PATH_DIR_USR__/{lib32,lib64,sbin}/ r,
    __INSTALLER_PATH_DIR_USR__/bin/ldd rix,
    __INSTALLER_PATH_DIR_USR__/bin/{bwrap,cage,pacmd,pactl,true} rix,
    __INSTALLER_PATH_DIR_USR__/bin/xkbcomp rix,
    __INSTALLER_PATH_DIR_USR__/bin/python3 rix,
    __INSTALLER_PATH_DIR_USR__/bin/python3.[0-9]* rix,
    __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-zoom-discord-compat-runtime rix,
    __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-{private-xwayland,compat-open-uri} rix,
    # Python/Gio runtime for the fixed portal client, never user Python code.
    #include <abstractions/python>
    __INSTALLER_PATH_DIR_PYTHON3_SYSTEM_PACKAGES__/gi/{,**} mr,
    __INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/girepository-1.0/{Gio,GLib,GObject}-2.0.typelib r,
    owner __INSTALLER_PATH_DIR_RUN__/labwc-compat-control/ r,
    owner __INSTALLER_PATH_DIR_RUN__/labwc-compat-control/{instance.sock,instance.lock,launch.lock} rw,
    owner __INSTALLER_PATH_DIR_TMP__/labwc-compat-primary-*/ rw,
    owner __INSTALLER_PATH_DIR_TMP__/labwc-compat-primary-*/primary.sock rw,
    signal (receive) set=(hup int term kill) peer=labwc-wayland-compat-app,
    ptrace (readby) peer=labwc-wayland-compat-app,
    signal (receive) set=(hup int term kill) peer=unconfined,
    __INSTALLER_PATH_DIR_PYTHON3_SITE_PACKAGES__/ r,
    __INSTALLER_PATH_DIR_PYTHON3_SITE_PACKAGES__/labwc_managed_app/ r,
    __INSTALLER_PATH_DIR_PYTHON3_SITE_PACKAGES__/labwc_managed_app/{__init__,bootstrap,compat_portal,compat_protocol,events,integrity,network_namespace,runtime,wayland_compat_runtime}.py r,
    __INSTALLER_PATH_DIR_USR_SHARE__/iproute2/group r,
    __INSTALLER_PATH_DIR_USR_SHARE__/misc/pci.ids r,
    __INSTALLER_PATH_DIR_USR_SHARE__/xdg-desktop-portal/portals/ r,
    /@__INSTALLER_PATH_DIR_USR__/bin/{lsb_release,xdg-mime,xdg-open} r,
    deny __INSTALLER_PATH_DIR_USR__/bin/chromium rxm,
    deny __INSTALLER_PATH_DIR_USR__/bin/Xwayland rxm,
    __INSTALLER_PATH_DIR_USR__/bin/zoom rix,
    __INSTALLER_PATH_DIR_USR__/lib/xorg/ r,
    __INSTALLER_PATH_DIR_USR__/lib/xorg/protocol.txt r,
    __INSTALLER_PATH_DIR_USR__/lib/x86_64-linux-gnu/libdecor/ r,
    __INSTALLER_PATH_DIR_USR__/lib/x86_64-linux-gnu/libdecor/plugins-1/ r,
    __INSTALLER_PATH_DIR_USR__/lib/x86_64-linux-gnu/libdecor/plugins-1/libdecor-gtk.so mr,
    __INSTALLER_PATH_DIR_USR_SHARE_XKB__/ r,
    __INSTALLER_PATH_DIR_USR_SHARE_XKB__/** r,
    __INSTALLER_PATH_DIR_OPT__/discord/Discord rix,
    __INSTALLER_PATH_DIR_OPT__/zoom/{ZoomLauncher,zoom} rix,
    __INSTALLER_PATH_DIR_VAR_LIB__/dbus/ r,
    __INSTALLER_PATH_DIR_VAR_LIB__/dbus/machine-id r,
    __INSTALLER_PATH_DIR_PROC__/self/exe rix,
    @{sys}/devices/**/{idProduct,idVendor,interface} r,

    deny @{sys}/devices/**/iio:device[0-9]*/in_accel_{offset,sampling_frequency,scale,x_raw,y_raw,z_raw} r,
  }

  include if exists <local/usr.local.bin.labwc-wayland-compat-app>
}

# The desktop session and ordinary applications must not start Cage or either
# the package-owned or private Xwayland binary directly. The managed
# Zoom/Discord Bubblewrap child above explicitly inherits its confined profile
# and therefore does not enter these fail-closed attachments.
profile labwc-cage-direct-exec-deny __INSTALLER_PATH_DIR_USR__/bin/cage flags=(attach_disconnected, mediate_deleted) {
  deny __INSTALLER_PATH_DIR_USR__/bin/cage mr,
}

profile labwc-xwayland-direct-exec-deny /{opt/xwayland/usr,usr}/bin/Xwayland flags=(attach_disconnected, mediate_deleted) {
  deny /{opt/xwayland/usr,usr}/bin/Xwayland mr,
}

profile labwc-xkbcomp-direct-exec-deny __INSTALLER_PATH_DIR_OPT__/xwayland/usr/{bin,lib/xkbcomp-overlay}/xkbcomp flags=(attach_disconnected, mediate_deleted) {
  deny __INSTALLER_PATH_DIR_OPT__/xwayland/usr/{bin,lib/xkbcomp-overlay}/xkbcomp mr,
}

profile labwc-private-xwayland-direct-deny __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-private-xwayland flags=(attach_disconnected) {
  deny __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-private-xwayland mr,
}

profile labwc-compat-open-uri-direct-deny __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-compat-open-uri flags=(attach_disconnected) {
  deny __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-compat-open-uri mr,
}
