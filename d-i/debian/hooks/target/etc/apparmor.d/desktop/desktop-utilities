# Terminals are the user's general command entry point. Permit arbitrary
# executable locations, including versioned toolchains, mounted workspaces,
# and newly installed tools. Direct descendants inherit this unrestricted
# command domain even when another executable attachment exists. DAC, kernel
# capabilities and authentication still apply. Explicit permissions survive
# the managed mode controller without a default_allow exception.
profile desktop-terminal __INSTALLER_PATH_DIR_USR__/bin/{foot,footclient,kitty} flags=(attach_disconnected, mediate_deleted) {
  allow all,
  # Keep arbitrary inherited execution explicit: never attach an implicit
  # compiler/application profile to a command launched from this terminal.
  /** rix,
}

