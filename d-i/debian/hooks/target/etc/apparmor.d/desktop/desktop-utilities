  __INSTALLER_PATH_DIR_VAR_CACHE__/apt/{pkgcache,srcpkgcache}.bin r,
  # Git invokes package-owned helpers below its exec-path, not only git itself.
  # Inherit the terminal domain; never create complain-mode null descendants.
  __INSTALLER_PATH_DIR_USR__/lib/git-core/git rix,
  __INSTALLER_PATH_DIR_USR__/lib/git-core/git-* rix,
  # GLib's desktop-entry trampoline retains this domain until the selected
  # executable attaches to its existing profile through the rules above.
  __INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/glib-2.0/gio-launch-desktop rix,
  # udevadm queries device metadata, not block/USB device contents.
  __INSTALLER_PATH_DIR_RUN__/udev/data/{b[0-9]*:[0-9]*,c189:[0-9]*,+usb:*} r,
  # thunar-volman also reads input-device metadata while handling hotplug.
  __INSTALLER_PATH_DIR_RUN__/udev/data/{c13:[0-9]*,+input:input[0-9]*} r,
  # The account owns the checked-out configuration tree. Edits from a terminal
  # are confined to that account's files; release and system configuration
  # under __INSTALLER_PATH_DIR_DATA__/codex/{lib,share} and __INSTALLER_PATH_DIR_ETC__/codex stay separate.
  __INSTALLER_PATH_DIR_DATA__/codex/usr/** r,
  owner __INSTALLER_PATH_DIR_DATA__/codex/usr/ rw,
  owner __INSTALLER_PATH_DIR_DATA__/codex/usr/** rwklm,

  # A terminal's mail check may read its user's traditional mail spool.
  owner __INSTALLER_PATH_DIR_VAR__/mail/* r,
  __INSTALLER_PATH_DIR_USR_SHARE__/** r,
  # Authentication boundary: Polkit/sudo retain their own authorization checks;
  # privileged repository helpers attach to their existing dedicated profiles.
  __INSTALLER_PATH_DIR_USR__/bin/{pkexec,sudo,sudoedit} rPUx,
  __INSTALLER_PATH_DIR_RUN__/mount/utab r,
  # util-linux's setuid mount drops credentials for privileged-only options
  # such as -a. Isolate that drop from the general terminal/file-manager domain.
  # Authorized mounts run through sudo or PID 1, outside this unprivileged child.
  __INSTALLER_PATH_DIR_USR__/bin/{mount,umount} rCx -> mount-user,
  profile mount-user {
    #include <abstractions/base>
    include <abstractions/nameservice-strict>
    capability setuid,
    capability setgid,
    __INSTALLER_PATH_DIR_USR__/bin/{mount,umount} mr,
    __INSTALLER_PATH_DIR_USR__/sbin/mount.nfs{,4} rix,
    __INSTALLER_PATH_DIR_ETC__/{fstab,mtab} r,
    __INSTALLER_PATH_DIR_RUN__/mount/utab r,
    @{PROC}/{filesystems,mounts,self/mountinfo,self/mounts} r,
    /**/ r,
  }
  signal (send) set=(kill term) peer=desktop-launcher//application-bwrap,
  __INSTALLER_PATH_DIR_USR__/bin/bwrap rCx -> application-bwrap,
  profile application-bwrap flags=(attach_disconnected) {
    signal (receive) set=(kill term) peer=desktop-launcher,
    #include <abstractions/bwrap-common>
    #include <abstractions/bwrap-desktop-runtime>
    #include <abstractions/devops-toolchain-runtime>
  }
  include if exists <local/desktop-launcher>
}

# FreeRDP's file clipboard uses libfuse. Its privileged fallback is isolated
# from the terminal/file-manager domain and may mount only cliprdr directories.
profile freerdp-client __INSTALLER_PATH_DIR_USR__/bin/{sdl-freerdp,sdl-freerdp3} flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/document-runtime>
  #include <abstractions/pipewire-audio>
  include if exists <abstractions/nameservice-strict>
  network inet dgram,
  network inet6 dgram,
  unix,
  signal (receive) set=(hup) peer=desktop-launcher,
  __INSTALLER_PATH_DIR_USR__/bin/{sdl-freerdp,sdl-freerdp3} mr,
  __INSTALLER_PATH_DIR_USR__/lib/** mr,
  __INSTALLER_PATH_DIR_USR_SHARE__/** r,
  __INSTALLER_PATH_DIR_ETC__/{freerdp,ssl}/** r,
  __INSTALLER_PATH_DIR_ETC__/krb5.conf r,
  __INSTALLER_PATH_DIR_ETC__/krb5.conf.d/{,**} r,
  __INSTALLER_PATH_DIR_DEV__/tty rw,
  owner __INSTALLER_PATH_DIR_DEV__/pts/[0-9]* rw,
  __INSTALLER_PATH_DIR_DEV__/fuse rw,
  __INSTALLER_PATH_DIR_PROC__/filesystems r,
  owner @{PROC}/[0-9]*/{mountinfo,mounts,cgroup,stat,status} r,
  owner @{PROC}/[0-9]*/task/[0-9]*/comm rw,
  __INSTALLER_PATH_DIR_SYS__/devices/virtual/dmi/id/{bios_vendor,board_vendor} r,
  owner @{HOME}/.config/freerdp/{,**} rwkl,
  owner @{HOME}/.local/share/freerdp/{,**} rwkl,
  owner @{HOME}/.cache/freerdp/{,**} rwkl,
  owner __INSTALLER_PATH_DIR_TMP__/com.freerdp.client.cliprdr.[0-9]*/{,**} rwkl,
  # libfuse first tries an unprivileged mount, then the setuid package helper.
  # Do not grant sys_admin to the network client merely to satisfy that probe.
  deny mount fstype=fuse __INSTALLER_PATH_DIR_DEV__/fuse -> __INSTALLER_PATH_DIR_TMP__/com.freerdp.client.cliprdr.[0-9]*/,
  __INSTALLER_PATH_DIR_USR__/bin/fusermount3 rCx -> clipboard-fuse,
  __INSTALLER_PATH_DIR_USR__/bin/umount rCx -> clipboard-fuse,
  __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/labwc-freerdp-askpass rPx -> labwc-freerdp-askpass,
  /{,usr/}bin/{sh,dash} rix,
  signal (send, receive) peer=freerdp-client//clipboard-fuse,
  profile clipboard-fuse flags=(attach_disconnected) {
    #include <abstractions/base>
    include if exists <abstractions/nameservice-strict>
    capability sys_admin,
    capability dac_override,
    capability dac_read_search,
    capability setuid,
    __INSTALLER_PATH_DIR_USR__/bin/{fusermount3,umount} rix,
    __INSTALLER_PATH_DIR_DEV__/fuse rw,
    __INSTALLER_PATH_DIR_ETC__/{fuse.conf,mtab} r,
    __INSTALLER_PATH_DIR_PROC__/filesystems r,
    owner @{PROC}/[0-9]*/{mountinfo,mounts,status} r,
    __INSTALLER_PATH_DIR_RUN__/mount/{utab,utab.lock,utab.act,utab.event} rwk,
    owner __INSTALLER_PATH_DIR_TMP__/com.freerdp.client.cliprdr.[0-9]*/{,**} rwkl,
    mount fstype=fuse options=(rw,nosuid,nodev) __INSTALLER_PATH_DIR_DEV__/fuse -> __INSTALLER_PATH_DIR_TMP__/com.freerdp.client.cliprdr.[0-9]*/,
    umount __INSTALLER_PATH_DIR_TMP__/com.freerdp.client.cliprdr.[0-9]*/,
    signal (send, receive) peer=freerdp-client,
  }
  include if exists <local/freerdp-client>
}
