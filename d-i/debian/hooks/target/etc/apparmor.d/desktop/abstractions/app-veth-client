__INSTALLER_PATH_DIR_PYTHON3_SITE_PACKAGES__/app_veth_policy.py r,
__INSTALLER_PATH_DIR_ETC__/app-veth.json r,
__INSTALLER_PATH_DIR_PYTHON3_SITE_PACKAGES__/labwc_managed_app/ r,
__INSTALLER_PATH_DIR_PYTHON3_SITE_PACKAGES__/labwc_managed_app/__init__.py r,
__INSTALLER_PATH_DIR_PYTHON3_SITE_PACKAGES__/labwc_managed_app/network_client.py r,
__INSTALLER_PATH_DIR_PYTHON3_SITE_PACKAGES__/labwc_managed_app/events.py r,
