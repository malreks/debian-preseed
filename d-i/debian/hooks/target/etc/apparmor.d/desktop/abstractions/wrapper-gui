# Managed by unattended-installer.
#
# Toolkit resources for the few repository-owned wrappers that render their
# own GTK window instead of transitioning into a separate GUI application.

#include <abstractions/wrapper-wayland>
#include <abstractions/desktop-graphics>
include if exists <abstractions/dbus-session-strict>

__INSTALLER_PATH_DIR_ETC__/dconf/ r,
__INSTALLER_PATH_DIR_ETC__/dconf/** r,
__INSTALLER_PATH_DIR_ETC__/fonts/ r,
__INSTALLER_PATH_DIR_ETC__/fonts/** r,
__INSTALLER_PATH_DIR_ETC__/gtk-{3,4}.0/ r,
__INSTALLER_PATH_DIR_ETC__/gtk-{3,4}.0/** r,
__INSTALLER_PATH_DIR_ETC__/xdg/gtk-3.0/settings.ini r,

__INSTALLER_PATH_DIR_USR_LOCAL_SHARE__/fonts/ r,
__INSTALLER_PATH_DIR_USR_LOCAL_SHARE__/fonts/** r,
__INSTALLER_PATH_DIR_USR_LOCAL_SHARE__/icons/ r,
__INSTALLER_PATH_DIR_USR_LOCAL_SHARE__/icons/** r,
__INSTALLER_PATH_DIR_USR_SHARE__/fontconfig/conf.avail/ r,
__INSTALLER_PATH_DIR_USR_SHARE__/fontconfig/conf.avail/** r,
__INSTALLER_PATH_DIR_USR_SHARE__/fonts/ r,
__INSTALLER_PATH_DIR_USR_SHARE__/fonts/** r,
__INSTALLER_PATH_DIR_USR_SHARE_GLIB_SCHEMAS__/gschemas.compiled r,
__INSTALLER_PATH_DIR_USR_SHARE__/gtk-{3,4}.0/ r,
__INSTALLER_PATH_DIR_USR_SHARE__/gtk-{3,4}.0/** r,
__INSTALLER_PATH_DIR_USR_SHARE__/icons/ r,
__INSTALLER_PATH_DIR_USR_SHARE__/icons/** r,
__INSTALLER_PATH_DIR_USR_SHARE_PIXMAPS__/ r,
