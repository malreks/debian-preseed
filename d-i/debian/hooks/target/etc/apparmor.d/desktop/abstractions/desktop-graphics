# Managed by unattended-installer.
#
# Shared hardware-accelerated desktop graphics access for repository-managed
# applications and the small set of wrappers that render their own GUI.
# Primary DRM card nodes permit read-only driver discovery; clients render
# through unprivileged render nodes. NVIDIA's common driver interface is available to
# confined graphics and CUDA workloads; selected NVIDIA hardware adds only
# module-parameter reads through local/desktop-graphics.

#include <abstractions/dri-enumerate>
#include <abstractions/nvidia>

network netlink dgram,
network netlink raw,

# Mesa and vendor libraries inspect these interfaces while selecting a render
# device and constructing the GL/EGL driver stack.
@{PROC}__INSTALLER_PATH_DIR_SYS__/dev/i915/perf_stream_paranoid r,
@{PROC}/driver/nvidia/ r,
@{PROC}/driver/nvidia/** r,
@{sys}/devices/pci[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]/**/{revision,config} r,
@{sys}/devices/pci[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]/**/{irq,resource} r,
@{sys}/devices/pci[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]/ r,
@{sys}/devices/pci[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]/**/ r,
@{sys}/bus/ r,
@{sys}/bus/*/devices/ r,
@{sys}/bus/pci/devices/ r,
@{sys}/bus/usb/devices/ r,
@{sys}/class/ r,
@{sys}/class/*/ r,
@{sys}/devices/**/drm/ r,
@{sys}/devices/**/{bConfigurationValue,busnum,class,descriptors,device,devnum,manufacturer,numa_node,product,serial,subsystem_device,subsystem_vendor,uevent,vendor} r,
@{sys}/devices/system/cpu/{online,possible} r,
@{sys}/devices/system/cpu/{kernel_max,present} r,
@{sys}/devices/system/cpu/cpufreq/policy[0-9]*/cpuinfo_max_freq r,
@{sys}/devices/system/cpu/cpufreq/policy[0-9]*/scaling_cur_freq r,
@{sys}/devices/system/cpu/cpufreq/policy[0-9]*/scaling_max_freq r,
@{sys}/devices/system/cpu/cpu[0-9]*/cache/index[0-9]*/{id,level} r,
@{sys}/devices/system/cpu/cpu[0-9]*/cache/index[0-9]*/size r,
@{sys}/devices/system/cpu/cpu[0-9]*/cpu_capacity r,
@{sys}/devices/system/cpu/cpu[0-9]*/microcode/version r,
@{sys}/devices/system/cpu/cpu[0-9]*/topology/{core_cpus,physical_package_id} r,
@{sys}/devices/system/memory/block_size_bytes r,
@{sys}/devices/system/node/ r,
@{sys}/devices/system/node/node[0-9]*/cpumap r,
@{sys}/devices/virtual/dmi/id/{product_name,product_sku,sys_vendor} r,
@{sys}/devices/virtual/tty/tty[0-9]*/active r,
# Unprivileged DRM render nodes are sufficient for normal Wayland clients.
__INSTALLER_PATH_DIR_DEV__/dri/ r,
# GLVND/libdrm enumerate primary-node metadata as well as render nodes.
# KMS writes remain compositor-owned; native clients need read-only discovery.
__INSTALLER_PATH_DIR_DEV__/dri/card[0-9]* r,
__INSTALLER_PATH_DIR_DEV__/dri/renderD[0-9] rw,
__INSTALLER_PATH_DIR_DEV__/dri/renderD[0-9][0-9] rw,
__INSTALLER_PATH_DIR_DEV__/dri/renderD[0-9][0-9][0-9] rw,
__INSTALLER_PATH_DIR_DEV__/dri/by-path/ r,
__INSTALLER_PATH_DIR_DEV__/dri/by-path/pci-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F].[0-7]-render r,
__INSTALLER_PATH_DIR_DEV__/nvidia[0-9]* rw,
__INSTALLER_PATH_DIR_DEV__/nvidia-caps/ r,
__INSTALLER_PATH_DIR_DEV__/nvidia-caps/** rw,
__INSTALLER_PATH_DIR_DEV__/nvidia-modeset rw,
__INSTALLER_PATH_DIR_DEV__/nvidia-uvm rw,
__INSTALLER_PATH_DIR_DEV__/nvidia-uvm-tools rw,
__INSTALLER_PATH_DIR_DEV__/nvidiactl rw,
__INSTALLER_PATH_DIR_DEV__/char/ r,
__INSTALLER_PATH_DIR_DEV__/char/195:* rw,
__INSTALLER_PATH_DIR_DEV__/char/226:* rw,
__INSTALLER_PATH_DIR_DEV__/char/5[0-9][0-9]:* rw,
__INSTALLER_PATH_DIR_DEV__/char/511:* rw,
# Device-node compatibility links are udev/root state. Desktop clients may use
# existing links but must never create or replace entries for dynamic majors.
deny __INSTALLER_PATH_DIR_DEV__/char/*:* l,
__INSTALLER_PATH_DIR_DEV__/udmabuf rw,

# Read-only libudev records used to enumerate DRM devices.
@{sys}/class/drm/{,**} r,
@{sys}/dev/char/{,**} r,
@{sys}/devices/** r,
__INSTALLER_PATH_DIR_RUN__/udev/data/{,**} r,
__INSTALLER_PATH_DIR_RUN__/udev/data/c195:* r,
__INSTALLER_PATH_DIR_RUN__/udev/data/c226:[0-9] r,
__INSTALLER_PATH_DIR_RUN__/udev/data/c226:[0-9][0-9] r,
__INSTALLER_PATH_DIR_RUN__/udev/data/c226:[0-9][0-9][0-9] r,
__INSTALLER_PATH_DIR_RUN__/udev/data/+drm:card[0-9]* r,

# GL, GLES, EGL, GBM, DRI, VA-API, and vendor-selection assets.
__INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/dri/ r,
__INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/dri/*.so mr,
__INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/lib{EGL,GL,GLESv1_CM,GLESv2,GLX,OpenGL,gbm}.so* mr,
__INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/libvulkan.so* mr,
# Llama and Whisper releases may be rebuilt against any retained CUDA version.
# Keep this version-independent but narrower than the complete CUDA toolchain:
# only the runtime, cuBLAS, and OpenCL libraries needed by the managed AI
# workloads are executable mappings.
__INSTALLER_PATH_DIR_USR_LOCAL__/cuda-*/targets/x86_64-linux/lib/lib{cublas,cublasLt,cudart}.so* mr,
__INSTALLER_PATH_DIR_USR_LOCAL__/cuda-*/targets/*/lib/libOpenCL.so* mr,
__INSTALLER_PATH_DIR_USR_SHARE__/libdrm/ r,
__INSTALLER_PATH_DIR_USR_SHARE__/libdrm/*.ids r,
__INSTALLER_PATH_DIR_ETC__/libva.conf r,
__INSTALLER_PATH_DIR_ETC__/drirc r,
__INSTALLER_PATH_DIR_USR_SHARE__/drirc.d/ r,
__INSTALLER_PATH_DIR_USR_SHARE__/drirc.d/*.conf r,
__INSTALLER_PATH_DIR_ETC__/glvnd/egl_vendor.d/ r,
__INSTALLER_PATH_DIR_ETC__/glvnd/egl_vendor.d/*.json r,
__INSTALLER_PATH_DIR_USR_SHARE__/glvnd/egl_vendor.d/ r,
__INSTALLER_PATH_DIR_USR_SHARE__/glvnd/egl_vendor.d/*.json r,
__INSTALLER_PATH_DIR_USR_SHARE__/egl/egl_external_platform.d/ r,
__INSTALLER_PATH_DIR_USR_SHARE__/egl/egl_external_platform.d/*.json r,
# Vulkan ICD/layer discovery is read-only, not privileged device access.
/{etc,usr/share}/vulkan/ r,
/{etc,usr/share}/vulkan/** r,
__INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/libvulkan_*.so mr,
__INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/libVkLayer_*.so mr,
owner @{HOME}/.libva r,
owner @{HOME}/.drirc r,

# Shared vendor shader caches prevent every confined GUI process from
# recompiling the same shaders and eliminate repeated cache denials.
owner @{HOME}/.cache/mesa_shader_cache/ rw,
owner @{HOME}/.cache/mesa_shader_cache/** rwkl,
owner @{HOME}/.cache/mesa_shader_cache_db/ rw,
owner @{HOME}/.cache/mesa_shader_cache_db/** rwkl,
owner @{HOME}/.cache/nvidia/ rw,
owner @{HOME}/.cache/nvidia/** rwkl,
owner @{HOME}/.nv/ rw,
owner @{HOME}/.nv/** rwkl,

include if exists <local/desktop-graphics>

# Mesa has both single-file and multi-file cache backends.
owner @{HOME}/.cache/mesa_shader_cache_sf/ rw,
owner @{HOME}/.cache/mesa_shader_cache_sf/** rwkl,
