# Managed by unattended-installer.
#
# Bubblewrap namespace-construction mechanics shared by caller-specific child
# profiles. Application trees, user data, runtime sockets, network access, and
# payload transitions must remain in the including profile.

userns,

capability chown,
capability dac_override,
capability setgid,
capability setpcap,
capability setuid,
capability sys_admin,
capability sys_chroot,
# Rootless namespace setup: loopback configuration and __INSTALLER_PATH_DIR_PROC__/PID/ns reads.
# The masked application exec explicitly drops ALL kernel capabilities.
capability net_admin,
capability sys_ptrace,

mount,
umount,
pivot_root,

network netlink dgram,
network netlink raw,
ptrace (read, trace) peer=@{profile_name},
signal (send, receive) peer=@{profile_name},

# Bubblewrap inventories the source root while constructing dynamic bind trees.
/ r,
@{PROC}/ r,
# Bubblewrap creates this mountpoint inside its private mount namespace before
# mounting procfs. Payload policy remains in the including child profile.
__INSTALLER_PATH_DIR_PROC__/ w,
@{PROC}/filesystems r,
@{PROC}__INSTALLER_PATH_DIR_SYS__/kernel/osrelease r,
@{PROC}__INSTALLER_PATH_DIR_SYS__/kernel/overflowgid r,
@{PROC}__INSTALLER_PATH_DIR_SYS__/kernel/overflowuid r,
@{PROC}__INSTALLER_PATH_DIR_SYS__/user/max_user_namespaces r,
owner @{PROC}/@{pid}/ r,
owner @{PROC}/@{pid}/fd/ r,
owner @{PROC}/@{pid}/fd/[0-9]* rw,
owner @{PROC}/[0-9]*/ r,
owner @{PROC}/[0-9]*/{gid_map,setgroups,uid_map} rw,
@{PROC}/[0-9]*/cgroup r,
@{PROC}/[0-9]*/mountinfo r,
@{PROC}/[0-9]*/ns/ r,
@{PROC}/[0-9]*/ns/{mnt,user} r,

__INSTALLER_PATH_DIR_DEV__/ r,
__INSTALLER_PATH_DIR_DEV__/{full,null,ptmx,random,tty,urandom,zero} rw,
__INSTALLER_PATH_DIR_DEV__/pts/ r,
__INSTALLER_PATH_DIR_DEV__/pts/[0-9]* rw,
/bindfile* rw,
/oldroot/ rw,
/oldroot/** rwkl,
/newroot/ rw,
/newroot/** rwkl,
__INSTALLER_PATH_DIR_TMP__/ r,
__INSTALLER_PATH_DIR_TMP__/newroot/ rw,
__INSTALLER_PATH_DIR_TMP__/newroot/** rwkl,
__INSTALLER_PATH_DIR_TMP__/oldroot/ rw,
__INSTALLER_PATH_DIR_TMP__/oldroot/** rwkl,
__INSTALLER_PATH_DIR_USR__/bin/bwrap mr,
