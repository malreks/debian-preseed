# Managed by unattended-installer.
#
# Debian's abstractions/audio includes abstractions/audio.d from inside each
# consuming profile. Deny rules take precedence over the package abstraction's
# legacy ALSA grants, so vendor profiles remain limited to session audio IPC.

deny __INSTALLER_PATH_DIR_DEV__/snd/ r,
deny __INSTALLER_PATH_DIR_DEV__/snd/** rwklm,
deny __INSTALLER_PATH_DIR_DEV__/sound/ r,
deny __INSTALLER_PATH_DIR_DEV__/sound/** rwklm,
deny __INSTALLER_PATH_DIR_DEV__/{admmidi,adsp,aload,amidi,audio,dmfm,dmmidi,dsp,midi,mixer,mpu401data,mpu401stat,patmgr,phone,radio,rmidi,sequencer,smpte}* rwklm,
