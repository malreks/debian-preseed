# Managed by unattended-installer.

abi "__INSTALLER_PATH_DIR_USR_SHARE__/apparmor-features/features",

#include <tunables/global>

profile avahi-daemon __INSTALLER_PATH_DIR_USR__/sbin/avahi-daemon flags=(attach_disconnected, complain) {
  #include <abstractions/base>
  include if exists <abstractions/dbus>
  include if exists <abstractions/mdns>
  include if exists <abstractions/nameservice>

  capability chown,
  capability net_admin,
  capability net_bind_service,
  capability setgid,
  capability setuid,
  capability sys_chroot,

  __INSTALLER_PATH_DIR_USR__/sbin/avahi-daemon mr,
  __INSTALLER_PATH_DIR_USR__/lib/avahi/** mr,
  __INSTALLER_PATH_DIR_USR_SHARE__/avahi/** r,
  __INSTALLER_PATH_DIR_ETC__/avahi/** r,
  __INSTALLER_PATH_DIR_ETC__/nsswitch.conf r,
  __INSTALLER_PATH_DIR_ETC__/hosts r,
  __INSTALLER_PATH_DIR_ETC__/resolv.conf r,

  __INSTALLER_PATH_DIR_RUN__/avahi-daemon/** rwk,
  __INSTALLER_PATH_DIR_VAR__/run/avahi-daemon/** rwk,
  __INSTALLER_PATH_DIR_VAR_LIB__/avahi-autoipd/** rwk,
  __INSTALLER_PATH_DIR_TMP__/** rwk,

  include if exists <local/usr.sbin.avahi-daemon>
}
