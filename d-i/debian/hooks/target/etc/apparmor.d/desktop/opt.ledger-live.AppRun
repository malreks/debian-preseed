# Managed by unattended-installer.

abi "__INSTALLER_PATH_DIR_USR_SHARE__/apparmor-features/features",

#include <tunables/global>

profile ledger-live __INSTALLER_PATH_DIR_OPT__/ledger-live/AppRun flags=(attach_disconnected) {
  #include <abstractions/electron-application>
  # Transaction report exports to the managed document/save-dialog roots.
  #include <abstractions/user-documents>
  #include <abstractions/pipewire-audio>
  include if exists <abstractions/user-tmp>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  __INSTALLER_PATH_DIR_DEV__/bus/usb/** rw,
  __INSTALLER_PATH_DIR_DEV__/hidraw* rw,
  __INSTALLER_PATH_DIR_DEV__/tty rw,

  @{sys}/devices/**/report_descriptor r,
  __INSTALLER_PATH_DIR_OPT__/ledger-live/ r,
  __INSTALLER_PATH_DIR_OPT__/ledger-live/** mrix,

  owner "@{HOME}/.cache/Ledger Live/" rw,
  owner "@{HOME}/.cache/Ledger Live/**" rwk,
  owner "@{HOME}/.config/Ledger Live/" rw,
  owner "@{HOME}/.config/Ledger Live/**" rwkl,
  owner "@{HOME}/.config/Ledger Wallet/" rw,
  owner "@{HOME}/.config/Ledger Wallet/**" rwkl,
  owner @{HOME}/.config/ledger-live-desktop/ rw,
  owner @{HOME}/.config/ledger-live-desktop/** rwkl,
  owner "@{HOME}/.local/share/Ledger Live/" rw,
  owner "@{HOME}/.local/share/Ledger Live/**" rwkl,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/ rw,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** rwkl,

  include if exists <local/opt.ledger-live.AppRun>
}
