abi "__INSTALLER_PATH_DIR_USR_SHARE__/apparmor-features/features",
#include <tunables/global>

# A named profile per account, selected by the system service. The CLI and
# fixed native helpers inherit it; none gets a shell, manager, bus or namespace delegate.
profile filen-sync-__ACCOUNT__ flags=(attach_disconnected) {
  #include <abstractions/wrapper-perl>
  #include <abstractions/nameservice-strict>
  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/filen-sync r,
  __INSTALLER_PATH_DIR_PERL5_SITE_PERL__/filen/{,**} r,
  __INSTALLER_PATH_DIR_PERL5_SITE_PERL__/runtime/Managed/{,Process.pm} r,
  __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/filen mrix,
  __INSTALLER_PATH_DIR_USR__/bin/oathtool mrix,
  # @parcel/watcher's pinned detect-libc first runs this ELF utility. Its
  # successful glibc probe avoids the shell-script ldd fallback entirely.
  __INSTALLER_PATH_DIR_USR__/bin/getconf rix,
  # The runtime also reads ldd as data; it must not execute its shell script.
  __INSTALLER_PATH_DIR_USR__/bin/ldd r,
  / r,
  __INSTALLER_PATH_DIR_USR__/{lib,sbin}/ r,
  # Resolve the private state directory through its public ancestors.
  __INSTALLER_PATH_DIR_VAR__/{,lib/} r,
  __INSTALLER_PATH_DIR_ETC__/ r,
  __INSTALLER_PATH_DIR_ETC__/filen/ r,
  __INSTALLER_PATH_DIR_ETC__/filen/__ACCOUNT__{,.sync}.json r,
  __INSTALLER_PATH_DIR_RUN__/credentials/filen-sync@__ACCOUNT__.service/{,email,password,seed} r,
  __INSTALLER_PATH_DIR_RUN__/systemd/timesync/synchronized r,
  __INSTALLER_PATH_DIR_VAR_LIB__/filen-__ACCOUNT__/{,**} rwkl,
  __SHARING_ROOT__/filen-__ACCOUNT__/{,**} rwkl,
  __INSTALLER_PATH_DIR_ETC__/ssl/{,**} r,
  __INSTALLER_PATH_DIR_ETC__/{os-release,localtime} r,
  __INSTALLER_PATH_DIR_USR__/lib/os-release r,
  __INSTALLER_PATH_DIR_TMP__/{,**} rwkl,
  owner @{PROC}/@{pid}/{stat,statm,status,fd/,fd/[0-9]*,task/,task/**} r,
  owner @{PROC}/@{pid}/{maps,exe} r,
  # Bun reads only this account's service memory limits. The slice name
  # contains a literal systemd escape, hence the doubled AppArmor backslash.
  @{sys}/fs/cgroup/system.slice/system-filen\\x2dsync.slice/filen-sync@__ACCOUNT__.service/memory.{high,max} r,
  # The pinned Bun release may mmap its bundled native modules from private tmp.
  __INSTALLER_PATH_DIR_TMP__/**.node mr,
  __INSTALLER_PATH_DIR_VAR_LIB__/filen-__ACCOUNT__/**.node mr,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  signal (send, receive) peer=filen-sync-__ACCOUNT__,
  signal (receive) set=(term,kill,int,hup) peer=unconfined,
  deny /{,usr/}bin/{sh,bash,dash} x,
  include if exists <local/filen-sync-__ACCOUNT__>
}
