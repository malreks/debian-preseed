# Managed by unattended-installer.

abi "__INSTALLER_PATH_DIR_USR_SHARE__/apparmor-features/features",

#include <tunables/global>

profile aa-status-reader __INSTALLER_PATH_DIR_USR__/{bin,sbin}/aa-status flags=(attach_disconnected) {
  #include <abstractions/wrapper-base>

  __INSTALLER_PATH_DIR_USR__/{bin,sbin}/aa-status mr,
  __INSTALLER_PATH_DIR_DEV__/pts/[0-9]* r,
  @{PROC}/ r,
  @{PROC}/[0-9]*/mounts r,
  @{PROC}/[0-9]*/attr/apparmor/ r,
  @{PROC}/[0-9]*/attr/apparmor/current r,
  @{sys}/kernel/security/apparmor/ r,
  @{sys}/kernel/security/apparmor/profiles r,
  @{sys}/module/apparmor/ r,
  @{sys}/module/apparmor/parameters/enabled r,
  __INSTALLER_PATH_DIR_VAR_LIB__/installer-state/logs/firstboot/data/ r,
  # aa-status writes its inherited output descriptor.  Keep this exact
  # artifact and its bounded atomic-write siblings writable without granting
  # reads, locking, or access to other first-boot data.
  __INSTALLER_PATH_DIR_VAR_LIB__/installer-state/logs/firstboot/data/apparmor-status.json w,
  __INSTALLER_PATH_DIR_VAR_LIB__/installer-state/logs/firstboot/data/apparmor-status.json.* w,
  capability sys_ptrace,
  ptrace (read),

  include if exists <local/usr.sbin.aa-status>
}
