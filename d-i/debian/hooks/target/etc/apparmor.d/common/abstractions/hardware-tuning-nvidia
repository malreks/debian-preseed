# Included ONLY when NVIDIA tuning passes flag, selected-class, and PCI gates.
__INSTALLER_PATH_DIR_HARDWARE_TUNING__/nvidia.py r,
__INSTALLER_PATH_DIR_ETC__/hardware-tuning/nvidia.json r,
__INSTALLER_PATH_DIR_RUN__/hardware-tuning/nvidia.{json,lock} rwk,
__INSTALLER_PATH_DIR_RUN__/hardware-tuning/.nvidia.json.tuning-* rw,
# NVML power/clock setters require host administrator capability; the socket
# broker deliberately does NOT have this AppArmor capability permission.
capability sys_admin,
# Fixed, argument-validated nvidia-smi is the clock fallback for drivers that
# do not expose the corresponding NVML symbols. No shell or arbitrary child
# executable is permitted by this include.
__INSTALLER_PATH_DIR_USR__/bin/nvidia-smi rix,
# Debian/Pika alternatives resolve the fixed command to this package binary.
__INSTALLER_PATH_DIR_USR_LIB__/nvidia/current/nvidia-smi rix,
__INSTALLER_PATH_DIR_DEV__/nvidiactl rw,
__INSTALLER_PATH_DIR_DEV__/nvidia[0-9]* rw,
__INSTALLER_PATH_DIR_DEV__/nvidia-uvm rw,
__INSTALLER_PATH_DIR_DEV__/nvidia-caps/ rw,
__INSTALLER_PATH_DIR_DEV__/nvidia-caps/nvidia-cap[0-9]* rw,
# Dynamic majors are validated by a separate root preparation service. Only
# the hardware worker consumes its exact numeric grants, never the broker.
include if exists "__INSTALLER_PATH_DIR_RUN__/hardware-tuning-policy/nvidia-char"
__INSTALLER_PATH_DIR_RUN__/hardware-tuning-policy/nvidia.json r,
__INSTALLER_PATH_DIR_RUN__/hardware-tuning-policy/nvidia-char r,
__INSTALLER_PATH_DIR_RUN__/hardware-tuning-policy/{nvidia-char.before,nvidia.json.before} r,
__INSTALLER_PATH_DIR_HARDWARE_TUNING__/nvidia_devices.py r,
__INSTALLER_PATH_DIR_DEV__/ r,
__INSTALLER_PATH_DIR_DEV__/char/ r,
__INSTALLER_PATH_DIR_PROC__/driver/nvidia/ r,
__INSTALLER_PATH_DIR_PROC__/driver/nvidia/** r,
__INSTALLER_PATH_DIR_PROC__/{devices,modules,meminfo} r,
__INSTALLER_PATH_DIR_PROC__/sys/vm/mmap_min_addr r,
# The kernel restricts thread-name writes to the calling thread group.
owner __INSTALLER_PATH_DIR_PROC__/@{pid}/task/@{tid}/comm rw,
__INSTALLER_PATH_DIR_SYS__/ r,
__INSTALLER_PATH_DIR_SYS__/** r,
# No X11, Coolbits, raw MSRs, GPU reset, or firmware/sysfs writes.
