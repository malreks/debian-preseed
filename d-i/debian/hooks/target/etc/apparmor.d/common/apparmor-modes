#include <tunables/global>

# Shared mode writer; identical confinement on desktops and servers.
profile apparmor-modes __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/apparmor-modes-run flags=(attach_disconnected) {
  __INSTALLER_PATH_DIR_PERL5_SITE_PERL__/runtime/{,Managed/,Managed/PolicyLock.pm} r,
  __INSTALLER_PATH_DIR_VAR_LIB__/labwc-apparmor-policy/ rw,
  __INSTALLER_PATH_DIR_VAR_LIB__/labwc-apparmor-policy/policy.lock rwk,
  #include <abstractions/wrapper-terminal>
  #include <abstractions/wrapper-base>
  #include <abstractions/wrapper-perl>

  __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/apparmor-modes-run rix,
  __INSTALLER_PATH_DIR_PERL5_SITE_PERL__/apparmor-modes/ r,
  __INSTALLER_PATH_DIR_PERL5_SITE_PERL__/apparmor-modes/** r,
  __INSTALLER_PATH_DIR_DEV__/log w,
  __INSTALLER_PATH_DIR_USR__/sbin/{aa-audit,aa-complain,aa-enforce,apparmor_parser} PUx,
  __INSTALLER_PATH_DIR_ETC__/apparmor/modes.conf r,
  __INSTALLER_PATH_DIR_APPARMOR__/ rw,
  __INSTALLER_PATH_DIR_APPARMOR__/** rwkl,
  __INSTALLER_PATH_DIR_SYS__/kernel/security/apparmor/profiles r,
  __INSTALLER_PATH_DIR_TMP__/apparmor-loaded-profiles.* rw,
  __INSTALLER_PATH_DIR_TMP__/apparmor-modes.* rw,
  __INSTALLER_PATH_DIR_TMP__/apparmor-unload.* rw,
  __INSTALLER_PATH_DIR_TMP__/apparmor-profile-mode.*/ rw,
  __INSTALLER_PATH_DIR_TMP__/apparmor-profile-mode.*/** rwkl,
  __INSTALLER_PATH_DIR_TMP__/apparmor-profile-names.* rw,
  __INSTALLER_PATH_DIR_TMP__/apparmor-profile-names.*/ rw,
  __INSTALLER_PATH_DIR_TMP__/apparmor-profile-names.*/** rwkl,
  __INSTALLER_PATH_DIR_TMP__/apparmor-local-child.* rw,
  __INSTALLER_PATH_DIR_VAR_LIB__/installer-state/logs/firstboot/data/validation-results.txt a,

  include if exists <local/usr.local.libexec.apparmor-modes-run>
}
