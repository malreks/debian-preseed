# Socket transport owns ordinary system messages. Authentication alone uses
# the structured journal's saved trusted credentials/executable, avoiding the
# later /proc lookup race for short-lived PAM/sudo senders. Its private cursor
# permits catch-up after collector downtime. Auth socket copies are discarded
# by 20-auth; all other journal copies stop here, before the shared routes.
# Forwarding starts only after rsyslog is ready and stops before an orderly
# collector stop; early boot records remain in the journal without replay.
# Private application inputs write only their file sinks, at every severity.
# They never send records back to journald.

global(maxMessageSize="__INSTALLER_LOG_RSYSLOG_MESSAGE_KIB__k"
       compatibility.defaults.secure="strict")
$WorkDirectory __INSTALLER_LOG_RSYSLOG_SPOOL_DIR__
module(load="imuxsock" SysSock.Use="on" SysSock.IgnoreOwnMessages="on"
       SysSock.Annotate="on" SysSock.ParseTrusted="on"
       SysSock.UsePIDFromSystem="on" SysSock.FlowControl="off"
       SysSock.RateLimit.Interval="__INSTALLER_LOG_SYSLOG_RATE_INTERVAL__"
       SysSock.RateLimit.Burst="__INSTALLER_LOG_SYSLOG_RATE_BURST__"
       SysSock.RateLimit.Severity="5")
# journald ReadKMsg=no: imklog remains the single managed kernel-log input.
module(load="imklog")
module(load="imjournal" StateFile="__INSTALLER_LOG_RSYSLOG_SPOOL_DIR__/auth-journal.state"
       FileCreateMode="0600" PersistStateInterval="64" IgnorePreviousMessages="off"
       IgnoreNonValidStatefile="off" Ratelimit.Interval="0" UsePid="system")
if ($inputname == "imjournal" and
    $syslogfacility-text != "auth" and $syslogfacility-text != "authpriv") then {
  stop
}
$FileOwner __INSTALLER_LOG_OWNER__
$FileGroup __INSTALLER_LOG_GROUP__
$FileCreateMode __INSTALLER_LOG_FILE_MODE__
$DirOwner __INSTALLER_LOG_OWNER__
$DirGroup __INSTALLER_LOG_GROUP__
$DirCreateMode __INSTALLER_LOG_DIRECTORY_MODE__
$Umask 0027
$ActionFileDefaultTemplate RSYSLOG_TraditionalFileFormat
$RepeatedMsgReduction off
# Bound in-memory dispatch independently of the disk-assisted output queues.
main_queue(queue.size="__INSTALLER_LOG_RSYSLOG_MAIN_QUEUE_MESSAGES__" queue.workerThreads="1")

# Private socket rulesets stay separate. Dedicated security routes run
# before constant-path fallbacks; journal-origin user records stop in 21-apps
# without being duplicated into the private application file sink.
# 99-discard stops the remaining classified records. Do not restore parallel __INSTALLER_PATH_DIR_VAR_LOG__/syslog/facility copies here.
include(file="__INSTALLER_PATH_DIR_ETC__/rsyslog.d/*.conf" mode="abort-if-missing")
