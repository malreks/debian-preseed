[Unit]
After=labwc-compositor.service labwc-session.target
Description=Capture a Whisper voice recording through PipeWire
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_TYPE=wayland
Requisite=labwc-session.target
PartOf=labwc-session.target

[Service]
Type=exec
Environment=PATH=__INSTALLER_PATH_DIR_USR_LOCAL_BIN__:__INSTALLER_PATH_DIR_USR__/bin:/bin
SyslogIdentifier=whisper-record-toggle
StandardOutput=journal
StandardError=journal
ExecCondition=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-session-check session-ready
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/whisper-record-timed
ExecStopPost=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/whisper-record-toggle finalize-recording
Restart=no
# The worker has a 15s capture limit plus 5s graceful shutdown.
RuntimeMaxSec=25s
TimeoutStartSec=15s
TimeoutStopSec=15s
KillSignal=SIGINT
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

# This unit is intentionally not enabled: recording starts only from the
# explicit Labwc/Waybar toggle and is stopped when labwc-session.target stops.
