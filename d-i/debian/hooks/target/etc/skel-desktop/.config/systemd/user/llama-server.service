[Unit]
After=labwc-compositor.service labwc-session.target
Description=Managed on-demand Llama server for the Labwc session
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=XDG_SESSION_TYPE=wayland
ConditionFileIsExecutable=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-ai-llama-server
ConditionFileIsExecutable=__INSTALLER_PATH_DIR_DATA__/llama/lib/llama
ConditionFileIsExecutable=__INSTALLER_PATH_DIR_DATA__/llama/bin/llama-server
Requisite=labwc-session.target
PartOf=labwc-session.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
KillMode=control-group
Type=exec
Environment=PATH=__INSTALLER_PATH_DIR_USR_LOCAL_BIN__:__INSTALLER_PATH_DIR_USR__/bin:/bin
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=%t
SyslogIdentifier=llama-server
StandardOutput=journal
StandardError=journal
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-ai-llama-server
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
SendSIGKILL=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
