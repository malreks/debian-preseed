[Unit]
Description=Commit and publish the Obsidian vault to managed GitLab branches
ConditionEnvironment=LABWC_SESSION_OWNER=desktop
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_TYPE=wayland
ConditionPathIsDirectory=%h/__INSTALLER_OBSIDIAN_GIT_DIRECTORY__/.git
Requisite=labwc-session.target
After=labwc-session.target ssh-agent.socket
PartOf=labwc-session.target

[Service]
Type=oneshot
KillMode=control-group
UMask=0077
LimitCORE=0
Environment=HOME=%h
Environment=SSH_AUTH_SOCK=%t/openssh_agent
Environment=XDG_RUNTIME_DIR=%t
# The manager reads this host policy before entering the user mount namespace.
# Host root is unmapped there; never treat overflow UID 65534 as trusted root.
LoadCredential=automatic-git-policy:__INSTALLER_PATH_DIR_ETC__/obsidian-git-sync.conf
ExecCondition=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-online-check
ExecStart=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/obsidian-git-sync
TimeoutStartSec=15min
TimeoutStopSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/__INSTALLER_OBSIDIAN_GIT_DIRECTORY__
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
