[Unit]
# Session triggers start after D-Bus, not before the user manager basic target.
# Avoid the implicit paths.target/timers.target -> basic.target -> session cycle.
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
Description=Watch local health and security events for Labwc desktop notifications
Requisite=labwc-session.target
After=labwc-session.target
PartOf=labwc-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_TYPE=wayland
ConditionEnvironment=LABWC_SESSION_OWNER=desktop

[Path]
PathModified=__INSTALLER_PATH_DIR_VAR__/mail/%u
PathChanged=__INSTALLER_PATH_DIR_VAR_LIB__/labwc-notifications/timeshift
PathChanged=__INSTALLER_PATH_DIR_VAR_LIB__/labwc-notifications/unattended-upgrades
PathChanged=__INSTALLER_PATH_DIR_VAR_LIB__/labwc-notifications/system
PathModified=__INSTALLER_PATH_DIR_VAR_LIB__/labwc-notifications/security/auth.signal
PathModified=__INSTALLER_PATH_DIR_VAR_LIB__/labwc-notifications/security/usb.signal
PathModified=__INSTALLER_PATH_DIR_VAR_LIB__/labwc-notifications/security/storage.signal
PathModified=__INSTALLER_PATH_DIR_VAR_LIB__/labwc-notifications/security/apparmor.signal
PathModified=__INSTALLER_PATH_DIR_VAR_LIB__/labwc-notifications/security/firewall.signal
Unit=labwc-health-notify.service

[Install]
WantedBy=labwc-session.target
