# Ledger HW.1 and original Nano devices. Active-seat ACLs are the authority;
# do not depend on an optional plugdev group that may not be installed on a
# desktop without Android tooling.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2581", ATTR{idProduct}=="1b7c|2b7c|3b7c|4b7c", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="2581", ATTRS{idProduct}=="1b7c|2b7c|3b7c|4b7c", MODE="0660", TAG+="uaccess"

# Current Ledger devices, including Ledger Stax and firmware-update modes.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2c97", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="2c97", MODE="0660", TAG+="uaccess"
