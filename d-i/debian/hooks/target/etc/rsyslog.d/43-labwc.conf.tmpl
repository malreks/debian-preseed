# labwc-session-check emits one bounded compositor policy record through the
# local syslog socket. Keep it out of journald and the generic system sink.
if ($programname == "labwc-session-check") then {
  action(
    name="labwc_log"
    type="omfile"
    file="__INSTALLER_LOG_LABWC_FILE__"
    fileOwner="__INSTALLER_LOG_OWNER__"
    fileGroup="__INSTALLER_LOG_GROUP__"
    fileCreateMode="__INSTALLER_LOG_FILE_MODE__"
    dirOwner="__INSTALLER_LOG_OWNER__"
    dirGroup="__INSTALLER_LOG_GROUP__"
    dirCreateMode="__INSTALLER_LOG_DIRECTORY_MODE__"
    createDirs="off"
    template="RSYSLOG_TraditionalFileFormat"
    sync="off"
    action.resumeRetryCount="-1"
    action.resumeInterval="__INSTALLER_LOG_RSYSLOG_RESUME_SECONDS__"
    rotation.sizeLimit="__INSTALLER_LOG_RSYSLOG_ROTATE_BYTES__"
    rotation.sizeLimitCommand="__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/rsyslog-size-rotate"
    rotation.sizeLimitCommandPassFileName="on"
  )
  stop
}
