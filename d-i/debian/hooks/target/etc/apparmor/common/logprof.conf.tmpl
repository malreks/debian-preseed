[required_hats]
  ^.+/apache(|2|2-prefork)$ = DEFAULT_URI HANDLING_UNTRUSTED_INPUT
  ^.+/httpd(|2|2-prefork)$  = DEFAULT_URI HANDLING_UNTRUSTED_INPUT

[defaulthat]
  ^.+/apache(|2|2-prefork)$ = DEFAULT_URI
  ^.+/httpd(|2|2-prefork)$  = DEFAULT_URI

[globs]
  # /foo/bar/lib/libbaz.so -> /foo/bar/lib/lib*
  /lib/lib[^\/]+so[^\/]*$ = /lib/lib*so*

  # Strip kernel version numbers from kernel module accesses.
  ^/lib/modules/[^\/]+\/     = /lib/modules/*/
  ^__INSTALLER_PATH_DIR_USR__/lib/modules/[^\/]+\/ = __INSTALLER_PATH_DIR_USR__/lib/modules/*/

  # Strip PID numbers from procfs accesses.
  ^__INSTALLER_PATH_DIR_PROC__/\d+/ = __INSTALLER_PATH_DIR_PROC__/*/

  # Generalize local user home directories.
  ^__INSTALLER_PATH_DIR_HOME__/[^\/]+ = __INSTALLER_PATH_DIR_HOME__/*

  # Generalize Perl module paths across native and multiarch layouts.
  ^__INSTALLER_PATH_DIR_USR__/lib/perl5/.+$         = __INSTALLER_PATH_DIR_USR__/lib/perl5/**
  ^__INSTALLER_PATH_DIR_USR__/lib/[^\/]+/perl5?/.+$ = __INSTALLER_PATH_DIR_USR__/lib/@{multiarch}/perl{,5}/**

  # Locale and timezone data.
  ^__INSTALLER_PATH_DIR_USR__/lib/locale/.+$    = __INSTALLER_PATH_DIR_USR__/lib/locale/**
  ^__INSTALLER_PATH_DIR_USR_SHARE__/locale/.+$  = __INSTALLER_PATH_DIR_USR_SHARE__/locale/**
  ^__INSTALLER_PATH_DIR_USR_SHARE__/zoneinfo/.+$ = __INSTALLER_PATH_DIR_USR_SHARE__/zoneinfo/**

  # Font trees.
  /fonts/.+$ = /fonts/**

  # PAM and security configuration families.
  ^__INSTALLER_PATH_DIR_ETC__/security/_[^\/]+$           = __INSTALLER_PATH_DIR_ETC__/security/*
  ^/lib/security/pam_filter/[^\/]+$ = /lib/security/pam_filter/*
  ^/lib/security/pam_[^\/]+\.so$    = /lib/security/pam_*.so
  ^__INSTALLER_PATH_DIR_ETC__/pam.d/[^\/]+$               = __INSTALLER_PATH_DIR_ETC__/pam.d/*
  ^__INSTALLER_PATH_DIR_ETC__/profile.d/[^\/]+\.sh$       = __INSTALLER_PATH_DIR_ETC__/profile.d/*.sh
