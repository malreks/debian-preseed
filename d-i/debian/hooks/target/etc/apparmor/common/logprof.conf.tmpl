  __INSTALLER_PATH_DIR_USR__/sbin/aa-audit        = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-autodep      = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-cleanprof    = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-complain     = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-decode       = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-disable      = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-enforce      = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-genprof      = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-load         = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-logprof      = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-mergeprof    = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-remove-unknown = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-status       = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-teardown     = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-unconfined   = u
  __INSTALLER_PATH_DIR_USR__/sbin/aa-update-browser = u
  __INSTALLER_PATH_DIR_USR__/bin/aa-notify        = u
  __INSTALLER_PATH_DIR_USR__/sbin/apparmor_parser = u

  # These programs cannot function usefully if confined by a generated child
  # profile.
  /bin/mount                         = u
  __INSTALLER_PATH_DIR_USR__/bin/mount                     = u
  __INSTALLER_PATH_DIR_ETC__/init.d/subdomain              = u
  /sbin/cardmgr                      = u
  __INSTALLER_PATH_DIR_USR__/sbin/cardmgr                  = u
  /sbin/subdomain_parser             = u
