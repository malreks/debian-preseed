#
# Managed AppArmor profiling defaults. The dedicated rsyslog destination is
# first so aa-logprof and aa-genprof use the complete AppArmor event stream
# without scanning unrelated system messages.

[settings]
  profiledir = __INSTALLER_PATH_DIR_ETC__/apparmor.d __INSTALLER_PATH_DIR_ETC__/subdomain.d
  inactive_profiledir = __INSTALLER_PATH_DIR_USR_SHARE__/apparmor/extra-profiles
  logfiles = __INSTALLER_LOG_APPARMOR_FILE__ __INSTALLER_LOG_AUDIT_FILE__ __INSTALLER_PATH_DIR_VAR_LOG__/audit/audit.log __INSTALLER_PATH_DIR_VAR_LOG__/syslog __INSTALLER_PATH_DIR_VAR_LOG__/kern.log __INSTALLER_PATH_DIR_VAR_LOG__/messages

  parser = __INSTALLER_PATH_DIR_USR__/sbin/apparmor_parser /sbin/apparmor_parser /sbin/subdomain_parser
  logger = __INSTALLER_PATH_DIR_USR__/bin/logger /bin/logger

  # Customize how file ownership permissions are presented:
  # 0 - off
  # 1 - default to the mode reported by the log
  # 2 - force new permissions to owner rules
  # 3 - force every permission on the rule to be an owner rule
  default_owner_prompt = 1

  # Relative directories below __INSTALLER_PATH_DIR_ETC__/apparmor.d that may provide #include
  # candidates. Keep empty unless a repository-managed include catalog is
  # deliberately added.
  custom_includes =

  # When called with --json, write input/output diagnostics to
  # __INSTALLER_PATH_DIR_TMP__/aa-jsonlog-*. Leave disabled outside explicit debugging sessions.
  json_log = 0

[qualifiers]
  # Shells and AppArmor profiling/policy-management tools must not be suggested
  # for separate child confinement.
  /bin/bash                 = icnu
  __INSTALLER_PATH_DIR_USR__/bin/bash             = icnu
  /bin/ksh                  = icnu
  __INSTALLER_PATH_DIR_USR__/bin/ksh              = icnu
  /bin/dash                 = icnu
  __INSTALLER_PATH_DIR_USR__/bin/dash             = icnu
  /bin/zsh                  = icnu
  __INSTALLER_PATH_DIR_USR__/bin/zsh              = icnu
