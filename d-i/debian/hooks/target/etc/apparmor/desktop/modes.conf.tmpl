# Managed by unattended-installer.
#
# Format:
#   MODE PRESENCE PROFILE_FILE EXECUTABLE_PROBE
#
# This tracked modes.conf.tmpl is installed as
# __INSTALLER_PATH_DIR_ETC__/apparmor/modes.conf only after MODE has been rendered from
# __DESKTOP_APPARMOR_STATE__ to the selected enforce or complain value. The
# installed administrative action may later write enforce or complain for the
# desktop profiles. The hardware control plane always requires enforce. Full
# disablement is a separately confirmed next-boot setting, never a live unload.
# PRESENCE is required, optional, or if-executable.
# PROFILE_FILE is relative to __INSTALLER_PATH_DIR_ETC__/apparmor.d and must not contain slashes.
# EXECUTABLE_PROBE is "-" unless PRESENCE is if-executable.
#
# Repository-owned wrapper, control-plane, application, service, browser,
# container, and vendor profile sources use the managed policy below. During
# desktop target staging, DESKTOP_APPARMOR_STATE selects the MODE of desktop
# rows. The hardware control plane stays enforced even on a complain desktop:
# its broker, worker and policy helper refuse any other loaded mode. The
# privileged Fuzzel global action updates only the desktop rows.
#
# apparmor-modes reconciles only this declared profile policy. Kernel
# selection, kernel configuration, boot command-line flags, LSM ordering, and
# AppArmor feature availability are preconfigured by the installer and are not
# probed or revalidated by the mode helper.

# Repository-managed desktop wrapper and control-plane source.
__DESKTOP_APPARMOR_STATE__ required desktop-wrappers -
__DESKTOP_APPARMOR_STATE__ required apparmor-modes -
__DESKTOP_APPARMOR_STATE__ required network-sharing -
__DESKTOP_APPARMOR_STATE__ required labwc-network-sharing -
__DESKTOP_APPARMOR_STATE__ optional filen-sync-private -
__DESKTOP_APPARMOR_STATE__ optional filen-sync-offsec -
__DESKTOP_APPARMOR_STATE__ required zoom-discord-compat -
__DESKTOP_APPARMOR_STATE__ required labwc-appearance -
__DESKTOP_APPARMOR_STATE__ if-executable gitbuild __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/gitbuild
__DESKTOP_APPARMOR_STATE__ if-executable gitbuild-worker __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/gitbuild-worker
__DESKTOP_APPARMOR_STATE__ required compz -
__DESKTOP_APPARMOR_STATE__ required debugsys -
__DESKTOP_APPARMOR_STATE__ required document-applications -
__DESKTOP_APPARMOR_STATE__ required labwc-session -
__DESKTOP_APPARMOR_STATE__ required tomat -
__DESKTOP_APPARMOR_STATE__ required waybar-menus -
__DESKTOP_APPARMOR_STATE__ required calendars -
__DESKTOP_APPARMOR_STATE__ required desktop-utilities -

# Repository-managed system, storage, first-boot, Podman, and optional GitLab
# Runner wrapper policy. Optional sources are staged in later installer phases.
__DESKTOP_APPARMOR_STATE__ required system-wrappers -
__DESKTOP_APPARMOR_STATE__ required desktop-system-wrappers -
__DESKTOP_APPARMOR_STATE__ optional usr.local.sbin.tpm2-enroll.sh -
__DESKTOP_APPARMOR_STATE__ optional firstboot -
enforce optional hardware-tuning -
enforce optional incus-host -
enforce optional incus-desktop-ui -
enforce required app-veth -

# Repository-managed status reader used by the privileged security launcher.
__DESKTOP_APPARMOR_STATE__ required usr.sbin.aa-status -

# Repository-managed desktop application profiles.
__DESKTOP_APPARMOR_STATE__ required whisper-local-transcription -
