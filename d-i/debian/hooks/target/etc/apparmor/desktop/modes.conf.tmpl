__DESKTOP_APPARMOR_STATE__ if-executable usr.sbin.tailscaled __INSTALLER_PATH_DIR_USR__/sbin/tailscaled

# Package-owned desktop profiles selected by this repository. Their vendor
# attachment files are retained, least-privilege rules are supplied through
# local includes, and the mode helper removes unconfined/default-allow flags.
__DESKTOP_APPARMOR_STATE__ if-executable code __INSTALLER_PATH_DIR_USR__/bin/code
__DESKTOP_APPARMOR_STATE__ optional vscode -
__DESKTOP_APPARMOR_STATE__ if-executable chromium __INSTALLER_PATH_DIR_USR__/bin/chromium
# Optional legacy files may be include-only stubs without their own AppArmor
# labels. The mode helper detects that they have no independent label and skips
# a standalone enforce or complain transition.
# The distribution msedge conffile is disabled when the vendor profile is
# installed: both attach __INSTALLER_PATH_DIR_OPT__/microsoft/msedge/msedge. Never reconcile msedge
# into enforce/complain here, which would re-enable the duplicate attachment.
__DESKTOP_APPARMOR_STATE__ optional opt.microsoft.msedge.microsoft-edge -
__DESKTOP_APPARMOR_STATE__ if-executable microsoft-edge-stable __INSTALLER_PATH_DIR_USR__/bin/microsoft-edge-stable
__DESKTOP_APPARMOR_STATE__ if-executable mullvad-browser __INSTALLER_PATH_DIR_USR__/bin/mullvad-browser
__DESKTOP_APPARMOR_STATE__ if-executable tor-browser __INSTALLER_PATH_DIR_OPT_TOR_BROWSER__/Browser/firefox.real
__DESKTOP_APPARMOR_STATE__ if-executable vivaldi-stable __INSTALLER_PATH_DIR_USR__/bin/vivaldi-stable
__DESKTOP_APPARMOR_STATE__ if-executable vivaldi-bin __INSTALLER_PATH_DIR_USR__/bin/vivaldi-stable
__DESKTOP_APPARMOR_STATE__ optional mullvad -

