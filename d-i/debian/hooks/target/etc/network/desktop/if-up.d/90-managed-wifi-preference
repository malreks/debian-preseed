#!/bin/sh
set -eu

PATH=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__:__INSTALLER_PATH_DIR_USR__/sbin:__INSTALLER_PATH_DIR_USR__/bin:/sbin:/bin
export PATH

interface=${IFACE:-}
[ -n "$interface" ] || exit 0

# Ethernet is owned by ifupdown in this target, so its if-up hook is the
# authoritative transition source. Wi-Fi preference reconciliation is advisory:
# a transient NetworkManager or lock failure must not fail ifup.
__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-wifi-configure --dispatcher "$interface" up || exit 0
