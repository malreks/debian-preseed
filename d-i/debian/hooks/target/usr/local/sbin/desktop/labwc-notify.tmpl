#!/bin/sh
set -eu

PATH=__INSTALLER_PATH_DIR_USR_LOCAL_SBIN__:__INSTALLER_PATH_DIR_USR_LOCAL_BIN__:__INSTALLER_PATH_DIR_USR__/sbin:__INSTALLER_PATH_DIR_USR__/bin:/sbin:/bin
LC_ALL=C.UTF-8
export PATH LC_ALL
umask 077

EVENT_ROOT=__INSTALLER_PATH_DIR_VAR_LIB__/labwc-notifications
EVENT_DIR="${EVENT_ROOT}/system"
EVENT_READER_GROUP=logreader
EVENT_TMP=

app_name='System Maintenance'
urgency=normal
icon=__THEME_MAKO_SYSTEM_NOTIFICATION_INFORMATION_ICON_NAME__
category=x-labwc.maintenance
summary=
body=

fatal() {
  printf 'fatal: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
usage: labwc-notify --summary TEXT [--body TEXT] [--app-name NAME]
                    [--urgency low|normal|critical] [--icon ICON]
                    [--category CATEGORY]
EOF
  exit 64
}

field_length() {
  field_value=$1
  field_maximum=$2
  field_length_value=$(
    printf '%s' "$field_value" |
      __INSTALLER_PATH_DIR_USR__/bin/wc -c |
      __INSTALLER_PATH_DIR_USR__/bin/tr -d '[:space:]'
  )
  case "$field_length_value" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$field_length_value" -le "$field_maximum" ]
}

printable_field() {
  field_value=$1
  field_maximum=$2
  field_required=$3

  case "$field_value" in
    *'|'*) return 1 ;;
  esac
  if [ "$field_required" = yes ] && [ -z "$field_value" ]; then
    return 1
  fi
  field_length "$field_value" "$field_maximum" || return 1

  line_break_count=$(
    printf '%s' "$field_value" |
      __INSTALLER_PATH_DIR_USR__/bin/tr -cd '\012\015' |
      __INSTALLER_PATH_DIR_USR__/bin/wc -c |
      __INSTALLER_PATH_DIR_USR__/bin/tr -d '[:space:]'
  )
  [ "$line_break_count" = 0 ] || return 1
  [ -n "$field_value" ] || return 0
  printf '%s\n' "$field_value" | __INSTALLER_PATH_DIR_USR__/bin/grep -Eq '^[ -~]+$'
}

validate_app_name() {
  printable_field "$1" 64 yes || return 1
  printf '%s\n' "$1" |
    __INSTALLER_PATH_DIR_USR__/bin/grep -Eq '^[A-Za-z0-9][A-Za-z0-9 ._-]*$'
}

validate_token() {
  token_value=$1
  token_maximum=$2
  printable_field "$token_value" "$token_maximum" yes || return 1
  printf '%s\n' "$token_value" |
    __INSTALLER_PATH_DIR_USR__/bin/grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$'
}

validate_queue() {
  event_reader_gid=$(
    __INSTALLER_PATH_DIR_USR__/bin/getent group "$EVENT_READER_GROUP" |
      __INSTALLER_PATH_DIR_USR__/bin/cut -d: -f3
  )
  case "$event_reader_gid" in
    ''|*[!0-9]*) return 1 ;;
  esac

  [ -d "$EVENT_ROOT" ] && [ ! -L "$EVENT_ROOT" ] || return 1
  [ -d "$EVENT_DIR" ] && [ ! -L "$EVENT_DIR" ] || return 1

  trusted_root=$(
    __INSTALLER_PATH_DIR_USR__/bin/find "$EVENT_ROOT" \
      -maxdepth 0 \
      -type d \
      -uid 0 \
      ! -perm /022 \
      -print \
      -quit 2>__INSTALLER_PATH_DIR_DEV__/null || true
  )
  [ "$trusted_root" = "$EVENT_ROOT" ] || return 1

  trusted_event_dir=$(
    __INSTALLER_PATH_DIR_USR__/bin/find "$EVENT_DIR" \
      -maxdepth 0 \
      -type d \
      -uid 0 \
      -gid "$event_reader_gid" \
      -perm -2750 \
      ! -perm /022 \
      -print \
      -quit 2>__INSTALLER_PATH_DIR_DEV__/null || true
  )
  [ "$trusted_event_dir" = "$EVENT_DIR" ] || return 1
}

cleanup() {
  [ -n "$EVENT_TMP" ] || return 0
  __INSTALLER_PATH_DIR_USR__/bin/rm -f -- "$EVENT_TMP" 2>__INSTALLER_PATH_DIR_DEV__/null || true
}
trap cleanup EXIT HUP INT TERM

[ "$(__INSTALLER_PATH_DIR_USR__/bin/id -u)" -eq 0 ] ||
  fatal 'labwc-notify requires root privileges; invoke it through sudo or a system service'

while [ "$#" -gt 0 ]; do
  case "$1" in
    --app-name)
      [ "$#" -ge 2 ] || usage
      app_name=$2
      shift 2
      ;;
    --urgency)
      [ "$#" -ge 2 ] || usage
      urgency=$2
      shift 2
      ;;
    --icon)
      [ "$#" -ge 2 ] || usage
      icon=$2
      shift 2
      ;;
    --category)
      [ "$#" -ge 2 ] || usage
      category=$2
      shift 2
      ;;
    --summary)
      [ "$#" -ge 2 ] || usage
      summary=$2
      shift 2
      ;;
    --body)
      [ "$#" -ge 2 ] || usage
      body=$2
      shift 2
      ;;
    --help)
      usage
      ;;
    --)
      shift
      [ "$#" -eq 0 ] || usage
      ;;
    *)
      usage
      ;;
  esac
done

validate_app_name "$app_name" ||
  fatal 'app name must contain only printable ASCII letters, digits, spaces, dots, underscores, and hyphens'
case "$urgency" in
  low|normal|critical) ;;
  *) fatal 'urgency must be low, normal, or critical' ;;
esac
validate_token "$icon" 64 ||
  fatal 'icon must contain only printable ASCII letters, digits, dots, underscores, and hyphens'
validate_token "$category" 96 ||
  fatal 'category must contain only printable ASCII letters, digits, dots, underscores, and hyphens'
printable_field "$summary" 160 yes ||
  fatal 'summary must be printable ASCII text up to 160 bytes without line breaks or pipe characters'
printable_field "$body" 512 no ||
  fatal 'body must be printable ASCII text up to 512 bytes without line breaks or pipe characters'
validate_queue ||
  fatal "Labwc notification queue is unavailable or unsafe: ${EVENT_DIR}"

event_epoch=$(__INSTALLER_PATH_DIR_USR__/bin/date -u +%s)
case "$event_epoch" in
  ''|*[!0-9]*) fatal 'unable to determine event timestamp' ;;
esac

event_sequence=1
while [ "$event_sequence" -le 9999 ]; do
  event_name=$(printf '%010d-%010d-%04d.event' "$event_epoch" "$$" "$event_sequence")
  event_path="${EVENT_DIR}/${event_name}"
  if [ ! -e "$event_path" ] && [ ! -L "$event_path" ]; then
    break
  fi
  event_sequence=$((event_sequence + 1))
done
[ "$event_sequence" -le 9999 ] ||
  fatal 'unable to allocate a unique notification event name'

EVENT_TMP=$(__INSTALLER_PATH_DIR_USR__/bin/mktemp "${EVENT_DIR}/.labwc-notify.XXXXXX") ||
  fatal 'unable to allocate a notification queue record'
printf '%s|%s|%s|%s|%s|%s\n' \
  "$app_name" \
  "$urgency" \
  "$icon" \
  "$category" \
  "$summary" \
  "$body" >"$EVENT_TMP"
__INSTALLER_PATH_DIR_USR__/bin/chmod 0640 "$EVENT_TMP" ||
  fatal 'unable to protect notification queue record'
__INSTALLER_PATH_DIR_USR__/bin/mv -f -- "$EVENT_TMP" "$event_path" ||
  fatal 'unable to publish notification queue record'
EVENT_TMP=

__INSTALLER_PATH_DIR_USR__/bin/find "$EVENT_DIR" \
  -mindepth 1 \
  -maxdepth 1 \
  -type f \
  -name '*.event' \
  -mtime +90 \
  -delete 2>__INSTALLER_PATH_DIR_DEV__/null || true
