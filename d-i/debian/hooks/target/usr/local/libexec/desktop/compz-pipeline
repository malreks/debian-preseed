#!__INSTALLER_PATH_DIR_USR__/bin/perl
use strict;
use warnings;
use lib '__INSTALLER_PATH_DIR_PERL5_SITE_PERL__/labwc-compz';
use CompzArchives::Pipeline;
use JSON::PP ();
%ENV = (PATH => '__INSTALLER_PATH_DIR_USR__/bin:/bin', HOME => '/nonexistent', LC_ALL => 'C.UTF-8',
        TMPDIR => '__INSTALLER_PATH_DIR_TMP__', LRZIP => 'NOCONFIG');

# Only the isolated worker calls this helper. Refuse a host-side invocation.
open(my $profile, '<', '__INSTALLER_PATH_DIR_PROC__/self/attr/current') or die "AppArmor is required\n";
my $label = <$profile>;
close($profile);
chomp($label) if defined $label;
die "enforcing compz worker confinement is required\n" unless defined $label && $label eq 'compz-worker (enforce)';
my $input = '';
while (1) {
    my $got = read(STDIN, my $block, 65536);
    die "pipeline specification read failed\n" unless defined $got;
    last unless $got;
    $input .= $block;
    die "pipeline specification too large\n" if length($input) > 1048576;
}
my $spec = JSON::PP->new->utf8->decode($input);
die "invalid pipeline specification\n" unless ref($spec) eq 'HASH';
exit CompzArchives::Pipeline->new(%$spec)->run();
