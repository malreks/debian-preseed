#!/bin/sh
set -eu

PATH=__INSTALLER_PATH_DIR_USR__/bin:/bin
LC_ALL=C.UTF-8
export PATH LC_ALL
umask 077

fatal() {
  printf 'fatal: %s\n' "$*" >&2
  exit 1
}

[ "$(__INSTALLER_PATH_DIR_USR__/bin/id -u)" -eq 0 ] ||
  fatal "Mullvad daemon start helper must run as root"
case "${PKEXEC_UID:-}" in
  ''|0|0*|*[!0-9]*)
    fatal "Mullvad daemon start helper requires a non-root pkexec invoker"
    ;;
esac
__INSTALLER_PATH_DIR_USR__/bin/getent passwd "$PKEXEC_UID" >__INSTALLER_PATH_DIR_DEV__/null 2>&1 ||
  fatal "pkexec invoking account does not exist: $PKEXEC_UID"
[ "$#" -eq 0 ] || fatal "usage: mullvad-daemon-start"

daemon_unit=mullvad-daemon.service
if __INSTALLER_PATH_DIR_USR__/bin/systemctl --quiet is-active "$daemon_unit"; then
  exit 0
fi

__INSTALLER_PATH_DIR_USR__/bin/systemctl start "$daemon_unit"
__INSTALLER_PATH_DIR_USR__/bin/systemctl --quiet is-active "$daemon_unit" ||
  fatal "Mullvad daemon did not become active"
