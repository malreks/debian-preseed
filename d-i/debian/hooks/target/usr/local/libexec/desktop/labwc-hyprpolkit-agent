#!__INSTALLER_PATH_DIR_USR__/bin/python3 -IB
"""Validate the signed-suite agent, then exec it in the existing user service.

--check is read-only and needs no display; installation/firstboot use it too.
This is a compatibility gate, not a replacement authentication implementation.
The signed APT policy selects the package; no binaries are fetched or patched.
"""
from __future__ import annotations

import os
from pathlib import Path
import re
import stat
import subprocess
import sys

BINARY = Path('__INSTALLER_PATH_DIR_USR_LIBEXEC__/hyprpolkitagent')
QUERY = '__INSTALLER_PATH_DIR_USR__/bin/dpkg-query'
QUERY_ENV = {'PATH': '__INSTALLER_PATH_DIR_USR__/sbin:__INSTALLER_PATH_DIR_USR__/bin:/sbin:/bin', 'LC_ALL': 'C'}
EX_CONFIG = 78
DRM_BY_PATH = Path('__INSTALLER_PATH_DIR_DEV__/dri/by-path')
DRM_PATH_NAME = re.compile(r'pci-[0-9a-fA-F:.]+-card\\Z')


def package_query(*arguments: str) -> str:
    result = subprocess.run([QUERY, *arguments], env=QUERY_ENV, check=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, timeout=5)
    return result.stdout


def check_metadata(record: str) -> str:
    fields = record.splitlines()
    if len(fields) != 3 or fields[0] != 'installed':
        raise ValueError('hyprpolkitagent is not fully installed')
    version, depends = fields[1:]
    # The reviewed Qt 0.1.3 implementation is the only version known to
    # negotiate Labwc's layer-shell protocol correctly. Reject the native 0.2.x
    # build before it can enter the user service and abort during GBM setup.
    if not re.fullmatch(r'0\.1\.3-[0-9A-Za-z.+:~_-]{1,127}', version):
        raise ValueError('unsupported hyprpolkitagent version; require Debian Qt 0.1.3')
    packages = {item.strip().split()[0].split(':')[0]
                for item in re.split(r'[,|]', depends) if item.strip()}
    qt = {'libpolkit-qt6-1-1', 'libqt6quickcontrols2-6', 'polkitd'} <= packages
    if not qt:
        raise ValueError('packaged Qt agent lacks the required PolicyKit dependency contract')
    return version


def check_binary() -> None:
    # No PATH lookup, local shadow binary, symlink or writable package parent.
    for path in (*reversed(BINARY.parents), BINARY):
        info = path.lstat()
        kind_ok = stat.S_ISREG(info.st_mode) if path == BINARY else stat.S_ISDIR(info.st_mode)
        if not kind_ok or info.st_uid != 0 or info.st_mode & 0o7022:
            raise ValueError(f'unsafe packaged hyprpolkitagent path: {path}')
        if path == BINARY and not info.st_mode & stat.S_IXUSR:
            raise ValueError('packaged hyprpolkitagent is not executable')
    owner = package_query('-S', str(BINARY)).strip()
    if not re.fullmatch(r'hyprpolkitagent(?::[a-z0-9][a-z0-9-]*)?: ' + re.escape(str(BINARY)), owner):
        raise ValueError('hyprpolkitagent executable is diverted or not owned by its Debian package')


def drm_devices() -> list[str]:
    """Return stable card identities for Aquamarine's primary-device search.

    On hybrid laptops the default Wayland-device probe can start from the
    NVIDIA card even though the compositor is scanning out on Intel.  The
    by-path names bind the selection to PCI identity, so enumeration order
    cannot make the authentication agent pick an unusable card.  If the
    target has no by-path cards, leave Aquamarine's normal discovery intact.
    """
    try:
        entries = sorted(DRM_BY_PATH.iterdir(), key=lambda item: item.name)
    except OSError:
        return []
    preferred = 'pci-0000:00:02.0-card'
    entries.sort(key=lambda item: (item.name != preferred, item.name))
    devices: list[str] = []
    for path in entries:
        if DRM_PATH_NAME.fullmatch(path.name) is None:
            continue
        try:
            info = path.stat()
        except OSError:
            continue
        if stat.S_ISCHR(info.st_mode) and info.st_uid == 0:
            devices.append(str(path))
    # The P15s scanout card is known from the target hardware record. Do not
    # make the small authentication client initialize the secondary NVIDIA
    # card, whose driver exposes no usable CRTC/PRIME path on this machine.
    primary = next((path for path in devices if Path(path).name == preferred), None)
    if primary is not None:
        return [primary]
    return devices


def check() -> str:
    version = check_metadata(package_query('-W', '-f=${db:Status-Status}\n${Version}\n${Depends}\n',
                                           'hyprpolkitagent'))
    check_binary()
    return version


def launch_environment() -> dict[str, str]:
    env = dict(os.environ)
    if (env.get('LABWC_SESSION_OWNER') != 'desktop' or
            env.get('XDG_SESSION_TYPE') != 'wayland' or not env.get('WAYLAND_DISPLAY')):
        raise ValueError('hyprpolkitagent requires the managed desktop Wayland session')
    for key in ('DISPLAY', 'XAUTHORITY', 'QSG_RHI_BACKEND', 'QMLSCENE_DEVICE'):
        env.pop(key, None)
    env.update(QT_QPA_PLATFORM='wayland', QT_QUICK_BACKEND='software',
               QT_NO_XDG_DESKTOP_PORTAL='1', AQ_NO_MODIFIERS='1')
    devices = drm_devices()
    if devices:
        env['AQ_DRM_DEVICES'] = ':'.join(devices)
    return env


def main(argv: list[str]) -> int:
    if argv not in (['--check'], ['--exec']):
        print('usage: labwc-hyprpolkit-agent --check|--exec', file=sys.stderr)
        return EX_CONFIG
    try:
        version = check()
        if argv == ['--check']:
            print(f'hyprpolkitagent {version}: packaged dependency contract and ownership verified; session acceptance required')
            return 0
        # Replace this process: the vendor agent remains systemd's main PID.
        os.execve(str(BINARY), [str(BINARY)], launch_environment())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'hyprpolkitagent compatibility check failed: {error}', file=sys.stderr)
        return EX_CONFIG
    return EX_CONFIG


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
