"""Own the GTK popup lifecycle for Waybar's fixed native menu assets.

Waybar's 0.15 native menu callback returns immediately after showing the
popup, so it cannot publish a latched module class or observe destroy,
Escape, and outside-click dismissal.  This helper is deliberately shared:
it loads the existing rendered GtkBuilder XML and the existing rendered
menu-actions map from that module file, while labwc-waybar-run remains the
only command allow-list and transient-service boundary.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shlex
import signal
import stat
import subprocess
import sys
import xml.etree.ElementTree as ET


POPUPS = {
    "notifications": ("notifications", "notifications-menu.xml", "custom/notifications"),
    "power": ("power", "power-menu.xml", "custom/power"),
    "tomat": ("tomat", "tomat-menu.xml", "custom/tomat"),
    "wayscriber": ("wayscriber", "wayscriber-menu.xml", "custom/wayscriber"),
}
MAX_CONFIG_BYTES = 256 * 1024
MAX_MENU_BYTES = 512 * 1024
MAX_MONITORS = 16


def diagnostic(stage: str, error: Exception) -> None:
    # GTK errors can contain newlines or hostile XML. Keep one bounded record.
    message = str(error).encode("unicode_escape").decode("ascii")[:384]
    print(f"labwc-waybar-menu: stage={stage} type={type(error).__name__} message={message}",
          file=sys.stderr, flush=True)


def secure_path(path: Path, *, directory: bool = False) -> Path:
    info = path.lstat()
    mode = None
    if (path.is_symlink() or info.st_uid != os.getuid()
            or (directory and (not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022))
            or (mode is None and (info.st_mode & 0o022))):
        raise ValueError("unsafe Waybar popup path")
    if not directory and not stat.S_ISREG(info.st_mode):
        raise ValueError("Waybar popup path is not a regular file")
    return path


def session_paths() -> tuple[Path, Path]:
    uid = os.getuid()
    if uid == 0 or os.geteuid() != uid or os.environ.get("LABWC_SESSION_OWNER") != "desktop":
        raise ValueError("Waybar popup requires the ordinary desktop account")
    runtime = secure_path(Path("__INSTALLER_PATH_DIR_RUN_USER__") / str(uid), directory=True)
    if (runtime.stat().st_mode & 0o777) != 0o700:
        raise ValueError("unsafe desktop runtime")
    home = Path(os.environ.get("HOME", ""))
    if not home.is_absolute() or home.is_symlink():
        raise ValueError("unsafe desktop home")
    home_info = home.lstat()
    if home_info.st_uid != uid or not home.is_dir():
        raise ValueError("unsafe desktop home")
    return runtime, home


def secure_config_roots(home: Path) -> None:
    for relative in (
        ".config", ".config/waybar", ".config/waybar/modules",
        ".config/waybar/gtk", ".config/waybar/style",
    ):
        secure_path(home / relative, directory=True)


def read_regular(path: Path, limit: int) -> str:
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or (info.st_mode & 0o022) or info.st_size > limit):
            raise ValueError("unsafe Waybar popup file")
        with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
            descriptor = -1
            return stream.read(limit + 1)
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def read_module(home: Path, module_name: str) -> tuple[Path, Path, dict[str, str]]:
    secure_config_roots(home)
    module_path = secure_path(home / ".config" / "waybar" / "modules" / module_name)
    data = json.loads(read_regular(module_path, MAX_CONFIG_BYTES))
    if not isinstance(data, dict) or len(data) != 1:
        raise ValueError("invalid Waybar module configuration")
    key, value = next(iter(data.items()))
    expected_key = POPUPS[module_name][2]
    if key != expected_key or not isinstance(value, dict):
        raise ValueError("unexpected Waybar module identity")
    actions = value.get("menu-actions")
    menu_file = value.get("menu-file")
    if not isinstance(actions, dict) or not isinstance(menu_file, str):
        raise ValueError("Waybar module has no fixed menu contract")
    if menu_file != f"~/.config/waybar/gtk/{POPUPS[module_name][1]}":
        raise ValueError("unexpected Waybar menu asset")
    if any(not isinstance(key, str) or not isinstance(command, str)
           or not key or len(key) > 64 or len(command) > 512
           for key, command in actions.items()):
        raise ValueError("invalid Waybar menu action")
    menu_path = secure_path(home / ".config" / "waybar" / "gtk" / POPUPS[module_name][1])
    style_path = secure_path(home / ".config" / "waybar" / "style" / "gtk.css")
    if len(read_regular(menu_path, MAX_MENU_BYTES)) > MAX_MENU_BYTES:
        raise ValueError("Waybar menu asset is too large")
    return menu_path, style_path, actions


def fixed_action(command: str) -> list[str]:
    try:
        argv = shlex.split(command, posix=True)
    except ValueError as error:
        raise ValueError("invalid Waybar menu action quoting") from error
    if not argv or argv[0] != "__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-waybar-run" or "--" not in argv:
        raise ValueError("Waybar menu action must use the fixed runner")
    if argv.count("--") != 1 or any(";" in value or "&&" in value or "|" in value for value in argv):
        raise ValueError("Waybar menu action contains shell syntax")
    return argv


def tomat_reverse_enabled(home: Path) -> bool:
    # Shared marker interface with labwc-tomat. Only its presence is data;
    # the popup never writes preferences or changes the running timer.
    try:
        secure_path(home / ".config/tomat", directory=True)
        marker = secure_path(home / ".config/tomat/reverse.enabled")
        if marker.lstat().st_nlink != 1:
            raise ValueError("unsafe Tomat reverse preference")
        return True
    except FileNotFoundError:
        return False


def prepared_menu_xml(path: Path, *, reverse: bool = False) -> tuple[str, list[tuple[str, str, int]]]:
    """Remove lazy icon-name properties before GTK can realize the widgets."""
    text = read_regular(path, MAX_MENU_BYTES)
    if len(text) > MAX_MENU_BYTES or re.search(r'<!\s*(?:DOCTYPE|ENTITY)\b', text, re.I):
        raise ValueError("unsupported menu XML declaration or size")
    tree = ET.fromstring(text)
    if reverse:
        for label in tree.iter("object"):
            if (label.get("class") != "GtkLabel"
                    or re.fullmatch(r"tomat_[0-9]+_label", label.get("id", "")) is None):
                continue
            value = label.find("./property[@name='label']")
            match = re.fullmatch(r"([0-9]+)\s*/\s*([0-9]+)", value.text or "") if value is not None else None
            if match is not None:
                value.text = f"{match[2]} / {match[1]}"
    icons = []
    for image in tree.iter("object"):
        if image.get("class") != "GtkImage":
            continue
        properties = {prop.get("name"): prop for prop in image.findall("property")}
        if any(key in properties for key in ("gicon", "file", "pixbuf", "stock", "resource", "surface")):
            raise ValueError("menu image must use the fixed themed-icon contract")
        if "icon-name" not in properties:
            continue
        identity = image.get("id", "")
        name = properties["icon-name"].text or ""
        size = properties.get("pixel-size")
        pixels = int(size.text) if size is not None else 16
        if (not identity or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]{0,127}", name) is None
                or not 1 <= pixels <= 512 or len(icons) >= 64):
            raise ValueError("invalid menu icon metadata")
        image.remove(properties["icon-name"])
        if "use-fallback" in properties:
            image.remove(properties["use-fallback"])
        icons.append((identity, name, pixels))
    return ET.tostring(tree, encoding="unicode"), icons


class Popup:
    def __init__(self, toolkit, module_name: str, menu_path: Path, style_path: Path, actions: dict[str, list[str]], *, reverse: bool = False):
        self.Gdk, self.GLib, self.Gtk, self.LayerShell = toolkit
        self.module_name = module_name
        self.menu_path = menu_path
        self.style_path = style_path
        self.actions = actions
        self.reverse = reverse
        self.menu = None
        self.done = False
        self.status = 0
        self.child = None
        self.dispatching = False
        self.marker_cleared = False
        self.dismiss_pending = False
        self.windows = []
        self.opened = False
        self.buttons = set()

    def dismiss(self, *_args) -> bool:
        if self.done:
            return False
        # Reuse the transient's exact marker identity. ExecStopPost remains
        # the cleanup fallback if GTK or this process is killed.
        if not self.marker_cleared:
            try:
                invocation = os.environ.get("LABWC_WAYBAR_ACTION_ID", "")
                if re.fullmatch(r"[0-9a-f]{32}", invocation) is None:
                    raise ValueError("missing popup lifecycle identity")
                subprocess.run(["__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-waybar-state",
                                "cleanup", self.module_name, invocation],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               timeout=2, check=True)
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                diagnostic("lifecycle", error)
                return self.finish(3, False)
            self.marker_cleared = True
        # Native menus can close on the outside button press. Retain the
        # transparent input surface through its release, so another Waybar
        # release action cannot consume an unpaired dismissing click.
        event = self.Gtk.get_current_event()
        if event is not None and event.type == self.Gdk.EventType.BUTTON_PRESS:
            self.buttons.add(event.button)
        if not self.buttons:
            for window in self.windows:
                window.hide()
        if not self.dispatching and not self.done and not self.dismiss_pending and not self.buttons:
            # GtkMenuShell deactivates/hides before emitting the item's
            # activate signal. Let that same event finish dispatching before
            # deciding whether this was dismissal without an action.
            self.dismiss_pending = True
            self.GLib.idle_add(self.dismissed)
        return False

    def dismissed(self) -> bool:
        self.dismiss_pending = False
        if not self.dispatching and not self.buttons:
            return self.finish(0, False)
        return False

    def finish(self, status: int = 0, popdown: bool = True) -> bool:
        if self.done:
            return False
        self.done = True
        self.status = status
        if popdown and self.menu is not None:
            self.menu.popdown()
        for window in self.windows:
            window.destroy()
        if self.Gtk.main_level():
            self.Gtk.main_quit()
        return False

    def pointer_entered(self, window, event) -> bool:
        if self.done or self.opened:
            return False
        self.opened = True
        self.LayerShell.set_keyboard_mode(window, self.LayerShell.KeyboardMode.EXCLUSIVE)
        rectangle = self.Gdk.Rectangle()
        rectangle.x, rectangle.y = int(event.x), int(event.y)
        rectangle.width = rectangle.height = 1
        self.menu.show_all()
        self.menu.popup_at_rect(window.get_window(), rectangle,
                                self.Gdk.Gravity.NORTH_WEST, self.Gdk.Gravity.NORTH_WEST, event)
        return False

    def outside_press(self, _window, event) -> bool:
        self.buttons.add(event.button)
        return True

    def outside_release(self, _window, event) -> bool:
        # Consume a complete outside click, never the opening button release.
        if event.button in self.buttons:
            self.buttons.remove(event.button)
            if not self.buttons:
                self.menu.popdown()
                self.dismiss()
        return True

    def menu_button_press(self, _menu, event) -> bool:
        # GTK's grab can redirect an anchor-window click to GtkMenu instead
        # of emitting it on that window. Own dismissal on both recipients.
        widget = self.Gtk.get_event_widget(event)
        if (widget in self.windows or
                (widget is self.menu and not (
                    0 <= event.x < self.menu.get_allocated_width() and
                    0 <= event.y < self.menu.get_allocated_height()))):
            return self.outside_press(_menu, event)
        return False

    def menu_button_release(self, _menu, event) -> bool:
        if event.button in self.buttons:
            return self.outside_release(_menu, event)
        return False

    def key_pressed(self, _window, event) -> bool:
        if event.keyval == self.Gdk.KEY_Escape:
            self.menu.popdown()
            self.dismiss()
            return True
        return False

    def startup_expired(self) -> bool:
        if (not self.done and not self.marker_cleared
                and (not self.opened or not self.menu.get_mapped())):
            diagnostic("anchor", ValueError("popup pointer surface unavailable"))
            self.finish(3)
        return False

    def prepare_surfaces(self) -> None:
        # This separate GTK process has no Waybar GdkWindow or input event.
        # Own transparent layer surfaces, as the managed Waycal popup does,
        # and anchor the unchanged native menu to the actual pointer enter.
        display = self.Gdk.Display.get_default()
        count = display.get_n_monitors()
        if not self.LayerShell.is_supported() or not 1 <= count <= MAX_MONITORS:
            raise ValueError("popup requires bounded Wayland layer-shell outputs")
        screen = display.get_default_screen()
        visual = screen.get_rgba_visual()
        if visual is None:
            raise ValueError("popup requires an RGBA visual")
        provider = self.Gtk.CssProvider()
        provider.load_from_data(b"window.waybar-popup-anchor { background: transparent; "
                                b"box-shadow: none; border: none; }")
        self.Gtk.StyleContext.add_provider_for_screen(
            screen, provider, self.Gtk.STYLE_PROVIDER_PRIORITY_USER + 2)
        display.connect("monitor-added", lambda *_args: self.finish(0))
        display.connect("monitor-removed", lambda *_args: self.finish(0))
        display.connect("closed", lambda *_args: self.finish(3, False))
        for index in range(count):
            monitor = display.get_monitor(index)
            if monitor is None:
                raise ValueError("popup output disappeared")
            for name in ("geometry", "scale-factor"):
                monitor.connect("notify::" + name, lambda *_args: self.finish(0))
            monitor.connect("invalidate", lambda *_args: self.finish(0))
            window = self.Gtk.Window(type=self.Gtk.WindowType.TOPLEVEL)
            self.windows.append(window)
            window.set_visual(visual)
            window.set_decorated(False)
            window.get_style_context().add_class("waybar-popup-anchor")
            self.LayerShell.init_for_window(window)
            self.LayerShell.set_namespace(window, "waybar-popup")
            self.LayerShell.set_monitor(window, monitor)
            self.LayerShell.set_layer(window, self.LayerShell.Layer.OVERLAY)
            self.LayerShell.set_keyboard_mode(window, self.LayerShell.KeyboardMode.NONE)
            self.LayerShell.set_exclusive_zone(window, -1)
            for edge in (self.LayerShell.Edge.TOP, self.LayerShell.Edge.BOTTOM,
                         self.LayerShell.Edge.LEFT, self.LayerShell.Edge.RIGHT):
                self.LayerShell.set_anchor(window, edge, True)
            if hasattr(self.LayerShell, "set_respect_close"):
                self.LayerShell.set_respect_close(window, True)
            window.add_events(self.Gdk.EventMask.ENTER_NOTIFY_MASK
                              | self.Gdk.EventMask.BUTTON_PRESS_MASK
                              | self.Gdk.EventMask.BUTTON_RELEASE_MASK
                              | self.Gdk.EventMask.KEY_PRESS_MASK)
            window.connect("enter-notify-event", self.pointer_entered)
            window.connect("button-press-event", self.outside_press)
            window.connect("button-release-event", self.outside_release)
            window.connect("key-press-event", self.key_pressed)
            window.connect("destroy", lambda *_args: self.finish(0))
        for window in self.windows:
            if not self.done:
                window.show_all()
        self.GLib.timeout_add(2000, self.startup_expired)

    def action(self, _item, action_id: str) -> None:
        if self.dispatching or self.done:
            return
        command = self.actions.get(action_id)
        if command is None:
            self.finish(3)
            return
        try:
            self.dispatching = True
            self.menu.popdown()
            self.dismiss()
            if self.done:
                return
            self.child = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                          stdout=subprocess.DEVNULL,
                                          close_fds=True, start_new_session=True)
            self.GLib.child_watch_add(self.GLib.PRIORITY_DEFAULT, self.child.pid, self.action_done)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            diagnostic("dispatch", error)
            self.finish(3)

    def action_done(self, _pid: int, status: int) -> bool:
        self.child.returncode = os.waitstatus_to_exitcode(status)
        self.finish(0 if self.child.returncode == 0 else 3)
        return False

    def populate_icons(self, builder, specifications) -> None:
        if not specifications:
            return
        theme = self.Gtk.IconTheme.get_default()
        if theme is None:
            raise ValueError("GTK icon theme unavailable")
        flags = self.Gtk.IconLookupFlags.FORCE_SIZE
        # A broken image-missing loader can otherwise turn a later GTK theme
        # fallback into a C assertion. This recoverable call fails cleanly.
        images, loaded = [], []
        try:
            theme.load_icon("image-missing", 16, flags)
            for identity, name, size in specifications:
                image = builder.get_object(identity)
                if not isinstance(image, self.Gtk.Image):
                    raise ValueError("menu icon object is missing")
                images.append(image)
                loaded.append((image, theme.load_icon(name, size, flags)))
        except self.GLib.Error as error:
            diagnostic("icons-text-only", error)
            for identity, _name, _size in specifications:
                image = builder.get_object(identity)
                if isinstance(image, self.Gtk.Image):
                    image.clear()
                    image.set_no_show_all(True)
                    image.hide()
        else:
            for image, pixbuf in loaded:
                image.set_from_pixbuf(pixbuf)
        # Reopen against the new theme instead of reviving unchecked GIcons.
        theme.connect("changed", lambda *_args: self.finish(0))

    def activate(self) -> None:
        provider = self.Gtk.CssProvider()
        provider.load_from_path(str(self.style_path))
        screen = self.Gdk.Screen.get_default()
        if screen is None:
            raise ValueError("GTK screen unavailable")
        self.Gtk.StyleContext.add_provider_for_screen(
            screen, provider, self.Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        builder = self.Gtk.Builder()
        xml, icons = (prepared_menu_xml(self.menu_path, reverse=True) if self.reverse
                      else prepared_menu_xml(self.menu_path))
        builder.add_from_string(xml)
        self.menu = builder.get_object("menu")
        if not isinstance(self.menu, self.Gtk.Menu):
            raise ValueError("Waybar menu object is missing")
        leaves = [obj for obj in builder.get_objects()
                  if isinstance(obj, self.Gtk.MenuItem)
                  and not isinstance(obj, self.Gtk.SeparatorMenuItem)
                  and obj.get_submenu() is None]
        menu_ids = [self.Gtk.Buildable.get_name(obj) for obj in leaves]
        if len(menu_ids) != len(set(menu_ids)) or set(menu_ids) != set(self.actions):
            raise ValueError("Waybar menu leaves do not match its fixed actions")
        for action_id in self.actions:
            obj = builder.get_object(action_id)
            if obj not in leaves:
                raise ValueError("Waybar action is not a menu leaf")
            obj.connect("activate", self.action, action_id)
        self.populate_icons(builder, icons)
        for event in ("deactivate", "selection-done", "hide", "destroy"):
            self.menu.connect(event, self.dismiss)
        self.menu.connect("button-press-event", self.menu_button_press)
        self.menu.connect("button-release-event", self.menu_button_release)
        self.menu.connect("key-press-event", self.key_pressed)
        self.prepare_surfaces()


def main(arguments: list[str]) -> int:
    if len(arguments) != 1 or arguments[0] not in POPUPS:
        raise ValueError("usage: labwc-waybar-menu BUTTON")
    module_name = arguments[0]
    _runtime, home = session_paths()
    menu_path, style_path, raw_actions = read_module(home, module_name)
    actions = {action_id: fixed_action(command)
               for action_id, command in raw_actions.items()}
    popup = None
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import Gdk, GLib, Gtk, GtkLayerShell
        try:
            from gi.repository import GLibUnix
            signal_add = GLibUnix.signal_add
        except ImportError:
            signal_add = GLib.unix_signal_add
        initialized, _remaining = Gtk.init_check([])
        if not initialized or Gdk.Display.get_default() is None:
            raise ValueError("GTK display unavailable")
        reverse = module_name == "tomat" and tomat_reverse_enabled(home)
        popup = Popup((Gdk, GLib, Gtk, GtkLayerShell), module_name, menu_path, style_path, actions,
                      reverse=reverse)
        for signum in (signal.SIGTERM, signal.SIGINT):
            signal_add(GLib.PRIORITY_DEFAULT, signum, lambda: popup.finish(0))
        popup.activate()
        if not popup.done:
            Gtk.main()
        return popup.status
    except Exception as error:
        diagnostic("popup", error)
        if popup is not None:
            popup.finish(3, False)
        return 3


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        diagnostic("context", error)
        raise SystemExit(3)
