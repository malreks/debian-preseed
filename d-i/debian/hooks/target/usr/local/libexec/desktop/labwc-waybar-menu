"""Own the GTK popup lifecycle for Waybar's fixed native menu assets.

Waybar's 0.15 native menu callback returns immediately after showing the
popup, so it cannot publish a latched module class or observe destroy,
Escape, and outside-click dismissal.  This helper is deliberately shared:
it loads the existing rendered GtkBuilder XML and the existing rendered
menu-actions map from that module file, while labwc-waybar-run remains the
only command allow-list and transient-service boundary.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import shlex
import signal
import stat
import subprocess
import sys


POPUPS = {
    "notifications": ("notifications", "notifications-menu.xml", "custom/notifications"),
    "power": ("power", "power-menu.xml", "custom/power"),
    "tomat": ("tomat", "tomat-menu.xml", "custom/tomat"),
    "wayscriber": ("wayscriber", "wayscriber-menu.xml", "custom/wayscriber"),
}
MAX_CONFIG_BYTES = 256 * 1024
MAX_MENU_BYTES = 512 * 1024


def secure_path(path: Path, *, directory: bool = False) -> Path:
    info = path.lstat()
    mode = None
    if (path.is_symlink() or info.st_uid != os.getuid()
            or (directory and (not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022))
            or (mode is None and (info.st_mode & 0o022))):
        raise ValueError("unsafe Waybar popup path")
    if not directory and not stat.S_ISREG(info.st_mode):
        raise ValueError("Waybar popup path is not a regular file")
    return path


def session_paths() -> tuple[Path, Path]:
    uid = os.getuid()
    if uid == 0 or os.geteuid() != uid or os.environ.get("LABWC_SESSION_OWNER") != "desktop":
        raise ValueError("Waybar popup requires the ordinary desktop account")
    runtime = secure_path(Path("__INSTALLER_PATH_DIR_RUN_USER__") / str(uid), directory=True)
    if (runtime.stat().st_mode & 0o777) != 0o700:
        raise ValueError("unsafe desktop runtime")
    home = Path(os.environ.get("HOME", ""))
    if not home.is_absolute() or home.is_symlink():
        raise ValueError("unsafe desktop home")
    home_info = home.lstat()
    if home_info.st_uid != uid or not home.is_dir():
        raise ValueError("unsafe desktop home")
    return runtime, home


def secure_config_roots(home: Path) -> None:
    for relative in (
        ".config", ".config/waybar", ".config/waybar/modules",
        ".config/waybar/gtk", ".config/waybar/style",
    ):
        secure_path(home / relative, directory=True)


def read_regular(path: Path, limit: int) -> str:
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or (info.st_mode & 0o022) or info.st_size > limit):
            raise ValueError("unsafe Waybar popup file")
        with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
            descriptor = -1
            return stream.read(limit + 1)
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def read_module(home: Path, module_name: str) -> tuple[Path, Path, dict[str, str]]:
    secure_config_roots(home)
    module_path = secure_path(home / ".config" / "waybar" / "modules" / module_name)
    data = json.loads(read_regular(module_path, MAX_CONFIG_BYTES))
    if not isinstance(data, dict) or len(data) != 1:
        raise ValueError("invalid Waybar module configuration")
    key, value = next(iter(data.items()))
    expected_key = POPUPS[module_name][2]
    if key != expected_key or not isinstance(value, dict):
        raise ValueError("unexpected Waybar module identity")
    actions = value.get("menu-actions")
    menu_file = value.get("menu-file")
    if not isinstance(actions, dict) or not isinstance(menu_file, str):
        raise ValueError("Waybar module has no fixed menu contract")
    if menu_file != f"~/.config/waybar/gtk/{POPUPS[module_name][1]}":
        raise ValueError("unexpected Waybar menu asset")
    if any(not isinstance(key, str) or not isinstance(command, str)
           or not key or len(key) > 64 or len(command) > 512
           for key, command in actions.items()):
        raise ValueError("invalid Waybar menu action")
    menu_path = secure_path(home / ".config" / "waybar" / "gtk" / POPUPS[module_name][1])
    style_path = secure_path(home / ".config" / "waybar" / "style" / "gtk.css")
    if len(read_regular(menu_path, MAX_MENU_BYTES)) > MAX_MENU_BYTES:
        raise ValueError("Waybar menu asset is too large")
    return menu_path, style_path, actions


def fixed_action(command: str) -> list[str]:
    try:
        argv = shlex.split(command, posix=True)
    except ValueError as error:
        raise ValueError("invalid Waybar menu action quoting") from error
    if not argv or argv[0] != "__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-waybar-run" or "--" not in argv:
        raise ValueError("Waybar menu action must use the fixed runner")
    if argv.count("--") != 1 or any(";" in value or "&&" in value or "|" in value for value in argv):
        raise ValueError("Waybar menu action contains shell syntax")
    return argv


class Popup:
    def __init__(self, toolkit, module_name: str, menu_path: Path, style_path: Path, actions: dict[str, list[str]]):
        self.Gdk, self.GLib, self.Gtk = toolkit
        self.module_name = module_name
        self.menu_path = menu_path
        self.style_path = style_path
        self.actions = actions
        self.menu = None
        self.done = False
        self.status = 0
        self.child = None

    def finish(self, status: int = 0, popdown: bool = True) -> bool:
        if self.done:
            return False
        self.done = True
        self.status = status
        if popdown and self.menu is not None:
            self.menu.popdown()
        if self.Gtk.main_level():
            self.Gtk.main_quit()
        return False

    def action(self, item) -> None:
        action_id = item.get_name()
        command = self.actions.get(action_id)
        if command is None:
            self.finish(3)
            return
        try:
            self.menu.popdown()
            self.child = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                          close_fds=True, start_new_session=True)
            self.GLib.child_watch_add(self.GLib.PRIORITY_DEFAULT, self.child.pid, self.action_done)
        except (OSError, ValueError):
            self.finish(3)

    def action_done(self, _pid: int, status: int) -> bool:
        self.finish(0 if os.waitstatus_to_exitcode(status) == 0 else 3)
        return False

    def activate(self) -> None:
        provider = self.Gtk.CssProvider()
        provider.load_from_path(str(self.style_path))
        screen = self.Gdk.Screen.get_default()
        if screen is None:
            raise ValueError("GTK screen unavailable")
        self.Gtk.StyleContext.add_provider_for_screen(
            screen, provider, self.Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        builder = self.Gtk.Builder()
        builder.add_from_file(str(self.menu_path))
        self.menu = builder.get_object("menu")
        if self.menu is None:
            raise ValueError("Waybar menu object is missing")
        menu_ids = {obj.get_name() for obj in builder.get_objects()
                    if isinstance(obj, self.Gtk.MenuItem) and obj.get_name()}
        if menu_ids != set(self.actions):
            raise ValueError("Waybar menu leaves do not match its fixed actions")
        for obj in builder.get_objects():
            if isinstance(obj, self.Gtk.MenuItem) and obj.get_name() in self.actions:
                obj.connect("activate", self.action)
        self.menu.connect("deactivate", lambda *_args: self.finish(0, False))
        self.menu.connect("selection-done", lambda *_args: self.finish(0, False))
        self.menu.connect("hide", lambda *_args: self.finish(0, False))
        self.menu.connect("destroy", lambda *_args: self.finish(0, False))
        self.menu.popup_at_pointer(None)


def main(arguments: list[str]) -> int:
    if len(arguments) != 1 or arguments[0] not in POPUPS:
        raise ValueError("usage: labwc-waybar-menu BUTTON")
    module_name = arguments[0]
    _runtime, home = session_paths()
    menu_path, style_path, raw_actions = read_module(home, module_name)
    actions = {action_id: fixed_action(command)
               for action_id, command in raw_actions.items()}
    popup = None
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, GLib, Gtk
        initialized, _remaining = Gtk.init_check([])
        if not initialized or Gdk.Display.get_default() is None:
            raise ValueError("GTK display unavailable")
        popup = Popup((Gdk, GLib, Gtk), module_name, menu_path, style_path, actions)
        for signum in (signal.SIGTERM, signal.SIGINT):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signum,
                                 lambda: popup.finish(0))
        popup.activate()
        Gtk.main()
        return popup.status
    except Exception:
        if popup is not None:
            popup.finish(3, False)
        return 3


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"labwc-waybar-menu: {error}", file=sys.stderr)
        raise SystemExit(3)
