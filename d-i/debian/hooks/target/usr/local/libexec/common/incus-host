"""Reconcile local Incus storage/network/profile without shell or YAML evaluation.

Confined clients stay on unix.socket.user (group incus). Only this root-owned
bootstrap talks to the administrator socket. All API operations are bounded;
uncertain mutations retain a private intent and require verified recovery.
"""
from __future__ import annotations
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import http.client
import ipaddress
import json
import os
from pathlib import Path
import re
import signal
import socket
import stat
import subprocess
import sys
import time

CONFIG_FILE = Path('__INSTALLER_PATH_DIR_ETC__/incus/host.conf')
ADMIN_SOCKET = Path('__INSTALLER_PATH_FILE_INCUS_ADMIN_SOCKET__')
USER_SOCKET = Path('__INSTALLER_PATH_DIR_VAR_LIB__/incus/unix.socket.user')
STATE = Path('__INSTALLER_PATH_DIR_INCUS_BOOTSTRAP_STATE__')
JOURNAL = Path('__INSTALLER_PATH_FILE_INCUS_BOOTSTRAP_JOURNAL__')
OPERATION_DEADLINE = float('inf')
CONFIG_ID = ''
KEYS = {'INCUS_MANAGED_POOL_NAME', 'INCUS_MANAGED_POOL_PATH',
        'INCUS_MANAGED_BRIDGE_NAME', 'INCUS_MANAGED_BRIDGE_IPV4',
        'INCUS_MANAGED_BRIDGE_IPV6', 'INCUS_MANAGED_WAIT_SECONDS',
        'INCUS_MANAGED_RETRY_DELAY_SECONDS'}


class Failure(RuntimeError):
    pass


class OutcomeUnknown(Failure):
    """A mutation may have completed. Keep its intent and refuse retry."""


class HTTPFailure(Failure):
    def __init__(self, status: int, message: str):
        self.status = status
        super().__init__(f'Incus API HTTP {status}: {message}')


def log(message: str) -> None:
    print(f'incus-host: {message}', file=sys.stderr, flush=True)


def direct_path(path: Path) -> None:
    if not path.is_absolute() or '..' in path.parts:
        raise Failure(f'unsafe path: {path}')
    for current in [*reversed(path.parents), path]:
        if current.is_symlink():
            raise Failure(f'indirect path: {current}')


def root_file(path: Path, mode: int = 0o644) -> str:
    direct_path(path)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        meta = os.fstat(fd)
        if not stat.S_ISREG(meta.st_mode) or meta.st_uid != 0 or meta.st_nlink != 1 or stat.S_IMODE(meta.st_mode) != mode:
            raise Failure(f'expected root-owned mode {mode:o} regular file: {path}')
        with os.fdopen(fd, closefd=False) as stream:
            data = stream.read(1048577)
            if len(data) > 1048576:
                raise Failure(f'configuration exceeds size limit: {path}')
            return data
    finally:
        os.close(fd)


def remaining(maximum: float) -> float:
    budget = min(maximum, OPERATION_DEADLINE - time.monotonic())
    if budget <= 0:
        raise TimeoutError('Incus bootstrap operation deadline expired')
    return budget


def state_directory() -> None:
    direct_path(STATE)
    for parent in reversed(STATE.parents):
        meta = parent.stat()
        if not stat.S_ISDIR(meta.st_mode) or meta.st_uid != 0 or meta.st_mode & 0o022:
            raise Failure('unsafe Incus recovery ancestry')
    STATE.mkdir(mode=0o700, exist_ok=True)
    meta = STATE.stat()
    if meta.st_uid != 0 or stat.S_IMODE(meta.st_mode) != 0o700:
        raise Failure('unsafe Incus recovery directory')


def sync_state() -> None:
    fd = os.open(STATE, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def begin_mutation(kind: str, description: dict) -> tuple[int, int]:
    state_directory()
    current = hashlib.sha256(json.dumps(parse_config(root_file(CONFIG_FILE)), sort_keys=True).encode()).hexdigest()
    if current != CONFIG_ID:
        raise Failure('Incus policy changed before mutation; no operation started')
    try:
        fd = os.open(JOURNAL, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    except FileExistsError:
        raise OutcomeUnknown('pending Incus mutation; inspect retained transaction and use explicit recovery') from None
    with os.fdopen(fd, 'w', encoding='utf-8') as stream:
        json.dump({'format': 1, 'kind': kind, 'config_sha256': CONFIG_ID, 'intent': description}, stream, sort_keys=True)
        stream.write('\n'); stream.flush(); os.fsync(stream.fileno())
        info = os.fstat(stream.fileno())
    sync_state()
    return info.st_dev, info.st_ino


def complete_mutation(identity: tuple[int, int]) -> None:
    info = JOURNAL.lstat()
    if (info.st_dev, info.st_ino) != identity or not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
        raise OutcomeUnknown('Incus recovery identity changed; retain evidence')
    JOURNAL.unlink()
    sync_state()


def parse_config(text: str) -> dict[str, str]:
    config = {}
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        match = re.fullmatch(r'([A-Z][A-Z0-9_]*)="([^"\r\n]*)"\s*', line)
        if not match or match[1] not in KEYS or match[1] in config:
            raise Failure('malformed, duplicate, or unknown Incus configuration assignment')
        config[match[1]] = match[2]
    if set(config) != KEYS:
        raise Failure('managed Incus configuration is incomplete')
    for name in ('POOL_NAME', 'BRIDGE_NAME'):
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,62}', config['INCUS_MANAGED_' + name]):
            raise Failure(f'invalid Incus {name}')
    path = config['INCUS_MANAGED_POOL_PATH']
    if not re.fullmatch(r'__INSTALLER_PATH_DIR_POOL__/[A-Za-z0-9_./-]+', path) or any(p in ('', '.', '..') for p in path.split('/')[1:]):
        raise Failure('Incus pool must be a direct non-root path under __INSTALLER_PATH_DIR_POOL__')
    for version in (4, 6):
        value = config[f'INCUS_MANAGED_BRIDGE_IPV{version}']
        if value not in ('auto', 'none'):
            try:
                address = ipaddress.ip_interface(value)
            except ValueError:
                raise Failure(f'invalid IPv{version} bridge address') from None
            if address.version != version:
                raise Failure('bridge address family mismatch')
    for key, minimum, maximum in (('WAIT_SECONDS', 1, 120), ('RETRY_DELAY_SECONDS', 1, 10)):
        value = config['INCUS_MANAGED_' + key]
        if not value.isdecimal() or not minimum <= int(value) <= maximum:
            raise Failure(f'{key} must be {minimum}..{maximum}')
    return config


def validate_static() -> dict[str, str]:
    config = parse_config(root_file(CONFIG_FILE))
    root_file(Path('__INSTALLER_PATH_DIR_ETC__/tmpfiles.d/85-qemu-incus-storage.conf'))
    dropin = root_file(Path('__INSTALLER_PATH_DIR_SYSTEMD_SYSTEM_INCUS_USER_DROPIN__/20-bootstrap.conf'))
    for expected in ('Requires=incus-host.service', 'After=incus-host.service'):
        if expected not in dropin.splitlines():
            raise Failure('restricted Incus broker must wait for managed bootstrap')
    for executable in ('__INSTALLER_PATH_DIR_USR__/bin/incus', '__INSTALLER_PATH_DIR_OPT__/incus/lib/systemd/incusd'):
        if not os.access(executable, os.X_OK):
            raise Failure(f'missing Incus package executable: {executable}')
    for unit, group, path in (('incus.socket', 'incus-admin', ADMIN_SOCKET),
                              ('incus-user.socket', 'incus', USER_SOCKET)):
        contents = Path('__INSTALLER_PATH_DIR_USR__/lib/systemd/system', unit).read_text()
        for key, expected in (('SocketMode', '0660'), ('SocketGroup', group), ('ListenStream', str(path))):
            values = re.findall(r'^\s*' + key + r'=(.*?)\s*$', contents, re.M)
            if values != [expected]:
                raise Failure(f'unsafe vendor socket contract: {unit} {key}')
    for unit in ('incus.service', 'incus-user.service', 'incus-startup.service'):
        if not Path('__INSTALLER_PATH_DIR_USR__/lib/systemd/system', unit).is_file():
            raise Failure(f'missing Incus unit: {unit}')
    return config


@contextmanager
def locked():
    directory = Path('__INSTALLER_PATH_DIR_RUN__/lock/incus-host')
    direct_path(directory)
    directory.mkdir(mode=0o700, exist_ok=True)
    meta = directory.stat()
    if meta.st_uid != 0 or stat.S_IMODE(meta.st_mode) != 0o700:
        raise Failure('unsafe Incus bootstrap lock directory')
    fd = os.open(directory / 'bootstrap.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        meta = os.fstat(fd)
        if not stat.S_ISREG(meta.st_mode) or meta.st_uid != 0 or meta.st_nlink != 1 or stat.S_IMODE(meta.st_mode) != 0o600:
            raise Failure('unsafe Incus bootstrap lock')
        deadline = time.monotonic() + 30
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise Failure('another Incus bootstrap owns the lock') from None
                time.sleep(0.1)
        yield
    finally:
        os.close(fd)


def storage_roots(config: dict[str, str], *, require: bool = False) -> None:
    import grp
    pool_root = Path('__INSTALLER_PATH_DIR_POOL__')
    direct_path(pool_root)
    if not pool_root.is_mount():
        raise Failure('the dedicated data pool is not mounted; no root-filesystem fallback')
    roots = ((Path(config['INCUS_MANAGED_POOL_PATH']), 0, 0o711),
             (Path('__INSTALLER_PATH_DIR_POOL_QEMU__'), grp.getgrnam('devops').gr_gid, 0o2770))
    for path, gid, mode in roots:
        direct_path(path)
        for parent in path.parents:
            meta = parent.stat()
            if meta.st_uid != 0 or (meta.st_mode & 0o022 and not meta.st_mode & stat.S_ISVTX):
                raise Failure('virtualization storage ancestry is writable or not root-owned')
        if path.exists():
            meta = path.stat()
            if not stat.S_ISDIR(meta.st_mode) or (meta.st_uid, meta.st_gid, stat.S_IMODE(meta.st_mode)) != (0, gid, mode):
                raise Failure('existing virtualization storage differs; no ownership or mode reset')
        elif require:
            raise Failure('virtualization storage root is missing')


def prepare_storage(config: dict[str, str]) -> None:
    storage_roots(config)
    if not hasattr(os, 'pidfd_open') or not hasattr(signal, 'pidfd_send_signal'):
        raise Failure('target cannot pin the storage preparation process; no mutation started')
    identity = begin_mutation('storage', {'action': 'create-owned-top-level-directories'})
    process = None
    pinned = None
    try:
        process = subprocess.Popen(['__INSTALLER_PATH_DIR_USR__/bin/systemd-tmpfiles', '--create',
                                    '__INSTALLER_PATH_DIR_ETC__/tmpfiles.d/85-qemu-incus-storage.conf'],
                                   env={'PATH': '__INSTALLER_PATH_DIR_USR_BIN__:/bin', 'LANG': 'C.UTF-8'},
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                   start_new_session=True)
        pinned = os.pidfd_open(process.pid)
        status = process.wait(timeout=remaining(20))
        if status:
            raise OutcomeUnknown('storage preparation failed after possible mutation; inspect retained transaction')
        storage_roots(config, require=True)
        complete_mutation(identity)
    except BaseException as error:
        if process is None:
            raise OutcomeUnknown('storage worker start could not be accounted for; retain transaction') from error
        if process.returncode is None and pinned is not None:
            try:
                signal.pidfd_send_signal(pinned, 0)
                if os.getsid(process.pid) != process.pid or os.getpgid(process.pid) != process.pid:
                    raise OutcomeUnknown('storage worker session identity changed')
                os.killpg(process.pid, signal.SIGTERM)
                time.sleep(0.25)
                os.killpg(process.pid, signal.SIGKILL)
                process.wait(timeout=3)
            except (OSError, subprocess.TimeoutExpired):
                raise OutcomeUnknown('storage worker termination cannot be proved; retain transaction') from None
        raise OutcomeUnknown('storage preparation outcome unknown; retained transaction requires review') from error
    finally:
        if pinned is not None:
            os.close(pinned)


def validate_sockets() -> None:
    import grp
    for path, group in ((ADMIN_SOCKET, 'incus-admin'), (USER_SOCKET, 'incus')):
        direct_path(path)
        meta = path.stat()
        if not stat.S_ISSOCK(meta.st_mode) or (meta.st_uid, meta.st_gid, stat.S_IMODE(meta.st_mode)) != (0, grp.getgrnam(group).gr_gid, 0o660):
            raise Failure(f'unsafe live Incus socket: {path}')


class UnixHTTP(http.client.HTTPConnection):
    def __init__(self, path: Path, timeout: float):
        super().__init__('localhost', timeout=timeout)
        self.path = path

    def connect(self) -> None:
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(str(self.path))


class API:
    def __init__(self, path: Path = ADMIN_SOCKET):
        self.path = path

    def request(self, method: str, path: str, payload: dict | None = None,
                etag: str | None = None) -> tuple[dict, str | None]:
        connection = UnixHTTP(self.path, timeout=remaining(10))
        headers = {'Content-Type': 'application/json'}
        if etag is not None:
            headers['If-Match'] = etag
        body = json.dumps(payload).encode() if payload is not None else None
        try:
            connection.request(method, path, body=body, headers=headers)
            response = connection.getresponse()
            raw = bytearray()
            while True:
                if connection.sock is not None:
                    connection.sock.settimeout(remaining(10))
                block = response.read1(65536)
                if not block:
                    break
                if len(raw) + len(block) > 2 * 1024 * 1024:
                    raise Failure('Incus API response exceeded the bootstrap size limit')
                raw.extend(block)
            parsed = json.loads(raw)
            if not isinstance(parsed, dict):
                raise Failure('malformed Incus API object')
            if response.status >= 400:
                raise HTTPFailure(response.status, 'request rejected')
            if not isinstance(parsed, dict) or 'metadata' not in parsed:
                raise Failure('malformed Incus API response')
            return parsed, response.getheader('ETag')
        finally:
            connection.close()

    def get(self, path: str) -> tuple[dict, str | None]:
        response, etag = self.request('GET', path)
        if not isinstance(response['metadata'], dict):
            raise Failure(f'expected object metadata for {path}')
        return response['metadata'], etag

    def exists(self, path: str) -> dict | None:
        try:
            return self.get(path)[0]
        except HTTPFailure as exc:
            if exc.status == 404:
                return None
            raise

    def mutate(self, method: str, path: str, payload: dict, etag: str | None = None) -> None:
        identity = begin_mutation('api', {'method': method, 'path': path,
            'payload_sha256': hashlib.sha256(json.dumps(payload, sort_keys=True).encode()).hexdigest()})
        try:
            response, _ = self.request(method, path, payload, etag)
            if response.get('type') == 'async':
                operation = response.get('operation', '')
                if not re.fullmatch(r'/1\.0/operations/[a-fA-F0-9-]+', operation):
                    raise OutcomeUnknown('unexpected Incus operation identity')
                deadline = time.monotonic() + remaining(60)
                while True:
                    if time.monotonic() >= deadline:
                        raise OutcomeUnknown('Incus asynchronous operation deadline expired')
                    state, _ = self.get(operation)
                    code = state.get('status_code', 0)
                    if code == 200:
                        break
                    if not isinstance(code, int) or code >= 400:
                        raise OutcomeUnknown('Incus asynchronous operation failed after possible mutation')
                    time.sleep(min(0.5, remaining(0.5)))
            complete_mutation(identity)
        except HTTPFailure as error:
            if error.status in (400, 404, 409, 412, 422):
                complete_mutation(identity)
                raise
            raise OutcomeUnknown('Incus rejected a mutation with an uncertain outcome; retain transaction') from None
        except BaseException as error:
            raise OutcomeUnknown('Incus mutation outcome unknown; retain transaction and do not retry') from error

    def create(self, endpoint: str, payload: dict) -> None:
        try:
            self.mutate('POST', endpoint, payload)
        except HTTPFailure as exc:
            if exc.status != 409:
                raise
            # A concurrent creator may have won. The caller MUST verify it.


def verify_network(network: dict, config: dict[str, str]) -> None:
    if network.get('type') != 'bridge' or network.get('managed') is not True:
        raise Failure('configured Incus network is not a managed bridge')
    actual = network.get('config', {})
    for version in (4, 6):
        expected = config[f'INCUS_MANAGED_BRIDGE_IPV{version}']
        found = actual.get(f'ipv{version}.address', '')
        if expected == 'auto':
            try:
                address = ipaddress.ip_interface(found)
            except ValueError:
                raise Failure('Incus auto bridge address has not been allocated') from None
            if address.version != version:
                raise Failure('allocated bridge address has the wrong family')
        elif found != expected:
            raise Failure(f'existing Incus IPv{version} bridge address differs from policy')
    if config['INCUS_MANAGED_BRIDGE_IPV4'] != 'none' and actual.get('ipv4.nat') != 'true':
        raise Failure('managed Incus IPv4 bridge must use NAT')


def reconcile(api: API, config: dict[str, str]) -> None:
    server, _ = api.get('/1.0')
    if server.get('config', {}).get('core.https_address'):
        raise Failure('remote Incus API is enabled; refusing to treat this as a local-only host')
    pool_name, path = config['INCUS_MANAGED_POOL_NAME'], config['INCUS_MANAGED_POOL_PATH']
    pool_url = '/1.0/storage-pools/' + pool_name
    pool = api.exists(pool_url)
    if pool is None:
        api.create('/1.0/storage-pools', {'name': pool_name, 'driver': 'dir', 'config': {'source': path}})
        pool, _ = api.get(pool_url)
    if pool.get('driver') != 'dir' or pool.get('config', {}).get('source') != path:
        raise Failure('existing Incus storage driver/source conflicts with policy; no migration attempted')
    cache_storage(api, config, create=True)
    bridge = config['INCUS_MANAGED_BRIDGE_NAME']
    network_url = '/1.0/networks/' + bridge
    network = api.exists(network_url)
    if network is None:
        network_config = {'ipv4.address': config['INCUS_MANAGED_BRIDGE_IPV4'],
                          'ipv6.address': config['INCUS_MANAGED_BRIDGE_IPV6']}
        if network_config['ipv4.address'] != 'none':
            network_config['ipv4.nat'] = 'true'
        api.create('/1.0/networks', {'name': bridge, 'type': 'bridge', 'config': network_config})
        network, _ = api.get(network_url)
    verify_network(network, config)
    expected_devices = {'root': {'type': 'disk', 'path': '/', 'pool': pool_name},
                        'eth0': {'type': 'nic', 'name': 'eth0', 'network': bridge}}
    for attempt in range(3):
        profile, etag = api.get('/1.0/profiles/default')
        settings = dict(profile.get('config', {}))
        if settings.get('security.privileged', 'false') != 'false':
            raise Failure('existing default profile enables privileged containers')
        settings['security.privileged'] = 'false'
        devices = dict(profile.get('devices', {}))
        for name, expected in expected_devices.items():
            current = dict(devices.get(name, {}))
            if any(key in current and current[key] != value for key, value in expected.items()):
                raise Failure(f'existing Incus default device conflicts with managed {name}')
            if name == 'eth0' and ('parent' in current or 'nictype' in current):
                raise Failure('existing eth0 uses a different network attachment model')
            devices[name] = {**current, **expected}
        if settings == profile.get('config', {}) and devices == profile.get('devices', {}):
            break
        if not etag:
            raise Failure('Incus profile response lacks an ETag; unsafe update refused')
        try:
            api.mutate('PUT', '/1.0/profiles/default',
                       {'description': profile.get('description', ''), 'config': settings, 'devices': devices}, etag)
        except HTTPFailure as exc:
            if exc.status == 412 and attempt < 2:
                continue
            raise
        # Re-read on the next pass and verify an acknowledged write.
    final, _ = api.get('/1.0/profiles/default')
    if final.get('config', {}).get('security.privileged') != 'false':
        raise Failure('default profile privilege policy did not verify')
    for name, expected in expected_devices.items():
        if any(final.get('devices', {}).get(name, {}).get(k) != v for k, v in expected.items()):
            raise Failure('default profile device reconciliation did not verify')


def cache_storage(api: API, config: dict[str, str], *, create: bool = False) -> None:
    """Use native custom volumes for image/backup archives on the data pool."""
    pool = config['INCUS_MANAGED_POOL_NAME']
    owner = hashlib.sha256((pool + '|' + config['INCUS_MANAGED_POOL_PATH']).encode()).hexdigest()
    expected = {'storage.images_volume': pool + '/managed-images',
                'storage.backups_volume': pool + '/managed-backups',
                'storage.logs_volume': pool + '/managed-logs'}
    server, etag = api.get('/1.0')
    settings = dict(server.get('config', {}))
    for key, value in expected.items():
        if settings.get(key, '') not in ('', value):
            raise Failure('Incus archive storage has another owner; no automatic replacement')
        if not create and settings.get(key) != value:
            raise Failure('Incus archive storage escaped the managed data pool')
        name = value.split('/', 1)[1]
        endpoint = '/1.0/storage-pools/' + pool + '/volumes/custom/' + name
        volume = api.exists(endpoint)
        if volume is None and create:
            api.create('/1.0/storage-pools/' + pool + '/volumes/custom',
                       {'name': name, 'content_type': 'filesystem',
                        'config': {'user.managed-incus-owner': owner}})
            volume, _ = api.get(endpoint)
        if (volume is None or volume.get('content_type') != 'filesystem'
                or volume.get('config', {}).get('user.managed-incus-owner') != owner):
            raise Failure('Incus archive volume identity differs; no adoption or reset')
    if create and any(settings.get(key) != value for key, value in expected.items()):
        if not etag:
            raise Failure('Incus archive storage update lacks a native ETag')
        # Native Incus owns any archive relocation; it never executes archives.
        # The existing mutation journal/deadline retains uncertain outcomes.
        api.mutate('PATCH', '/1.0', {'config': expected}, etag)
        current, _ = api.get('/1.0')
        if any(current.get('config', {}).get(key) != value for key, value in expected.items()):
            raise Failure('Incus archive storage changed after its acknowledged update; inspect native configuration')


def verify_reconciled(api: API, config: dict[str, str]) -> None:
    """Read-only verification for normal completion and explicit recovery."""
    server, _ = api.get('/1.0')
    if server.get('config', {}).get('core.https_address'):
        raise Failure('remote Incus API conflicts with local-only policy')
    pool, _ = api.get('/1.0/storage-pools/' + config['INCUS_MANAGED_POOL_NAME'])
    if pool.get('driver') != 'dir' or pool.get('config', {}).get('source') != config['INCUS_MANAGED_POOL_PATH']:
        raise Failure('Incus storage identity does not match the retained policy')
    cache_storage(api, config)
    network, _ = api.get('/1.0/networks/' + config['INCUS_MANAGED_BRIDGE_NAME'])
    verify_network(network, config)
    profile, _ = api.get('/1.0/profiles/default')
    if profile.get('config', {}).get('security.privileged') != 'false':
        raise Failure('Incus default profile privilege policy differs')
    expected = {'root': {'type': 'disk', 'path': '/', 'pool': config['INCUS_MANAGED_POOL_NAME']},
                'eth0': {'type': 'nic', 'name': 'eth0', 'network': config['INCUS_MANAGED_BRIDGE_NAME']}}
    for name, values in expected.items():
        found = profile.get('devices', {}).get(name, {})
        if any(found.get(key) != value for key, value in values.items()):
            raise Failure('Incus default profile device identity differs')
        if name == 'eth0' and ('parent' in found or 'nictype' in found):
            raise Failure('Incus default NIC uses an incompatible attachment')


def wait_ready(api: API, config: dict[str, str]) -> None:
    deadline = time.monotonic() + remaining(int(config['INCUS_MANAGED_WAIT_SECONDS']))
    last = None
    while time.monotonic() < deadline:
        try:
            api.get('/1.0')
            return
        except (OSError, http.client.HTTPException, Failure, ValueError) as exc:
            last = exc
            time.sleep(min(int(config['INCUS_MANAGED_RETRY_DELAY_SECONDS']), max(0, deadline - time.monotonic())))
    raise Failure(f'Incus readiness deadline exceeded: {last}')


def main() -> int:
    global OPERATION_DEADLINE, CONFIG_ID
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument('--prepare-install', action='store_true')
    modes.add_argument('--validate-config', action='store_true')
    modes.add_argument('--recover-uncertain', action='store_true', help='verify completed state without mutations, then acknowledge the retained intent')
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise Failure('bootstrap is root-only; desktop clients must use the confined incus socket')
    config = validate_static()
    if args.validate_config:
        log('static configuration verified; no daemon calls or filesystem changes')
        return 0
    CONFIG_ID = hashlib.sha256(json.dumps(config, sort_keys=True).encode()).hexdigest()
    OPERATION_DEADLINE = time.monotonic() + 180
    # A single process-wide alarm also bounds slow HTTP header/body reads.
    # It fires once; pinned-child cleanup retains its separate three seconds.
    def expired(_number, _frame):
        raise TimeoutError('Incus bootstrap operation deadline expired')
    signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, 180)
    try:
        with locked():
            state_directory()
            if JOURNAL.exists() or JOURNAL.is_symlink():
                if not args.recover_uncertain:
                    raise OutcomeUnknown('retained Incus mutation; inspect transaction and run explicit recovery')
                journal = json.loads(root_file(JOURNAL, 0o600))
                if not isinstance(journal, dict) or journal.get('format') != 1 or journal.get('config_sha256') != CONFIG_ID or journal.get('kind') not in ('storage', 'api'):
                    raise OutcomeUnknown('retained Incus mutation has a different policy or invalid format')
                info = JOURNAL.stat()
                storage_roots(config, require=True)
                if journal['kind'] == 'api':
                    validate_sockets()
                    verify_reconciled(API(), config)
                complete_mutation((info.st_dev, info.st_ino))
                log('recovery verified without changing Incus objects; retained intent acknowledged')
                return 0
            if args.recover_uncertain:
                raise Failure('no uncertain Incus transaction is present')
            prepare_storage(config)
            if args.prepare_install:
                log('install-time storage prepared; no Incus daemon activation')
                return 0
            api = API()
            validate_sockets()
            wait_ready(api, config)
            reconcile(api, config)
            verify_reconciled(api, config)
            log('ready local-only=true unprivileged-default=true confined-group=incus')
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
    return 0


if __name__ == '__main__':
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda number, _frame: sys.exit(128 + number))
    try:
        sys.exit(main())
    except OutcomeUnknown:
        log('outcome unknown; retained private transaction requires operator recovery')
        sys.exit(76)
    except (OSError, ValueError, KeyError, Failure, http.client.HTTPException, subprocess.TimeoutExpired) as exc:
        log(f'ERROR {exc}')
        sys.exit(1)
