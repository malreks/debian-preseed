    for source in __INSTALLER_PATH_DIR_SYS__/class/block/*/dev __INSTALLER_PATH_DIR_SYS__/class/block/*/size __INSTALLER_PATH_DIR_SYS__/class/block/*/queue/rotational __INSTALLER_PATH_DIR_SYS__/class/drm/card*/device/uevent; do
