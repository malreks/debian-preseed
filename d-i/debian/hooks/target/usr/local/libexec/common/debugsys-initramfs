    for source in __INSTALLER_PATH_DIR_PROC__/uptime __INSTALLER_PATH_DIR_PROC__/cmdline __INSTALLER_PATH_DIR_PROC__/mounts __INSTALLER_PATH_DIR_PROC__/modules __INSTALLER_PATH_DIR_PROC__/meminfo __INSTALLER_PATH_DIR_PROC__/partitions __INSTALLER_PATH_DIR_PROC__/pressure/cpu __INSTALLER_PATH_DIR_PROC__/pressure/memory __INSTALLER_PATH_DIR_PROC__/pressure/io; do
