    done
    printf '\n--- kernel ring buffer (bounded tail unavailable on minimal initrd) ---\n'
    timeout -k 1 5 dmesg 2>__INSTALLER_PATH_DIR_DEV__/null
    printf '\n--- interfaces and routes ---\n'
    timeout -k 1 5 ip -brief address 2>__INSTALLER_PATH_DIR_DEV__/null
    timeout -k 1 5 ip route show table all 2>__INSTALLER_PATH_DIR_DEV__/null
