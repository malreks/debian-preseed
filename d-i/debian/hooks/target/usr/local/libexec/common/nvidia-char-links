#!__INSTALLER_PATH_DIR_USR__/bin/python3 -IB
"""Reconcile only __INSTALLER_PATH_DIR_DEV__/char links for existing, root-owned NVIDIA devices.

Never create devices, load modules, change permissions, or follow an untrusted
path. The command accepts no paths. --check is read-only and reports every bad
link. NVIDIA-specific udev rules cover late device creation; the oneshot service
provides cold-boot reconciliation without a global /dev watcher or polling.
"""
from __future__ import annotations
import os
from pathlib import Path
import re
import signal
import stat
import sys
import uuid

DEVICE = re.compile(r"nvidia(?:[0-9]+|ctl|-modeset|-uvm|-uvm-tools)\Z")


def directory(path, *, dir_fd=None):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                 dir_fd=dir_fd)
    st = os.fstat(fd)
    if st.st_uid != 0 or st.st_mode & 0o022:
        os.close(fd)
        raise ValueError("device directory is not root-owned and protected")
    return fd


def reconcile(dev: Path = Path("__INSTALLER_PATH_DIR_DEV__"), *, check: bool = False) -> int:
    errors = 0
    dev_fd = directory(dev)
    char_fd = None
    caps_fd = None
    try:
        devices = []
        names = []
        with os.scandir(dev_fd) as entries:
            for entry in entries:
                if len(names) >= 4096:
                    raise ValueError("device inventory exceeds its limit")
                names.append(entry.name)
        for name in sorted(names):
            if not DEVICE.fullmatch(name):
                continue
            try:
                metadata = os.stat(name, dir_fd=dev_fd, follow_symlinks=False)
            except FileNotFoundError:
                continue  # a device removed during enumeration
            if not stat.S_ISCHR(metadata.st_mode) or metadata.st_uid != 0:
                print(f"unsafe NVIDIA device entry: {name}", file=sys.stderr)
                errors += 1
                continue
            devices.append((name, metadata.st_rdev, metadata.st_dev, metadata.st_ino))
        try:
            caps_fd = directory("nvidia-caps", dir_fd=dev_fd)
        except FileNotFoundError:
            pass
        if caps_fd is not None:
            with os.scandir(caps_fd) as entries:
                for count, entry in enumerate(entries, 1):
                    if count > 256:
                        raise ValueError("NVIDIA capability inventory exceeds its limit")
                    if not re.fullmatch(r"nvidia-cap[0-9]+", entry.name):
                        continue
                    metadata = entry.stat(follow_symlinks=False)
                    if not stat.S_ISCHR(metadata.st_mode) or metadata.st_uid != 0:
                        raise ValueError("unsafe NVIDIA capability device")
                    devices.append(("nvidia-caps/" + entry.name, metadata.st_rdev,
                                    metadata.st_dev, metadata.st_ino))
        if len(devices) > 256:
            raise ValueError("NVIDIA device inventory exceeds its limit")
        if not devices:
            print("nvidia-char-links: no NVIDIA character devices present")
            return errors
        if not check:
            try:
                os.mkdir("char", 0o755, dir_fd=dev_fd)
            except FileExistsError:
                pass
        try:
            char_fd = directory("char", dir_fd=dev_fd)
        except FileNotFoundError:
            for name, rdev, _device, _inode in devices:
                print(f"missing __INSTALLER_PATH_DIR_DEV__/char/{os.major(rdev)}:{os.minor(rdev)} -> {name}", file=sys.stderr)
            return errors + len(devices)
        for name, rdev, device, inode in devices:
            def unchanged_device() -> None:
                if name.startswith('nvidia-caps/'):
                    current_directory = os.stat('nvidia-caps', dir_fd=dev_fd, follow_symlinks=False)
                    pinned_directory = os.fstat(caps_fd)
                    if (current_directory.st_dev, current_directory.st_ino) != (pinned_directory.st_dev, pinned_directory.st_ino):
                        raise ValueError("NVIDIA capability directory changed during reconciliation")
                    current = os.stat(name.split('/', 1)[1], dir_fd=caps_fd, follow_symlinks=False)
                else:
                    current = os.stat(name, dir_fd=dev_fd, follow_symlinks=False)
                if (not stat.S_ISCHR(current.st_mode) or current.st_uid != 0
                        or (current.st_dev, current.st_ino, current.st_rdev) != (device, inode, rdev)):
                    raise ValueError("NVIDIA device changed during reconciliation")
            unchanged_device()
            key = f"{os.major(rdev)}:{os.minor(rdev)}"
            try:
                link = os.stat(key, dir_fd=char_fd, follow_symlinks=False)
            except FileNotFoundError:
                link = None
            if link is not None and not stat.S_ISLNK(link.st_mode):
                print(f"refusing to replace non-symlink __INSTALLER_PATH_DIR_DEV__/char/{key}", file=sys.stderr)
                errors += 1
                continue
            if link is not None:
                try:
                    resolved = os.stat(key, dir_fd=char_fd)
                except FileNotFoundError:
                    resolved = None
                if (resolved is not None and stat.S_ISCHR(resolved.st_mode)
                        and (resolved.st_dev, resolved.st_ino, resolved.st_rdev) == (device, inode, rdev)):
                    continue
            if check:
                print(f"missing/incorrect __INSTALLER_PATH_DIR_DEV__/char/{key} -> {name}", file=sys.stderr)
                errors += 1
                continue
            temporary = ".nvidia-" + uuid.uuid4().hex
            try:
                os.symlink("../" + name, temporary, dir_fd=char_fd)
                unchanged_device()
                os.replace(temporary, key, src_dir_fd=char_fd, dst_dir_fd=char_fd)
                print(f"nvidia-char-links: __INSTALLER_PATH_DIR_DEV__/char/{key} -> ../{name}")
            finally:
                try:
                    os.unlink(temporary, dir_fd=char_fd)
                except FileNotFoundError:
                    pass
        return errors
    finally:
        if caps_fd is not None:
            os.close(caps_fd)
        if char_fd is not None:
            os.close(char_fd)
        os.close(dev_fd)


def main(args: list[str]) -> int:
    if args not in ([], ["--check"]):
        print("usage: nvidia-char-links [--check]", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("nvidia-char-links: root is required", file=sys.stderr)
        return 1
    return int(reconcile(check=bool(args)) != 0)


if __name__ == "__main__":
    # Also handle TERM as PID 1 in the service's private PID namespace. Raising
    # SystemExit preserves reconcile()'s descriptor/temporary-link finally blocks.
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda number, frame: sys.exit(128 + number))
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, ValueError) as exc:
        print(f"nvidia-char-links: {exc}", file=sys.stderr)
        raise SystemExit(1)
