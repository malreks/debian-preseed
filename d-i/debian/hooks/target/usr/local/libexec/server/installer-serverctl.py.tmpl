class OutcomeUnknown(RuntimeError):
    """A mutation may have completed; preserve evidence and prohibit retry."""


def trusted_directory(path: Path, info, uid: int = 0) -> bool:
    # The canonical root:devops mode-3775 data partition is deliberately
    # shared. Its sticky bit protects root-owned children from replacement.
    # No other writable ancestor receives this exception.
    shared_pool = path == POOL_ROOT and info.st_uid == 0 and stat.S_IMODE(info.st_mode) == 0o3775
    return (stat.S_ISDIR(info.st_mode) and info.st_uid in (0, uid)
            and (not info.st_mode & 0o022 or shared_pool))


def require_pool_mount() -> None:
    mounted = command(['/usr/bin/findmnt', '-n', '-o', 'TARGET', '--mountpoint', str(POOL_ROOT)])
    if mounted.strip() != str(POOL_ROOT).encode():
        raise ValueError('the dedicated data pool is not mounted; no root-filesystem fallback')


def json_document(data):
    """Bounded callers supply bytes; reject duplicate/private ambiguous fields."""
    def pairs(items):
        value = {}
        for name, item in items:
            if name in value:
                raise ValueError('duplicate JSON field')
            value[name] = item
        return value
    def constant(_):
        raise ValueError('non-finite JSON value')
    return json.loads(data, object_pairs_hook=pairs, parse_constant=constant)


def regular(path: Path, *, private: bool = False, maximum: int = 1048576, owner: int = 0) -> bytes:
    if private:
        for parent in path.parents:
            info = parent.lstat()
            if not trusted_directory(parent, info, owner):
                raise ValueError('private input has untrusted ancestry')
    # A substituted FIFO must fail its type check without blocking the owner.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != owner
                or info.st_mode & (0o077 if private else 0o022) or info.st_size > maximum):
            raise ValueError('unsafe protected input')
        with os.fdopen(os.dup(fd), 'rb') as stream:
            data = stream.read(maximum + 1)
        after, named = os.fstat(fd), path.lstat()
        def identity(value):
            return (value.st_dev, value.st_ino, value.st_mode, value.st_nlink,
                    value.st_uid, value.st_gid, value.st_size, value.st_mtime_ns, value.st_ctime_ns)
        if (len(data) > maximum or len(data) != info.st_size
                or identity(info) != identity(after) or identity(after) != identity(named)):
            raise ValueError('input changed or exceeds byte bound')
        return data
    finally:
        os.close(fd)


def protected_directory(path: Path, mode: int = 0o700) -> None:
    if not path.is_absolute() or '..' in path.parts:
        raise ValueError('unsafe managed directory')
    for parent in reversed((path, *path.parents)):
        if parent == Path('/'):
            continue
        if not parent.exists():
            parent.mkdir(mode=mode)
        info = parent.lstat()
        if not trusted_directory(parent, info):
            raise ValueError('managed ancestry is not trusted')


def sync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write(path: Path, data: bytes, mode: int = 0o600, uid: int = 0) -> None:
    # Pin each directory while walking from the immutable filesystem root.
    # Service-owned stores must not redirect a privileged writer through a
    # renamed parent, symlink or a different account's private directory.
    if not path.is_absolute() or any(part in ('.', '..') for part in path.parts):
        raise ValueError('unsafe publication path')
    directory = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    temporary = None
    try:
        current = Path('/')
        for part in path.parent.parts[1:]:
            current /= part
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory)
            info = os.fstat(child)
            if not trusted_directory(current, info, uid):
                os.close(child)
                raise ValueError('unsafe publication ancestry')
            os.close(directory)
            directory = child
        try:
            info = os.stat(path.name, dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid not in (0, uid):
                raise ValueError('refusing unsafe publication target')
        temporary = '.candidate-' + os.urandom(16).hex()
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=directory)
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            os.fchmod(stream.fileno(), mode)
            os.fchown(stream.fileno(), uid, uid)
            stream.flush(); os.fsync(stream.fileno())
            published = os.fstat(stream.fileno())
        os.replace(temporary, path.name, src_dir_fd=directory, dst_dir_fd=directory)
        temporary = None
        os.fsync(directory)
        current = os.stat(path.name, dir_fd=directory, follow_symlinks=False)
        if (current.st_dev, current.st_ino, current.st_uid, stat.S_IMODE(current.st_mode)) != (published.st_dev, published.st_ino, uid, mode):
            raise OutcomeUnknown('publication identity changed; retain recovery state')
    finally:
        try:
            if temporary is not None:
                # Remove only this operation's still-owned regular candidate.
                try:
                    candidate = os.stat(temporary, dir_fd=directory, follow_symlinks=False)
                    if candidate.st_uid == os.geteuid() and stat.S_ISREG(candidate.st_mode):
                        os.unlink(temporary, dir_fd=directory)
                except FileNotFoundError:
                    pass
        finally:
            os.close(directory)


@contextlib.contextmanager
def ownership_lock():
    protected_directory(STATE, 0o755)
    os.chmod(STATE, 0o755)
    fd = os.open(STATE / 'ownership.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(fd)
        if info.st_uid != 0 or not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_mode & 0o077:
            raise ValueError('unsafe ownership lock')
        end = min(DEADLINE, time.monotonic() + 30)
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= end:
                    raise TimeoutError('service state already has an owner') from None
                time.sleep(0.1)
        yield
    finally:
        os.close(fd)


def command(argv: list[str], *, user: str | None = None, cwd: Path | None = None,
            extra: dict[str, str] | None = None, timeout: int = 120) -> bytes:
    env = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8'}
    options = {}
    if user:
        account = pwd.getpwnam(user)
        options.update(user=account.pw_uid, group=account.pw_gid, extra_groups=[], umask=0o077)
        env.update(HOME=account.pw_dir, USER=user, LOGNAME=user)
    if extra:
        env.update(extra)
    remaining = min(timeout, DEADLINE - time.monotonic())
    if remaining <= 0:
        raise TimeoutError('operation deadline expired')
    if not hasattr(os, 'pidfd_open') or not hasattr(signal, 'pidfd_send_signal'):
        raise ValueError('the selected target runtime cannot pin child identities')
    # Drain a bounded pipe, without writing vendor output or tokens to a log.
    # A pinned leader owns this new session. Uncertain termination is distinct
    # from an ordinary failure and never triggers an automatic mutation retry.
    end = time.monotonic() + remaining
    process = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               start_new_session=True, **options)
    pinned = None
    output = bytearray()
    selector = selectors.DefaultSelector()
    try:
        try:
            pinned = os.pidfd_open(process.pid)
        except OSError:
            # No verified identity means no numeric-PID/group fallback. The
            # caller retains its uncertainty marker for operator recovery.
            raise OutcomeUnknown('unable to pin child identity; retained state requires review') from None
        selector.register(process.stdout, selectors.EVENT_READ)
        while selector.get_map():
            if time.monotonic() >= end:
                raise TimeoutError('headless operation deadline expired')
            for key, _ in selector.select(min(0.25, max(0, end - time.monotonic()))):
                block = os.read(key.fileobj.fileno(), 65536)
                if not block:
                    selector.unregister(key.fileobj)
                    break
                if len(output) + len(block) > 2097152:
                    raise ValueError('headless operation output bound exceeded')
                output.extend(block)
        result = process.wait(timeout=max(0.01, end - time.monotonic()))
        if result:
            raise RuntimeError(f'headless operation failed (status={result})')
        return bytes(output)
    except BaseException as error:
        # An unreaped leader pins the numeric session identity. A direct-child
        # reap cannot account for detached descendants after cancellation.
        # Preserve enrollment-uncertain and stop if ownership cannot be proved.
        interrupted = process.returncode is None
        if interrupted and pinned is not None:
            try:
                signal.pidfd_send_signal(pinned, 0)
                if os.getsid(process.pid) != process.pid or os.getpgid(process.pid) != process.pid:
                    raise OutcomeUnknown('child session identity changed')
                os.killpg(process.pid, signal.SIGTERM)
                # Keep the leader unreaped throughout group cleanup, including
                # when TERM makes it exit before its descendants finish.
                time.sleep(0.25)
                os.killpg(process.pid, signal.SIGKILL)
                process.wait(timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                raise OutcomeUnknown('child termination cannot be proved') from None
        if interrupted or isinstance(error, (TimeoutError, KeyboardInterrupt)):
            raise OutcomeUnknown('child tree completion cannot be proved; retained state requires review') from error
        raise
    finally:
        selector.close()
        process.stdout.close()
        if pinned is not None:
            os.close(pinned)


def acquire(record: dict, arch: str, destination: Path) -> str:
    artifact = record['architectures'][arch]
    algorithm = 'sha512' if 'sha512' in artifact else 'sha256'
    expected = artifact[algorithm]
    if re.fullmatch('[0-9a-f]{' + str(hashlib.new(algorithm).digest_size * 2) + '}', expected) is None:
        raise ValueError('artifact has no reviewed content identity')
    # One shared HTTP owner validates every hop before requesting it and bounds
    # streaming/retries/final waits. Its stdout may contain a signed URL and is
    # consumed privately, never passed to diagnostics or a receipt.
    command(['__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/installer-artifact-fetch',
             artifact['url'], str(destination), 'artifact', ' '.join(record['hosts'])], timeout=900)
    descriptor = os.open(destination, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    digest = hashlib.new(algorithm)
    size = 0
    with os.fdopen(descriptor, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid or info.st_nlink != 1
                or info.st_mode & 0o077):
            raise ValueError('artifact file identity differs from its policy')
        while block := stream.read(65536):
            if time.monotonic() >= DEADLINE:
                raise TimeoutError('artifact verification deadline expired')
            size += len(block)
            digest.update(block)
    if size != info.st_size or digest.hexdigest() != expected:
        raise ValueError('artifact digest differs from the release pin')
    return digest.hexdigest()


def relative(name: str) -> str:
    while name.startswith('./'):
        name = name[2:]
    if (not name or len(name) > 240 or name.startswith('/') or '\\' in name
            or any(x in ('', '.', '..') for x in name.split('/')) or any(ord(x) < 32 for x in name)):
        raise ValueError('unsafe archive member')
    return name


def extract(archive: Path, target: Path, record: dict) -> None:
    members, links, total = {}, {}, 0
    with tarfile.open(archive, 'r:gz') as source:
        for member in source:
            if time.monotonic() >= DEADLINE:
                raise TimeoutError('extraction deadline expired')
            if member.name in ('.', './') and member.isdir():
                continue
            name = relative(member.name.rstrip('/') if member.isdir() else member.name)
            if name in members or len(members) >= record['maximum_members']:
                raise ValueError('duplicate or excessive archive members')
            if not (member.isfile() or member.isdir() or member.issym()) or member.mode & 0o7000:
                raise ValueError('unsafe archive member type or privilege bits')
            total += member.size
            if member.size > 256000000 or total > record['expanded_bytes']:
                raise ValueError('expanded archive bound exceeded')
            if member.issym():
                if not any(name.startswith(prefix) for prefix in record['relative_link_prefixes']):
                    raise ValueError('symlink outside the approved vendor subtree')
                parts = list(PurePosixPath(name).parent.parts)
                if member.linkname.startswith('/') or '\\' in member.linkname:
                    raise ValueError('absolute vendor link')
                for part in member.linkname.split('/'):
                    if part in ('', '.'):
                        continue
                    if part == '..':
                        if not parts:
                            raise ValueError('escaping vendor link')
                        parts.pop()
                    else:
                        parts.append(part)
                links[name] = '/'.join(parts)
            members[name] = member
        for name in members:
            if any(str(parent) in links for parent in PurePosixPath(name).parents):
                raise ValueError('archive writes through a symlink parent')
        for name in links:
            current, seen = name, set()
            while current in links:
                if current in seen or len(seen) >= 32:
                    raise ValueError('cyclic or excessive vendor link chain')
                seen.add(current)
                current = links[current]
            if current not in members or not members[current].isfile():
                raise ValueError('vendor link does not resolve to one regular member')
        # Manual extraction never invokes archive code or retains ownership.
        for name, member in members.items():
            path = target / name
            path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
            if member.isdir():
                path.mkdir(mode=0o755, exist_ok=True)
            elif member.isfile():
                stream = source.extractfile(member)
                if stream is None:
                    raise ValueError('archive member data is absent')
                with stream, path.open('xb') as output:
                    copied = 0
                    while block := stream.read(65536):
                        copied += len(block)
                        if copied > member.size or time.monotonic() >= DEADLINE:
                            raise ValueError('member changed or extraction deadline expired')
                        output.write(block)
                    if copied != member.size:
                        raise ValueError('archive member truncated')
                    output.flush(); os.fsync(output.fileno())
                path.chmod(0o755 if member.mode & 0o111 else 0o644)
        for name in links:
            os.symlink(members[name].linkname, target / name)


def elf(path: Path, arch: str) -> None:
    with path.open('rb') as stream:
        header = stream.read(64)
    if (len(header) != 64 or header[:6] != b'\x7fELF\x02\x01'
            or struct.unpack_from('<H', header, 18)[0] != {'amd64': 62, 'arm64': 183}[arch]
            or struct.unpack_from('<H', header, 16)[0] not in (2, 3)):
        raise ValueError('artifact ELF identity does not match the selected architecture')


def artifact_members(tree: Path, record: dict) -> dict:
    """Bind reuse to current regular-file bytes, link identity and modes."""
    pending, result, total = [tree], {}, 0
    while pending:
        parent = pending.pop()
        with os.scandir(parent) as entries:
            for entry in entries:
                path = Path(entry.path)
                name = str(path.relative_to(tree))
                if name == 'artifact.json':
                    continue
                info = entry.stat(follow_symlinks=False)
                if len(result) >= record['maximum_members'] or time.monotonic() >= DEADLINE:
                    raise ValueError('artifact verification bound exceeded')
                if info.st_uid != 0 or (not stat.S_ISLNK(info.st_mode) and info.st_mode & 0o6022):
                    raise ValueError('artifact is writable or has unsafe ownership')
                if stat.S_ISDIR(info.st_mode):
                    result[name] = ['directory', stat.S_IMODE(info.st_mode)]
                    pending.append(path)
                elif stat.S_ISLNK(info.st_mode):
                    link = os.readlink(path)
                    resolved = path.resolve(strict=True)
                    if not resolved.is_relative_to(tree) or not resolved.is_file():
                        raise ValueError('artifact link escaped its immutable tree')
                    result[name] = ['link', link]
                elif stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
                    total += info.st_size
                    if total > record['expanded_bytes']:
                        raise ValueError('artifact verification byte bound exceeded')
                    digest = hashlib.sha256()
                    with path.open('rb') as stream:
                        while block := stream.read(65536):
                            if time.monotonic() >= DEADLINE:
                                raise TimeoutError('artifact verification deadline expired')
                            digest.update(block)
                    after = path.lstat()
                    if (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
                        raise ValueError('artifact changed during verification')
                    result[name] = ['file', stat.S_IMODE(info.st_mode), info.st_size, digest.hexdigest()]
                else:
                    raise ValueError('artifact contains an unsafe member')
    return result


def artifact(name: str, arch: str) -> Path:
    record = json_document(regular(CATALOG))['artifacts'][name]
    if arch not in record['architectures']:
        raise ValueError('no qualified artifact for the selected architecture')
    identity = record['architectures'][arch].get('sha256', record['architectures'][arch].get('sha512'))
    protected_directory(RELEASES, 0o755)
    destination = RELEASES / (name + '-' + identity)
    if destination.exists():
        receipt = json_document(regular(destination / 'artifact.json', maximum=8388608))
        expected = {'format': 1, 'artifact': name, 'architecture': arch, 'digest': identity,
                    'members': artifact_members(destination, record)}
        if receipt != expected:
            raise ValueError('existing artifact identity differs')
        return destination
    work = Path(tempfile.mkdtemp(prefix='.artifact-', dir=RELEASES))
    # Keep failed work and its exact path for inspection; never sweep siblings.
    archive = work / 'download'
    acquire(record, arch, archive)
    tree = work / 'tree'
    tree.mkdir(mode=0o755)
    if record['kind'] in ('elf', 'file'):
        shutil.copyfile(archive, tree / record['entry'])
        (tree / record['entry']).chmod(0o755 if record['kind'] == 'elf' else 0o644)
    else:
        extract(archive, tree, record)
    entry = tree / record['entry']
    if not entry.is_file() or entry.is_symlink():
        raise ValueError('pinned artifact entry is absent or a link')
    if record['kind'] == 'elf' or name in ('github-actions', 'dotnet', 'whisper'):
        elf(entry, arch)
    receipt = {'format': 1, 'artifact': name, 'architecture': arch, 'digest': identity,
               'members': artifact_members(tree, record)}
    write(tree / 'artifact.json', json.dumps(receipt, sort_keys=True).encode(), 0o644)
    for directory, names, files in os.walk(tree, topdown=False, followlinks=False):
        sync_directory(Path(directory))
    os.rename(tree, destination)
    sync_directory(RELEASES)
    archive.unlink()
    work.rmdir()
    return destination


def status(home: Path, value: str) -> None:
    write(home / 'status.json', json.dumps({'format': 1, 'state': value, 'online': False}).encode(), 0o644)










