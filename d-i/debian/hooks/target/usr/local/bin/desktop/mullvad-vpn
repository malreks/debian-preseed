#!/bin/sh
set -eu

PATH=__INSTALLER_PATH_DIR_USR__/bin:/bin
LC_ALL=C.UTF-8
export PATH LC_ALL
umask 077
# find must not inspect an arbitrary caller working directory under confinement.
cd /

fatal() {
  printf 'fatal: %s\n' "$*" >&2
  exit 1
}

validate_wayland_session() {
  current_uid=$(__INSTALLER_PATH_DIR_USR__/bin/id -u 2>__INSTALLER_PATH_DIR_DEV__/null) ||
    fatal "cannot resolve the current account ID"
  case "$current_uid" in
    ''|*[!0-9]*) fatal "the current account ID is invalid" ;;
  esac
  [ "$current_uid" -gt 0 ] || fatal "Mullvad VPN must not run as root"

  [ "${LABWC_SESSION_OWNER:-}" = desktop ] ||
    fatal "Mullvad VPN requires the managed Labwc desktop session"
  [ "${XDG_SESSION_TYPE:-}" = wayland ] ||
    fatal "Mullvad VPN requires a native Wayland session"

  expected_runtime_dir="__INSTALLER_PATH_DIR_RUN_USER__/${current_uid}"
  [ "${XDG_RUNTIME_DIR:-}" = "$expected_runtime_dir" ] ||
    fatal "XDG_RUNTIME_DIR is not the managed account runtime directory"
  [ -d "$XDG_RUNTIME_DIR" ] && [ ! -L "$XDG_RUNTIME_DIR" ] ||
    fatal "XDG_RUNTIME_DIR is not a direct directory"
  runtime_owner=$(__INSTALLER_PATH_DIR_USR__/bin/find -P "$XDG_RUNTIME_DIR" -maxdepth 0 -printf '%U' 2>__INSTALLER_PATH_DIR_DEV__/null) ||
    fatal "cannot inspect XDG_RUNTIME_DIR ownership"
  runtime_mode=$(__INSTALLER_PATH_DIR_USR__/bin/find -P "$XDG_RUNTIME_DIR" -maxdepth 0 -printf '%m' 2>__INSTALLER_PATH_DIR_DEV__/null) ||
    fatal "cannot inspect XDG_RUNTIME_DIR mode"
  [ "$runtime_owner" = "$current_uid" ] ||
    fatal "XDG_RUNTIME_DIR is not owned by the current account"
  [ "$runtime_mode" = 700 ] ||
    fatal "XDG_RUNTIME_DIR must be mode 0700"

  case "${WAYLAND_DISPLAY:-}" in
    wayland-*) wayland_suffix=${WAYLAND_DISPLAY#wayland-} ;;
    *) fatal "WAYLAND_DISPLAY is not a managed Wayland socket name" ;;
  esac
  case "$wayland_suffix" in
    ''|*[!0-9]*) fatal "WAYLAND_DISPLAY is not a managed Wayland socket name" ;;
  esac

  wayland_socket="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"
  [ -S "$wayland_socket" ] && [ ! -L "$wayland_socket" ] ||
    fatal "the managed Wayland socket is unavailable"
  wayland_owner=$(__INSTALLER_PATH_DIR_USR__/bin/find -P "$wayland_socket" -maxdepth 0 -printf '%U' 2>__INSTALLER_PATH_DIR_DEV__/null) ||
    fatal "cannot inspect the managed Wayland socket ownership"
  wayland_links=$(__INSTALLER_PATH_DIR_USR__/bin/find -P "$wayland_socket" -maxdepth 0 -printf '%n' 2>__INSTALLER_PATH_DIR_DEV__/null) ||
    fatal "cannot inspect the managed Wayland socket link count"
  [ "$wayland_owner" = "$current_uid" ] ||
    fatal "the managed Wayland socket is not owned by the current account"
  [ "$wayland_links" = 1 ] ||
    fatal "the managed Wayland socket must have one filesystem link"
}

in_managed_host_unit() {
  # Unified cgroup membership comes from procfs, not a caller-supplied marker.
  [ -r __INSTALLER_PATH_DIR_PROC__/self/cgroup ] || fatal "cannot verify the Mullvad launcher cgroup"
  while IFS=: read -r hierarchy controllers cgroup; do
    [ "$hierarchy:$controllers" = "0:" ] || continue
    unit=${cgroup##*/}
    case "$unit" in
      labwc-wayland-mullvad-vpn-*.service)
        token=${unit#labwc-wayland-mullvad-vpn-}
        token=${token%.service}
        case "$token" in ''|*[!0123456789abcdef]*) continue ;; esac
        [ "${#token}" -eq 32 ] && return 0
        ;;
    esac
  done <__INSTALLER_PATH_DIR_PROC__/self/cgroup
  return 1
}

has_host_root_mapping() {
  # Fail explicitly on a locally overridden unit that reintroduces PrivateUsers.
  while read -r inside outside count; do
    [ "$inside" = 0 ] && [ "$outside" = 0 ] && [ "$count" -gt 0 ] && return 0
  done <__INSTALLER_PATH_DIR_PROC__/self/uid_map
  return 1
}

[ "$#" -eq 0 ] || fatal "usage: mullvad-vpn"
validate_wayland_session
if ! in_managed_host_unit; then
  exec __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/labwc-wayland-app auto -- __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/mullvad-vpn
fi
has_host_root_mapping || fatal "Mullvad launcher requires the host root UID mapping"

daemon_unit=mullvad-daemon.service
root_helper=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/mullvad-daemon-start
vendor_gui='__INSTALLER_PATH_DIR_OPT__/Mullvad VPN/mullvad-gui'

[ -x "$root_helper" ] || fatal "Mullvad daemon start helper is unavailable"
[ -f "$vendor_gui" ] && [ ! -L "$vendor_gui" ] && [ -x "$vendor_gui" ] ||
  fatal "Mullvad VPN executable is unavailable"
# The vendor shell launcher silently supplies --no-sandbox when namespaces
# are disabled. Launch the package binary through our existing strict wrapper
# instead, and fail before starting it if the namespace sandbox is disabled.
if [ -r __INSTALLER_PATH_DIR_PROC__/sys/kernel/unprivileged_userns_clone ]; then
  userns_enabled=$(__INSTALLER_PATH_DIR_USR__/bin/cat __INSTALLER_PATH_DIR_PROC__/sys/kernel/unprivileged_userns_clone) ||
    fatal "cannot read the user namespace policy"
  [ "$userns_enabled" = 1 ] || fatal "Mullvad VPN requires its unprivileged namespace sandbox"
fi
userns_limit=$(__INSTALLER_PATH_DIR_USR__/bin/cat __INSTALLER_PATH_DIR_PROC__/sys/user/max_user_namespaces) ||
  fatal "cannot read the user namespace limit"
case "$userns_limit" in ''|*[!0-9]*) fatal "cannot validate the user namespace limit" ;; esac
[ "$userns_limit" -gt 0 ] || fatal "Mullvad VPN requires available user namespaces"

if ! __INSTALLER_PATH_DIR_USR__/bin/systemctl --quiet is-active "$daemon_unit"; then
  if __INSTALLER_PATH_DIR_USR__/bin/timeout \
      --foreground \
      --kill-after=5s \
      120s \
      __INSTALLER_PATH_DIR_USR__/bin/pkexec \
      "$root_helper"
  then
    :
  else
    start_status=$?
    fatal "Mullvad daemon start was cancelled or failed (status ${start_status})"
  fi
fi

__INSTALLER_PATH_DIR_USR__/bin/systemctl --quiet is-active "$daemon_unit" ||
  fatal "Mullvad daemon did not become active"

unset \
  DESKTOP_STARTUP_ID \
  DISPLAY \
  SESSION_MANAGER \
  WINDOWID \
  WLR_XWAYLAND \
  XAUTHORITY \
  XWAYLAND \
  XWAYLAND_FORCE_SCALE \
  XWAYLAND_NO_GLAMOR \
  XWAYLAND_PATH \
  XWAYLAND_RESTART_DELAY \
  _XWAYLAND_GLOBAL_OUTPUT_SCALE

ELECTRON_OZONE_PLATFORM_HINT=wayland
GDK_BACKEND=wayland
QT_QPA_PLATFORM=wayland
SDL_VIDEODRIVER=wayland
export \
  ELECTRON_OZONE_PLATFORM_HINT \
  GDK_BACKEND \
  QT_QPA_PLATFORM \
  SDL_VIDEODRIVER

# The GUI must outlive the panel and remain separate from its namespace/cgroup.
exec __INSTALLER_PATH_DIR_USR_LOCAL_BIN__/labwc-electron-app auto -- "$vendor_gui"
