def desktop_policy() -> dict:
    """Share the root-owned action map with package and menu reconciliation."""
    global _DESKTOP_POLICY
    if _DESKTOP_POLICY is None:
        hook = pathlib.Path('__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-wrap-desktop-files')
        for path in (hook, *hook.parents):
            metadata = path.lstat()
            expected = stat.S_ISREG if path == hook else stat.S_ISDIR
            if not expected(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_mode & 0o022:
                raise RuntimeError('unsafe shared desktop action policy')
        _DESKTOP_POLICY = runpy.run_path(str(hook))
    return _DESKTOP_POLICY


@lru_cache(maxsize=1)
def configured_defaults() -> dict[str, str]:
    # Each oneshot invocation reads the current root-owned configuration once.
    # Keep its launcher/autostart/dock publication on the same default snapshot.
    return desktop_policy()['load_defaults']()


def read_regular_text(
    path: str,
    owners: set[int],
    *,
    allow_root_group_write: bool = False,
    size_limit: int = MAX_DESKTOP_FILE_BYTES,
) -> str:
    """Open the checked inode, not a symlink swapped in after lstat."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as handle:
        metadata = os.fstat(handle.fileno())
        mode = stat.S_IMODE(metadata.st_mode)
        if not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError(f"managed input is not a regular file: {path}")
        if metadata.st_uid not in owners:
            raise RuntimeError(
                f"managed input has an unexpected owner: {path}: uid={metadata.st_uid}"
            )
        trusted_root_group_write = (
            allow_root_group_write
            and metadata.st_uid == 0
            and metadata.st_gid == 0
            and bool(mode & stat.S_IROTH)
            and not mode & 0o7000
        )
        if mode & stat.S_IWOTH or (
            mode & stat.S_IWGRP and not trusted_root_group_write
        ):
            raise RuntimeError(
                "managed input is writable by an untrusted principal: "
                f"{path}: uid={metadata.st_uid} gid={metadata.st_gid} mode={mode:04o}"
            )
        if metadata.st_size > size_limit:
            raise RuntimeError(
                f"managed input exceeds {size_limit} bytes: {path}"
            )
        data = handle.read(size_limit + 1)
        if len(data) > size_limit:
            raise RuntimeError(f"managed input grew beyond its size limit: {path}")
        return data.decode("utf-8")


def read_system_desktop_text(path: str) -> str:
    # Some vendor packages install desktop entries as root:root mode 0775.
    # These fixed system paths remain immutable to the desktop account: permit
    # only the root administrative group write bit while retaining the strict
    # policy for defaults, user launchers, autostart files, and destinations.
    return read_regular_text(path, {0}, allow_root_group_write=True)


def acquire_lock(directory: str, uid: int, gid: int):
    path = os.path.join(directory, ".labwc-launcher-sync.lock")
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    handle = os.fdopen(fd, "r+")
    try:
        metadata = os.fstat(fd)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1
                or metadata.st_uid not in {0, uid} or metadata.st_mode & 0o077):
            raise RuntimeError(f"unsafe synchronization lock: {path}")
        if os.geteuid() == 0:
            os.fchown(fd, uid, gid)
        deadline = time.monotonic() + 15
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return handle
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError("another launcher synchronization is still running")
                time.sleep(0.1)
    except BaseException:
        handle.close()
        raise


def load_acceleration_availability(path: str) -> dict[str, bool]:
    try:
        metadata = os.lstat(path)
    except OSError as exc:
        raise RuntimeError(f"managed desktop defaults are unavailable: {path}: {exc}") from exc
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise RuntimeError(f"managed desktop defaults must be a regular file: {path}")
    if metadata.st_uid != 0 or metadata.st_mode & 0o022:
        raise RuntimeError(
            "managed desktop defaults must be root-owned and not writable by "
            f"group or others: {path}"
        )
    if metadata.st_size > MAX_DESKTOP_FILE_BYTES:
        raise RuntimeError(
            f"managed desktop defaults exceed {MAX_DESKTOP_FILE_BYTES} bytes: {path}"
        )

    values: dict[str, str] = {}
    try:
        lines = read_regular_text(path, {0}).splitlines()
    except (OSError, UnicodeError) as exc:
        raise RuntimeError(f"failed to read managed desktop defaults: {path}: {exc}") from exc
    for line_number, raw_line in enumerate(lines, start=1):
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, raw_value = line.split("=", 1)
        key = key.strip()
        if key not in ACCELERATION_DEFAULT_KEYS:
            continue
        if key in values:
            raise RuntimeError(f"duplicate {key} assignment on line {line_number}")
        try:
            parsed = shlex.split(raw_value, comments=False, posix=True)
        except ValueError as exc:
            raise RuntimeError(
                f"invalid {key} assignment on line {line_number}: {exc}"
            ) from exc
        if len(parsed) != 1:
            raise RuntimeError(f"invalid {key} assignment on line {line_number}")
        values[key] = parsed[0]

    availability: dict[str, bool] = {}
    for mode, key in (
        ("intel", "LABWC_INTEL_ACCELERATION_AVAILABLE"),
        ("nvidia", "LABWC_NVIDIA_ACCELERATION_AVAILABLE"),
    ):
        value = values.get(key, "")
        if value not in {"true", "false"}:
            raise RuntimeError(f"{key} must be true or false in managed desktop defaults")
        availability[mode] = value == "true"
    return availability


def available_actions(
    requested_actions: tuple[str, ...],
    availability: dict[str, bool],
) -> tuple[str, ...]:
    filtered: list[str] = []
    for action in requested_actions:
        if action not in desktop_policy()["ACTION_SPECS"]:
            raise RuntimeError(f"unknown managed desktop action: {action}")
        mode, _display_name = desktop_policy()["ACTION_SPECS"][action]
        if mode in {"intel", "nvidia"} and not availability[mode]:
            continue
        filtered.append(action)
    return tuple(filtered)


def ensure_user_directory(path: str, uid: int, gid: int) -> None:
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        try:
            os.mkdir(path, MANAGED_DIRECTORY_MODE)
        except FileExistsError:
            pass
        metadata = os.lstat(path)

    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise RuntimeError(f"managed user path is not a directory: {path}")
    if metadata.st_uid not in {0, uid}:
        raise RuntimeError(f"managed user directory has an unexpected owner: {path}")
    if (metadata.st_uid, metadata.st_gid) != (uid, gid):
        os.chown(path, uid, gid)
    os.chmod(path, MANAGED_DIRECTORY_MODE)


def application_data_home(account_home: str) -> str:
    # Root installation must never act on inherited user XDG paths. At session
    # time this is a per-user synchronizer, and absolute user XDG roots apply.
    configured = os.environ.get("XDG_DATA_HOME", "") if os.geteuid() != 0 else ""
    if configured and os.path.isabs(configured):
        return os.path.normpath(configured)
    return os.path.join(account_home, ".local", "share")


def ensure_application_directory(account_home: str, uid: int, gid: int) -> str:
    data_dir = application_data_home(account_home)
    default = os.path.join(account_home, ".local", "share")
    if data_dir == default:
        for directory in (os.path.join(account_home, ".local"), data_dir):
            ensure_user_directory(directory, uid, gid)
    else:
        # Only reached unprivileged. Never chmod/chown existing custom data
        # parents (e.g. a shared filesystem root); create missing private paths.
        pending = []
        candidate = data_dir
        while not os.path.lexists(candidate):
            pending.append(candidate)
            candidate = os.path.dirname(candidate)
        for parent in (candidate, *pathlib.Path(candidate).parents):
            metadata = os.lstat(parent)
            if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
                raise RuntimeError(f"unsafe XDG data ancestor: {parent}")
        for directory in reversed(pending):
            os.mkdir(directory, MANAGED_DIRECTORY_MODE)
        metadata = os.lstat(data_dir)
        if metadata.st_uid != uid or metadata.st_mode & 0o022:
            raise RuntimeError(f"XDG data root must be owned by the desktop user and not shared-writable: {data_dir}")
    desktop_dir = os.path.join(data_dir, "applications")
    ensure_user_directory(desktop_dir, uid, gid)
    return desktop_dir


def validate_account_context(account_user: str, account_home: str) -> tuple[int, int]:
    try:
        account = pwd.getpwnam(account_user)
    except KeyError as exc:
        raise RuntimeError(f"account is unavailable: {account_user}") from exc

    if os.geteuid() not in {0, account.pw_uid}:
        raise RuntimeError("must run as the target user or root")
    normalized_home = os.path.normpath(account_home)
    if (
        not os.path.isabs(account_home)
        or normalized_home != account_home
        or normalized_home == "/"
        or account.pw_dir != account_home
    ):
        raise RuntimeError(f"account home does not match passwd: {account_home}")

    metadata = os.lstat(account_home)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise RuntimeError(f"account home is not a directory: {account_home}")
    if metadata.st_uid != account.pw_uid:
        raise RuntimeError(f"account home owner does not match passwd: {account_home}")
    return account.pw_uid, account.pw_gid


def desktop_content(parser: configparser.ConfigParser) -> str:
    return "".join(
        f"[{section}]\n" + "".join(f"{key}={value}\n" for key, value in parser[section].items()) + "\n"
        for section in parser.sections()
    )


def write_desktop_file(
    path: str,
    parser: configparser.ConfigParser,
    uid: int,
    gid: int,
    validate: str | None,
) -> bool:
    destination_dir = os.path.dirname(path)
    destination_name = os.path.basename(path)
    content = desktop_content(parser)
    try:
        old_content = read_regular_text(path, {uid, 0})
        metadata = os.lstat(path)
        if old_content == content and stat.S_IMODE(metadata.st_mode) == MANAGED_FILE_MODE and metadata.st_uid == uid:
            return False
    except FileNotFoundError:
        pass
    file_descriptor, temporary_path = tempfile.mkstemp(
        prefix=f".{destination_name}.",
        suffix=".desktop",
        dir=destination_dir,
        text=True,
    )
    try:
        with os.fdopen(file_descriptor, "w", encoding="utf-8") as handle:
            os.fchmod(handle.fileno(), MANAGED_FILE_MODE)
            if os.geteuid() == 0:
                os.fchown(handle.fileno(), uid, gid)
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())

        if validate:
            result = subprocess.run(
                [validate, temporary_path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
                check=False,
            )
            if result.returncode != 0:
                raise RuntimeError(f"desktop-file-validate rejected {destination_name}")
        os.replace(temporary_path, path)
        directory_fd = os.open(destination_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
        return True
    finally:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass


def remove_unmanaged_tuta_launchers(account_home: str, uid: int, desktop_dir: str | None = None) -> int:
    removed = 0
    for directory in (
        desktop_dir or os.path.join(account_home, ".local", "share", "applications"),
        os.path.join(account_home, ".config", "autostart"),
    ):
        try:
            directory_metadata = os.lstat(directory)
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(directory_metadata.st_mode) or not stat.S_ISDIR(directory_metadata.st_mode):
            continue

        with os.scandir(directory) as entries:
            for entry in entries:
                if "tuta" not in entry.name.casefold():
                    continue
                try:
                    metadata = entry.stat(follow_symlinks=False)
                except FileNotFoundError:
                    continue
                if (
                    not stat.S_ISREG(metadata.st_mode)
                    or metadata.st_uid not in {0, uid}
                    or metadata.st_size > MAX_DESKTOP_FILE_BYTES
                ):
                    continue

                parser = configparser.ConfigParser(interpolation=None, strict=False)
                parser.optionxform = str
                try:
                    parser.read_string(read_regular_text(entry.path, {0, uid}))
                except (OSError, RuntimeError, configparser.Error, UnicodeError):
                    continue
                if not parser.has_section("Desktop Entry"):
                    continue
                executable = parser["Desktop Entry"].get("Exec", "").strip()
                if executable.startswith("__INSTALLER_PATH_DIR_OPT__/tuta") or "AooRun" in executable:
                    os.unlink(entry.path)
                    removed += 1
    return removed


def normalize_bitwarden_autostart_mode(
    account_home: str, path: str, metadata: os.stat_result, uid: int, gid: int,
) -> bool:
    """Adopt Electron's owner-created 0660 file, not arbitrary writable input.

    The private directory chain prevents other group members from reaching
    this entry. Check that chain and the opened inode before changing mode;
    the ordinary strict reader remains unchanged for every other input.
    """
    if stat.S_IMODE(metadata.st_mode) != 0o660:
        return False
    if (metadata.st_uid != uid or metadata.st_gid != gid
            or metadata.st_nlink != 1):
        raise RuntimeError(f"Bitwarden autostart ownership is unsafe: {path}")
    for directory in (account_home, os.path.join(account_home, ".config"),
                      os.path.dirname(path)):
        parent = os.lstat(directory)
        if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid != uid
                or parent.st_mode & 0o077):
            raise RuntimeError(f"Bitwarden autostart parent is not private: {directory}")
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        opened = os.fstat(descriptor)
        if (not stat.S_ISREG(opened.st_mode)
                or (opened.st_dev, opened.st_ino) != (metadata.st_dev, metadata.st_ino)
                or opened.st_uid != uid or opened.st_gid != gid
                or opened.st_nlink != 1 or stat.S_IMODE(opened.st_mode) != 0o660
                or opened.st_size > MAX_DESKTOP_FILE_BYTES):
            raise RuntimeError(f"Bitwarden autostart changed during validation: {path}")
        os.fchmod(descriptor, MANAGED_FILE_MODE)
    finally:
        os.close(descriptor)
    return True


def synchronize_bitwarden_autostart(
    account_home: str,
    uid: int,
    gid: int,
    validate: str | None,
) -> bool:
    autostart_path = os.path.join(
        account_home,
        ".config",
        "autostart",
        "bitwarden.desktop",
    )
    try:
        metadata = os.lstat(autostart_path)
    except FileNotFoundError:
        return False
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid not in {0, uid}
        or metadata.st_size > MAX_DESKTOP_FILE_BYTES
    ):
        raise RuntimeError(f"Bitwarden autostart entry is unsafe: {autostart_path}")

    mode_changed = normalize_bitwarden_autostart_mode(
        account_home, autostart_path, metadata, uid, gid,
    )
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str
    try:
        parser.read_string(read_regular_text(autostart_path, {0, uid}))
    except (OSError, configparser.Error, UnicodeError) as exc:
        raise RuntimeError(
            f"Bitwarden autostart entry is invalid: {autostart_path}: {exc}"
        ) from exc
    if not parser.has_section("Desktop Entry"):
        raise RuntimeError(
            f"Bitwarden autostart entry lacks [Desktop Entry]: {autostart_path}"
        )

    strip_desktop_actions(parser)
    entry = parser["Desktop Entry"]
    managed_command = managed_default_exec("bitwarden", "--autostart")
    changed = normalize_managed_launch_metadata(entry)
    if entry.get("Exec", "").strip() != managed_command:
        entry["Exec"] = managed_command
        changed = True
    if not changed:
        return mode_changed
    write_desktop_file(autostart_path, parser, uid, gid, validate)
    return True


def managed_exec(mode: str, app_name: str, field_code: str) -> str:
    return desktop_policy()["managed_exec"](mode, app_name, field_code)


def managed_default_exec(
    app_name: str,
    field_code: str,
    default_mode: str | None = None,
) -> str:
    # All fixed application entrypoints, including qBittorrent and ChatGPT,
    # receive the configured managed default through the shared constructor.
    return desktop_policy()['managed_default_command'](
        {'action_app': app_name, 'field_code': field_code}, configured_defaults()['managed'],
    )


def normalize_managed_launch_metadata(entry: configparser.SectionProxy) -> bool:
    # Managed launchers must execute the rewritten wrapper command. Retaining a
    # vendor D-Bus activation flag lets desktop launchers bypass Exec entirely,
    # while startup notification cannot follow the wrapper's systemd/bwrap
    # process handoff and can leave the compositor-side launch pipe unusable.
    changed = (
        entry.get("DBusActivatable", "").strip().lower() != "false"
        or entry.get("StartupNotify", "").strip().lower() != "false"
    )
    entry["DBusActivatable"] = "false"
    entry["StartupNotify"] = "false"
    return changed


def add_actions(
    parser: configparser.ConfigParser,
    app_name: str,
    field_code: str,
    enabled_actions: tuple[str, ...] = (),
    policy_actions: tuple[tuple[str, str, str], ...] = (),
) -> None:
    entry = parser["Desktop Entry"]
    # Package-owned desktop files are untrusted metadata at this boundary.
    # Remove every vendor action section and rebuild the complete action list
    # from explicit project policy so raw vendor Exec values cannot survive
    # package upgrades, aliases, or account synchronization.
    for section in tuple(parser.sections()):
        if section.startswith("Desktop Action "):
            parser.remove_section(section)
    actions: list[str] = []
    policy_by_id: dict[str, tuple[str, str]] = {}
    for action, display_name, command in policy_actions:
        if (re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", action) is None
                or not display_name or not command):
            raise RuntimeError(f"invalid project desktop action: {action!r}")
        if action in policy_by_id or action in desktop_policy()["ACTION_SPECS"]:
            raise RuntimeError(f"duplicate project desktop action: {action}")
        policy_by_id[action] = (display_name, command)
        actions.append(action)
    for action in enabled_actions:
        if action not in desktop_policy()["ACTION_SPECS"]:
            raise RuntimeError(f"unknown managed desktop action: {action}")
        if action not in actions:
            actions.append(action)
    if actions:
        entry["Actions"] = ";".join(actions) + ";"
    else:
        entry.pop("Actions", None)

    for action, (display_name, command) in policy_by_id.items():
        section = f"Desktop Action {action}"
        parser.add_section(section)
        parser[section]["Name"] = display_name
        parser[section]["Exec"] = command

    for action in enabled_actions:
        mode, display_name = desktop_policy()["ACTION_SPECS"][action]
        section = f"Desktop Action {action}"
        parser.add_section(section)
        parser[section]["Name"] = display_name
        parser[section]["Exec"] = managed_exec(mode, app_name, field_code)


def strip_desktop_actions(parser: configparser.ConfigParser) -> None:
    """Remove vendor action sections from non-launcher desktop metadata."""
    entry = parser["Desktop Entry"] if parser.has_section("Desktop Entry") else None
    for section in tuple(parser.sections()):
        if section.startswith("Desktop Action "):
            parser.remove_section(section)
    if entry is not None:
        entry.pop("Actions", None)


def find_desktop_file(desktop_names: tuple[str, ...]) -> tuple[str, str] | None:
    # Directory precedence wins over alternative vendor desktop IDs. Never
    # feed our generated account-local files back into the synchronizer.
    # Prefer the original vendor entry over a project fallback template.
    for directory in (SYSTEM_APPLICATION_DIR, LOCAL_APPLICATION_DIR):
        for desktop_name in desktop_names:
            source_path = os.path.join(directory, desktop_name)
            try:
                os.lstat(source_path)
            except FileNotFoundError:
                continue
            # read_regular_text performs the ownership/symlink check. A broken,
            # unreadable or hostile local override must not silently fall back.
            return desktop_name, source_path
    if TUTA_DESKTOP_ID in desktop_names and os.path.exists(TUTA_MANAGED_DESKTOP_SOURCE):
        return TUTA_DESKTOP_ID, TUTA_MANAGED_DESKTOP_SOURCE
    return None


def code_runtime_available() -> bool:
    try:
        metadata = os.stat(CODE_EXECUTABLE)
    except FileNotFoundError:
        return False
    return (stat.S_ISREG(metadata.st_mode) and metadata.st_uid == 0
            and not metadata.st_mode & 0o022 and bool(metadata.st_mode & 0o111))


def desktop_source(config: dict) -> tuple[str, str] | None:
    resolved = find_desktop_file(config["desktop_names"])
    if resolved is not None:
        name, path = resolved
        return name, read_system_desktop_text(path)
    if config["action_app"] == "code" and code_runtime_available():
        return "code.desktop", CODE_FALLBACK_DESKTOP
    return None


def synchronize_tuta_mime_defaults(account_home: str, uid: int, gid: int) -> bool:
    """Repair managed mail defaults without rewriting other associations/comments."""
    directory = os.path.join(account_home, ".config")
    ensure_user_directory(directory, uid, gid)
    path = os.path.join(directory, "mimeapps.list")
    try:
        original = read_regular_text(path, {0, uid})
    except FileNotFoundError:
        original = ""
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.read_string(original)  # Fail closed on a malformed file; do not truncate it.
    lines = original.splitlines(keepends=True)
    output: list[str] = []
    section = ""
    handled: set[str] = set()
    seen: set[str] = set()
    targets = {"Default Applications", "Added Associations"}
    def finish_section() -> None:
        if section in targets and section not in handled:
            if output and not output[-1].endswith("\n"):
                output[-1] += "\n"
            for scheme in TUTA_SCHEMES:
                if scheme not in seen:
                    output.append(f"{scheme}={TUTA_DESKTOP_ID};\n")
            handled.add(section)
    for line in lines:
        match = re.fullmatch(r"\s*\[([^]\r\n]+)\]\s*", line.rstrip("\r\n"))
        if match:
            finish_section()
            section = match.group(1)
            seen.clear()
        key, separator, value = line.strip().partition("=")
        if section in targets and separator and key in TUTA_SCHEMES:
            if section not in handled and key not in seen:
                output.append(f"{key}={TUTA_DESKTOP_ID};\n")
                seen.add(key)
            continue
        if section == "Removed Associations" and key in TUTA_SCHEMES and separator:
            remaining = [item for item in value.split(";") if item and item != TUTA_DESKTOP_ID]
            if remaining:
                output.append(f"{key}={';'.join(remaining)};\n")
            continue
        output.append(line)
    finish_section()
    for missing in sorted(targets - handled):
        if output and not output[-1].endswith("\n"):
            output[-1] += "\n"
        output.append(f"\n[{missing}]\n")
        output.extend(f"{scheme}={TUTA_DESKTOP_ID};\n" for scheme in TUTA_SCHEMES)
    content = "".join(output)
    if content == original:
        return False
    fd, temporary = tempfile.mkstemp(prefix=".mimeapps.list.", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            os.fchmod(handle.fileno(), MANAGED_FILE_MODE)
            if os.geteuid() == 0:
                os.fchown(handle.fileno(), uid, gid)
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        if os.path.lexists(temporary):
            os.unlink(temporary)
    return True


def parse_desktop(text: str) -> configparser.ConfigParser:
    parser = configparser.ConfigParser(interpolation=None, strict=True)
    parser.optionxform = str
    parser.read_string(text)
    return parser


def synchronize_catalog(account_home: str, desktop_dir: str, uid: int, gid: int,
                        validate: str | None, availability: dict[str, bool]) -> None:
    """Add actions for the complete GUI catalog and prepare the dock view.

    The dock view uses the same IDs, names, icons and action map. Its main Exec
    alone is the managed default; systemd exposes that view only to the dock.
    Account overrides keep their normal command and receive the same actions.
    """
    policy = desktop_policy()
    defaults = configured_defaults()
    enabled = available_actions(('IntelAccelerated', 'NvidiaAccelerated'), availability)
    known_names = {name for config in policy['APP_CONFIG'] for name in config['desktop_names']}
    effective: dict[str, pathlib.Path] = {}
    # Account entries include the fixed app aliases published just above.
    for directory in (desktop_dir, LOCAL_APPLICATION_DIR, SYSTEM_APPLICATION_DIR):
        root = pathlib.Path(directory)
        if not root.is_dir():
            continue
        for source in sorted(root.rglob('*.desktop')):
            name = source.relative_to(root).as_posix().replace('/', '-')
            if len(effective) >= 2048 and name not in effective:
                raise RuntimeError('desktop catalog exceeds 2048 entries')
            effective.setdefault(name, source)
    dock = pathlib.Path(account_home) / '.local/share/labwc-dock'
    for directory in (pathlib.Path(account_home) / '.local',
                      pathlib.Path(account_home) / '.local/share', dock, dock / 'applications'):
        ensure_user_directory(str(directory), uid, gid)
    dock_apps = dock / 'applications'
    state = dock / 'catalog.json'
    previous = {}
    if state.exists():
        previous = json.loads(read_regular_text(str(state), {uid}, size_limit=1024 * 1024))
        if not isinstance(previous, dict) or len(previous) > 2048:
            raise RuntimeError('invalid managed desktop catalog state')
    # An interruption can publish a launcher before publishing catalog.json.
    # Its self-contained receipt recovers ownership only while every managed
    # field still matches; an account edit invalidates it. No privilege derives
    # from this account-owned metadata, and source roots are checked below.
    for name, source in effective.items():
        if (source.parent != pathlib.Path(desktop_dir) or name in known_names
                or source.lstat().st_uid != uid):
            continue
        text = read_regular_text(str(source), {uid})
        try:
            candidate = parse_desktop(text)
            entry = candidate['Desktop Entry']
            original = entry.get('X-Labwc-CatalogSource')
            digest = entry.pop('X-Labwc-CatalogDigest', None)
            if (original and digest and re.fullmatch('[0-9a-f]{64}', digest)
                    and hashlib.sha256(desktop_content(candidate).encode('utf-8')).hexdigest() == digest):
                previous[name] = {'source': original, 'sha256': hashlib.sha256(text.encode('utf-8')).hexdigest()}
        except (configparser.Error, KeyError):
            continue
    current = {}
    for name, receipt in previous.items():
        if (not isinstance(name, str) or pathlib.Path(name).name != name or not name.endswith('.desktop')
                or not isinstance(receipt, dict) or set(receipt) != {'source', 'sha256'}
                or not isinstance(receipt['source'], str)
                or re.fullmatch('[0-9a-f]{64}', receipt['sha256']) is None):
            raise RuntimeError('unsafe managed desktop catalog receipt')
        original = pathlib.Path(receipt['source'])
        if (not original.is_absolute() or '..' in original.parts or not original.name.endswith('.desktop')
                or not any(original.is_relative_to(root) for root in
                           (pathlib.Path(LOCAL_APPLICATION_DIR), pathlib.Path(SYSTEM_APPLICATION_DIR)))):
            raise RuntimeError('managed desktop source escapes application roots')
        destination = pathlib.Path(desktop_dir) / name
        if effective.get(name) == destination:
            content = read_regular_text(str(destination), {uid})
            if hashlib.sha256(content.encode('utf-8')).hexdigest() == receipt['sha256']:
                if original.exists():
                    effective[name] = original
                else:
                    destination.unlink()
                    effective.pop(name)
    published = set()
    for name, source in sorted(effective.items()):
        text = read_regular_text(str(source), {0, uid}, allow_root_group_write=source.parent != pathlib.Path(desktop_dir))
        try:
            parser = parse_desktop(text)
            if not parser.has_section('Desktop Entry'):
                continue
            entry = parser['Desktop Entry']
            if entry.get('Type') != 'Application' or entry.get('Hidden') == 'true' or not entry.get('Exec', '').strip():
                continue
            # Reuse the classified prefix on package-generated metadata. Only
            # previously unclassified entries require a read-only package query.
            prefix = defaults['wayland']
            words = shlex.split(entry.get('X-Labwc-ManagedExec', ''))
            if words and words[0] in policy['WRAPPERS'].values():
                kind = next(kind for kind, wrapper in policy['WRAPPERS'].items() if wrapper == words[0])
                prefix = defaults[kind]
            elif source.parent != pathlib.Path(desktop_dir):
                executable = shlex.split(entry['Exec'])[0]
                prefix = policy['launch_prefix'](source, executable, entry['Exec'], defaults)
            updated = policy['rewrite_desktop'](text, prefix, name=name, actions=enabled,
                                                managed_default=defaults['managed'])
            parser = parse_desktop(updated)
            entry = parser['Desktop Entry']
            if (name not in known_names and source.parent == pathlib.Path(desktop_dir)
                    and source.lstat().st_uid == uid):
                write_desktop_file(str(source), parser, uid, gid, validate)
            if name not in known_names and source.parent != pathlib.Path(desktop_dir):
                destination = pathlib.Path(desktop_dir) / name
                old = read_regular_text(str(destination), {uid}) if destination.exists() else None
                owned = (old is not None and name in previous
                         and hashlib.sha256(old.encode('utf-8')).hexdigest() == previous[name]['sha256'])
                if old is None or owned:
                    entry['X-Labwc-CatalogSource'] = str(source)
                    entry.pop('X-Labwc-CatalogDigest', None)
                    entry['X-Labwc-CatalogDigest'] = hashlib.sha256(desktop_content(parser).encode('utf-8')).hexdigest()
                    write_desktop_file(str(destination), parser, uid, gid, validate)
                    content = read_regular_text(str(destination), {uid})
                    current[name] = {'source': str(source), 'sha256': hashlib.sha256(content.encode('utf-8')).hexdigest()}
            clone = parse_desktop(updated)
            target = clone['Desktop Entry']
            if target.get('Terminal') == 'true':
                target['Exec'] = '__INSTALLER_PATH_DIR_USR_LOCAL_BIN__/labwc-terminal -e ' + target['Exec']
                target['Terminal'] = 'false'
            else:
                target['Exec'] = target.get('X-Labwc-ManagedExec') or prefix + ' -- ' + target['Exec']
            target['DBusActivatable'] = 'false'
            target['StartupNotify'] = 'false'
            write_desktop_file(str(dock_apps / name), clone, uid, gid, validate)
            published.add(name)
        except (configparser.Error, ValueError) as exc:
            # One malformed vendor entry must not remove the rest of the menu.
            print(f'warning: skipped desktop catalog entry {name}: {exc}', file=sys.stderr)
    # This directory is exclusively owned by the private dock view. Never
    # prune the user's real applications directory or follow symlink entries.
    for old in dock_apps.glob('*.desktop'):
        if old.name not in published:
            read_regular_text(str(old), {uid})
            old.unlink()
    descriptor = os.open(dock_apps, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    payload = json.dumps(current, sort_keys=True) + '\n'
    if len(payload.encode('utf-8')) > 1024 * 1024:
        raise RuntimeError('managed desktop catalog state exceeds its bound')
    old = read_regular_text(str(state), {uid}, size_limit=1024 * 1024) if state.exists() else None
    if payload != old:
        descriptor, temporary = tempfile.mkstemp(prefix='.catalog-', dir=dock)
        try:
            with os.fdopen(descriptor, 'w', encoding='utf-8') as stream:
                os.fchmod(stream.fileno(), MANAGED_FILE_MODE)
                if os.geteuid() == 0:
                    os.fchown(stream.fileno(), uid, gid)
                stream.write(payload)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, state)
        finally:
            if os.path.lexists(temporary):
                os.unlink(temporary)
        descriptor = os.open(dock, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


def main() -> int:
    configured_defaults.cache_clear()
    if len(sys.argv) not in {3, 5}:
        print("usage: labwc-sync-application-launchers <user> <home> [--coalesce-seconds 0..60]", file=sys.stderr)
        return 2

    delay = 0
    if len(sys.argv) == 5:
        if sys.argv[3] != "--coalesce-seconds" or not sys.argv[4].isascii() or not sys.argv[4].isdigit() or len(sys.argv[4]) > 2:
            return 2
        delay = int(sys.argv[4])
        if delay > 60:
            return 2
    os.umask(0o077)
    account_user = sys.argv[1]
    account_home = sys.argv[2]
    try:
        uid, gid = validate_account_context(account_user, account_home)
    except (OSError, RuntimeError) as exc:
        print(f"fatal: {exc}", file=sys.stderr)
        return 1

    try:
        desktop_dir = ensure_application_directory(account_home, uid, gid)
    except (OSError, RuntimeError) as exc:
        print(f"fatal: {exc}", file=sys.stderr)
        return 1

    # Keep the descriptor alive until this invocation exits; never unlink locks.
    synchronization_lock = acquire_lock(desktop_dir, uid, gid)
    if delay:
        time.sleep(delay)
    configured_defaults.cache_clear()
    acceleration_availability = load_acceleration_availability(DEFAULTS_PATH)
    validate = shutil.which("desktop-file-validate")
    processed = 0
    skipped_missing = 0
    missing_apps: list[str] = []
    invalid_apps: list[str] = []
    removed_unmanaged_tuta = 0
    synchronized_bitwarden_autostart = 0

    for config in desktop_policy()["APP_CONFIG"]:
        resolved_desktop = desktop_source(config)
        if resolved_desktop is None:
            skipped_missing += 1
            missing_apps.append(config["action_app"])
            continue
        desktop_name, source_text = resolved_desktop
        # One visible ID per application. Retain vendor aliases as managed,
        # non-menu entries so existing MIME associations and pinned IDs work.
        desktop_name = config["desktop_names"][0]
        destination_path = os.path.join(desktop_dir, desktop_name)

        parser = configparser.ConfigParser(interpolation=None, strict=False)
        parser.optionxform = str
        parser.read_string(source_text)
        if not parser.has_section("Desktop Entry"):
            print(f"warning: skipped {desktop_name}: missing [Desktop Entry]", file=sys.stderr)
            invalid_apps.append(config["action_app"])
            continue
        entry = parser["Desktop Entry"]
        # Preserve the effective system/vendor command. Managed entrypoints
        # belong to actions and the dock's private view, never the main Exec.
        if not entry.get("Exec", "").strip():
            invalid_apps.append(config["action_app"])
            continue
        compatibility = desktop_policy()['compatibility_exec'](entry['Exec'])
        if compatibility is not None:
            entry['Exec'] = compatibility
        normalize_managed_launch_metadata(entry)
        entry["X-Labwc-ManagedExec"] = managed_default_exec(
            config["action_app"], config["field_code"], config.get("default_mode"),
        ).strip()
        if config["action_app"] == "code" and not config.get("no_display"):
            entry["NoDisplay"] = "false"
        if config.get("no_display"):
            entry["NoDisplay"] = "true"
            entry["MimeType"] = "x-scheme-handler/vscode;"
        if config["action_app"] == "tutanota":
            entry["MimeType"] = ";".join(TUTA_SCHEMES) + ";"
            entry["X-GNOME-UsesNotifications"] = "true"
        add_actions(
            parser,
            config["action_app"],
            config["field_code"],
            available_actions(
                ("IntelAccelerated", "NvidiaAccelerated"),
                acceleration_availability,
            ),
            tuple(config.get("policy_actions", ())),
        )
        try:
            processed += int(write_desktop_file(destination_path, parser, uid, gid, validate))
            for alias in config["desktop_names"][1:]:
                entry["NoDisplay"] = "true"
                processed += int(write_desktop_file(os.path.join(desktop_dir, alias), parser, uid, gid, validate))
            if config["action_app"] == "tutanota":
                synchronize_tuta_mime_defaults(account_home, uid, gid)
        except (OSError, RuntimeError) as exc:
            print(f"fatal: failed to publish {desktop_name}: {exc}", file=sys.stderr)
            return 1

    try:
        synchronize_catalog(account_home, desktop_dir, uid, gid, validate, acceleration_availability)
        removed_unmanaged_tuta = remove_unmanaged_tuta_launchers(account_home, uid, desktop_dir)
        synchronized_bitwarden_autostart = int(
            synchronize_bitwarden_autostart(
                account_home,
                uid,
                gid,
                validate,
            )
        )
    except OSError as exc:
        print(f"fatal: failed to synchronize managed launchers: {exc}", file=sys.stderr)
        return 1
    except RuntimeError as exc:
        print(f"fatal: failed to synchronize managed launchers: {exc}", file=sys.stderr)
        return 1

    print(
        f"desktop_launcher_sync user={account_user} home={account_home} processed={processed} "
        f"skipped_missing={skipped_missing} missing={','.join(missing_apps) or 'none'} "
        f"skipped_invalid={len(invalid_apps)} invalid={','.join(invalid_apps) or 'none'} "
        f"removed_unmanaged_tuta={removed_unmanaged_tuta} "
        f"synchronized_bitwarden_autostart={synchronized_bitwarden_autostart}"
    )
    return 0


def interrupted(signum, _frame):
    raise SystemExit(128 + signum)


if __name__ == "__main__":
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, interrupted)
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, configparser.Error, UnicodeError, subprocess.TimeoutExpired) as exc:
        print(f"fatal: launcher synchronization failed: {exc}", file=sys.stderr)
        raise SystemExit(1)
