#!/bin/sh
set -eu

case "${1:-}" in
  --help|--version) exec __INSTALLER_PATH_DIR_USR__/bin/nmtui "$@" ;;
esac

# Opening the network UI is an explicit user request to enable Wi-Fi. Keep the
# package's native nmtui untouched; prepare the fixed profile before selection.
if [ -f __INSTALLER_PATH_DIR_ETC__/network/wifi.nmconnection ]; then
  exec __INSTALLER_PATH_DIR_USR__/bin/pkexec __INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/network-wifi-configure --nmtui "$@"
fi
exec __INSTALLER_PATH_DIR_USR__/bin/nmtui "$@"
