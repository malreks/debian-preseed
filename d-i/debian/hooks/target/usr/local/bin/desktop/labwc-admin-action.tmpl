#!/bin/sh
set -eu
umask 077

notify_failure() {
  notification_message=$1

  notify_send_cmd=$(command -v notify-send 2>__INSTALLER_PATH_DIR_DEV__/null || true)
  [ -n "$notify_send_cmd" ] && [ -x "$notify_send_cmd" ] || return 0

  "$notify_send_cmd" \
    -a "Desktop Power" \
    -u critical \
    -i __THEME_LABWC_MENU_POWER_ICON_NAME__ \
    -c x-labwc.power \
    "Power request failed" \
    "$notification_message" >__INSTALLER_PATH_DIR_DEV__/null 2>&1 || true
}

fatal() {
  fatal_message=$*
  printf 'fatal: %s\n' "$fatal_message" >&2
  notify_failure "$fatal_message"
  exit 1
}

require_executable() {
  [ -x "$1" ] || fatal "required executable is not available: $1"
}

action=${1:-}
[ "$#" -eq 1 ] && [ -n "$action" ] ||
  fatal "usage: labwc-admin-action <suspend|reboot|poweroff|shutdown|logout>"

case "$action" in
  shutdown) action=poweroff ;;
  suspend|reboot|poweroff|logout) ;;
  *)
    fatal "unsupported privileged desktop action: ${action}"
    ;;
esac

current_uid=$(__INSTALLER_PATH_DIR_USR__/bin/id -u) ||
  fatal "unable to resolve the invoking desktop account"
case "$current_uid" in
  ''|0|*[!0-9]*)
    fatal "desktop power requests require a non-root numeric user identity"
    ;;
esac
runtime_dir=${XDG_RUNTIME_DIR:-}
if [ "$runtime_dir" != "__INSTALLER_PATH_DIR_RUN_USER__/$current_uid" ] ||
   [ ! -d "$runtime_dir" ] ||
   [ -L "$runtime_dir" ] ||
   [ "$(__INSTALLER_PATH_DIR_USR__/bin/find -P "$runtime_dir" -maxdepth 0 -printf '%U' 2>__INSTALLER_PATH_DIR_DEV__/null || true)" != "$current_uid" ] ||
   [ "$(__INSTALLER_PATH_DIR_USR__/bin/find -P "$runtime_dir" -maxdepth 0 -printf '%m' 2>__INSTALLER_PATH_DIR_DEV__/null || true)" != 700 ]; then
  fatal "XDG_RUNTIME_DIR is unavailable or unsafe for the desktop power request"
fi

power_lock="${runtime_dir%/}/labwc-admin-action.lock"
[ ! -L "$power_lock" ] || fatal "unsafe desktop power lock"
exec 9>>"$power_lock"
[ "$(__INSTALLER_PATH_DIR_USR__/bin/find -H __INSTALLER_PATH_DIR_PROC__/self/fd/9 -maxdepth 0 -printf '%U:%n:%m')" = "$current_uid:1:600" ] ||
  fatal "unsafe desktop power lock metadata"
if ! __INSTALLER_PATH_DIR_USR__/bin/flock --nonblock 9; then
  fatal "another desktop power request is already awaiting authorization"
fi

pkexec_cmd=__INSTALLER_PATH_DIR_USR__/bin/pkexec
root_helper=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-admin-action-root
require_executable "$pkexec_cmd"
require_executable "$root_helper"

if [ "$action" = logout ]; then
  root_helper=__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/labwc-logout-root
  require_executable "$root_helper"
  set --
else
  set -- "$action"
fi

# Keep authentication in this foreground desktop process so the registered
# graphical Polkit agent can show the administrator-password prompt. The
# dedicated rule and root helper are independent of display-manager/login1
# active-session classification; rejected or cancelled requests leave Labwc
# and labwc-session.target untouched.
if "$pkexec_cmd" "$root_helper" "$@"; then
  exit 0
else
  action_status=$?
fi

notify_failure "The ${action} request was cancelled or failed (status ${action_status})."
exit "$action_status"
