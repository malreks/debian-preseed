<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>client</decoration>
    <!-- Initialize Labwc's output layout before the selector checks for a
         no-op. A DRM head can report Enabled: yes without a scene output
         when autoEnableOutputs is disabled, leaving gtkgreet no monitor. -->
    <autoEnableOutputs>yes</autoEnableOutputs>
    <primarySelection>no</primarySelection>
  </core>
  <windowRules>
    <!-- The private bus-free GTK session advertises the executable app_id.
         Keep its normal Wayland window alive across output/VT loss and make
         it fullscreen on first map. This rule is greeter-only. -->
    <windowRule identifier="gtkgreet" serverDecoration="no">
      <action name="ToggleFullscreen" />
    </windowRule>
  </windowRules>
  <keyboard>
    <keybind key="A-F4" />
    <keybind key="F10">
      <action name="Execute" command="__INSTALLER_PATH_DIR_USR_LOCAL_SBIN__/greetd-power-action reboot" />
    </keybind>
    <keybind key="F12">
      <action name="Execute" command="__INSTALLER_PATH_DIR_USR_LOCAL_SBIN__/greetd-power-action poweroff" />
    </keybind>
  </keyboard>
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press" />
    </context>
  </mouse>
</labwc_config>
