[Unit]
Description=Restore and stop persistent containers for the locked devops engine
Documentation=man:podman-start(1) man:podman-stop(1)
Requires=podman-devops-bootstrap.service podman-devops.service
After=podman-devops-bootstrap.service podman-devops.service
Before=shutdown.target
Conflicts=shutdown.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
User=devops
Group=devops
Environment=HOME=/nonexistent
Environment=XDG_CONFIG_HOME=__INSTALLER_PATH_DIR_RUN__/podman-devops/config
Environment=XDG_DATA_HOME=__INSTALLER_PATH_DIR_POOL__/podman/xdg-data
Environment=XDG_CACHE_HOME=__INSTALLER_PATH_DIR_POOL__/podman/xdg-cache
Environment=XDG_RUNTIME_DIR=__INSTALLER_PATH_DIR_RUN__/podman-devops
Environment=CONTAINERS_CONF=__INSTALLER_PATH_DIR_ETC__/podman-devops/client.conf
Environment=CONTAINER_HOST=unix://__INSTALLER_PATH_DIR_RUN__/podman-devops/podman.sock
Environment=TMPDIR=__INSTALLER_PATH_DIR_POOL__/podman/tmp
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS CONTAINER_CONNECTION CONTAINER_SSHKEY DOCKER_HOST DOCKER_CONTEXT CONTAINERS_STORAGE_CONF CONTAINERS_CONF_OVERRIDE
RuntimeDirectory=podman-devops
RuntimeDirectoryMode=0710
RuntimeDirectoryPreserve=yes
ExecStartPre=+__INSTALLER_PATH_DIR_USR_LOCAL_LIBEXEC__/podman-devops-host verify-start
ExecStart=__INSTALLER_PATH_DIR_USR__/bin/podman --remote --url=unix://__INSTALLER_PATH_DIR_RUN__/podman-devops/podman.sock start --all --filter should-start-on-boot=true
ExecStop=__INSTALLER_PATH_DIR_USR__/bin/podman --remote --url=unix://__INSTALLER_PATH_DIR_RUN__/podman-devops/podman.sock stop --all --ignore --time 20
TimeoutStartSec=180s
TimeoutStopSec=90s
Restart=on-failure
RestartSec=30s
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
