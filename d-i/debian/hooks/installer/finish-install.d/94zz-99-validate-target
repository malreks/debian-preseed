#!/bin/sh
# This is a target-readiness record, not an installation-success record.
# Only the guarded 99reboot sentinel may publish installation.success later.
set -eu
runtime=${INSTALLER_RUNTIME_DIR:-/tmp/install-runtime}
[ -f "$runtime/bootstrap/common-lib.sh" ] && [ ! -L "$runtime/bootstrap/common-lib.sh" ] || {
  printf '%s\n' 'fatal: cached installer common contract is unavailable at finish-install' >&2
  exit 1
}
. "$runtime/bootstrap/common-lib.sh"
. "$runtime/bootstrap/di.env"
installer_lifecycle_paths
[ -r "${DIR_INSTALLER_ENV}/runtime.env" ] || {
  validate_target_message='installer runtime environment is unavailable'
  printf '[finish-install:validate-target] fatal: %s\n' "$validate_target_message" >&2
  if [ -c /dev/tty4 ] && [ -w /dev/tty4 ]; then
    printf '[finish-install:validate-target] fatal: %s\n' "$validate_target_message" >/dev/tty4 || :
  fi
  if [ -c /dev/console ] && [ -w /dev/console ]; then
    printf '[finish-install:validate-target] fatal: %s\n' "$validate_target_message" >/dev/console || :
  fi
  if command -v logger >/dev/null 2>&1; then
    logger -t preseed-finish-validate "fatal: $validate_target_message" 2>/dev/null || :
  fi
  exit 1
}
# shellcheck disable=SC1090,SC1091
. "${DIR_INSTALLER_ENV}/runtime.env"
installer_operation_context_repo hooks/installer/finish-install.d/94zz-99-validate-target 25 finish_install_validate_target
tmp=
finish_validate_target_exit() {
  finish_validate_target_status=$?
  [ -z "$tmp" ] || rm -f -- "$tmp"
  if [ "$finish_validate_target_status" -ne 0 ]; then
    installer_record_failure "$finish_validate_target_status" finish-install 'target readiness validation failed' || :
    installer_preserve_failure || :
  fi
  if [ "$finish_validate_target_status" -ne 0 ] && command -v installer_error >/dev/null 2>&1; then
    installer_error "finish-install target validation exited with status ${finish_validate_target_status}"
  fi
  exit "$finish_validate_target_status"
}
trap finish_validate_target_exit 0
target=$(installer_target_context_path)
target_state="${target}${DIR_VAR_LIB_INSTALLER_STATE}"
# Reruns must earn readiness again, including after a previous successful scan.
path=$target_state
while [ "$path" != / ]; do
  [ ! -L "$path" ]
  path=${path%/*}; [ -n "$path" ] || path=/
done
rm -f "$LC_STATE/target-validated" "$target_state/target-validated"
[ -f "$LC_STATE/late.done" ]
[ ! -e "$LC_STATE/first-failure" ]
placeholder_registry=${DIR_INSTALLER_RUNTIME}/bootstrap/placeholder-registry.tsv
[ -f "$placeholder_registry" ] && [ ! -L "$placeholder_registry" ] || {
  printf '%s\n' 'fatal: authenticated placeholder ownership registry is unavailable' >&2
  exit 1
}
[ "$(installer_metadata_value "$placeholder_registry" uid_gid_mode_links)" = '0:0:600:1' ] || {
  printf '%s\n' 'fatal: placeholder ownership registry metadata is unsafe' >&2
  exit 1
}
chroot "$target" /bin/sh -eu -c '
target_etc=$1
target_boot=$2
target_lib=$3
target_usr_local_bin=$4
target_usr_local_sbin=$5
target_usr_local_libexec=$6
target_usr_local_lib=$7
target_usr_local_share=$8
target_usr_lib=$9
target_var_lib_install_state=${10}
target_firstboot=${11}
target_perl=${12}
target_python=${13}
target_apparmor=${14}
target_systemd=${15}
target_systemd_units=${16}
shift 16
audit=$(dpkg --audit)
[ -z "$audit" ] || { printf "%s\n" "$audit" >&2; exit 1; }
test -s "$target_etc/fstab"
test -s "$target_boot/grub/grub.cfg"
require_signature() {
  signatures=$(sbverify --list "$1" 2>&1)
  # sbverify --list may return zero for an unsigned PE image.
  printf "%s\n" "$signatures" | grep -Eq "^signature [0-9]+"
}
count=0
for image in "$target_boot"/vmlinuz-*; do
  test -s "$image" || continue
  version=${image#"$target_boot"/vmlinuz-}
  test -d "$target_lib/modules/$version"
  test -s "$target_boot/initrd.img-$version"
  lsinitramfs "$target_boot/initrd.img-$version" >/dev/null
  require_signature "$image"
  count=$((count + 1))
done
test "$count" -gt 0
arch=$(dpkg --print-architecture)
case "$arch" in amd64) suffix=x64 ;; arm64) suffix=aa64 ;; *) exit 1 ;; esac
for file in "$target_boot/efi/EFI/debian/shim${suffix}.efi" "$target_boot/efi/EFI/debian/grub${suffix}.efi" "$target_boot/efi/EFI/debian/mm${suffix}.efi"; do
  test -s "$file"
  require_signature "$file"
done
systemctl --root=/ get-default >/dev/null
# The desktop role publishes these two owned units before enabling them.
# Recheck at final readiness because intervening stages can mutate the target.
# Role gating by either installed unit is safe here: the ownership scan below
# independently rejects removal of every published unit, including both files.
if [ -e "$target_systemd_units/labwc-system-desktop-overrides.service" ] ||
   [ -L "$target_systemd_units/labwc-system-desktop-overrides.service" ] ||
   [ -e "$target_systemd_units/labwc-system-desktop-overrides.path" ] ||
   [ -L "$target_systemd_units/labwc-system-desktop-overrides.path" ]; then
  unit_parent="$target_systemd_units/multi-user.target.wants"
  while [ "$unit_parent" != / ]; do
    test -d "$unit_parent" && test ! -L "$unit_parent" || {
      printf "%s\n" "fatal: required desktop unit ancestry is absent or indirect" >&2
      exit 1
    }
    unit_parent=${unit_parent%/*}; [ -n "$unit_parent" ] || unit_parent=/
  done
  for unit in labwc-system-desktop-overrides.service labwc-system-desktop-overrides.path; do
    unit_file="$target_systemd_units/$unit"
    unit_link="$target_systemd_units/multi-user.target.wants/$unit"
    test -f "$unit_file" && test ! -L "$unit_file" &&
      [ "$(find -P "$unit_file" -maxdepth 0 -printf "%U:%G:%m:%n")" = "0:0:644:1" ] &&
      test -L "$unit_link" && [ "$(readlink "$unit_link")" = "$unit_file" ] &&
      [ "$(find -P "$unit_link" -maxdepth 0 -printf "%U:%G")" = "0:0" ] &&
      test -r "$unit_link" || {
        printf "fatal: required desktop unit is not safely enabled: %s\n" "$unit" >&2
        exit 1
      }
  done
fi
' sh \
  "$DIR_ETC" \
  "$DIR_BOOT" \
  "$DIR_LIB" \
  "$DIR_USR_LOCAL_BIN" \
  "$DIR_USR_LOCAL_SBIN" \
  "$DIR_USR_LOCAL_LIBEXEC" \
  "$DIR_USR_LOCAL_LIB" \
  "$DIR_USR_LOCAL_SHARE" \
  "$DIR_USR_LIB" \
  "$DIR_VAR_LIB_INSTALLER_STATE" \
  "$DIR_FIRSTBOOT" \
  "$DIR_PERL5_SITE_PERL" \
  "$DIR_PYTHON3_SITE_PACKAGES" \
  "$DIR_APPARMOR" \
  "$DIR_SYSTEMD_ETC" \
  "$DIR_SYSTEMD_SYSTEM"
# Scan only files declared at the authenticated publication boundary. Keeping
# the inventory in private installer state avoids package-tree traversal and
# prevents installer environment or repository selectors entering the target.
owned_scan=${DIR_INSTALLER_RUNTIME}/bootstrap/target-owned-scan.awk
[ -f "$owned_scan" ] && [ ! -L "$owned_scan" ] &&
  [ "$(installer_metadata_value "$owned_scan" uid_gid_mode_links)" = '0:0:600:1' ] || {
    printf '%s\n' 'fatal: authenticated target ownership scanner is unavailable' >&2
    exit 1
  }
[ -d "$DIR_INSTALLER_TARGET_OWNERSHIP" ] && [ ! -L "$DIR_INSTALLER_TARGET_OWNERSHIP" ] &&
  [ "$(installer_metadata_value "$DIR_INSTALLER_TARGET_OWNERSHIP" uid_gid_mode)" = '0:0:700' ] || {
    printf '%s\n' 'fatal: private target ownership inventory is unavailable' >&2
    exit 1
  }
marker_report=$(mktemp "${DIR_INSTALLER_RUNTIME}/target-marker-scan.XXXXXX")
owned_inventory=$(mktemp "${DIR_INSTALLER_RUNTIME}/target-owned-files.XXXXXX")
chmod 0600 "$marker_report" "$owned_inventory"
owned_record=$(mktemp "${DIR_INSTALLER_RUNTIME}/target-owned-snapshot.XXXXXX")
installer_target_ownership_snapshot >"$owned_record" || {
  printf '%s\n' 'fatal: malformed or interrupted target ownership journal' >&2
  exit 1
}
owned_count=0
while IFS="$(printf '\t')" read -r owned_path owned_source owned_kind owned_phase owned_mode owned_extra; do
  [ -n "$owned_source" ] && [ -n "$owned_kind" ] && [ -n "$owned_phase" ] &&
    [ -n "$owned_mode" ] && [ -z "$owned_extra" ] || exit 1
  case "$owned_path" in /*) ;; *) exit 1 ;; esac
  case "$owned_path" in /|*//*|*/../*|*/..|*/./*|*/.|*[!A-Za-z0-9_./@+\ -]*) exit 1 ;; esac
  owned_count=$((owned_count + 1))
  [ "$owned_count" -le 10000 ] || { printf '%s\n' 'fatal: excessive target ownership records' >&2; exit 1; }
  owned_file=${target}${owned_path}
  case "$owned_source" in repo.env|hosts/installer/runtime.env|hooks/installer/di.env)
    printf 'fatal: installer input published into target file=%s source=%s phase=%s\n' "$owned_path" "$owned_source" "$owned_phase" >&2
    exit 1 ;;
  esac
  # Typed consumer scratch inputs may already have been removed. No other
  # missing publication is accepted as a successfully installed final file.
  if [ "$owned_kind" = template-input ]; then
    [ ! -e "$owned_file" ] && [ ! -L "$owned_file" ] || {
      printf 'fatal: installer consumer input remains in target file=%s source=%s phase=%s\n' "$owned_path" "$owned_source" "$owned_phase" >&2
      exit 1
    }
    continue
  fi
  [ -f "$owned_file" ] && [ ! -L "$owned_file" ] &&
    [ "$(installer_metadata_value "$owned_file" links)" = 1 ] || {
      printf 'fatal: absent or indirect owned target file=%s source=%s phase=%s\n' "$owned_path" "$owned_source" "$owned_phase" >&2
      exit 1
    }
  owned_real=$(readlink -f -- "$owned_file") || exit 1
  [ "$owned_real" = "$owned_file" ] || { printf '%s\n' 'fatal: owned target ancestry contains a symlink alias' >&2; exit 1; }
  case "$owned_real" in "$target"/*) ;; *) printf '%s\n' 'fatal: owned target parent escapes mounted target' >&2; exit 1 ;; esac
  owned_bytes=$(wc -c <"$owned_file")
  [ "$owned_bytes" -le 16777216 ] || { printf '%s\n' 'fatal: excessive owned target file size' >&2; exit 1; }
  printf '%s\t%s\t%s\t%s\t%s\n' "$owned_path" "$owned_source" "$owned_kind" "$owned_phase" "$owned_mode" >>"$owned_inventory"
done <"$owned_record"
[ "$owned_count" -gt 0 ] || { printf '%s\n' 'fatal: empty target ownership inventory' >&2; exit 1; }
if ! LC_ALL=C awk -v registry="$placeholder_registry" -v target_root="$target" \
    -f "$owned_scan" "$owned_inventory" >"$marker_report"; then
  cat "$marker_report" >&2
  printf 'fatal: owned target validation failed; evidence=%s inventory=%s\n' "$marker_report" "$owned_inventory" >&2
  exit 1
fi
rm -f "$marker_report" "$owned_inventory" "$owned_record"
# Do not traverse indirect parents when writing privileged readiness state.
path=$target_state
while [ "$path" != / ]; do
  [ ! -L "$path" ]
  path=${path%/*}; [ -n "$path" ] || path=/
done
install -d -m 0700 "$target_state"
tmp=$(mktemp "$target_state/.validated.XXXXXX")
printf 'state=TARGET_VALIDATED\ninstallation_success=not_yet\n' >"$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$target_state/target-validated"
tmp=$(mktemp "$LC_STATE/.validated.XXXXXX")
printf 'state=TARGET_VALIDATED\n' >"$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$LC_STATE/target-validated"
