#!/bin/sh
# Finish-install hook: repair target APT sources before apt reads them, then
# modernize and normalize generated .sources files and Debian archive stanzas.
# The target normalizer groups the exact 3proxy archive into 3proxy.sources,
# retaining apt-setup's scoped Signed-By key; it does not use global trust.
set -eu

RUNTIME_DIR=${INSTALLER_RUNTIME_DIR:-/tmp/install-runtime}
RUNTIME_LOG_FILE=
BOOTSTRAP_LIB="${RUNTIME_DIR}/bootstrap/common-lib.sh"
CONTEXT_ENV="${RUNTIME_DIR}/state/context.env"
TARGET=
ENV_DIR=${INSTALLER_ENV_DIR:-}
HOST_ENV=
CUDA_LEGACY_REPO_URL=
CUDA_LEGACY_REPO_MATCH=

if [ -r "$BOOTSTRAP_LIB" ]; then
  # shellcheck disable=SC1090
  . "$BOOTSTRAP_LIB"
  RUNTIME_LOG_FILE=$(installer_runtime_log_file)
  RUNTIME_DIR=$(installer_runtime_dir)
  CONTEXT_ENV="${RUNTIME_DIR}/state/context.env"
  TARGET=${INSTALLER_TARGET_DIR:-${TARGET_ROOT:-}}
  ENV_DIR=${DIR_INSTALLER_ENV}
  HOST_ENV="${ENV_DIR}/host.env"
  installer_operation_context_repo FILE_INST_FINISH_95_NORMALIZE_APT 26 finish_install_apt_normalizer
  [ -r "$HOST_ENV" ] || {
    printf '%s\n' "fatal: missing host environment: ${HOST_ENV}" >&2
    exit 1
  }
  # shellcheck disable=SC1090,SC1091
  if installer_load_data_env "$HOST_ENV"; then
    :
  else
    host_env_status=$?
    installer_fatal_status "$host_env_status" "finish-install APT host profile data was rejected: ${HOST_ENV}"
  fi
  [ -r "$CONTEXT_ENV" ] || {
    printf '%s\n' "fatal: missing installer suite context: ${CONTEXT_ENV}" >&2
    exit 1
  }
  # The context is the authenticated preseed decision, not installer-media
  # identity. It carries the target suite selected by the generated frontend.
  # shellcheck disable=SC1090
  . "$CONTEXT_ENV"
  CUDA_LEGACY_REPO_URL=${CUDA_LEGACY_REPOSITORY_URL%/}
  CUDA_LEGACY_REPO_MATCH=${CUDA_LEGACY_REPO_URL#https://}
else
  printf '%s\n' "fatal: installer common library is unavailable: ${BOOTSTRAP_LIB}" >&2
  exit 1
fi

runtime_log_dir=$(dirname "$RUNTIME_LOG_FILE")
[ -d "$runtime_log_dir" ] || install -d -m 0700 "$runtime_log_dir"
: >>"$RUNTIME_LOG_FILE"
chmod 0600 "$RUNTIME_LOG_FILE" 2>/dev/null || true
exec >>"$RUNTIME_LOG_FILE" 2>&1

finish_install_apt_status=0
trap 'finish_install_apt_status=$?; if [ "$finish_install_apt_status" -ne 0 ] && command -v installer_error >/dev/null 2>&1; then installer_error "finish-install APT normalization exited with status ${finish_install_apt_status}"; fi; exit "$finish_install_apt_status"' EXIT

log() {
  INSTALLER_LOG_STAGE=post_install_validation
  INSTALLER_LOG_TAG=finish-install-normalize-apt
  installer_info "$*"
}

target_is_mounted() {
  if [ "${INSTALLER_ASSUME_TARGET_MOUNTED:-0}" = 1 ]; then
    return 0
  fi
  while IFS=' ' read -r _mount_source mount_path _mount_type _mount_options _mount_rest || [ -n "${mount_path:-}" ]; do
    [ "$mount_path" = "$TARGET" ] && return 0
  done </proc/mounts
  return 1
}

run_in_target() {
  if command -v in-target >/dev/null 2>&1; then
    in-target "$@"
    return
  fi
  chroot "$TARGET" "$@"
}

append_with_separator() {
  dest=$1
  src=$2

  [ -s "$src" ] || return 0
  if [ -s "$dest" ]; then
    printf '\n' >>"$dest"
  fi
  cat "$src" >>"$dest"
}

rewrite_apt_http_to_https() {
  apt_dir="${TARGET}${DIR_APT}"
  [ -d "$apt_dir" ] || return 0

  find "$apt_dir" -type f \( -name '*.list' -o -name '*.sources' \) | while IFS= read -r src; do
    tmp="${src}.tmp.$$"
    sed 's#http://#https://#g' "$src" >"$tmp"
    mv "$tmp" "$src"
  done
}

dedupe_list_file_lines() {
  src=$1
  tmp="${src}.tmp.$$"

  [ -f "$src" ] || return 0
  awk '
    /^[[:space:]]*$/ { print; next }
    !seen[$0]++ { print }
  ' "$src" >"$tmp"
  mv "$tmp" "$src"
}

strip_exact_repo_from_list_file() {
  src=$1
  repo_url=$2
  tmp="${src}.tmp.$$"

  [ -f "$src" ] || return 0
  awk -v repo_url="$repo_url" '
    index($0, repo_url) == 0 { print }
  ' "$src" >"$tmp"
  mv "$tmp" "$src"
}

strip_exact_repo_from_sources_file() {
  src=$1
  repo_url=$2
  tmp="${src}.tmp.$$"

  [ -f "$src" ] || return 0
  awk -v repo_url="$repo_url" '
    function flush_stanza(    line_index) {
      if (stanza_line_count == 0) {
        return
      }
      if (!drop_stanza) {
        if (wrote_stanza) {
          print ""
        }
        for (line_index = 1; line_index <= stanza_line_count; line_index++) {
          print stanza_lines[line_index]
        }
        wrote_stanza = 1
      }
      for (line_index = 1; line_index <= stanza_line_count; line_index++) {
        delete stanza_lines[line_index]
      }
      stanza_line_count = 0
      drop_stanza = 0
    }
    /^[[:space:]]*$/ {
      flush_stanza()
      next
    }
    {
      stanza_lines[++stanza_line_count] = $0
      if (index($0, repo_url) != 0) {
        drop_stanza = 1
      }
    }
    END {
      flush_stanza()
    }
  ' "$src" >"$tmp"
  mv "$tmp" "$src"
}

remove_cdrom_repo_state() {
  sources_list="${TARGET}${DIR_APT}/sources.list"

  strip_exact_repo_from_list_file "$sources_list" "cdrom:"

  find "${TARGET}${DIR_APT_SOURCES_LIST_D}" -maxdepth 1 -type f | while IFS= read -r src; do
    case "${src##*/}" in
      *.list|*.list.*)
        strip_exact_repo_from_list_file "$src" "cdrom:"
        dedupe_list_file_lines "$src"
        ;;
      *.sources|*.sources.*)
        strip_exact_repo_from_sources_file "$src" "cdrom:"
        ;;
    esac
  done

  log "removed any lingering cdrom apt source entries from target apt state"
}

remove_cuda_legacy_repo_state() {
  if installer_nvidia_legacy_selected; then
    if installer_cuda_legacy_selected; then
      # The source belongs to the driver class. End the temporary CUDA-only
      # authentication exception before publishing the installed APT policy.
      installer_cuda_stage_target_source "$(installer_cuda_repository_url)" / "" persistent || return "$?"
    fi
    log "retained selected legacy NVIDIA repository with normal signature verification"
    return 0
  fi
  sources_list="${TARGET}${DIR_APT}/sources.list"
  remaining_source=

  strip_exact_repo_from_list_file "$sources_list" "$CUDA_LEGACY_REPO_MATCH"

  for src in "${TARGET}${DIR_APT_SOURCES_LIST_D}/cuda-legacy-temp".*; do
    [ -f "$src" ] || continue
    rm -f "$src"
  done

  find "${TARGET}${DIR_APT_SOURCES_LIST_D}" -maxdepth 1 -type f | while IFS= read -r src; do
    case "${src##*/}" in
      *.list|*.list.*)
        strip_exact_repo_from_list_file "$src" "$CUDA_LEGACY_REPO_MATCH"
        dedupe_list_file_lines "$src"
        ;;
      *.sources|*.sources.*)
        strip_exact_repo_from_sources_file "$src" "$CUDA_LEGACY_REPO_MATCH"
        ;;
    esac
  done

  rm -f "${TARGET}${FILE_APT_CUDA_LEGACY_ARCHIVE_KEY}"

  if [ -f "$sources_list" ] && grep -F -q "$CUDA_LEGACY_REPO_MATCH" "$sources_list"; then
    log "legacy CUDA repository remains in ${sources_list}"
    return 1
  fi
  remaining_source=$(
    find "${TARGET}${DIR_APT_SOURCES_LIST_D}" -maxdepth 1 -type f \
      -exec grep -F -l "$CUDA_LEGACY_REPO_MATCH" {} \; |
      sed -n '1p'
  )
  if [ -n "$remaining_source" ]; then
    log "legacy CUDA repository remains in ${remaining_source}"
    return 1
  fi

  log "removed all staged legacy CUDA Debian 12 source artifacts and keyring state"
}

[ -d "$TARGET" ] || exit 0
target_is_mounted || exit 0
[ -d "${TARGET}${DIR_APT_SOURCES_LIST_D}" ] || install -d -m 0755 "${TARGET}${DIR_APT_SOURCES_LIST_D}"

# Safety net for hooks that edit the canonical file after apt-setup has
# published its already-deduplicated generator output.
installer_apt_dedupe_source_list "${TARGET}${DIR_APT}/sources.list"

log "repairing and normalizing apt sources before apt modernize-sources"
rewrite_apt_http_to_https
remove_cdrom_repo_state
# End the installer-only legacy source policy before the normalizer moves
# sources.list entries into vendor .sources files. Otherwise an old temporary
# stanza and a new persistent stanza could disagree about authentication.
remove_cuda_legacy_repo_state
run_in_target "$FILE_INSTALLER_APT_NORMALIZE_SOURCES"
log "running apt modernize-sources in target"
run_in_target env DEBIAN_FRONTEND=noninteractive APT_LISTCHANGES_FRONTEND=none apt -y modernize-sources

log "normalizing apt sources after apt modernize-sources"
run_in_target "$FILE_INSTALLER_APT_NORMALIZE_SOURCES"
rewrite_apt_http_to_https
# Publish after source modernization: the default-release must not precede the
# selected archive. Drop any package defaults introduced by later transactions.
installer_apt_install_target_policy "$TARGET" final

log "normalized apt sources into .sources layout"
