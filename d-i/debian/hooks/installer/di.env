# Installer-only paths; never publish these inputs into target runtime settings.
# Immutable d-i phase directories and initrd /lan_ed25519.pub are Debian/media interfaces.

# Target policy.
TARGET_ROOT="/target"

# File policy.
FILE_INSTALLER_SSH_LAN_PUBLIC_KEY="/lan_ed25519.pub"

# Dir policy.
DIR_INSTALLER_RUNTIME="/tmp/install-runtime"
DIR_INSTALLER_ENV="/tmp/install-env"
DIR_INSTALLER_LATE_ENV="/tmp/install-env-late"
DIR_INSTALLER_PRE_PKGSEL_ENV="/tmp/install-env-pre-pkgsel"
DIR_INSTALLER_RUNTIME_STATE="${DIR_INSTALLER_RUNTIME}/state"
DIR_INSTALLER_TARGET_OWNERSHIP="${DIR_INSTALLER_RUNTIME_STATE}/target-assets"
DIR_INSTALLER_BIN="/bin"
DIR_INSTALLER_SBIN="/sbin"
DIR_INSTALLER_USR="/usr"
DIR_INSTALLER_USR_BIN="${DIR_INSTALLER_USR}/bin"
DIR_INSTALLER_USR_SBIN="${DIR_INSTALLER_USR}/sbin"
DIR_INSTALLER_USR_LOCAL="${DIR_INSTALLER_USR}/local"
DIR_INSTALLER_USR_LOCAL_BIN="${DIR_INSTALLER_USR_LOCAL}/bin"
DIR_INSTALLER_USR_LOCAL_SBIN="${DIR_INSTALLER_USR_LOCAL}/sbin"
DIR_INSTALLER_USR_LOCAL_LIBEXEC="${DIR_INSTALLER_USR_LOCAL}/libexec"
DIR_INSTALLER_STATE="/var/lib/installer-state"
# Target-relative, private rendered payload inputs for primary-account setup.
# This installation workspace is independent of the future-account skeletons.
DIR_INSTALLER_TARGET_DEFAULTS="${DIR_INSTALLER_STATE}/primary-defaults"
DIR_INSTALLER_TARGET_STAGE="${DIR_INSTALLER_STATE}/rendered-payload"

# File policy.
FILE_INSTALLER_LOG="/tmp/installer.log"
FILE_INSTALLER_TARGET_RENDER_READY="${DIR_INSTALLER_RUNTIME_STATE}/target-render.ready"
FILE_INSTALLER_SELECTED_DISK_IDENTITY="${DIR_INSTALLER_RUNTIME_STATE}/selected-disk.identity"
FILE_INSTALLER_SECURE_BOOT_REUSE_RESET="${DIR_INSTALLER_RUNTIME_STATE}/secure-boot-reuse-reset"
FILE_INSTALLER_APT_NORMALIZE_SOURCES="${DIR_INSTALLER_USR_LOCAL_LIBEXEC}/apt-repo-local-normalize-sources"
FILE_INSTALLER_DPKG_DIVERT="${DIR_INSTALLER_USR_BIN}/dpkg-divert"
FILE_INSTALLER_OS_PROBER="${DIR_INSTALLER_USR_BIN}/os-prober"
FILE_INSTALLER_OS_PROBER_REAL="${DIR_INSTALLER_USR_BIN}/os-prober.installer-real"
FILE_INSTALLER_OS_PROBER_STATE="${DIR_INSTALLER_STATE}/temporary-os-prober-shim"
FILE_INSTALLER_UNSHARE="${DIR_INSTALLER_USR_BIN}/unshare"
FILE_INSTALLER_UNSHARE_REAL="${DIR_INSTALLER_USR_BIN}/unshare.installer-real"
FILE_INSTALLER_UNSHARE_STATE="${DIR_INSTALLER_STATE}/temporary-unshare-shim"
# Temporary package entrypoint diversion; removed before finish-install completes.
FILE_INSTALLER_UPDATE_INITRAMFS="${DIR_INSTALLER_USR_SBIN}/update-initramfs"
FILE_INSTALLER_UPDATE_INITRAMFS_REAL="${DIR_INSTALLER_USR_SBIN}/update-initramfs.installer-real"

# Dir policy.
DIR_INSTALLER_BASE_INSTALLER_D="/usr/lib/base-installer.d"
DIR_INSTALLER_POST_BASE_INSTALLER_D="/usr/lib/post-base-installer.d"
DIR_INSTALLER_PRE_PKGSEL_D="/usr/lib/pre-pkgsel.d"
DIR_INSTALLER_APT_SETUP_GENERATORS="/usr/lib/apt-setup/generators"
# APT's immutable configuration interface in the d-i root, separate from target APT.
DIR_INSTALLER_APT_CONF_D="/etc/apt/apt.conf.d"
# console-setup-udeb's setupcon cache is an immutable installer package interface.
DIR_INSTALLER_CONSOLE_SETUP="/etc/console-setup"
DIR_INSTALLER_FINISH_INSTALL_D="/usr/lib/finish-install.d"
DIR_INSTALLER_LIB_PARTMAN="/lib/partman"
DIR_INSTALLER_LIB_PARTMAN_FINISH_D="${DIR_INSTALLER_LIB_PARTMAN}/finish.d"
DIR_INSTALLER_VAR_LIB_PARTMAN="/var/lib/partman"
